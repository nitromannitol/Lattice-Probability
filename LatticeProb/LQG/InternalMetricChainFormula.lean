import Mathlib
import LatticeProb.LQG.InternalMetricChainInf
import LatticeProb.LQG.InternalMetricChainSound

/-!
# The chain formula for the internal metric

For a Euclidean length metric `D` and an open set `U`, the internal metric `D(x, y; U)` equals the countable chain
infimum `chainInf D U x y` (`IsEuclideanLengthMetric.internalMetric_eq_chainInf`): the soundness of chains
(`IsEuclideanLengthMetric.internalMetric_chain_le_sum`) gives `D(x, y; U) ≤ chainInf D U x y`, and the rational
chains along paths give the converse (`IsEuclideanLengthMetric.chainInf_le_internalMetric`).

Consequently, for a γ-LQG metric `𝔇`, there is one function of the field, measurable for the σ-algebra generated by
the pairings with test functions, that equals `T ↦ 𝔇_T(x, y; U)` at every `T` for which `𝔇 T` is a Euclidean length
metric (`IsLQGMetric.exists_measurable_eq_internalMetric`).
-/

namespace LatticeProb.LQG

open Set Metric MeasureTheory
open scoped ENNReal
open LatticeProb.Gauss

/-- Soundness of the chain infimum: for a Euclidean length metric, `D(x, y; U) ≤ chainInf D U x y`. -/
theorem IsEuclideanLengthMetric.internalMetric_le_chainInf {D : ℂ → ℂ → ℝ}
    (hD : IsEuclideanLengthMetric D) (U : Set ℂ) (x y : ℂ) :
    internalMetric D U x y ≤ chainInf D U x y := by
  refine le_iInf₂ fun c hc => ?_
  obtain ⟨hρ, hc⟩ := hc
  have h := hD.internalMetric_chain_le_sum (U := U) (Nat.succ_pos c.1.length) (chainPoint x y c.1)
    (fun _ => (c.2 : ℝ)) (fun _ _ => by exact_mod_cast hρ) (fun i hi => (hc i hi).1)
    (fun i hi => (hc i hi).2.trans_le (hD.ratCircleInf_eq _ _).le)
  rw [chainPoint_zero, chainPoint_length_succ] at h
  exact h

/-- The chain formula: for a Euclidean length metric `D` and an open set `U`, `D(x, y; U) = chainInf D U x y`. -/
theorem IsEuclideanLengthMetric.internalMetric_eq_chainInf {D : ℂ → ℂ → ℝ}
    (hD : IsEuclideanLengthMetric D) {U : Set ℂ} (hU : IsOpen U) (x y : ℂ) :
    internalMetric D U x y = chainInf D U x y :=
  le_antisymm (hD.internalMetric_le_chainInf U x y) (hD.chainInf_le_internalMetric hU x y)

/-- For a γ-LQG metric `𝔇` and an open set `U`, there is a function of the field, measurable for the σ-algebra
generated by the pairings with test functions, equal to `𝔇_T(x, y; U)` at every `T` for which `𝔇 T` is a
Euclidean length metric. -/
theorem IsLQGMetric.exists_measurable_eq_internalMetric {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : IsLQGMetric γ ξ 𝔇) {U : Set ℂ} (hU : IsOpen U) (x y : ℂ) :
    ∃ g : ((ℂ → ℝ) → ℝ) → ℝ≥0∞, Measurable[distributionMeasurableSpace] g ∧
      ∀ T, IsEuclideanLengthMetric (𝔇 T) → g T = internalMetric (𝔇 T) U x y :=
  ⟨fun T => chainInf (𝔇 T) U x y, h𝔇.measurable_chainInf U x y,
    fun _ hT => (hT.internalMetric_eq_chainInf hU x y).symm⟩

end LatticeProb.LQG
