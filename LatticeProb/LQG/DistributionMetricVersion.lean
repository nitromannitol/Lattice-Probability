import LatticeProb.Prob.CountableCoordinatesMeasurable
import LatticeProb.Bonanno.LQGMetric.Statement.Metric
import LatticeProb.Bonanno.LQGMetric.Statement.Field

/-!
# A measurable metric assignment does not see the version of a random distribution

Let `D : 𝒟'(ℂ) → ContMetric` be measurable for the cylinder σ-algebra of `𝒟'(ℂ)`, the σ-algebra generated by the
pairings `T ↦ ⟨T, φ⟩` with test functions (`LQGMetric.DistOn.measurableSpace`), as for a strong γ-LQG metric
(`LQGMetric.IsStrongLQGMetric`). If two random distributions `F` and `G` have, for each test function `φ`, almost surely
the same pairing with `φ` (the exceptional event may depend on `φ`), then almost surely `D (F ω) = D (G ω)`.

The cylinder σ-algebra is the supremum of the σ-algebras generated by the single pairings
(`distOn_measurableSpace_le_iSup_comap`), so for a fixed pair of points `p` the real map `T ↦ D_T(p)` depends on
countably many pairings (`LatticeProb.ae_eq_comp_of_measurable_iSup_comap`). Hence both continuous functions `D_{F ω}` and
`D_{G ω}` on `ℂ × ℂ` agree on a countable dense set of pairs, outside one null event, and therefore everywhere.

## Main results

* `LatticeProb.LQG.distOn_measurableSpace_le_iSup_comap`: the cylinder σ-algebra of `𝒟'(U)` is generated by the single
  pairings.
* `LatticeProb.LQG.ae_eq_of_ae_eq_pairings_distC`: a measurable `D : 𝒟'(ℂ) → ContMetric` takes almost surely the same
  value at two random distributions with almost surely equal pairings with each test function.
-/

open MeasureTheory LQGMetric

namespace LatticeProb.LQG

/-- The cylinder σ-algebra of `𝒟'(U)` is contained in (in fact equal to) the supremum of the σ-algebras generated by the
pairings `T ↦ ⟨T, φ⟩` with single test functions `φ`. -/
theorem distOn_measurableSpace_le_iSup_comap (U : TopologicalSpace.Opens ℂ) :
    DistOn.measurableSpace U ≤
      ⨆ (φ : TestOn U) (_ : True), MeasurableSpace.comap (fun T : DistOn U => T φ) inferInstance := by
  change MeasurableSpace.comap (fun (T : DistOn U) (φ : TestOn U) => T φ) MeasurableSpace.pi ≤ _
  simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  exact iSup_mono fun φ => le_iSup_of_le trivial le_rfl

/-- For a measurable map `g` on `𝒟'(U)` into a countably generated space with measurable singletons, two random
distributions with almost surely equal pairings with each test function have almost surely the same image under `g`. -/
theorem ae_eq_comp_of_ae_eq_pairings_distOn {U : TopologicalSpace.Opens ℂ} {γ : Type*} [MeasurableSpace γ]
    [MeasurableSpace.CountablyGenerated γ] [MeasurableSingletonClass γ] {g : DistOn U → γ} (hg : Measurable g)
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {F G : Ω → DistOn U}
    (hFG : ∀ φ : TestOn U, ∀ᵐ ω ∂μ, F ω φ = G ω φ) : ∀ᵐ ω ∂μ, g (F ω) = g (G ω) :=
  LatticeProb.ae_eq_comp_of_measurable_iSup_comap (E := fun _ : TestOn U => ℝ) (p := fun _ => True)
    (X := fun (φ : TestOn U) (T : DistOn U) => T φ)
    (hg.mono (distOn_measurableSpace_le_iSup_comap U) le_rfl) fun φ _ => hFG φ

/-- **Version independence of a measurable continuous-metric assignment.** Let `D : 𝒟'(ℂ) → ContMetric` be measurable
for the cylinder σ-algebra. If the random distributions `F` and `G` satisfy `⟨F ω, φ⟩ = ⟨G ω, φ⟩` almost surely for
each test function `φ`, then almost surely `D (F ω) = D (G ω)`. -/
theorem ae_eq_of_ae_eq_pairings_distC {D : DistC → ContMetric} (hD : Measurable D) {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} {F G : Ω → DistC} (hFG : ∀ φ : TestC, ∀ᵐ ω ∂μ, F ω φ = G ω φ) :
    ∀ᵐ ω ∂μ, D (F ω) = D (G ω) := by
  obtain ⟨S, hSc, hSd⟩ := TopologicalSpace.exists_countable_dense (ℂ × ℂ)
  have hpt : ∀ p : ℂ × ℂ, ∀ᵐ ω ∂μ, (D (F ω)).1 p = (D (G ω)).1 p := fun p =>
    ae_eq_comp_of_ae_eq_pairings_distOn
      ((ContinuousMap.measurable_eval p).comp (measurable_subtype_coe.comp hD)) hFG
  have hall : ∀ᵐ ω ∂μ, ∀ p ∈ S, (D (F ω)).1 p = (D (G ω)).1 p :=
    (ae_ball_iff hSc).2 fun p _ => hpt p
  filter_upwards [hall] with ω hω
  exact Subtype.ext (ContinuousMap.coe_injective
    (Continuous.ext_on hSd (D (F ω)).1.continuous (D (G ω)).1.continuous hω))

/-- Pointwise form of `ae_eq_of_ae_eq_pairings_distC`: outside one null event, the two metrics agree at all pairs of
points. -/
theorem ae_forall_eq_of_ae_eq_pairings_distC {D : DistC → ContMetric} (hD : Measurable D) {Ω : Type*}
    [MeasurableSpace Ω] {μ : Measure Ω} {F G : Ω → DistC} (hFG : ∀ φ : TestC, ∀ᵐ ω ∂μ, F ω φ = G ω φ) :
    ∀ᵐ ω ∂μ, ∀ u v : ℂ, (D (F ω)).1 (u, v) = (D (G ω)).1 (u, v) := by
  filter_upwards [ae_eq_of_ae_eq_pairings_distC hD hFG] with ω hω u v
  rw [hω]

end LatticeProb.LQG
