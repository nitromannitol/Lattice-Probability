import LatticeProb.LQG.CoupledRealPrefixExit

/-! # Observation of finite exit traces -/

set_option autoImplicit false

noncomputable section

open MeasureTheory Filter Set Metric TopologicalSpace LQGMetric LQGMetric.Blueprint LQGMetric.LocalEvent
open MatedCRTHarmonic MatedCRTHarmonic.MatedCRT
open scoped ENNReal NNReal Topology

namespace LatticeProb.LQG

/-- The compact prefix is measurable in the sigma algebra generated by the
stopped path and the extended clock, including at an infinite clock. -/
theorem measurable_compact_prefix_from_observation
    {Ω : Type*} [MeasurableSpace (NonemptyCompacts ℂ)] [BorelSpace (NonemptyCompacts ℂ)]
    (v : Ω → C(ℝ≥0, ℂ)) (T : Ω → ℝ≥0∞) :
    @Measurable Ω (NonemptyCompacts ℂ)
      (MeasurableSpace.comap (fun ω => (v ω, T ω)) inferInstance) inferInstance
      (fun ω => compactPathPrefix (v ω) (T ω).toNNReal) := by
  let : MeasurableSpace Ω := MeasurableSpace.comap (fun ω => (v ω, T ω)) inferInstance
  have h : @Measurable Ω (C(ℝ≥0, ℂ) × ℝ≥0∞)
      (MeasurableSpace.comap (fun ω => (v ω, T ω)) inferInstance) inferInstance
      (fun ω => (v ω, T ω)) := comap_measurable _
  exact measurable_compactPathPrefix_toNNReal h.fst h.snd

/-- At any fixed radius the observed compact prefix represents almost surely
the trace up to the real prefix-exit infimum. -/
theorem ae_coupled_exit_trace_from_observation
    {γ : ℝ} {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {X X₀ hIG₀ : Ω → Field} {B B' B₀ B₀' : ℝ≥0 → Ω → ℝ}
    {U : Ω → ℝ} {ηL η η₀ : Ω → C(ℝ, ℂ)} {bm : Ω → Path2}
    (D : IsMatingOfTreesCoupling γ P X X₀ hIG₀ B B' B₀ B₀' U ηL η η₀ bm)
    (r : ℝ) :
    ∀ᵐ ω ∂P,
      let w : C(ℝ≥0, ℂ) := ⟨fun t => ηL ω t, (ηL ω).continuous.comp NNReal.continuous_coe⟩
      let T := openExitTime (fun t (_ : Unit) => w t) (ball 0 r) ()
      let τ := sInf {t : ℝ | 0 ≤ t ∧ ¬ ηL ω '' Icc 0 t ⊆ ball 0 r}
      (compactPathPrefix (stoppedPath T w) T.toNNReal : Set ℂ) = ηL ω '' Icc 0 τ := by
  filter_upwards [ae_coupled_real_prefix_exit D] with ω hω
  exact (hω r).2.2

end LatticeProb.LQG
