import LatticeProb.LQG.MatingOfTreesCouplingData

/-!
# The merge properties of a mating-of-trees pair under Brownian scaling

For a continuous pair `w = (L, R)` and a continuous curve `η`, the *merge property* says that every
direct `L`- or `R`-identification of two times `s < t` (`DirectRel`: `L s = L t < L u` for
`u ∈ (s, t)`) gives `η s = η t` (Duplantier-Miller-Sheffield, Lemma 8.8), and the *only-merge
property* says that `η s = η t` only if `s` and `t` are equivalent for the equivalence relation
generated by the direct identifications (Duplantier-Miller-Sheffield, Lemmas 8.9 and 8.14).

Both properties are invariant under the scaling of the mating-of-trees pair used for the quantum
cone: for `b > 0` and `R ≠ 0`, the pair `t ↦ b^{-1/2} w(bt)` (`brownRescale`) and the curve
`t ↦ R⁻¹ η(bt)` (`coneRescaleCurve`). The direct identifications of the rescaled pair are those of
`w` at the times `b s`, `b t`, and the rescaled curve takes the same value at `s` and `t` iff `η`
does at `b s` and `b t`.

The only-merge property is not a property of the law of `(η, w)` in any evident way (the complement
of a generated equivalence relation is only coanalytic); the scaling statements below transfer it
pathwise instead.

* `directRel_smul_comp_mul_iff`, `directRel_lrCoord_brownRescale_iff`: direct identifications under
  the scaling;
* `Relation.EqvGen.map_of_rel`: generated equivalence relations along a relation-preserving map;
* `merge_rescale`, `onlyMerge_rescale`: the two properties for one rescaled pair;
* `ae_merge_of_ae_rescale`, `ae_onlyMerge_of_ae_rescale`: the almost sure forms for random pairs
  equal almost surely to rescalings;
* `IsCouplingData.merge_of_ae_rescale`, `IsCouplingData.onlyMerge_of_ae_rescale`: the merge and
  only-merge clauses of a mating-of-trees coupling for any random element of the data space whose
  curve and boundary-length pair are almost surely the rescalings of those of the coupling.
-/

noncomputable section

open MeasureTheory Set
open scoped ENNReal NNReal

namespace Relation.EqvGen

/-- The equivalence relation generated by `r` is carried to the one generated by `r'` along a map
taking `r`-related points to `r'`-related points. -/
theorem map_of_rel {α β : Type*} {r : α → α → Prop} {r' : β → β → Prop} (f : α → β)
    (h : ∀ a c, r a c → r' (f a) (f c)) {a c : α} (hac : Relation.EqvGen r a c) :
    Relation.EqvGen r' (f a) (f c) := by
  induction hac with
  | rel x y hxy => exact .rel _ _ (h x y hxy)
  | refl x => exact .refl _
  | symm x y _ ih => exact .symm _ _ ih
  | trans x y z _ _ ih1 ih2 => exact .trans _ _ _ ih1 ih2

end Relation.EqvGen

namespace MatedCRTHarmonic

namespace MatedCRT

/-- Direct identifications of `u ↦ c X(b u)` for `b, c > 0` are those of `X` at the times `b s`,
`b t`. -/
theorem directRel_smul_comp_mul_iff {b c : ℝ} (hb : 0 < b) (hc : 0 < c) (X : ℝ → ℝ) (s t : ℝ) :
    DirectRel (fun u => c * X (b * u)) s t ↔ DirectRel X (b * s) (b * t) := by
  unfold DirectRel
  constructor
  · rintro ⟨hst, heq, hlt⟩
    refine ⟨mul_lt_mul_of_pos_left hst hb, mul_left_cancel₀ hc.ne' heq, fun v hv => ?_⟩
    have hv' : v / b ∈ Ioo s t :=
      ⟨by rw [lt_div_iff₀ hb, mul_comm]; exact hv.1, by rw [div_lt_iff₀ hb, mul_comm]; exact hv.2⟩
    have key : c * X (b * s) < c * X (b * (v / b)) := hlt (v / b) hv'
    have e : b * (v / b) = v := by field_simp
    rw [e] at key
    exact lt_of_mul_lt_mul_left key hc.le
  · rintro ⟨hst, heq, hlt⟩
    refine ⟨lt_of_mul_lt_mul_left hst hb.le, show c * X (b * s) = c * X (b * t) by rw [heq],
      fun u hu => ?_⟩
    exact mul_lt_mul_of_pos_left
      (hlt (b * u) ⟨mul_lt_mul_of_pos_left hu.1 hb, mul_lt_mul_of_pos_left hu.2 hb⟩) hc

/-- The coordinates of the Brownian rescaling `t ↦ b^{-1/2} w(bt)` of a pair. -/
theorem lrCoord_brownRescale (b : ℝ) (i : Fin 2) (u : ℝ) (w : Path2) :
    lrCoord i u (brownRescale b w) = b ^ (-(1 / 2 : ℝ)) * lrCoord i (b * u) w := by
  unfold lrCoord brownRescale
  split_ifs <;> simp

/-- Direct identifications of a coordinate of the Brownian rescaling of a pair are those of the
pair at the times `b s`, `b t`. -/
theorem directRel_lrCoord_brownRescale_iff {b : ℝ} (hb : 0 < b) (i : Fin 2) (w : Path2)
    (s t : ℝ) :
    DirectRel (fun u => lrCoord i u (brownRescale b w)) s t ↔
      DirectRel (fun u => lrCoord i u w) (b * s) (b * t) := by
  simp only [lrCoord_brownRescale]
  exact directRel_smul_comp_mul_iff hb (by positivity) (fun u => lrCoord i u w) s t

theorem coneRescaleCurve_apply (R b : ℝ) (η : C(ℝ, ℂ)) (t : ℝ) :
    coneRescaleCurve R b η t = ((R⁻¹ : ℝ) : ℂ) * η (b * t) := rfl

/-- For `R ≠ 0` the rescaled curve `t ↦ R⁻¹ η(bt)` takes the same value at `s` and `t` iff `η`
does at `b s` and `b t`. -/
theorem coneRescaleCurve_eq_iff {R : ℝ} (hR : R ≠ 0) (b : ℝ) (η : C(ℝ, ℂ)) (s t : ℝ) :
    coneRescaleCurve R b η s = coneRescaleCurve R b η t ↔ η (b * s) = η (b * t) := by
  rw [coneRescaleCurve_apply, coneRescaleCurve_apply]
  exact mul_right_inj' (Complex.ofReal_ne_zero.mpr (inv_ne_zero hR))

/-- **The merge property under Brownian scaling.** If every direct identification of `w` gives
equal points of `η`, then every direct identification of `t ↦ b^{-1/2} w(bt)` gives equal points of
`t ↦ R⁻¹ η(bt)`. -/
theorem merge_rescale {b : ℝ} (hb : 0 < b) (R : ℝ) {η : C(ℝ, ℂ)} {w : Path2}
    (h : ∀ s t : ℝ, (DirectRel (fun u => lrCoord 0 u w) s t ∨
      DirectRel (fun u => lrCoord 1 u w) s t) → η s = η t) (s t : ℝ)
    (hst : DirectRel (fun u => lrCoord 0 u (brownRescale b w)) s t ∨
      DirectRel (fun u => lrCoord 1 u (brownRescale b w)) s t) :
    coneRescaleCurve R b η s = coneRescaleCurve R b η t := by
  rw [directRel_lrCoord_brownRescale_iff hb, directRel_lrCoord_brownRescale_iff hb] at hst
  rw [coneRescaleCurve_apply, coneRescaleCurve_apply, h _ _ hst]

/-- **The only-merge property under Brownian scaling.** If `η s = η t` only for times equivalent
under the equivalence relation generated by the direct identifications of `w`, then, for `R ≠ 0`,
the same holds for `t ↦ R⁻¹ η(bt)` and `t ↦ b^{-1/2} w(bt)`. -/
theorem onlyMerge_rescale {b R : ℝ} (hb : 0 < b) (hR : R ≠ 0) {η : C(ℝ, ℂ)} {w : Path2}
    (h : ∀ s t : ℝ, η s = η t → Relation.EqvGen (fun a c => DirectRel (fun u => lrCoord 0 u w) a c ∨
      DirectRel (fun u => lrCoord 1 u w) a c) s t) (s t : ℝ)
    (hst : coneRescaleCurve R b η s = coneRescaleCurve R b η t) :
    Relation.EqvGen (fun a c => DirectRel (fun u => lrCoord 0 u (brownRescale b w)) a c ∨
      DirectRel (fun u => lrCoord 1 u (brownRescale b w)) a c) s t := by
  have e1 : ∀ x : ℝ, b * (x / b) = x := fun x => by field_simp
  have e2 : ∀ x : ℝ, b * x / b = x := fun x => by field_simp
  have h' := Relation.EqvGen.map_of_rel (fun x : ℝ => x / b)
    (r' := fun a c => DirectRel (fun u => lrCoord 0 u (brownRescale b w)) a c ∨
      DirectRel (fun u => lrCoord 1 u (brownRescale b w)) a c)
    (fun a c hac => by
      rw [directRel_lrCoord_brownRescale_iff hb, directRel_lrCoord_brownRescale_iff hb, e1, e1]
      exact hac)
    (h _ _ ((coneRescaleCurve_eq_iff hR b η s t).1 hst))
  simpa only [e2] using h'

section Random

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}

/-- The merge property holds almost surely for random pairs that are almost surely the Brownian
rescalings of random pairs with the merge property. -/
theorem ae_merge_of_ae_rescale {b : ℝ} (hb : 0 < b) {R : Ω → ℝ} {η η' : Ω → C(ℝ, ℂ)}
    {w w' : Ω → Path2} (hη : ∀ᵐ ω ∂P, η' ω = coneRescaleCurve (R ω) b (η ω))
    (hw : ∀ᵐ ω ∂P, w' ω = brownRescale b (w ω))
    (h : ∀ᵐ ω ∂P, ∀ s t : ℝ, (DirectRel (fun u => lrCoord 0 u (w ω)) s t ∨
      DirectRel (fun u => lrCoord 1 u (w ω)) s t) → η ω s = η ω t) :
    ∀ᵐ ω ∂P, ∀ s t : ℝ, (DirectRel (fun u => lrCoord 0 u (w' ω)) s t ∨
      DirectRel (fun u => lrCoord 1 u (w' ω)) s t) → η' ω s = η' ω t := by
  filter_upwards [hη, hw, h] with ω e1 e2 hω
  rw [e1, e2]
  exact merge_rescale hb (R ω) hω

/-- The only-merge property holds almost surely for random pairs that are almost surely the
Brownian rescalings (with an almost surely nonzero curve factor) of random pairs with the
only-merge property. -/
theorem ae_onlyMerge_of_ae_rescale {b : ℝ} (hb : 0 < b) {R : Ω → ℝ} {η η' : Ω → C(ℝ, ℂ)}
    {w w' : Ω → Path2} (hR : ∀ᵐ ω ∂P, R ω ≠ 0)
    (hη : ∀ᵐ ω ∂P, η' ω = coneRescaleCurve (R ω) b (η ω))
    (hw : ∀ᵐ ω ∂P, w' ω = brownRescale b (w ω))
    (h : ∀ᵐ ω ∂P, ∀ s t : ℝ, η ω s = η ω t →
      Relation.EqvGen (fun a c => DirectRel (fun u => lrCoord 0 u (w ω)) a c ∨
        DirectRel (fun u => lrCoord 1 u (w ω)) a c) s t) :
    ∀ᵐ ω ∂P, ∀ s t : ℝ, η' ω s = η' ω t →
      Relation.EqvGen (fun a c => DirectRel (fun u => lrCoord 0 u (w' ω)) a c ∨
        DirectRel (fun u => lrCoord 1 u (w' ω)) a c) s t := by
  filter_upwards [hR, hη, hw, h] with ω e0 e1 e2 hω
  rw [e1, e2]
  exact onlyMerge_rescale hb e0 hω

end Random

section CouplingData

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} {γ : ℝ}

/-- **Merge clause of a rescaled coupling.** If the curve and the boundary-length pair of a random
element `V'` of the data space are almost surely `t ↦ R⁻¹ η(bt)` and `t ↦ b^{-1/2} w(bt)` for the
curve `η` and pair `w` of a mating-of-trees coupling `V`, then `V'` has the merge property. -/
theorem IsCouplingData.merge_of_ae_rescale {V V' : Ω → CouplingData} (hC : IsCouplingData γ P V)
    {b : ℝ} (hb : 0 < b) {R : Ω → ℝ} (hη : ∀ᵐ ω ∂P, (V' ω).η = coneRescaleCurve (R ω) b (V ω).η)
    (hw : ∀ᵐ ω ∂P, (V' ω).bm = brownRescale b (V ω).bm) :
    ∀ᵐ ω ∂P, ∀ s t : ℝ, (DirectRel (fun u => lrCoord 0 u (V' ω).bm) s t ∨
      DirectRel (fun u => lrCoord 1 u (V' ω).bm) s t) → (V' ω).η s = (V' ω).η t :=
  ae_merge_of_ae_rescale hb hη hw
    (show IsMatingOfTreesCoupling _ _ _ _ _ _ _ _ _ _ _ _ _ _ from hC).merge

/-- **Only-merge clause of a rescaled coupling.** If the curve and the boundary-length pair of a
random element `V'` of the data space are almost surely `t ↦ R⁻¹ η(bt)` (with `R ≠ 0` almost surely)
and `t ↦ b^{-1/2} w(bt)` for the curve `η` and pair `w` of a mating-of-trees coupling `V`, then `V'`
has the only-merge property. -/
theorem IsCouplingData.onlyMerge_of_ae_rescale {V V' : Ω → CouplingData}
    (hC : IsCouplingData γ P V) {b : ℝ} (hb : 0 < b) {R : Ω → ℝ} (hR : ∀ᵐ ω ∂P, R ω ≠ 0)
    (hη : ∀ᵐ ω ∂P, (V' ω).η = coneRescaleCurve (R ω) b (V ω).η)
    (hw : ∀ᵐ ω ∂P, (V' ω).bm = brownRescale b (V ω).bm) :
    ∀ᵐ ω ∂P, ∀ s t : ℝ, (V' ω).η s = (V' ω).η t →
      Relation.EqvGen (fun a c => DirectRel (fun u => lrCoord 0 u (V' ω).bm) a c ∨
        DirectRel (fun u => lrCoord 1 u (V' ω).bm) a c) s t :=
  ae_onlyMerge_of_ae_rescale hb hR hη hw
    (show IsMatingOfTreesCoupling _ _ _ _ _ _ _ _ _ _ _ _ _ _ from hC).onlyMerge

end CouplingData

end MatedCRT

end MatedCRTHarmonic
