import LatticeProb.LQG.MatingOfTreesCouplingLaw
import LatticeProb.Prob.AnalyticUniversalMeasurable
import LatticeProb.Bonanno.MatedCRTHarmonic.Frozen.MatedCRTDirectRel
import LatticeProb.Bonanno.MatedCRTHarmonic.Frozen.MatedCRTLrCoord

/-!
# The merge property of a mating-of-trees pair is a property of its law

For a continuous pair `b = (L, R)` and a continuous curve `η`, the *merge property* says that every
direct `L`- or `R`-identification of two times `s < t` (`DirectRel`: `L s = L t < L u` for
`u ∈ (s, t)`) gives `η s = η t` (Duplantier-Miller-Sheffield, Lemma 8.8).

* `measurableSet_directRel`: the direct identifications form a Borel subset of `Path2 × ℝ × ℝ`;
* `analyticSet_setOf_not_merge`: the pairs `(η, b)` violating the merge property form an analytic
  subset of `C(ℝ, ℂ) × Path2`, the projection of a Borel set of `(η, b, s, t)`;
* `ae_merge_of_map_eq`: hence, if the merge property holds almost surely for a random pair, it holds
  almost surely for every random pair with the same law, on any probability space (analytic sets
  are universally measurable);
* `MeasureTheory.ae_mem_of_map_eq_of_map_compl_eq_zero`: if `W = g ∘ V` almost surely and the law of
  `W` gives outer measure zero to the complement of a set `G`, then `g ∘ V'` lies in `G` almost
  surely for every `V'` with the law of `V`.

The reverse inclusion (points of `η` with several preimages only come from the equivalence relation
generated by the direct identifications) is not of this form: the complement of a generated
equivalence relation is only coanalytic.
-/

noncomputable section

open MeasureTheory Set
open scoped ENNReal

namespace MeasureTheory

variable {Ω Ω' 𝒱 β : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] [MeasurableSpace 𝒱]
  [MeasurableSpace β] {P : Measure Ω} {P' : Measure Ω'} {V : Ω → 𝒱} {V' : Ω' → 𝒱}

/-- Let `W` agree almost surely with a measurable function `g` of `V`, and let the law of `W` give
outer measure zero to the complement of a set `G` (measurable or not). Then for every random element
`V'` with the law of `V`, the random element `g ∘ V'` lies in `G` almost surely. -/
theorem ae_mem_of_map_eq_of_map_compl_eq_zero (hV : Measurable V) (hV' : Measurable V')
    (hlaw : P'.map V' = P.map V) {g : 𝒱 → β} (hg : Measurable g) {W : Ω → β}
    (hW : ∀ᵐ ω ∂P, W ω = g (V ω)) {G : Set β} (hG : P.map W Gᶜ = 0) :
    ∀ᵐ ω ∂P', g (V' ω) ∈ G := by
  obtain ⟨T, hGT, hT, hT0⟩ := exists_measurable_superset_of_null hG
  have hmapW : P.map W = P.map (fun ω => g (V ω)) := Measure.map_congr hW
  rw [hmapW, Measure.map_apply (f := fun ω => g (V ω)) (hg.comp hV) hT] at hT0
  have h2 : P' (V' ⁻¹' (g ⁻¹' T)) = 0 := by
    rw [← Measure.map_apply hV' (hg hT), hlaw, Measure.map_apply hV (hg hT)]
    exact hT0
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 h2] with ω hω
  by_contra hc
  exact hω (hGT hc)

end MeasureTheory

namespace MatedCRTHarmonic

namespace MatedCRT

/-- The coordinates `(b, t) ↦ lrCoord i t b` of a pair are jointly continuous. -/
theorem continuous_lrCoord (i : Fin 2) : Continuous fun p : Path2 × ℝ => lrCoord i p.2 p.1 := by
  have hev : Continuous fun p : Path2 × ℝ => p.1 p.2 := ContinuousEval.continuous_eval
  by_cases hi : i = 0
  · simp only [lrCoord, hi, ↓reduceIte]
    exact continuous_fst.comp hev
  · simp only [lrCoord, hi, ↓reduceIte]
    exact continuous_snd.comp hev

/-- A direct identification, with the open segment `(s, t)` exhausted by the compact segments
`s + θ (t - s)`, `θ ∈ [1/(n+3), 1 - 1/(n+3)]`. -/
theorem directRel_iff (X : ℝ → ℝ) (s t : ℝ) :
    DirectRel X s t ↔ s < t ∧ X s = X t ∧
      ∀ n : ℕ, ∀ θ ∈ Icc (1 / ((n : ℝ) + 3)) (1 - 1 / ((n : ℝ) + 3)),
        X s < X (s + θ * (t - s)) := by
  unfold DirectRel
  constructor
  · rintro ⟨hst, heq, hpos⟩
    refine ⟨hst, heq, fun n θ hθ => hpos _ ⟨?_, ?_⟩⟩
    · have hθ0 : 0 < θ := lt_of_lt_of_le (by positivity) hθ.1
      have := mul_pos hθ0 (sub_pos.2 hst)
      linarith
    · have hn : (0 : ℝ) < 1 / ((n : ℝ) + 3) := by positivity
      have hθ1 : θ < 1 := lt_of_le_of_lt hθ.2 (by linarith)
      have := mul_lt_mul_of_pos_right hθ1 (sub_pos.2 hst)
      linarith
  · rintro ⟨hst, heq, hpos⟩
    refine ⟨hst, heq, fun u hu => ?_⟩
    have hts : 0 < t - s := sub_pos.2 hst
    have hθ0 : 0 < (u - s) / (t - s) := div_pos (sub_pos.2 hu.1) hts
    have hθ1 : (u - s) / (t - s) < 1 := (div_lt_one hts).2 (by linarith [hu.2])
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt (lt_min hθ0 (sub_pos.2 hθ1))
    have hn3 : 1 / ((n : ℝ) + 3) ≤ 1 / ((n : ℝ) + 1) :=
      one_div_le_one_div_of_le (by positivity) (by linarith)
    have hu' : s + (u - s) / (t - s) * (t - s) = u := by
      rw [div_mul_cancel₀ _ hts.ne']
      ring
    have h := hpos n ((u - s) / (t - s))
      ⟨by linarith [min_le_left ((u - s) / (t - s)) (1 - (u - s) / (t - s))],
        by linarith [min_le_right ((u - s) / (t - s)) (1 - (u - s) / (t - s))]⟩
    rwa [hu'] at h

/-- **Direct identifications are Borel**: `{(b, s, t) | DirectRel (lrCoord i · b) s t}` is a
measurable subset of `Path2 × ℝ × ℝ`. -/
theorem measurableSet_directRel (i : Fin 2) :
    MeasurableSet {q : Path2 × ℝ × ℝ | DirectRel (fun u => lrCoord i u q.1) q.2.1 q.2.2} := by
  have hL := continuous_lrCoord i
  have hF : Continuous fun r : (Path2 × ℝ × ℝ) × ℝ =>
      lrCoord i (r.1.2.1 + r.2 * (r.1.2.2 - r.1.2.1)) r.1.1 - lrCoord i r.1.2.1 r.1.1 :=
    (hL.comp (f := fun r : (Path2 × ℝ × ℝ) × ℝ => (r.1.1, r.1.2.1 + r.2 * (r.1.2.2 - r.1.2.1)))
      (by fun_prop)).sub
      (hL.comp (f := fun r : (Path2 × ℝ × ℝ) × ℝ => (r.1.1, r.1.2.1)) (by fun_prop))
  have hopen : ∀ n : ℕ, IsOpen {q : Path2 × ℝ × ℝ |
      ∀ θ ∈ Icc (1 / ((n : ℝ) + 3)) (1 - 1 / ((n : ℝ) + 3)),
        0 < lrCoord i (q.2.1 + θ * (q.2.2 - q.2.1)) q.1 - lrCoord i q.2.1 q.1} := fun n =>
    (ContinuousMap.isOpen_setOfPred_mapsTo (isCompact_Icc (a := 1 / ((n : ℝ) + 3))
      (b := 1 - 1 / ((n : ℝ) + 3))) (isOpen_Ioi (a := (0 : ℝ)))).preimage
      (ContinuousMap.curry ⟨_, hF⟩).continuous
  have hlt : MeasurableSet {q : Path2 × ℝ × ℝ | q.2.1 < q.2.2} :=
    measurableSet_lt (by fun_prop) (by fun_prop)
  have heq : MeasurableSet {q : Path2 × ℝ × ℝ | lrCoord i q.2.1 q.1 = lrCoord i q.2.2 q.1} :=
    (isClosed_eq (hL.comp (f := fun q : Path2 × ℝ × ℝ => (q.1, q.2.1)) (by fun_prop))
      (hL.comp (f := fun q : Path2 × ℝ × ℝ => (q.1, q.2.2)) (by fun_prop))).measurableSet
  have hset : {q : Path2 × ℝ × ℝ | DirectRel (fun u => lrCoord i u q.1) q.2.1 q.2.2} =
      ({q : Path2 × ℝ × ℝ | q.2.1 < q.2.2} ∩
        {q : Path2 × ℝ × ℝ | lrCoord i q.2.1 q.1 = lrCoord i q.2.2 q.1}) ∩
        ⋂ n : ℕ, {q : Path2 × ℝ × ℝ |
          ∀ θ ∈ Icc (1 / ((n : ℝ) + 3)) (1 - 1 / ((n : ℝ) + 3)),
            0 < lrCoord i (q.2.1 + θ * (q.2.2 - q.2.1)) q.1 - lrCoord i q.2.1 q.1} := by
    ext q
    simp only [Set.mem_inter_iff, Set.mem_iInter, Set.mem_ofPred_eq, directRel_iff, sub_pos,
      and_assoc]
  rw [hset]
  exact (hlt.inter heq).inter (MeasurableSet.iInter fun n => (hopen n).measurableSet)

/-- **The failure of the merge property is analytic**: the pairs `(η, b)` having a direct `L`- or
`R`-identification `s < t` with `η s ≠ η t` form an analytic subset of `C(ℝ, ℂ) × Path2`. -/
theorem analyticSet_setOf_not_merge :
    AnalyticSet {p : C(ℝ, ℂ) × Path2 | ∃ s t : ℝ,
      (DirectRel (fun u => lrCoord 0 u p.2) s t ∨ DirectRel (fun u => lrCoord 1 u p.2) s t) ∧
        p.1 s ≠ p.1 t} := by
  have : PolishSpace C(ℝ, ℂ) := LQGMetric.polishSpace_continuousMap ℝ ℂ
  have : PolishSpace Path2 := LQGMetric.polishSpace_continuousMap ℝ (ℝ × ℝ)
  have hD : ∀ i : Fin 2, MeasurableSet {r : (C(ℝ, ℂ) × Path2) × ℝ × ℝ |
      DirectRel (fun u => lrCoord i u r.1.2) r.2.1 r.2.2} := fun i =>
    (measurableSet_directRel i).preimage
      ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
  have h1 : Continuous fun r : (C(ℝ, ℂ) × Path2) × ℝ × ℝ => r.1.1 r.2.1 :=
    ContinuousEval.continuous_eval.comp
      ((continuous_fst.comp continuous_fst).prodMk (continuous_fst.comp continuous_snd))
  have h2 : Continuous fun r : (C(ℝ, ℂ) × Path2) × ℝ × ℝ => r.1.1 r.2.2 :=
    ContinuousEval.continuous_eval.comp
      ((continuous_fst.comp continuous_fst).prodMk (continuous_snd.comp continuous_snd))
  have hne : MeasurableSet {r : (C(ℝ, ℂ) × Path2) × ℝ × ℝ | r.1.1 r.2.1 ≠ r.1.1 r.2.2} :=
    (isClosed_eq h1 h2).measurableSet.compl
  have hT : AnalyticSet {r : (C(ℝ, ℂ) × Path2) × ℝ × ℝ |
      (DirectRel (fun u => lrCoord 0 u r.1.2) r.2.1 r.2.2 ∨
        DirectRel (fun u => lrCoord 1 u r.1.2) r.2.1 r.2.2) ∧ r.1.1 r.2.1 ≠ r.1.1 r.2.2} :=
    (((hD 0).union (hD 1)).inter hne).analyticSet
  have hset : {p : C(ℝ, ℂ) × Path2 | ∃ s t : ℝ,
      (DirectRel (fun u => lrCoord 0 u p.2) s t ∨ DirectRel (fun u => lrCoord 1 u p.2) s t) ∧
        p.1 s ≠ p.1 t} =
      Prod.fst '' {r : (C(ℝ, ℂ) × Path2) × ℝ × ℝ |
        (DirectRel (fun u => lrCoord 0 u r.1.2) r.2.1 r.2.2 ∨
          DirectRel (fun u => lrCoord 1 u r.1.2) r.2.1 r.2.2) ∧ r.1.1 r.2.1 ≠ r.1.1 r.2.2} := by
    ext p
    constructor
    · rintro ⟨s, t, h, hst⟩
      exact ⟨(p, s, t), ⟨h, hst⟩, rfl⟩
    · rintro ⟨⟨q, s, t⟩, ⟨h, hst⟩, rfl⟩
      exact ⟨s, t, h, hst⟩
  rw [hset]
  exact hT.image_of_continuous continuous_fst

/-- **The merge property passes between random pairs with the same law.** Let `V` and `V'` be
measurable random elements of `C(ℝ, ℂ) × Path2`, on possibly different probability spaces, with the
same law. If almost surely every direct `L`- or `R`-identification of the pair `(V ω).2` gives the
same point of the curve `(V ω).1`, then the same holds almost surely for `V'`. -/
theorem ae_merge_of_map_eq {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω}
    [IsFiniteMeasure P] {P' : Measure Ω'} {V : Ω → C(ℝ, ℂ) × Path2} {V' : Ω' → C(ℝ, ℂ) × Path2}
    (hV : Measurable V) (hV' : Measurable V') (hlaw : P'.map V' = P.map V)
    (h : ∀ᵐ ω ∂P, ∀ s t : ℝ,
      (DirectRel (fun u => lrCoord 0 u (V ω).2) s t ∨ DirectRel (fun u => lrCoord 1 u (V ω).2) s t) →
        (V ω).1 s = (V ω).1 t) :
    ∀ᵐ ω ∂P', ∀ s t : ℝ,
      (DirectRel (fun u => lrCoord 0 u (V' ω).2) s t ∨
        DirectRel (fun u => lrCoord 1 u (V' ω).2) s t) → (V' ω).1 s = (V' ω).1 t := by
  have : PolishSpace C(ℝ, ℂ) := LQGMetric.polishSpace_continuousMap ℝ ℂ
  have : PolishSpace Path2 := LQGMetric.polishSpace_continuousMap ℝ (ℝ × ℝ)
  have hS := (LatticeProb.AnalyticSet.nullMeasurableSet (P.map V) analyticSet_setOf_not_merge).compl
  have h' := ae_comp_of_map_eq_of_nullMeasurableSet hV hV' hlaw hS (by
    filter_upwards [h] with ω hω
    show ¬ ∃ s t : ℝ, _
    rintro ⟨s, t, hst, hne⟩
    exact hne (hω s t hst))
  filter_upwards [h'] with ω hω s t hst
  by_contra hne
  exact hω (show ∃ s t : ℝ, _ from ⟨s, t, hst, hne⟩)

end MatedCRT

end MatedCRTHarmonic

