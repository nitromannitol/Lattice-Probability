import LatticeProb.LQG.InternalMetricSquareTail
import LatticeProb.LQG.LQGMetricMeasurable2
import LatticeProb.LQG.WeylCompositionOuter

/-!
# Measurability of the internal diameter of a compact set for the γ-LQG metric

For a γ-LQG metric `𝔇`, a whole-plane GFF `h`, an open set `U` and a compact set `K ⊆ U`, the quantity
`sup_{u, v ∈ K} D_h(u, v; U)` is almost surely equal to a random variable that is measurable for the σ-algebra
`σ(h|_U)` generated by the pairings of `h` with test functions supported in `U`.

The proof combines locality (axiom II), which gives `σ(h|_U)`-measurable versions of the internal distances, with the
continuity of the internal metric of a Euclidean length metric on `U × U` (axiom I), which reduces the supremum over `K`
to a supremum over a countable dense subset of `K`.

## Main statement

* `LatticeProb.LQG.IsLQGMetric.exists_measurable_iSup_internalMetric`
-/

open MeasureTheory Set LatticeProb.Gauss
open scoped ENNReal

namespace LatticeProb.LQG

variable {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
  {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}

/-- **Measurable version of the internal diameter of a compact set.** For a γ-LQG metric `𝔇`, a whole-plane GFF `h`, an
open set `U` and a compact set `K ⊆ U`, almost surely `sup_{u, v ∈ K} D_h(u, v; U)` equals a random variable that is
measurable for `σ(h|_U)` (`pairingSigmaAlgebra`). -/
theorem IsLQGMetric.exists_measurable_iSup_internalMetric (h𝔇 : IsLQGMetric γ ξ 𝔇)
    (hG : IsWholePlaneGFF P hC hcirc) {U K : Set ℂ} (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U) :
    ∃ T : Ω → ℝ≥0∞, Measurable[pairingSigmaAlgebra hC U] T ∧
      ∀ᵐ ω ∂P, (⨆ u ∈ K, ⨆ v ∈ K, internalMetric (𝔇 (hC ω)) U u v) = T ω := by
  have hA := h𝔇.satisfiesLQGMetricAxioms Ω P hC hcirc (fun _ _ => 0) hG (fun _ => continuous_const)
    (fun _ => measurable_const)
  have h0 : (fun ω => addFunPairing (hC ω) (fun _ => (0 : ℝ))) = hC := by
    funext ω φ
    simp [addFunPairing]
  rw [h0] at hA
  obtain ⟨G, hGm, hGae⟩ := hA.locality U hU
  obtain ⟨Q, hQc, hQK, hKQ⟩ := TopologicalSpace.exists_countable_dense_subset K
  have : Countable Q := hQc.to_subtype
  refine ⟨fun ω => ⨆ x : Q, ⨆ y : Q, G ω x y, ?_, ?_⟩
  · let _ := pairingSigmaAlgebra hC U
    exact Measurable.iSup fun x => Measurable.iSup fun y => hGm x y
  · filter_upwards [h𝔇.ae_isEuclideanLengthMetric_self hG, hGae] with ω hIω hGω
    have hcont : ContinuousOn (fun p : ℂ × ℂ => internalMetric (𝔇 (hC ω)) U p.1 p.2) (K ×ˢ K) :=
      (hIω.continuousOn_internalMetric_pair hIω.nonneg' hU).mono (prod_mono hKU hKU)
    rw [iSup_iSup_compact_eq_countable (F := internalMetric (𝔇 (hC ω)) U) hK hQK hKQ hcont]
    exact iSup_congr fun x => iSup_congr fun y => hGω x.1 (hKU (hQK x.2)) y.1 (hKU (hQK y.2))

end LatticeProb.LQG
