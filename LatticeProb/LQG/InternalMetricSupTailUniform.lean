import Mathlib
import LatticeProb.LQG.InternalMetricChainSup
import LatticeProb.LQG.InternalMetricCompactFinite
import LatticeProb.LQG.InternalMetricSquareTail
import LatticeProb.LQG.LQGMetricInternalScaling
import LatticeProb.Gauss.WholePlaneGFFLawTransfer
import LatticeProb.Gauss.GFFIncrementBound

/-!
# Uniform tails of the internal diameter of a compact connected set for the γ-LQG metric

Let `𝔇` be a γ-LQG metric (`IsLQGMetric`), `K ⊆ U` with `K` compact and preconnected and `U` open.

* `IsLQGMetric.exists_measure_iSup_internalMetric_gt_le`: for every `ε > 0` there is a constant `C` such that, in every
  realization of the whole-plane GFF, the probability that `sup_{u, v ∈ K} 𝔇_h(u, v; U) > C` is at most `ε`. The constant
  does not depend on the realization: the event is measurable for the σ-algebra generated by the pairings up to a set
  of zero probability in every realization, so its probability is a function of the law of the pairings alone.
* `IsLQGMetric.exists_measure_scaled_iSup_internalMetric_gt_le`: the same bound for the image of `(K, U)` under the
  affine map `w ↦ r w + z`, at the random scale `e^{ξ (h_r(z) + Q log r)}` (`ae_internalMetric_scaling`), uniformly in
  the radius `r > 0`, the centre `z ∈ ℂ` and the realization.
-/

open Set Metric MeasureTheory
open scoped ENNReal
open LatticeProb.Gauss

namespace LatticeProb.LQG

variable {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}

/-- **Uniform tail of the internal diameter of a compact connected set.** For a γ-LQG metric `𝔇`, a compact preconnected
set `K` in an open set `U` and `ε > 0`, there is a real `C` such that in every realization of the whole-plane GFF,
`P (sup_{u, v ∈ K} 𝔇_h(u, v; U) > C) ≤ ε`. -/
theorem IsLQGMetric.exists_measure_iSup_internalMetric_gt_le (h𝔇 : IsLQGMetric γ ξ 𝔇) {U K : Set ℂ}
    (hU : IsOpen U) (hK : IsCompact K) (hKc : IsPreconnected K) (hKU : K ⊆ U) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ C : ℝ, ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
      (hcirc : Ω → ℝ → ℂ → ℝ), IsWholePlaneGFF P hC hcirc →
      P {ω | ENNReal.ofReal C < ⨆ u ∈ K, ⨆ v ∈ K, internalMetric (𝔇 (hC ω)) U u v} ≤ ε := by
  obtain ⟨Ω₀, _, P₀, hP₀, hC₀, hcirc₀, hG₀⟩ := exists_isWholePlaneGFF_proved
  obtain ⟨g, hg, hgeq⟩ := h𝔇.exists_measurable_eq_iSup_internalMetric hU hK hKU
  set B : ℝ → Set ((ℂ → ℝ) → ℝ) :=
    fun C => {T | ENNReal.ofReal C < ⨆ u ∈ K, ⨆ v ∈ K, internalMetric (𝔇 T) U u v} with hB
  set M : ℕ → Set ((ℂ → ℝ) → ℝ) := fun n => g ⁻¹' Ioi (ENNReal.ofReal n) with hM
  have hMmeas : ∀ n, MeasurableSet[distributionMeasurableSpace] (M n) := fun n => hg measurableSet_Ioi
  have hBM : ∀ n : ℕ, B n ∩ {T | IsEuclideanLengthMetric (𝔇 T)} =
      M n ∩ {T | IsEuclideanLengthMetric (𝔇 T)} := by
    intro n
    ext T
    simp only [mem_inter_iff, mem_ofPred_eq, hB, hM, mem_preimage, mem_Ioi, and_congr_left_iff]
    intro hT
    rw [hgeq T hT]
  have hGood₀ := h𝔇.ae_isEuclideanLengthMetric_self hG₀
  -- the measurable sets `hC₀ ⁻¹' M n` decrease to a null set
  have hmeas : ∀ n : ℕ, MeasurableSet (hC₀ ⁻¹' M n) := fun n => hG₀.measurable_hC (hMmeas n)
  have hanti : Antitone fun n : ℕ => hC₀ ⁻¹' M n := by
    intro m n hmn T hT
    simp only [hM, mem_preimage, mem_Ioi] at hT ⊢
    exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (Nat.cast_le.2 hmn)) hT
  have hnull : P₀ (⋂ n : ℕ, hC₀ ⁻¹' M n) = 0 := by
    refine measure_mono_null (fun ω hω => ?_) (ae_iff.1 hGood₀)
    by_contra hgood
    have hgood' : IsEuclideanLengthMetric (𝔇 (hC₀ ω)) := not_not.1 hgood
    obtain ⟨A, hA⟩ := hgood'.exists_internalMetric_le_ofReal_of_isCompact hK hKc hU hKU
    obtain ⟨n, hn⟩ := exists_nat_ge A
    have hle : g (hC₀ ω) ≤ ENNReal.ofReal n := by
      rw [hgeq _ hgood']
      exact iSup₂_le fun u hu => iSup₂_le fun v hv =>
        (hA u hu v hv).trans (ENNReal.ofReal_le_ofReal hn)
    have h1 := mem_iInter.1 hω n
    simp only [hM, mem_preimage, mem_Ioi] at h1
    exact absurd h1 (not_lt.2 hle)
  have htend := tendsto_measure_iInter_atTop (μ := P₀) (fun n => (hmeas n).nullMeasurableSet) hanti
    ⟨0, measure_ne_top P₀ _⟩
  rw [hnull] at htend
  obtain ⟨n, hn⟩ := ((tendsto_order.1 htend).2 ε hε).exists
  refine ⟨n, fun Ω _ P hC hcirc hG => ?_⟩
  have hGood := h𝔇.ae_isEuclideanLengthMetric_self hG
  have hP : P (hC ⁻¹' B n) = P₀ (hC₀ ⁻¹' B n) :=
    hG.measure_preimage_eq_of_inter_eq hG₀ hGood hGood₀ (hMmeas n) (hBM n)
  have hP₁ : P₀ (hC₀ ⁻¹' B n) = P₀ (hC₀ ⁻¹' M n) :=
    measure_preimage_congr_of_inter_eq P₀ hC₀ hGood₀ (hBM n)
  exact (hP.trans hP₁).le.trans hn.le

/-- **Uniform tail of the internal diameter at every scale and centre.** For a γ-LQG metric `𝔇`, a compact preconnected
set `K` in an open set `U` and `ε > 0`, there is a real `C` such that in every realization of the whole-plane GFF, for
every `r > 0` and `z ∈ ℂ`, the probability that
`sup_{x, y ∈ rK + z} 𝔇_h(x, y; rU + z) > C e^{ξ (h_r(z) + Q log r)}` is at most `ε`. -/
theorem IsLQGMetric.exists_measure_scaled_iSup_internalMetric_gt_le (h𝔇 : IsLQGMetric γ ξ 𝔇) {U K : Set ℂ}
    (hU : IsOpen U) (hK : IsCompact K) (hKc : IsPreconnected K) (hKU : K ⊆ U) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ C : ℝ, ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
      (hcirc : Ω → ℝ → ℂ → ℝ), IsWholePlaneGFF P hC hcirc → ∀ r : ℝ, 0 < r → ∀ z : ℂ,
      P {ω | ENNReal.ofReal (C * Real.exp (ξ * (hcirc ω r z + lqgQ γ * Real.log r))) <
        ⨆ x ∈ (fun w : ℂ => (r : ℂ) * w + z) '' K, ⨆ y ∈ (fun w : ℂ => (r : ℂ) * w + z) '' K,
          internalMetric (𝔇 (hC ω)) ((fun w : ℂ => (r : ℂ) * w + z) '' U) x y} ≤ ε := by
  obtain ⟨C, hCε⟩ := h𝔇.exists_measure_iSup_internalMetric_gt_le hU hK hKc hKU hε
  refine ⟨C, fun Ω _ P hC hcirc hG r hr z => ?_⟩
  have h1 := hCε Ω P (recentredPairing hC hcirc r z) _ (isWholePlaneGFF_recentredPairing hG hr z)
  refine le_of_eq_of_le (measure_congr ?_) h1
  filter_upwards [h𝔇.ae_internalMetric_scaling hG hr z] with ω hω
  apply propext
  set a := ENNReal.ofReal (Real.exp (ξ * (hcirc ω r z + lqgQ γ * Real.log r))) with ha
  have hsup : (⨆ x ∈ (fun w : ℂ => (r : ℂ) * w + z) '' K, ⨆ y ∈ (fun w : ℂ => (r : ℂ) * w + z) '' K,
        internalMetric (𝔇 (hC ω)) ((fun w : ℂ => (r : ℂ) * w + z) '' U) x y) =
      a * ⨆ u ∈ K, ⨆ v ∈ K, internalMetric (𝔇 (recentredPairing hC hcirc r z ω)) U u v := by
    simp only [iSup_image, hω, ENNReal.mul_iSup]
  have ha0 : a ≠ 0 := (ENNReal.ofReal_pos.2 (Real.exp_pos _)).ne'
  show (_ < _) ↔ (_ < _)
  rw [hsup, ENNReal.ofReal_mul' (Real.exp_pos _).le, mul_comm (ENNReal.ofReal C) a,
    ENNReal.mul_lt_mul_iff_right ha0 ENNReal.ofReal_ne_top]

end LatticeProb.LQG
