import Mathlib
import LatticeProb.LQG.InternalMetricChainSup
import LatticeProb.LQG.HalfCrossingsOfSetDistance
import LatticeProb.LQG.InternalMetricSquareTail
import LatticeProb.Gauss.WholePlaneGFFLawTransfer

/-!
# Measurability of the internal distance between two compact sets

For compact sets `K₁, K₂` in an open set `U` and a family of Euclidean length metrics `D ω` with measurable values, the
internal distance `D_ω(K₁, K₂; U) = inf_{z ∈ K₁, w ∈ K₂} D_ω(z, w; U)` equals `inf_{z ∈ Q₁, w ∈ Q₂} chainInf (D ω) U z w`
for countable dense subsets `Q₁ ⊆ K₁`, `Q₂ ⊆ K₂` (continuity of the internal metric and the chain formula), hence is a
measurable function of `ω` on the set of `ω` for which `D ω` is a Euclidean length metric.

For a γ-LQG metric `𝔇` this gives a function measurable for the pairing σ-algebra. Combined with the independence of the
law of the pairing field from the realization, the probability that `D_h(K₁, K₂; U) ≥ L` is the same for every
whole-plane GFF `h` (`IsLQGMetric.measure_internalSetDist_ge_eq`).
-/

namespace LatticeProb.LQG

open Set Metric MeasureTheory
open scoped ENNReal
open LatticeProb.Gauss

/-- Reduction of an infimum over a product of two closed sets to countable dense subsets: if `F` is continuous on
`A × B` and `Qa ⊆ A`, `Qb ⊆ B` are dense, then `inf_{x ∈ A} inf_{y ∈ B} F x y = inf_{x ∈ Qa} inf_{y ∈ Qb} F x y`. -/
theorem iInf_iInf_closed_eq_countable {F : ℂ → ℂ → ℝ≥0∞} {A B Qa Qb : Set ℂ} (hA : IsClosed A)
    (hB : IsClosed B) (hQA : Qa ⊆ A) (hAQ : A ⊆ closure Qa) (hQB : Qb ⊆ B) (hBQ : B ⊆ closure Qb)
    (hF : ContinuousOn (fun p : ℂ × ℂ => F p.1 p.2) (A ×ˢ B)) :
    (⨅ x ∈ A, ⨅ y ∈ B, F x y) = ⨅ x : Qa, ⨅ y : Qb, F x y := by
  apply le_antisymm
  · exact le_iInf fun x => le_iInf fun y => iInf_le_of_le x.1 (iInf_le_of_le (hQA x.2)
      (iInf_le_of_le y.1 (iInf_le_of_le (hQB y.2) le_rfl)))
  · set b := ⨅ x : Qa, ⨅ y : Qb, F x y with hb
    have hclosed : IsClosed ((A ×ˢ B) ∩ (fun p : ℂ × ℂ => F p.1 p.2) ⁻¹' Ici b) :=
      hF.preimage_isClosed_of_isClosed (hA.prod hB) isClosed_Ici
    have hQQ : Qa ×ˢ Qb ⊆ (A ×ˢ B) ∩ (fun p : ℂ × ℂ => F p.1 p.2) ⁻¹' Ici b := by
      rintro ⟨x, y⟩ ⟨hx, hy⟩
      refine ⟨⟨hQA hx, hQB hy⟩, ?_⟩
      show b ≤ F x y
      exact iInf_le_of_le (⟨x, hx⟩ : Qa) (iInf_le_of_le (⟨y, hy⟩ : Qb) le_rfl)
    have hsub : A ×ˢ B ⊆ closure (Qa ×ˢ Qb) := by
      rw [closure_prod_eq]
      exact prod_mono hAQ hBQ
    refine le_iInf₂ fun x hx => le_iInf₂ fun y hy => ?_
    exact (closure_minimal hQQ hclosed (hsub (mk_mem_prod hx hy))).2

/-- For a family `ω ↦ D ω` with measurable values `ω ↦ D ω z w`, compact sets `K₁, K₂` in an open set `U`, there is a
measurable `g` with `g ω = D_ω(K₁, K₂; U)` whenever `D ω` is a Euclidean length metric. -/
theorem exists_measurable_eq_internalSetDist {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {D : Ω → ℂ → ℂ → ℝ} (hD : ∀ z w, Measurable fun ω => D ω z w) {U K₁ K₂ : Set ℂ} (hU : IsOpen U)
    (hK₁ : IsCompact K₁) (hK₂ : IsCompact K₂) (hK₁U : K₁ ⊆ U) (hK₂U : K₂ ⊆ U) :
    ∃ g : Ω → ℝ≥0∞, Measurable g ∧ ∀ ω, IsEuclideanLengthMetric (D ω) →
      g ω = internalSetDist (D ω) U K₁ K₂ := by
  obtain ⟨Q₁, hQ₁c, hQ₁K, hKQ₁⟩ := TopologicalSpace.exists_countable_dense_subset K₁
  obtain ⟨Q₂, hQ₂c, hQ₂K, hKQ₂⟩ := TopologicalSpace.exists_countable_dense_subset K₂
  have : Countable Q₁ := hQ₁c.to_subtype
  have : Countable Q₂ := hQ₂c.to_subtype
  refine ⟨fun ω => ⨅ x : Q₁, ⨅ y : Q₂, chainInf (D ω) U x y,
    Measurable.iInf fun x => Measurable.iInf fun y => measurable_chainInf hD U x y, fun ω hω => ?_⟩
  have hcont : ContinuousOn (fun p : ℂ × ℂ => internalMetric (D ω) U p.1 p.2) (K₁ ×ˢ K₂) :=
    (hω.continuousOn_internalMetric_pair (fun x y => hω.apply_nonneg x y) hU).mono
      (prod_mono hK₁U hK₂U)
  show (⨅ x : Q₁, ⨅ y : Q₂, chainInf (D ω) U x y) = _
  unfold internalSetDist
  rw [iInf_iInf_closed_eq_countable (F := internalMetric (D ω) U) hK₁.isClosed hK₂.isClosed hQ₁K hKQ₁
    hQ₂K hKQ₂ hcont]
  simp only [hω.internalMetric_eq_chainInf hU]

/-- For a γ-LQG metric `𝔇`, compact sets `K₁, K₂` in an open set `U`, there is a function of the field, measurable for
the σ-algebra generated by the pairings with test functions, equal to `𝔇_T(K₁, K₂; U)` at every `T` for which `𝔇 T` is a
Euclidean length metric. -/
theorem IsLQGMetric.exists_measurable_eq_internalSetDist {γ ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsLQGMetric γ ξ 𝔇) {U K₁ K₂ : Set ℂ} (hU : IsOpen U)
    (hK₁ : IsCompact K₁) (hK₂ : IsCompact K₂) (hK₁U : K₁ ⊆ U) (hK₂U : K₂ ⊆ U) :
    ∃ g : ((ℂ → ℝ) → ℝ) → ℝ≥0∞, Measurable[distributionMeasurableSpace] g ∧
      ∀ T, IsEuclideanLengthMetric (𝔇 T) → g T = internalSetDist (𝔇 T) U K₁ K₂ :=
  LatticeProb.LQG.exists_measurable_eq_internalSetDist h𝔇.measurable_apply hU hK₁ hK₂ hK₁U hK₂U

/-- **The tail of the internal distance between two compact sets does not depend on the realization of the field.**
Let `𝔇` be a γ-LQG metric, `K₁, K₂` compact subsets of an open set `U`, and `L` a value in `ℝ≥0∞`. For any two
realizations of the whole-plane GFF, the probabilities that `𝔇_h(K₁, K₂; U) ≥ L` coincide. -/
theorem IsLQGMetric.measure_internalSetDist_ge_eq {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : IsLQGMetric γ ξ 𝔇) {U K₁ K₂ : Set ℂ} (hU : IsOpen U) (hK₁ : IsCompact K₁)
    (hK₂ : IsCompact K₂) (hK₁U : K₁ ⊆ U) (hK₂U : K₂ ⊆ U) (L : ℝ≥0∞) {Ω Ω' : Type}
    [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω} {Q : Measure Ω'}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {hC' : Ω' → (ℂ → ℝ) → ℝ}
    {hcirc' : Ω' → ℝ → ℂ → ℝ} (hP : IsWholePlaneGFF P hC hcirc) (hQ : IsWholePlaneGFF Q hC' hcirc') :
    P {ω | L ≤ internalSetDist (𝔇 (hC ω)) U K₁ K₂} = Q {ω | L ≤ internalSetDist (𝔇 (hC' ω)) U K₁ K₂} := by
  obtain ⟨g, hg, hgeq⟩ := h𝔇.exists_measurable_eq_internalSetDist hU hK₁ hK₂ hK₁U hK₂U
  refine hP.measure_preimage_eq_of_inter_eq hQ (B := {T | L ≤ internalSetDist (𝔇 T) U K₁ K₂})
    (M := g ⁻¹' Ici L) (Good := {T | IsEuclideanLengthMetric (𝔇 T)})
    (h𝔇.ae_isEuclideanLengthMetric_self hP) (h𝔇.ae_isEuclideanLengthMetric_self hQ)
    (hg measurableSet_Ici) ?_
  ext T
  simp only [mem_inter_iff, mem_ofPred_eq, mem_preimage, mem_Ici, and_congr_left_iff]
  intro hT
  rw [hgeq T hT]

end LatticeProb.LQG
