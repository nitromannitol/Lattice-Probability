import Mathlib
import LatticeProb.LQG.InternalMetricChainFormula
import LatticeProb.LQG.LQGMetricMeasurable2

/-!
# Measurability of the supremum of the internal metric over a compact set

Let `K` be a compact subset of an open set `U`. For a family `ω ↦ D ω` of functions `ℂ → ℂ → ℝ` whose values
`ω ↦ D ω z w` are measurable, there is one measurable function `g` such that
`g ω = sup_{u, v ∈ K} D_ω(u, v; U)` at every `ω` for which `D ω` is a Euclidean length metric
(`exists_measurable_eq_iSup_internalMetric`). For a γ-LQG metric `𝔇`, the same holds for `T ↦ 𝔇 T` with the
σ-algebra generated by the pairings with test functions (`IsLQGMetric.exists_measurable_eq_iSup_internalMetric`).

The function is `g ω = sup_{u, v ∈ Q} chainInf (D ω) U u v` for a countable dense subset `Q` of `K`: the chain
formula `D(u, v; U) = chainInf D U u v` and the joint continuity of the internal metric on `U × U` reduce the
supremum over `K × K` to `Q × Q`.
-/

namespace LatticeProb.LQG

open Set Metric MeasureTheory
open scoped ENNReal
open LatticeProb.Gauss

/-- For a family `ω ↦ D ω` with measurable values `ω ↦ D ω z w`, a compact set `K` and an open set `U ⊇ K`, there is a
measurable `g` with `g ω = sup_{u, v ∈ K} D_ω(u, v; U)` whenever `D ω` is a Euclidean length metric. -/
theorem exists_measurable_eq_iSup_internalMetric {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {D : Ω → ℂ → ℂ → ℝ} (hD : ∀ z w, Measurable fun ω => D ω z w) {U K : Set ℂ} (hU : IsOpen U)
    (hK : IsCompact K) (hKU : K ⊆ U) :
    ∃ g : Ω → ℝ≥0∞, Measurable g ∧ ∀ ω, IsEuclideanLengthMetric (D ω) →
      g ω = ⨆ u ∈ K, ⨆ v ∈ K, internalMetric (D ω) U u v := by
  obtain ⟨Q, hQc, hQK, hKQ⟩ := TopologicalSpace.exists_countable_dense_subset K
  have : Countable Q := hQc.to_subtype
  refine ⟨fun ω => ⨆ x : Q, ⨆ y : Q, chainInf (D ω) U x y,
    Measurable.iSup fun x => Measurable.iSup fun y => measurable_chainInf hD U x y, fun ω hω => ?_⟩
  have hcont : ContinuousOn (fun p : ℂ × ℂ => internalMetric (D ω) U p.1 p.2) (K ×ˢ K) :=
    (hω.continuousOn_internalMetric_pair (fun x y => hω.apply_nonneg x y) hU).mono
      (prod_mono hKU hKU)
  show (⨆ x : Q, ⨆ y : Q, chainInf (D ω) U x y) = _
  rw [iSup_iSup_compact_eq_countable (F := internalMetric (D ω) U) hK hQK hKQ hcont]
  simp only [hω.internalMetric_eq_chainInf hU]

/-- For a γ-LQG metric `𝔇`, a compact set `K` and an open set `U ⊇ K`, there is a function of the field, measurable for
the σ-algebra generated by the pairings with test functions, equal to `sup_{u, v ∈ K} 𝔇_T(u, v; U)` at every `T` for
which `𝔇 T` is a Euclidean length metric. -/
theorem IsLQGMetric.exists_measurable_eq_iSup_internalMetric {γ ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsLQGMetric γ ξ 𝔇) {U K : Set ℂ} (hU : IsOpen U)
    (hK : IsCompact K) (hKU : K ⊆ U) :
    ∃ g : ((ℂ → ℝ) → ℝ) → ℝ≥0∞, Measurable[distributionMeasurableSpace] g ∧
      ∀ T, IsEuclideanLengthMetric (𝔇 T) → g T = ⨆ u ∈ K, ⨆ v ∈ K, internalMetric (𝔇 T) U u v :=
  LatticeProb.LQG.exists_measurable_eq_iSup_internalMetric h𝔇.measurable_apply hU hK hKU

end LatticeProb.LQG
