import LatticeProb.LQG.LocalHullFieldPhase

/-! # Anchor independence of local discrete field observations -/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set LQGMetric LQGMetric.Blueprint LQGMetric.CONF

namespace LatticeProb.LQG

/-- A uniformly supported anchor observes every other unit-integral anchor phase. -/
theorem localHullFieldSigma_le_of_anchor_supported {Ω : Type} (h : Ω → DistC)
    (A : Ω → Set ℂ) (hA : ∀ ω, Bornology.IsBounded (A ω)) (n : ℕ)
    (a b : TestC) (ha : ∫ z, a z = 1) (hb : ∫ z, b z = 1)
    (hasupp : ∀ ω, tsupport (a : ℂ → ℝ) ⊆ interior (dyadicHull n (A ω)))
    {p : ℝ} (hp : 0 < p) :
    localHullFieldSigma h A n b hp ≤ localHullFieldSigma h A n a hp := by
  classical
  apply sup_le le_sup_left
  apply Measurable.comap_le
  let : MeasurableSpace Ω := localHullFieldSigma h A n a hp
  let E : Set Ω := {ω | tsupport (b : ℂ → ℝ) ⊆ interior (dyadicHull n (A ω))}
  have hE : MeasurableSet E :=
    (le_sup_left : hullSigma0 h A n ≤ localHullFieldSigma h A n a hp) _
      (measurableSet_subset_interior_dyadicHull h A hA n _)
  have hphase : Measurable (fun ω => toIcoMod hp 0 (h ω a)) := by
    have hm : Measurable (localHullFieldPhase h A n a hp) :=
      (comap_measurable _).mono le_sup_right le_rfl
    have heq : localHullFieldPhase h A n a hp = (fun ω => toIcoMod hp 0 (h ω a)) := by
      funext ω
      exact Set.indicator_of_mem (hasupp ω) _
    rw [heq] at hm
    exact hm
  let C : Ω → ℝ := fun ω => E.indicator (fun ω => h ω b - h ω a) ω
  have hC : Measurable C := by
    have hm := measurable_hull_gated_centered_pairing h A hA n b a ha
    have heq : (fun ω =>
        ({ω | tsupport (b : ℂ → ℝ) ∪ tsupport (a : ℂ → ℝ) ⊆
          interior (dyadicHull n (A ω))} : Set Ω).indicator
          (fun ω => h ω b - (∫ z, b z) * h ω a) ω) = C := by
      have hgate : {ω | tsupport (b : ℂ → ℝ) ∪ tsupport (a : ℂ → ℝ) ⊆
          interior (dyadicHull n (A ω))} = E := by
        ext ω
        simp only [E, mem_ofPred_eq, union_subset_iff, hasupp ω, and_true]
      rw [hgate]
      simp only [hb, one_mul, C]
    rw [heq] at hm
    exact hm.mono le_sup_left le_rfl
  have hm := ((LatticeProb.measurable_toIcoMod_zero hp).comp (hphase.add hC)).indicator hE
  have heq : localHullFieldPhase h A n b hp =
      E.indicator (fun ω => toIcoMod hp 0 (toIcoMod hp 0 (h ω a) + C ω)) := by
    funext ω
    by_cases hω : ω ∈ E
    · rw [localHullFieldPhase, Set.indicator_of_mem hω, Set.indicator_of_mem hω]
      dsimp [C]
      rw [Set.indicator_of_mem hω]
      apply (toIcoMod_eq_toIcoMod hp).mpr
      refine ⟨-toIcoDiv hp 0 (h ω a), ?_⟩
      rw [neg_zsmul]
      have hx := toIcoMod_add_toIcoDiv_zsmul hp 0 (h ω a)
      linarith
    · simp [localHullFieldPhase, E, hω]
  rw [heq]
  exact hm

/-- A family of unit-integral anchors generates the observation of any one
member that is supported inside every hull at the given scale. -/
theorem iSup_localHullFieldSigma_eq_of_anchor_supported {Ω : Type} {I : Type*}
    (h : Ω → DistC) (A : Ω → Set ℂ) (hA : ∀ ω, Bornology.IsBounded (A ω))
    (n : ℕ) (ψ : I → TestC) (i : I) (hψ : ∀ j, ∫ z, ψ j z = 1)
    (hsupp : ∀ ω, tsupport (ψ i : ℂ → ℝ) ⊆ interior (dyadicHull n (A ω)))
    {p : ℝ} (hp : 0 < p) :
    (⨆ j, localHullFieldSigma h A n (ψ j) hp) = localHullFieldSigma h A n (ψ i) hp := by
  apply le_antisymm
  · exact iSup_le fun j => localHullFieldSigma_le_of_anchor_supported h A hA n
      (ψ i) (ψ j) (hψ i) (hψ j) hsupp hp
  · exact le_iSup (fun j => localHullFieldSigma h A n (ψ j) hp) i


/-- The germ generated by an anchor family can be computed using one
uniformly supported anchor at each scale. -/
theorem iInf_iSup_localHullFieldSigma_eq {Ω : Type} {I : Type*}
    (h : Ω → DistC) (A : Ω → Set ℂ) (hA : ∀ ω, Bornology.IsBounded (A ω))
    (ψ : I → TestC) (i : ℕ → I) (hψ : ∀ j, ∫ z, ψ j z = 1)
    (hsupp : ∀ n ω, tsupport (ψ (i n) : ℂ → ℝ) ⊆ interior (dyadicHull n (A ω)))
    {p : ℝ} (hp : 0 < p) :
    (⨅ n, ⨆ j, localHullFieldSigma h A n (ψ j) hp) =
      ⨅ n, localHullFieldSigma h A n (ψ (i n)) hp := by
  exact iInf_congr fun n =>
    iSup_localHullFieldSigma_eq_of_anchor_supported h A hA n ψ (i n) hψ (hsupp n) hp

end LatticeProb.LQG
