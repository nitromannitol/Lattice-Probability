import LatticeProb.Bonanno.MatedCRTHarmonic.ConeScaling.Lateral
import LatticeProb.Bonanno.LQGMetric.Field.Green

/-!
# Independence of the radial and lateral parts of the whole-plane Gaussian free field

Let `X` be a whole-plane Gaussian free field (`LQGMetric.IsWholePlaneGFF`: its pairings with
mean-zero test functions form a centered Gaussian process with covariance `logCov`), and let
`lateralPart X = X − (z ↦ circle average of X on ∂B(0, |z|))` be its lateral part
(`MatedCRTHarmonic.CellScaling.lateralPart`). The pairings of `X` with rotation-invariant
mean-zero test functions only see the radial part of `X`, and they are independent of the
lateral part (Duplantier–Miller–Sheffield, *Liouville quantum gravity as a mating of trees*,
Lemma 4.9: the projections of the whole-plane GFF onto radially symmetric functions and onto
functions with mean zero on all circles about the origin are independent).

## Main results

* `LatticeProb.LQG.isRotInv_logPotential`: the logarithmic potential
  `x ↦ ∫ −log|x − y| ψ(y) dy` of a rotation-invariant function `ψ` is rotation invariant.
* `LatticeProb.LQG.logCov_sub_symmTest_eq_zero`: `logCov (φ − φ̄) ψ = 0` for every test
  function `φ` (with rotational symmetrization `φ̄`) and every rotation-invariant test function `ψ`.
* `LatticeProb.LQG.indepFun_of_forall_ae_eq_apply`: independence from a real-valued process
  passes to any process that agrees with it almost surely at each fixed index.
* `LatticeProb.LQG.IsWholePlaneGFF.indepFun_pairing_lateralPart_of_orth`: pairings with mean-zero
  test functions `logCov`-orthogonal to all lateral test functions are independent of the lateral
  part.
* `LatticeProb.LQG.IsWholePlaneGFF.indepFun_cmTest_lateralPart`: the same for the Cameron–Martin
  test functions `−Δρ/(2π)` of rotation-invariant test functions `ρ`.
* `LatticeProb.LQG.IsWholePlaneGFF.indepFun_pairing_lateralPart`: for any family `ψ` of
  rotation-invariant mean-zero test functions, the pairings `(X(ψ i))ᵢ` are independent of the
  lateral part of `X`.
-/

open MeasureTheory ProbabilityTheory LQGMetric MatedCRTHarmonic.GMCFacts
  MatedCRTHarmonic.ConeScaling

namespace LatticeProb.LQG

/-- The logarithmic potential `x ↦ ∫ −log|x − y| ψ(y) dy` of a rotation-invariant function `ψ`
is rotation invariant. -/
theorem isRotInv_logPotential {ψ : ℂ → ℝ} (hψ : IsRotInv ψ) :
    IsRotInv fun x => ∫ y, -Real.log ‖x - y‖ * ψ y := by
  intro α w
  have ha : ‖Complex.exp (α * Complex.I)‖ = 1 := norm_exp_ofReal_mul_I' α
  refine (integral_comp_mul_unit ha
    (fun y => -Real.log ‖Complex.exp (α * Complex.I) * w - y‖ * ψ y)).symm.trans ?_
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only
  rw [hψ α y, ← mul_sub, norm_mul, ha, one_mul]

/-- The logarithmic covariance of the lateral test function `φ − φ̄` (`φ̄` the rotational
symmetrization of `φ`) with a rotation-invariant test function vanishes. -/
theorem logCov_sub_symmTest_eq_zero (φ : TestC) {ψ : TestC} (hψ : IsRotInv ψ) :
    logCov ⇑(φ - symmTest φ) ψ = 0 := by
  let u : ℂ → ℝ := fun x => ∫ y, -Real.log ‖x - y‖ * ψ y
  have hu : Continuous u := (MarkovGermVer.contDiff_logPot ψ).continuous
  have hrot : IsRotInv u := isRotInv_logPotential hψ
  have key : logCov ⇑(φ - symmTest φ) ψ = ∫ x, (φ - symmTest φ) x * u x := by
    unfold logCov
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [u]
    rw [← integral_const_mul]
    congr 1
    funext y
    ring
  have hint : ∀ g : TestC, Integrable (fun x => g x * u x) := fun g =>
    (g.continuous.mul hu).integrable_of_hasCompactSupport (g.hasCompactSupport.mul_right)
  have hsplit : (fun x => (φ - symmTest φ) x * u x) =
      fun x => φ x * u x - symmTest φ x * u x := by
    funext x
    rw [show (φ - symmTest φ) x = φ x - symmTest φ x from rfl]
    ring
  rw [key, hsplit, integral_sub (hint φ) (hint _),
    integral_symmTest_mul φ hrot hu.locallyIntegrable, sub_self]

section Modification

variable {Ω β T : Type*} [MeasurableSpace Ω] [MeasurableSpace β] {P : Measure Ω}

omit [MeasurableSpace Ω] in
/-- The σ-algebra generated by a real-valued process is the supremum of the σ-algebras
generated by its finite-dimensional restrictions. -/
theorem comap_pi_eq_iSup_finset (Y : Ω → T → ℝ) :
    MeasurableSpace.comap Y MeasurableSpace.pi =
      ⨆ I : Finset T, MeasurableSpace.comap (fun ω (t : I) => Y ω t) inferInstance := by
  refine le_antisymm ?_ (iSup_le fun I => ?_)
  · rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    refine iSup_le fun t => ?_
    rw [MeasurableSpace.comap_comp]
    have : (fun v : T → ℝ => v t) ∘ Y = (fun v : ({t} : Finset T) → ℝ =>
        v ⟨t, Finset.mem_singleton_self t⟩) ∘ fun ω (s : ({t} : Finset T)) => Y ω s := rfl
    refine le_trans ?_ (le_iSup (fun I : Finset T =>
      MeasurableSpace.comap (fun ω (t : I) => Y ω t) inferInstance) {t})
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le
  · have : (fun ω (t : I) => Y ω t) = (fun (v : T → ℝ) (t : I) => v t) ∘ Y := rfl
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_pi_iff.2 fun t => measurable_pi_apply _).comap_le

/-- **Independence passes to coordinatewise modifications.** If `A` is independent of the
real-valued process `Y` and `Y' t = Y t` almost surely for every index `t`, then `A` is
independent of `Y'` (no joint null set over the indices is needed). -/
theorem indepFun_of_forall_ae_eq_apply [IsZeroOrProbabilityMeasure P] {A : Ω → β}
    {Y Y' : Ω → T → ℝ} (hA : Measurable A) (hY' : Measurable Y') (hind : IndepFun A Y P)
    (hae : ∀ t, ∀ᵐ ω ∂P, Y' ω t = Y ω t) : IndepFun A Y' P := by
  rw [IndepFun_iff_Indep, comap_pi_eq_iSup_finset]
  refine (indep_iSup_of_directed_le (fun I => ?_) (fun I => ?_) hA.comap_le ?_).symm
  · have h1 : IndepFun A (fun ω (t : I) => Y ω t) P :=
      hind.comp (φ := id) (ψ := fun (v : T → ℝ) (t : I) => v t) measurable_id
        (measurable_pi_iff.2 fun t : I => measurable_pi_apply (t : T))
    have h2 : IndepFun A (fun ω (t : I) => Y' ω t) P := by
      refine h1.congr (Filter.EventuallyEq.refl _ _) ?_
      filter_upwards [ae_all_iff.2 fun t : I => hae t.1] with ω hω
      funext t
      exact (hω t).symm
    exact ((IndepFun_iff_Indep _ _ _).1 h2).symm
  · exact (measurable_pi_iff.2 fun t : I => (measurable_pi_apply (t : T)).comp hY').comap_le
  · refine Monotone.directed_le fun I J hIJ => ?_
    have : (fun ω (t : I) => Y' ω t) =
        (fun (v : J → ℝ) (t : I) => v ⟨t, hIJ t.2⟩) ∘ fun ω (t : J) => Y' ω t := rfl
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_pi_iff.2 fun t => measurable_pi_apply _).comap_le

end Modification

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {X : Ω → DistC}

/-- **Independence from the lateral part.** For a whole-plane GFF `X` and a family `ψ` of
mean-zero test functions that are `logCov`-orthogonal to every lateral test function `φ − φ̄`, the
pairings `(X(ψ i))ᵢ` are independent of the lateral part of `X`. -/
theorem IsWholePlaneGFF.indepFun_pairing_lateralPart_of_orth (hX : IsWholePlaneGFF X P)
    {ι : Type*} (ψ : ι → TestC0) (horth : ∀ i (φ : TestC), logCov ⇑(φ - symmTest φ) (ψ i).1 = 0) :
    IndepFun (fun ω i => X ω (ψ i).1)
      (fun ω => MatedCRTHarmonic.CellScaling.lateralPart (X ω)) P := by
  have := hX.gaussian.isProbabilityMeasure
  have hev : ∀ φ : TestC, Measurable fun ω => X ω φ := fun φ =>
    (measurable_pi_apply φ).comp (measurable_evDist.comp hX.measurable)
  have hGs : IsGaussianProcess (Sum.elim (fun i ω => X ω (ψ i).1)
      (fun φ : TestC => fun ω => X ω (latTest φ).1)) P := by
    refine (hX.gaussian.comp_right (Sum.elim ψ latTest)).congr fun j => ?_
    cases j <;> exact ae_of_all _ fun ω => rfl
  have hind : IndepFun (fun ω i => X ω (ψ i).1) (fun ω φ => X ω (latTest φ).1) P :=
    hGs.indepFun_of_covariance_eq_zero (fun i => (hev _).aemeasurable)
      (fun φ => (hev _).aemeasurable) fun i φ => by
        show cov[fun ω => X ω (ψ i).1, fun ω => X ω (latTest φ).1; P] = 0
        rw [covariance_comm, hX.covariance_eq]
        exact horth i φ
  have hL : Measurable fun ω => MatedCRTHarmonic.CellScaling.lateralPart (X ω) :=
    measurable_lateralPart.comp hX.measurable
  have h2 : IndepFun (fun ω i => X ω (ψ i).1)
      (fun ω => evDist (MatedCRTHarmonic.CellScaling.lateralPart (X ω))) P :=
    indepFun_of_forall_ae_eq_apply (measurable_pi_iff.2 fun i => hev _)
      (measurable_evDist.comp hL) hind fun φ => by
        filter_upwards [ae_lateralPart_apply hX φ] with ω hω
        exact hω
  have hc : MeasurableSpace.comap (fun ω => MatedCRTHarmonic.CellScaling.lateralPart (X ω))
      (inferInstance : MeasurableSpace DistC) = MeasurableSpace.comap
        (fun ω => evDist (MatedCRTHarmonic.CellScaling.lateralPart (X ω))) MeasurableSpace.pi :=
    MeasurableSpace.comap_comp
  rw [IndepFun_iff_Indep, hc]
  exact (IndepFun_iff_Indep _ _ _).1 h2

/-- **Radial–lateral independence** (Duplantier–Miller–Sheffield, Lemma 4.9). For a whole-plane
GFF `X` and any family `ψ` of rotation-invariant mean-zero test functions, the pairings
`(X(ψ i))ᵢ` are independent of the lateral part of `X`. -/
theorem IsWholePlaneGFF.indepFun_pairing_lateralPart (hX : IsWholePlaneGFF X P) {ι : Type*}
    (ψ : ι → TestC0) (hψ : ∀ i, IsRotInv (ψ i).1) :
    IndepFun (fun ω i => X ω (ψ i).1)
      (fun ω => MatedCRTHarmonic.CellScaling.lateralPart (X ω)) P :=
  IsWholePlaneGFF.indepFun_pairing_lateralPart_of_orth hX ψ fun i φ =>
    logCov_sub_symmTest_eq_zero φ (hψ i)

/-- The Cameron–Martin test function `−Δρ/(2π)` of a rotation-invariant test function `ρ` is
`logCov`-orthogonal to every lateral test function `φ − φ̄` (Green's identity
`logCov ψ (−Δρ/(2π)) = ∫ ψ ρ`). -/
theorem logCov_sub_symmTest_cmTest_eq_zero (φ : TestC) {ρ : TestC} (hρ : IsRotInv ρ) :
    logCov ⇑(φ - symmTest φ) (cmTest ρ) = 0 := by
  rw [logCov_cmTest_right]
  have hint : ∀ g : TestC, Integrable (fun x => g x * ρ x) := fun g =>
    (g.continuous.mul ρ.continuous).integrable_of_hasCompactSupport
      (g.hasCompactSupport.mul_right)
  have hsplit : (fun x => (φ - symmTest φ) x * ρ x) =
      fun x => φ x * ρ x - symmTest φ x * ρ x := by
    funext x
    rw [show (φ - symmTest φ) x = φ x - symmTest φ x from rfl]
    ring
  rw [hsplit, integral_sub (hint φ) (hint _),
    integral_symmTest_mul φ hρ ρ.continuous.locallyIntegrable, sub_self]

/-- For rotation-invariant test functions `ρ i`, the pairings of a whole-plane GFF with the
Cameron–Martin test functions `−Δ(ρ i)/(2π)` are independent of its lateral part. -/
theorem IsWholePlaneGFF.indepFun_cmTest_lateralPart (hX : IsWholePlaneGFF X P) {ι : Type*}
    (ρ : ι → TestC) (hρ : ∀ i, IsRotInv (ρ i)) :
    IndepFun (fun ω i => X ω (cmTest (ρ i)))
      (fun ω => MatedCRTHarmonic.CellScaling.lateralPart (X ω)) P :=
  IsWholePlaneGFF.indepFun_pairing_lateralPart_of_orth hX (fun i => cmTest0 (ρ i)) fun i φ =>
    logCov_sub_symmTest_cmTest_eq_zero φ (hρ i)

end LatticeProb.LQG
