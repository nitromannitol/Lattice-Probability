import LatticeProb.Bonanno.MatedCRTHarmonic.RouteM.PsiBundle

/-! # Time translation of Peanosphere relations -/

set_option autoImplicit false

namespace MatedCRTHarmonic.RouteM

open Set

/-- Translating time transports the direct identification relation. -/
theorem directRel_time_translate (X : ℝ → ℝ) (c s t : ℝ) :
    directRel (fun u => X (u + c)) s t ↔ directRel X (s + c) (t + c) := by
  constructor
  · rintro ⟨hst, heq, hinside⟩
    refine ⟨by linarith, heq, ?_⟩
    intro v hv
    have hv' : v - c ∈ Ioo s t := by
      constructor <;> linarith [hv.1, hv.2]
    simpa using hinside (v - c) hv'
  · rintro ⟨hst, heq, hinside⟩
    refine ⟨by linarith, heq, ?_⟩
    intro v hv
    apply hinside (v + c)
    constructor <;> linarith [hv.1, hv.2]

/-- The equivalence generated by two direct identification relations commutes with
translation of the time coordinate. -/
theorem eqvGen_directRel_time_translate (L R : ℝ → ℝ) (c s t : ℝ) :
    Relation.EqvGen (fun a b => directRel (fun u => L (u + c)) a b ∨
      directRel (fun u => R (u + c)) a b) s t ↔
    Relation.EqvGen (fun a b => directRel L a b ∨ directRel R a b) (s + c) (t + c) := by
  constructor
  · intro h
    induction h with
    | rel a b h =>
      apply Relation.EqvGen.rel
      rcases h with h | h
      · exact Or.inl ((directRel_time_translate L c a b).mp h)
      · exact Or.inr ((directRel_time_translate R c a b).mp h)
    | refl a => exact Relation.EqvGen.refl _
    | symm a b h ih => exact Relation.EqvGen.symm _ _ ih
    | trans a b d hab hbd ihab ihbd => exact Relation.EqvGen.trans _ _ _ ihab ihbd
  · intro h
    have aux : ∀ a b, Relation.EqvGen (fun a b => directRel L a b ∨ directRel R a b) a b →
        Relation.EqvGen (fun a b => directRel (fun u => L (u + c)) a b ∨
          directRel (fun u => R (u + c)) a b) (a - c) (b - c) := by
      intro a b h
      induction h with
      | rel a b h =>
        apply Relation.EqvGen.rel
        rcases h with h | h
        · apply Or.inl
          apply (directRel_time_translate L c (a - c) (b - c)).mpr
          simpa using h
        · apply Or.inr
          apply (directRel_time_translate R c (a - c) (b - c)).mpr
          simpa using h
      | refl a => exact Relation.EqvGen.refl _
      | symm a b h ih => exact Relation.EqvGen.symm _ _ ih
      | trans a b d hab hbd ihab ihbd => exact Relation.EqvGen.trans _ _ _ ihab ihbd
    simpa using aux (s + c) (t + c) h

end MatedCRTHarmonic.RouteM
