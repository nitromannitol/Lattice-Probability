import Mathlib
import LatticeProb.LQG.InternalMetricRationalChain
import LatticeProb.LQG.LQGMetric

/-!
# A countable chain infimum for the internal metric

For `D : ℂ → ℂ → ℝ`, an open set `U` and points `x, y`, the *chain infimum* `chainInf D U x y` is the infimum of
the `D`-lengths `∑ D(z_i, z_{i+1})` of the chains `x = z₀, z₁, …, z_m = y` whose interior points have rational
real and imaginary parts, together with a rational radius `ρ > 0`, such that for every step

* the Euclidean ball `B(z_i, ρ)` lies in `U`,
* `D(z_i, z_{i+1})` is strictly smaller than the infimum of `D(z_i, z_i + ρ e^{iθ})` over rational angles `θ`.

It is a countable infimum built from countably many values of `D`, so for a family `ω ↦ D ω` of functions whose
values `ω ↦ D ω z w` are measurable, `ω ↦ chainInf (D ω) U x y` is measurable (`measurable_chainInf`), and for
a γ-LQG metric `𝔇`, `T ↦ chainInf (𝔇 T) U x y` is measurable for the σ-algebra generated by the pairings
(`IsLQGMetric.measurable_chainInf`).

For a Euclidean length metric `D`, the infimum over rational angles equals the infimum over the whole circle
(`IsEuclideanLengthMetric.ratCircleInf_eq`), and the chain infimum is at most the internal metric `D(x, y; U)`
(`IsEuclideanLengthMetric.chainInf_le_internalMetric`, from the rational chains along paths of
`IsEuclideanLengthMetric.exists_ratChain_le_pathLength`).
-/

namespace LatticeProb.LQG

open Set Metric MeasureTheory
open scoped ENNReal NNReal
open LatticeProb.Gauss

/-- The point of `ℂ` with real part `q.1` and imaginary part `q.2`. -/
noncomputable def ratPoint (q : ℚ × ℚ) : ℂ := ⟨q.1, q.2⟩

/-- The points `x = z₀, z₁, …, z_m = y` of the chain with interior points `l`, where `m = |l| + 1`: `z₀ = x`,
`z_i = l_{i-1}` for `0 < i ≤ |l|` and `z_i = y` for `i ≥ |l| + 1`. -/
noncomputable def listChainPoint (x y : ℂ) (l : List (ℚ × ℚ)) (i : ℕ) : ℂ :=
  if i = 0 then x else if l.length + 1 ≤ i then y else ratPoint (l.getD (i - 1) 0)

/-- The infimum of `D(z, ·)` over the points `z + ρ e^{iθ}`, `θ ∈ ℚ`, of the circle `∂B(z, ρ)`. -/
noncomputable def ratCircleInf (D : ℂ → ℂ → ℝ) (z : ℂ) (ρ : ℝ) : ℝ≥0∞ :=
  ⨅ θ : ℚ, ENNReal.ofReal (D z (z + (ρ : ℂ) * Complex.exp (((θ : ℝ) : ℂ) * Complex.I)))

/-- `(l, ρ)` is an admissible rational chain from `x` to `y` in `U` for `D`: `ρ > 0`, and for every step `i ≤ |l|`
the ball `B(z_i, ρ)` lies in `U` and `D(z_i, z_{i+1})` is strictly smaller than `ratCircleInf D z_i ρ`. -/
def IsRatChain (D : ℂ → ℂ → ℝ) (U : Set ℂ) (x y : ℂ) (l : List (ℚ × ℚ)) (ρ : ℚ) : Prop :=
  0 < ρ ∧ ∀ i < l.length + 1, ball (listChainPoint x y l i) (ρ : ℝ) ⊆ U ∧
    ENNReal.ofReal (D (listChainPoint x y l i) (listChainPoint x y l (i + 1))) <
      ratCircleInf D (listChainPoint x y l i) (ρ : ℝ)

/-- The `D`-length `∑_{i ≤ |l|} D(z_i, z_{i+1})` of the chain with interior points `l`. -/
noncomputable def chainSum (D : ℂ → ℂ → ℝ) (x y : ℂ) (l : List (ℚ × ℚ)) : ℝ≥0∞ :=
  ∑ i ∈ Finset.range (l.length + 1),
    ENNReal.ofReal (D (listChainPoint x y l i) (listChainPoint x y l (i + 1)))

/-- The chain infimum: the infimum of the `D`-lengths of the admissible rational chains from `x` to `y` in `U`. -/
noncomputable def chainInf (D : ℂ → ℂ → ℝ) (U : Set ℂ) (x y : ℂ) : ℝ≥0∞ :=
  ⨅ (c : List (ℚ × ℚ) × ℚ) (_ : IsRatChain D U x y c.1 c.2), chainSum D x y c.1

theorem listChainPoint_zero (x y : ℂ) (l : List (ℚ × ℚ)) : listChainPoint x y l 0 = x := by
  simp [listChainPoint]

theorem listChainPoint_length_succ (x y : ℂ) (l : List (ℚ × ℚ)) :
    listChainPoint x y l (l.length + 1) = y := by
  simp [listChainPoint]

/-- A chain `z 0 = x, …, z m = y`, `m > 0`, with rational interior points is `listChainPoint x y l` on `[0, m]` for a
list `l` of length `m - 1`. -/
theorem exists_list_chainPoint_eq {x y : ℂ} {m : ℕ} {z : ℕ → ℂ} (hm : 0 < m) (h0 : z 0 = x)
    (hmy : z m = y) (hrat : ∀ i, 0 < i → i < m → ∃ q : ℚ × ℚ, z i = ⟨q.1, q.2⟩) :
    ∃ l : List (ℚ × ℚ), l.length + 1 = m ∧ ∀ i ≤ m, listChainPoint x y l i = z i := by
  classical
  let q : ℕ → ℚ × ℚ := fun i => if h : 0 < i ∧ i < m then (hrat i h.1 h.2).choose else 0
  have hlen : ((List.range (m - 1)).map fun j => q (j + 1)).length + 1 = m := by
    simp only [List.length_map, List.length_range]; omega
  refine ⟨(List.range (m - 1)).map fun j => q (j + 1), hlen, fun i hi => ?_⟩
  rcases Nat.eq_zero_or_pos i with hi0 | hi0
  · rw [hi0, listChainPoint, ite_eq_left rfl, h0]
  rcases eq_or_lt_of_le hi with him | him
  · rw [him, hmy, listChainPoint, ite_eq_right hm.ne', ite_eq_left hlen.le]
  · have hnle : ¬ ((List.range (m - 1)).map fun j => q (j + 1)).length + 1 ≤ i := by omega
    have hlt : i - 1 < m - 1 := by omega
    have hq : q i = (hrat i hi0 him).choose := dite_eq_left ⟨hi0, him⟩
    rw [listChainPoint, ite_eq_right hi0.ne', ite_eq_right hnle, List.getD_eq_getElem?_getD, List.getElem?_map,
      List.getElem?_range hlt]
    simp only [Option.map_some, Option.getD_some]
    rw [Nat.sub_add_cancel (by omega : 1 ≤ i), hq]
    exact (hrat i hi0 him).choose_spec.symm

/-- For a Euclidean length metric, the infimum of `D(z, ·)` over the rational-angle points of `∂B(z, ρ)` is the
infimum over the whole circle. -/
theorem IsEuclideanLengthMetric.ratCircleInf_eq {D : ℂ → ℂ → ℝ} (hD : IsEuclideanLengthMetric D)
    (z : ℂ) (ρ : ℝ) :
    ratCircleInf D z ρ =
      ⨅ θ : ℝ, ENNReal.ofReal (D z (z + (ρ : ℂ) * Complex.exp (θ * Complex.I))) := by
  set f : ℝ → ℝ≥0∞ := fun θ => ENNReal.ofReal (D z (z + (ρ : ℂ) * Complex.exp (θ * Complex.I)))
    with hf
  have hg : Continuous fun θ : ℝ => ((z, z + (ρ : ℂ) * Complex.exp (θ * Complex.I)) : ℂ × ℂ) := by
    fun_prop
  have hfc : Continuous f := ENNReal.continuous_ofReal.comp (hD.continuous_uncurry.comp hg)
  refine le_antisymm (le_iInf fun t => ?_) (le_iInf fun q => iInf_le f (q : ℝ))
  exact Rat.denseRange_cast.induction_on (p := fun t => ratCircleInf D z ρ ≤ f t) t
    (isClosed_le continuous_const hfc) fun q => iInf_le (fun θ : ℚ => f θ) q

/-- `ω ↦ ratCircleInf (D ω) z ρ` is measurable when every value `ω ↦ D ω z w` is. -/
theorem measurable_ratCircleInf {Ω : Type*} {mΩ : MeasurableSpace Ω} {D : Ω → ℂ → ℂ → ℝ}
    (hD : ∀ z w, Measurable fun ω => D ω z w) (z : ℂ) (ρ : ℝ) :
    Measurable fun ω => ratCircleInf (D ω) z ρ :=
  Measurable.iInf fun _ => (hD _ _).ennreal_ofReal

/-- The chain infimum is measurable in `D`: for a family `ω ↦ D ω` whose values `ω ↦ D ω z w` are measurable,
`ω ↦ chainInf (D ω) U x y` is measurable. -/
theorem measurable_chainInf {Ω : Type*} {mΩ : MeasurableSpace Ω} {D : Ω → ℂ → ℂ → ℝ}
    (hD : ∀ z w, Measurable fun ω => D ω z w) (U : Set ℂ) (x y : ℂ) :
    Measurable fun ω => chainInf (D ω) U x y := by
  classical
  have hite : ∀ (p : Prop) [Decidable p] (a : ℝ≥0∞), (⨅ _ : p, a) = if p then a else ⊤ := by
    intro p _ a
    split_ifs with h <;> simp [h]
  simp only [chainInf, hite]
  refine Measurable.iInf fun c => Measurable.ite ?_ ?_ measurable_const
  · refine measurableSet_setOfPred.mpr ?_
    simp only [IsRatChain]
    refine measurable_const.and
      (Measurable.forall fun i => Measurable.forall fun _ => measurable_const.and ?_)
    exact measurableSet_setOfPred.mp
      (measurableSet_lt (hD _ _).ennreal_ofReal (measurable_ratCircleInf hD _ _))
  · exact Finset.measurable_sum _ fun i _ => (hD _ _).ennreal_ofReal

/-- For a γ-LQG metric `𝔇`, `T ↦ chainInf (𝔇 T) U x y` is measurable for the σ-algebra generated by the pairings
with test functions. -/
theorem IsLQGMetric.measurable_chainInf {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : IsLQGMetric γ ξ 𝔇) (U : Set ℂ) (x y : ℂ) :
    Measurable[distributionMeasurableSpace] fun T => chainInf (𝔇 T) U x y :=
  LatticeProb.LQG.measurable_chainInf h𝔇.measurable_apply U x y

/-- For a Euclidean length metric `D` and an open set `U`, the chain infimum is at most the internal metric:
`chainInf D U x y ≤ D(x, y; U)`. -/
theorem IsEuclideanLengthMetric.chainInf_le_internalMetric {D : ℂ → ℂ → ℝ}
    (hD : IsEuclideanLengthMetric D) {U : Set ℂ} (hU : IsOpen U) (x y : ℂ) :
    chainInf D U x y ≤ internalMetric D U x y := by
  refine le_iInf₂ fun P hPU => ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  obtain ⟨m, z, ρ, hm, h0, hmy, hrat, ⟨r, hr⟩, hρ, hstep, hsum⟩ :=
    hD.exists_ratChain_le_pathLength hU P hPU (ε := ε) (NNReal.coe_pos.mpr hε)
  obtain ⟨l, hl, hlz⟩ := exists_list_chainPoint_eq hm h0 hmy hrat
  subst hr
  have hchain : IsRatChain D U x y l r := by
    refine ⟨by exact_mod_cast hρ, fun i hi => ?_⟩
    rw [hl] at hi
    rw [hlz i hi.le, hlz (i + 1) hi]
    exact ⟨(hstep i hi).1, (hstep i hi).2.trans_le (hD.ratCircleInf_eq _ _).ge⟩
  calc chainInf D U x y ≤ chainSum D x y l := iInf₂_le (l, r) hchain
    _ = ∑ i ∈ Finset.range m, ENNReal.ofReal (D (z i) (z (i + 1))) := by
      rw [chainSum, hl]
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [Finset.mem_range] at hi
      rw [hlz i hi.le, hlz (i + 1) hi]
    _ ≤ pathLength D P + ENNReal.ofReal ε := hsum
    _ = pathLength D P + ε := by rw [ENNReal.ofReal_coe_nnreal]

end LatticeProb.LQG
