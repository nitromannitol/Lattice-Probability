import LatticeProb.Bonanno.MatedCRTHarmonic.Frozen.MatedCRTDirectRel

/-! # Contour identifications under increasing changes of time -/

set_option autoImplicit false

open Set MatedCRTHarmonic.MatedCRT

namespace LatticeProb

/-- An increasing time isomorphism preserves direct contour identifications. -/
theorem directRel_comp_orderIso_iff (X : ℝ → ℝ) (e : ℝ ≃o ℝ) (s t : ℝ) :
    DirectRel (fun u => X (e u)) s t ↔ DirectRel X (e s) (e t) := by
  constructor
  · rintro ⟨hst, heq, hmin⟩
    refine ⟨e.strictMono hst, heq, ?_⟩
    intro v hv
    have hv' : e.symm v ∈ Ioo s t := by
      constructor
      · apply e.lt_iff_lt.mp
        simpa only [e.apply_symm_apply] using hv.1
      · apply e.lt_iff_lt.mp
        simpa only [e.apply_symm_apply] using hv.2
    simpa only [e.apply_symm_apply] using hmin (e.symm v) hv'
  · rintro ⟨hst, heq, hmin⟩
    refine ⟨e.lt_iff_lt.mp hst, heq, ?_⟩
    intro u hu
    exact hmin (e u) ⟨e.strictMono hu.1, e.strictMono hu.2⟩

private theorem eqvGen_map {α β : Type*} {r : α → α → Prop} {q : β → β → Prop}
    (f : α → β) (hf : ∀ a b, r a b → q (f a) (f b)) {a b : α}
    (h : Relation.EqvGen r a b) : Relation.EqvGen q (f a) (f b) := by
  induction h with
  | rel a b h => exact Relation.EqvGen.rel _ _ (hf a b h)
  | refl a => exact Relation.EqvGen.refl _
  | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans a b c _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- The equivalence generated by either of two contour identifications is
preserved by an increasing time isomorphism. -/
theorem eqvGen_directRel_comp_orderIso_iff (X Y : ℝ → ℝ) (e : ℝ ≃o ℝ) (s t : ℝ) :
    Relation.EqvGen (fun a b => DirectRel (fun u => X (e u)) a b ∨
      DirectRel (fun u => Y (e u)) a b) s t ↔
    Relation.EqvGen (fun a b => DirectRel X a b ∨ DirectRel Y a b) (e s) (e t) := by
  constructor
  · intro h
    apply eqvGen_map e ?_ h
    intro a b hab
    exact hab.elim (fun hX => Or.inl ((directRel_comp_orderIso_iff X e a b).mp hX))
      (fun hY => Or.inr ((directRel_comp_orderIso_iff Y e a b).mp hY))
  · intro h
    have hh := eqvGen_map e.symm (q := fun a b =>
      DirectRel (fun u => X (e u)) a b ∨ DirectRel (fun u => Y (e u)) a b)
      (fun a b hab => hab.elim
        (fun hX => Or.inl ((directRel_comp_orderIso_iff X e (e.symm a) (e.symm b)).mpr
          (by simpa only [e.apply_symm_apply] using hX)))
        (fun hY => Or.inr ((directRel_comp_orderIso_iff Y e (e.symm a) (e.symm b)).mpr
          (by simpa only [e.apply_symm_apply] using hY)))) h
    simpa only [e.symm_apply_apply] using hh


/-- Direct contour identifications continue to identify curve times after
both are subjected to the same increasing change of time. -/
theorem merge_comp_orderIso (X Y : ℝ → ℝ) {E : Type*} (η : ℝ → E)
    (e : ℝ ≃o ℝ)
    (h : ∀ a b, (DirectRel X a b ∨ DirectRel Y a b) → η a = η b) :
    ∀ s t, (DirectRel (fun u => X (e u)) s t ∨
      DirectRel (fun u => Y (e u)) s t) → η (e s) = η (e t) := by
  intro s t hst
  apply h
  exact hst.elim (fun hX => Or.inl ((directRel_comp_orderIso_iff X e s t).mp hX))
    (fun hY => Or.inr ((directRel_comp_orderIso_iff Y e s t).mp hY))

/-- A converse identification through the generated relation is also preserved
by the same time change. -/
theorem onlyMerge_comp_orderIso (X Y : ℝ → ℝ) {E : Type*} (η : ℝ → E)
    (e : ℝ ≃o ℝ)
    (h : ∀ a b, η a = η b →
      Relation.EqvGen (fun u v => DirectRel X u v ∨ DirectRel Y u v) a b) :
    ∀ s t, η (e s) = η (e t) →
      Relation.EqvGen (fun a b => DirectRel (fun u => X (e u)) a b ∨
        DirectRel (fun u => Y (e u)) a b) s t := by
  intro s t hst
  exact (eqvGen_directRel_comp_orderIso_iff X Y e s t).mpr (h (e s) (e t) hst)

end LatticeProb
