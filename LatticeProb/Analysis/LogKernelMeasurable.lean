import Mathlib

/-!
# Measurability of ball masses and of logarithmic potentials as functions of the measure

For a Borel measure `m` on `ℂ`, the maps `m ↦ m (ball w s)`, `m ↦ ⨅ w ∈ K, m (ball w s)` (`K` compact) and
`m ↦ ⨆ w ∈ A, m (ball w s)` (`A` arbitrary) are measurable for the σ-algebra of `Measure ℂ` generated by the
evaluations `m ↦ m B`. The same holds for the logarithmic potential `m ↦ ⨆ v ∈ A, ∫ u in B, log (r / ‖u - v‖) + 1 ∂m`
when `A` is open and `B` is measurable. The proofs reduce infima and suprema to countable operations: a countable dense
set approximates ball masses from inside, and compactness reduces an infimum over a compact set to a supremum over
finite subcovers. The logarithmic kernel is lower semicontinuous in its second variable (Fatou's lemma), so its
supremum over an open set is attained along a countable dense subset.

Literature locators: Duplantier-Sheffield, arXiv:0808.1560,
Sec. 3.1.
-/

namespace LatticeProb.LogKernelMeasurable

open MeasureTheory Filter Topology Set Metric
open scoped ENNReal NNReal

/-! ## Countable reduction of infima and suprema -/

/-- For `g = sup_i a_i 1_{U_i}` with `U_i` open and `K` compact, `inf_K g = sup_{F finite, K ⊆ ⋃_F U} min_F a`. -/
theorem iInf_mem_compact_eq_iSup_finset {X ι : Type*} [TopologicalSpace X] {U : ι → Set X}
    (hU : ∀ i, IsOpen (U i)) (a : ι → ℝ≥0∞) (g : X → ℝ≥0∞)
    (hg : ∀ x, g x = ⨆ i, ⨆ (_ : x ∈ U i), a i) {K : Set X} (hK : IsCompact K) :
    ⨅ x ∈ K, g x = ⨆ (F : Finset ι) (_ : K ⊆ ⋃ i ∈ F, U i), ⨅ i ∈ F, a i := by
  apply le_antisymm
  · refine le_of_forall_lt fun b hb => ?_
    have hcov : K ⊆ ⋃ j : {i // b < a i}, U j.1 := by
      intro x hx
      have h1 : b < g x := hb.trans_le (iInf₂_le x hx)
      rw [hg x] at h1
      obtain ⟨i, hi⟩ := lt_iSup_iff.1 h1
      obtain ⟨hxi, hbi⟩ := lt_iSup_iff.1 hi
      exact mem_iUnion.2 ⟨⟨i, hbi⟩, hxi⟩
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun j : {i // b < a i} => U j.1) (fun j => hU j.1) hcov
    have hcovF : K ⊆ ⋃ i ∈ t.map (Function.Embedding.subtype _), U i := by
      intro x hx
      obtain ⟨j, hj, hxj⟩ := mem_iUnion₂.1 (ht hx)
      exact mem_iUnion₂.2 ⟨j.1, Finset.mem_map_of_mem _ hj, hxj⟩
    refine lt_of_lt_of_le ?_ (le_iSup₂_of_le (t.map (Function.Embedding.subtype _)) hcovF le_rfl)
    rw [← Finset.inf_eq_iInf, Finset.lt_inf_iff (hb.trans_le le_top)]
    intro i hi
    obtain ⟨j, -, rfl⟩ := Finset.mem_map.1 hi
    exact j.2
  · refine iSup₂_le fun F hF => le_iInf₂ fun x hx => ?_
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.1 (hF hx)
    rw [hg x]
    exact (iInf₂_le i hi).trans (le_iSup₂_of_le i hxi le_rfl)

/-- For `g = sup_i a_i 1_{U_i}`, `sup_A g = sup {a_i : A ∩ U_i ≠ ∅}`. -/
theorem iSup_mem_eq_iSup_nonempty {X ι : Type*} (U : ι → Set X) (a : ι → ℝ≥0∞) (g : X → ℝ≥0∞)
    (hg : ∀ x, g x = ⨆ i, ⨆ (_ : x ∈ U i), a i) (A : Set X) :
    ⨆ x ∈ A, g x = ⨆ i, ⨆ (_ : (A ∩ U i).Nonempty), a i := by
  apply le_antisymm
  · refine iSup₂_le fun x hx => ?_
    rw [hg x]
    exact iSup₂_le fun i hxi => le_iSup₂_of_le i ⟨x, hx, hxi⟩ le_rfl
  · refine iSup₂_le fun i hi => ?_
    obtain ⟨x, hx, hxi⟩ := hi
    refine le_iSup₂_of_le x hx ?_
    rw [hg x]
    exact le_iSup₂_of_le i hxi le_rfl

/-- The mass of an open ball as a countable supremum: for a dense `D`,
`m(B_s(w)) = sup {m(B_t(q)) : q ∈ D, t ∈ ℚ, |w - q| + t < s}`. -/
theorem measure_ball_eq_iSup_rational {D : Set ℂ} (hD : Dense D) (m : Measure ℂ) (w : ℂ) (s : ℝ) :
    m (ball w s) = ⨆ i : D × ℚ, ⨆ (_ : w ∈ {x : ℂ | dist x i.1 + i.2 < s}), m (ball (i.1 : ℂ) i.2) := by
  apply le_antisymm
  · have hU : ball w s = ⋃ n : ℕ, ball w (s - 1 / ((n : ℝ) + 1)) := by
      ext x
      simp only [mem_ball, mem_iUnion]
      constructor
      · intro hx
        obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.2 hx)
        exact ⟨n, by linarith⟩
      · rintro ⟨n, hn⟩
        have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
        linarith
    have hmono : Monotone fun n : ℕ => ball w (s - 1 / ((n : ℝ) + 1)) := by
      intro i j hij
      apply ball_subset_ball
      have hij' : (i : ℝ) + 1 ≤ (j : ℝ) + 1 := by
        have : (i : ℝ) ≤ j := by exact_mod_cast hij
        linarith
      have := one_div_le_one_div_of_le (by positivity : (0 : ℝ) < (i : ℝ) + 1) hij'
      linarith
    rw [hU]
    refine le_of_tendsto' (tendsto_measure_iUnion_atTop hmono) fun n => ?_
    show m (ball w (s - 1 / ((n : ℝ) + 1))) ≤ _
    have hg : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    obtain ⟨y, hyD, hy⟩ := hD.exists_dist_lt w (div_pos hg (by norm_num : (0 : ℝ) < 3))
    obtain ⟨t, ht1, ht2⟩ := exists_rat_btwn
      (by linarith : s - 1 / ((n : ℝ) + 1) + 1 / ((n : ℝ) + 1) / 3 <
        s - 1 / ((n : ℝ) + 1) + 2 * (1 / ((n : ℝ) + 1)) / 3)
    have hsub : ball w (s - 1 / ((n : ℝ) + 1)) ⊆ ball y t := ball_subset_ball' (by linarith)
    refine (measure_mono hsub).trans (le_iSup₂_of_le (⟨y, hyD⟩, t) ?_ le_rfl)
    show dist w y + (t : ℝ) < s
    linarith
  · refine iSup₂_le fun i hi => measure_mono (ball_subset_ball' ?_)
    have hi' : dist w i.1 + i.2 < s := hi
    rw [dist_comm] at hi'
    linarith

/-! ## Measurability of ball masses as functions of the measure -/

/-- `m ↦ inf_{w ∈ K} m(B_s(w))` is measurable for a compact `K`. -/
theorem measurable_iInf_measure_ball_of_isCompact {K : Set ℂ} (hK : IsCompact K) (s : ℝ) :
    Measurable fun m : Measure ℂ => ⨅ w ∈ K, m (ball w s) := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense ℂ
  have := hDc.to_subtype
  have hrep : (fun m : Measure ℂ => ⨅ w ∈ K, m (ball w s)) = fun m =>
      ⨆ (F : Finset (D × ℚ)) (_ : K ⊆ ⋃ i ∈ F, {x : ℂ | dist x i.1 + i.2 < s}),
        ⨅ i ∈ F, m (ball (i.1 : ℂ) i.2) :=
    funext fun m => iInf_mem_compact_eq_iSup_finset (U := fun i : D × ℚ => {x : ℂ | dist x i.1 + i.2 < s})
      (fun i => isOpen_lt (by fun_prop) continuous_const) (fun i => m (ball (i.1 : ℂ) i.2))
      (fun w => m (ball w s)) (measure_ball_eq_iSup_rational hD m · s) hK
  rw [hrep]
  exact Measurable.iSup fun F => Measurable.iSup fun _ => Measurable.iInf fun i => Measurable.iInf fun _ =>
    Measure.measurable_coe measurableSet_ball

/-- `m ↦ sup_{w ∈ A} m(B_s(w))` is measurable for any `A`. -/
theorem measurable_iSup_measure_ball (A : Set ℂ) (s : ℝ) :
    Measurable fun m : Measure ℂ => ⨆ w ∈ A, m (ball w s) := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense ℂ
  have := hDc.to_subtype
  have hrep : (fun m : Measure ℂ => ⨆ w ∈ A, m (ball w s)) = fun m =>
      ⨆ (i : D × ℚ) (_ : (A ∩ {x : ℂ | dist x i.1 + i.2 < s}).Nonempty), m (ball (i.1 : ℂ) i.2) :=
    funext fun m => iSup_mem_eq_iSup_nonempty (fun i : D × ℚ => {x : ℂ | dist x i.1 + i.2 < s})
      (fun i => m (ball (i.1 : ℂ) i.2)) (fun w => m (ball w s)) (measure_ball_eq_iSup_rational hD m · s) A
  rw [hrep]
  exact Measurable.iSup fun i => Measurable.iSup fun _ => Measure.measurable_coe measurableSet_ball

/-! ## Logarithmic potentials -/

/-- Lower semicontinuity of `v ↦ log(r / |u - v|) + 1` (with `r / 0 = 0`, `log 0 = 0` on the diagonal). -/
theorem logKernel_le_liminf {r : ℝ} (hr : 0 < r) (u v : ℂ) {x : ℕ → ℂ} (hx : Tendsto x atTop (𝓝 v)) :
    ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ≤
      liminf (fun n => ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1)) atTop := by
  by_cases huv : u = v
  · subst huv
    simp only [sub_self, norm_zero, div_zero, Real.log_zero, zero_add, ENNReal.ofReal_one]
    refine Filter.le_liminf_of_le (by isBoundedDefault) ?_
    filter_upwards [Metric.tendsto_nhds.1 hx r hr] with n hn
    rw [ENNReal.one_le_ofReal]
    have hlog : 0 ≤ Real.log (r / ‖u - x n‖) := by
      rcases eq_or_lt_of_le (norm_nonneg (u - x n)) with h0 | hpos
      · rw [← h0, div_zero, Real.log_zero]
      · apply Real.log_nonneg
        rw [le_div_iff₀ hpos, one_mul]
        rw [dist_comm, dist_eq_norm] at hn
        exact hn.le
    linarith
  · have hd : ‖u - v‖ ≠ 0 := norm_ne_zero_iff.2 (sub_ne_zero.2 huv)
    have h : Tendsto (fun n => ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1)) atTop
        (𝓝 (ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1))) :=
      ENNReal.tendsto_ofReal (((tendsto_const_nhds.div (tendsto_const_nhds.sub hx).norm hd).log
        (div_ne_zero hr.ne' hd)).add_const 1)
    exact h.liminf_eq.ge

/-- The logarithmic kernel is measurable in `u`. -/
theorem measurable_logKernel (r : ℝ) (v : ℂ) :
    Measurable fun u : ℂ => ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) :=
  (((measurable_const.div (measurable_id.sub_const v).norm).log).add_const 1).ennreal_ofReal

/-- The supremum over an open set `A` of the lower semicontinuous potential `v ↦ ∫_B log(r / |u - v|) + 1 dm(u)` is
its supremum over `A ∩ D`, `D` dense. -/
theorem iSup_logPotential_eq_iSup_inter_dense (m : Measure ℂ) {r : ℝ} (hr : 0 < r) {A : Set ℂ}
    (hA : IsOpen A) {D : Set ℂ} (hD : Dense D) (B : Set ℂ) :
    ⨆ v ∈ A, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m =
      ⨆ v ∈ A ∩ D, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m := by
  apply le_antisymm
  · refine iSup₂_le fun v hv => ?_
    obtain ⟨x, hxA, hxv⟩ := mem_closure_iff_seq_limit.1 (hD.open_subset_closure_inter hA hv)
    calc ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m
        ≤ ∫⁻ u in B, liminf (fun n => ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1)) atTop ∂m :=
          lintegral_mono fun u => logKernel_le_liminf hr u v hxv
      _ ≤ liminf (fun n => ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1) ∂m) atTop :=
          lintegral_liminf_le fun n => measurable_logKernel r (x n)
      _ ≤ limsup (fun n => ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1) ∂m) atTop :=
          liminf_le_limsup
      _ ≤ ⨆ n, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1) ∂m := limsup_le_iSup
      _ ≤ _ := iSup_le fun n => le_iSup₂_of_le (x n) (hxA n) le_rfl
  · exact iSup₂_le fun v hv => le_iSup₂_of_le v hv.1 le_rfl

/-- `m ↦ sup_{v ∈ A} ∫_B log(r / |u - v|) + 1 dm(u)` is measurable for `A` open and `B` measurable. -/
theorem measurable_iSup_logPotential {r : ℝ} (hr : 0 < r) {A : Set ℂ} (hA : IsOpen A) {B : Set ℂ}
    (hB : MeasurableSet B) :
    Measurable fun m : Measure ℂ => ⨆ v ∈ A, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense ℂ
  have hrep : (fun m : Measure ℂ => ⨆ v ∈ A, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m) =
      fun m => ⨆ v ∈ A ∩ D, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m :=
    funext fun m => iSup_logPotential_eq_iSup_inter_dense m hr hA hD B
  rw [hrep]
  refine Measurable.biSup _ (hDc.mono inter_subset_right) fun v _ => ?_
  simp_rw [← lintegral_indicator hB]
  exact Measure.measurable_lintegral ((measurable_logKernel r v).indicator hB)

end LatticeProb.LogKernelMeasurable
