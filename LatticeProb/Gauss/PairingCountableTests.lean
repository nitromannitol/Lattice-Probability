import LatticeProb.Gauss.GFF
import LatticeProb.Prob.CountableCoordinatesMeasurable

/-!
# Measurable functionals of pairings depend on countably many test functions

A map on the space `(ℂ → ℝ) → ℝ` of pairing functionals that is measurable for `distributionMeasurableSpace`, the
sigma-algebra generated by the evaluations `T ↦ T φ` at test functions `φ`, and takes values in a countably generated
space with measurable singletons, is determined by the values at countably many test functions. Consequently, if two
random pairing functionals have almost surely the same pairing with each test function separately, then their images
under such a map agree almost surely; this applies to two versions of the same random distribution.

* `LatticeProb.Gauss.exists_countable_testFunctions_determining`
* `LatticeProb.Gauss.ae_eq_comp_of_ae_eq_pairings`
-/

open MeasureTheory

namespace LatticeProb.Gauss

/-- A map on pairing functionals measurable for `distributionMeasurableSpace`, with values in a countably generated
space with measurable singletons, is determined by the pairings with countably many test functions. -/
theorem exists_countable_testFunctions_determining {γ : Type*} [MeasurableSpace γ]
    [MeasurableSpace.CountablyGenerated γ] [MeasurableSingletonClass γ] {g : ((ℂ → ℝ) → ℝ) → γ}
    (hg : Measurable[distributionMeasurableSpace] g) :
    ∃ Φ : Set (ℂ → ℝ), Φ.Countable ∧ (∀ φ ∈ Φ, IsTestFunction Set.univ φ) ∧
      ∀ T T' : (ℂ → ℝ) → ℝ, (∀ φ ∈ Φ, T φ = T' φ) → g T = g T' := by
  have hg' : Measurable[⨆ (φ : ℂ → ℝ) (_ : IsTestFunction Set.univ φ),
      MeasurableSpace.comap (fun T : (ℂ → ℝ) → ℝ => T φ) Real.measurableSpace] g := hg
  exact exists_countable_determining_of_measurable_iSup_comap hg'

/-- Two random pairing functionals with almost surely the same pairing with each test function separately have almost
surely the same image under every map measurable for `distributionMeasurableSpace` with values in a countably
generated space with measurable singletons. -/
theorem ae_eq_comp_of_ae_eq_pairings {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {γ : Type*}
    [MeasurableSpace γ] [MeasurableSpace.CountablyGenerated γ] [MeasurableSingletonClass γ]
    {g : ((ℂ → ℝ) → ℝ) → γ} (hg : Measurable[distributionMeasurableSpace] g) {F G : Ω → (ℂ → ℝ) → ℝ}
    (hFG : ∀ φ, IsTestFunction Set.univ φ → ∀ᵐ ω ∂μ, F ω φ = G ω φ) :
    ∀ᵐ ω ∂μ, g (F ω) = g (G ω) := by
  have hg' : Measurable[⨆ (φ : ℂ → ℝ) (_ : IsTestFunction Set.univ φ),
      MeasurableSpace.comap (fun T : (ℂ → ℝ) → ℝ => T φ) Real.measurableSpace] g := hg
  exact ae_eq_comp_of_measurable_iSup_comap hg' hFG

end LatticeProb.Gauss
