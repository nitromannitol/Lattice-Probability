import Mathlib
import LatticeProb.Gauss.CameronMartinDerived2

/-!
# The law of a whole-plane GFF does not depend on the realization

Two realizations `(Ω, P, hC, hcirc)` and `(Ω', Q, hC', hcirc')` of the whole-plane GFF may live on different probability
spaces and need not be onto. What is common to all of them is the law of the pairings with test functions, i.e. the
image measure on the space of pairing functionals `(ℂ → ℝ) → ℝ` with the σ-algebra `distributionMeasurableSpace`.

* `IsWholePlaneGFF.measurable_hC`: the pairing field `hC` is measurable for `distributionMeasurableSpace`.
* `IsWholePlaneGFF.measure_preimage_eq`: for `M` measurable for `distributionMeasurableSpace`,
  `P (hC ⁻¹' M) = Q (hC' ⁻¹' M)`.
* `IsWholePlaneGFF.measure_preimage_eq_of_inter_eq`: the same for an arbitrary set `B` of pairing functionals, as soon as
  `B` agrees with such an `M` inside a set `Good` that both realizations visit almost surely. The probability of an
  event described by the field, which need not be measurable, is then the same in all realizations.
-/

open MeasureTheory

namespace LatticeProb.Gauss

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω} {Q : Measure Ω'}
  {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {hC' : Ω' → (ℂ → ℝ) → ℝ} {hcirc' : Ω' → ℝ → ℂ → ℝ}

/-- The field of pairings of a whole-plane GFF is measurable for the σ-algebra `distributionMeasurableSpace` generated by
the evaluations at test functions. -/
theorem IsWholePlaneGFF.measurable_hC (hP : IsWholePlaneGFF P hC hcirc) :
    Measurable[_, distributionMeasurableSpace] hC := by
  refine measurable_iff_comap_le.2 ?_
  unfold distributionMeasurableSpace
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun φ => ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun hφ => ?_
  rw [MeasurableSpace.comap_comp]
  exact (hP.measurable_pairing φ hφ).comap_le

/-- The restriction of the pairing field to the test functions on `ℂ` is a measurable map into the product space. -/
theorem IsWholePlaneGFF.measurable_cmDerivedEval_comp (hP : IsWholePlaneGFF P hC hcirc) :
    Measurable fun ω => cmDerivedEval (hC ω) :=
  measurable_pi_iff.2 fun φ => hP.measurable_pairing φ.1 φ.2

/-- **The law of the pairings is the same in every realization.** For two realizations of the whole-plane GFF and a set
`M` of pairing functionals that is measurable for `distributionMeasurableSpace`, the probabilities that the pairing
field lies in `M` agree. -/
theorem IsWholePlaneGFF.measure_preimage_eq (hP : IsWholePlaneGFF P hC hcirc)
    (hQ : IsWholePlaneGFF Q hC' hcirc') {M : Set ((ℂ → ℝ) → ℝ)}
    (hM : MeasurableSet[distributionMeasurableSpace] M) : P (hC ⁻¹' M) = Q (hC' ⁻¹' M) := by
  rw [distributionMeasurableSpace_eq_comap_cmDerivedEval] at hM
  obtain ⟨A, hA, rfl⟩ := MeasurableSpace.measurableSet_comap.1 hM
  have hmap := wholePlaneGFF_localFieldPairings_map_eq hP hQ 0 Set.univ
  have e1 : localFieldPairings 0 hC Set.univ = fun ω => cmDerivedEval (hC ω) := by
    funext ω φ
    simp [localFieldPairings, cmDerivedEval, fieldPairing]
  have e2 : localFieldPairings 0 hC' Set.univ = fun ω => cmDerivedEval (hC' ω) := by
    funext ω φ
    simp [localFieldPairings, cmDerivedEval, fieldPairing]
  rw [e1, e2] at hmap
  have h1 : hC ⁻¹' (cmDerivedEval ⁻¹' A) = (fun ω => cmDerivedEval (hC ω)) ⁻¹' A := rfl
  have h2 : hC' ⁻¹' (cmDerivedEval ⁻¹' A) = (fun ω => cmDerivedEval (hC' ω)) ⁻¹' A := rfl
  rw [h1, h2, ← Measure.map_apply hP.measurable_cmDerivedEval_comp hA,
    ← Measure.map_apply hQ.measurable_cmDerivedEval_comp hA, hmap]

/-- If two sets of pairing functionals agree inside a set `Good` that a random pairing functional visits almost surely,
then the probabilities that it lies in the two sets agree (the sets need not be measurable). -/
theorem measure_preimage_congr_of_inter_eq {Ω₁ : Type*} [MeasurableSpace Ω₁] (ν : Measure Ω₁)
    (h : Ω₁ → (ℂ → ℝ) → ℝ) {B M Good : Set ((ℂ → ℝ) → ℝ)} (hG : ∀ᵐ ω ∂ν, h ω ∈ Good)
    (hBM : B ∩ Good = M ∩ Good) : ν (h ⁻¹' B) = ν (h ⁻¹' M) := by
  refine measure_congr ?_
  filter_upwards [hG] with ω hω
  have hx := Set.ext_iff.1 hBM (h ω)
  simp only [Set.mem_inter_iff, hω, and_true] at hx
  exact propext hx

/-- **Events of the field that are measurable up to a common full set have the same probability in all realizations.**
Let `B` be a set of pairing functionals (not necessarily measurable), `M` a set measurable for
`distributionMeasurableSpace`, and `Good` a set with `B ∩ Good = M ∩ Good` that the pairing field of each of the two
realizations of the whole-plane GFF visits almost surely. Then `P (hC ⁻¹' B) = Q (hC' ⁻¹' B)`. -/
theorem IsWholePlaneGFF.measure_preimage_eq_of_inter_eq (hP : IsWholePlaneGFF P hC hcirc)
    (hQ : IsWholePlaneGFF Q hC' hcirc') {B M Good : Set ((ℂ → ℝ) → ℝ)}
    (hGP : ∀ᵐ ω ∂P, hC ω ∈ Good) (hGQ : ∀ᵐ ω ∂Q, hC' ω ∈ Good)
    (hM : MeasurableSet[distributionMeasurableSpace] M) (hBM : B ∩ Good = M ∩ Good) :
    P (hC ⁻¹' B) = Q (hC' ⁻¹' B) := by
  rw [measure_preimage_congr_of_inter_eq P hC hGP hBM, measure_preimage_congr_of_inter_eq Q hC' hGQ hBM,
    hP.measure_preimage_eq hQ hM]

/-- The upper bound for an event of the field transfers between realizations of the whole-plane GFF when the event is
measurable up to a common full set. -/
theorem IsWholePlaneGFF.measure_preimage_le_of_inter_eq (hP : IsWholePlaneGFF P hC hcirc)
    (hQ : IsWholePlaneGFF Q hC' hcirc') {B M Good : Set ((ℂ → ℝ) → ℝ)}
    (hGP : ∀ᵐ ω ∂P, hC ω ∈ Good) (hGQ : ∀ᵐ ω ∂Q, hC' ω ∈ Good)
    (hM : MeasurableSet[distributionMeasurableSpace] M) (hBM : B ∩ Good = M ∩ Good) {p : ENNReal}
    (h : Q (hC' ⁻¹' B) ≤ p) : P (hC ⁻¹' B) ≤ p :=
  (hP.measure_preimage_eq_of_inter_eq hQ hGP hGQ hM hBM).le.trans h

end LatticeProb.Gauss
