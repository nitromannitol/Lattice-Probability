import Mathlib

/-!
# Whole-plane Gaussian free field on `ℂ`: observables, covariance kernel, circle averages and pairings

General definitions of the whole-plane Gaussian free field (GFF) on `ℂ` and of its pairings, circle averages and
σ-algebras, in the namespace `LatticeProb.Gauss`. Only Mathlib is imported.

* `wholePlaneCov z w = log (max(|z|,1) max(|w|,1) / |z - w|)`: the covariance kernel of the whole-plane GFF normalized
  so that its average over the unit circle vanishes (Duplantier-Sheffield, arXiv:0808.1560, Section 3).
* `GFFObservable`: the pairing `(h, φ)` with a function `φ` and the circle average `h_r(z)` over `∂B_r(z)`; the
  admissible observables are those with a test function, resp. a positive radius.
* `IsWholePlaneGFF P hC hcirc`: the pairings `hC ω φ` and the circle averages `hcirc ω r z` form a whole-plane GFF
  under the probability measure `P`: a centered Gaussian family (Mathlib's `IsGaussianProcess`) with covariance
  `wholePlaneGFFCov`, and a.s. continuous circle averages on `(0, ∞) × ℂ`.
* `fieldPairing`, `fieldCircleAverage`, `fieldSigmaAlgebra`: the field `h = h^ℂ - α₀ log|·|` (a deterministic
  logarithmic shift of a whole-plane GFF), its pairings, circle averages and the σ-algebra of its restriction to `U`.
* `addFunPairing`, `affinePullbackPairing`, `addCircleAverage`: the pairings and circle averages of `h + f` for a
  function `f`, and of the affine pullback `h(r · + z)`.
* `distributionMeasurableSpace`, `pairingSigmaAlgebra`: the σ-algebras generated by the pairings with test functions.
* `PolyHighProb`, `LocalZeroMeanTest`, `localModConstPairings`, `CircleParameter`, `circleProfile`: an event holding
  with polynomially high probability; local test functions with zero integral and the pairings with them; the
  parameter space of circles and the extension of a continuous circle-average profile to all radii.

Test functions are smooth with compact support `tsupport φ ⊆ U`, as in the distributional sense.

Provenance and credit. The definitions are general adaptations of the definitions of the Lean formalization accompanying [Harmonic balls in Liouville quantum gravity, arXiv:2208.11795]. The whole-plane GFF statement layer of Leonardo Bonanno's formalization (adapted from leobon12/lean-formalizations) was consulted for the naming of the same object; no code of it is imported or copied, and nothing here depends on it.

Not included here (paper-specific Campbell–Palm observations of the rooted field, Section 11 of the Harmonic-Balls paper):
`campbellMarkedObs`, `campbellReferenceObs`.
-/

open MeasureTheory ProbabilityTheory

namespace LatticeProb.Gauss

/-- The parameter space of positive radii and complex centers of circles. -/
abbrev CircleParameter := Set.Ioi (0 : ℝ) × ℂ

/-- `φ : ℂ → ℝ` is a test function on `U`: it is smooth (`C^∞`), has compact support, and its support
`tsupport φ` is contained in `U`. -/
def IsTestFunction (U : Set ℂ) (φ : ℂ → ℝ) : Prop :=
  ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ ∧ HasCompactSupport φ ∧ tsupport φ ⊆ U

/-- The covariance kernel of the whole-plane GFF normalized so that its average over the unit circle vanishes,
`Cov(h(z), h(w)) = log (max(|z|,1) max(|w|,1) / |z - w|)`. On the diagonal `z = w` the value is the junk value
`log (·/0) = 0`; the diagonal is Lebesgue-null for the smearing measures used below. -/
noncomputable def wholePlaneCov (z w : ℂ) : ℝ :=
  Real.log (max ‖z‖ 1 * max ‖w‖ 1 / ‖z - w‖)

/-- The observables of a random generalized function on `ℂ`: the pairing `(h, φ)` with a function `φ : ℂ → ℝ`, and
the circle average `h_r(z)` over `∂B_r(z)`. -/
inductive GFFObservable
  /-- The pairing `(h, φ)` with a function `φ : ℂ → ℝ`. -/
  | pairing (φ : ℂ → ℝ)
  /-- The circle average `h_r(z)`. -/
  | circle (r : ℝ) (z : ℂ)

namespace GFFObservable

/-- An observable is admissible if its test function is smooth with compact support, resp. its radius is positive. -/
def IsAdmissible : GFFObservable → Prop
  | pairing φ => IsTestFunction Set.univ φ
  | circle r _ => 0 < r

/-- The value of an observable on a sample `(hC, hcirc)` of pairings and circle averages. -/
def eval (hC : (ℂ → ℝ) → ℝ) (hcirc : ℝ → ℂ → ℝ) : GFFObservable → ℝ
  | pairing φ => hC φ
  | circle r z => hcirc r z

/-- The integral of `f` against the (signed) smearing measure of an observable: `∫ φ(x) f(x) dx` for a pairing, and
the average of `f` over `∂B_r(z)` for a circle average. -/
noncomputable def smear : GFFObservable → (ℂ → ℝ) → ℝ
  | pairing φ, f => ∫ x, φ x * f x
  | circle r z, f => Real.circleAverage f z r

end GFFObservable

/-- The admissible observables, the index set of the Gaussian family of a whole-plane GFF. -/
def GFFObservable.Admissible : Type :=
  {o : GFFObservable // o.IsAdmissible}

/-- The covariance of two observables of the whole-plane GFF: the kernel `wholePlaneCov` integrated against the
smearing measures of both observables. -/
noncomputable def wholePlaneGFFCov (o o' : GFFObservable) : ℝ :=
  o.smear fun x => o'.smear fun y => wholePlaneCov x y

/-- `IsWholePlaneGFF P hC hcirc`: under the probability measure `P`, the pairings `hC ω φ` with test functions and the
circle averages `hcirc ω r z` with `r > 0` are those of a whole-plane GFF normalized so that its circle average over
`∂B_1(0)` vanishes:

* each pairing with a test function and each circle average of positive radius is a random variable;
* every finite family of admissible observables is a Gaussian vector (`IsGaussianProcess`), centered, with covariance
  `wholePlaneGFFCov`;
* a.s. the circle average process `(r, z) ↦ hcirc ω r z` is continuous on `(0, ∞) × ℂ`. -/
structure IsWholePlaneGFF {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) : Prop where
  /-- Each pairing with a test function is a random variable. -/
  measurable_pairing : ∀ φ, IsTestFunction Set.univ φ → Measurable fun ω => hC ω φ
  /-- Each circle average of positive radius is a random variable. -/
  measurable_circle : ∀ r z, 0 < r → Measurable fun ω => hcirc ω r z
  /-- Finite families of admissible observables are jointly Gaussian. -/
  isGaussianProcess :
    IsGaussianProcess (fun (o : GFFObservable.Admissible) ω => o.1.eval (hC ω) (hcirc ω)) P
  /-- The field is centered. -/
  integral_eq_zero : ∀ o : GFFObservable, o.IsAdmissible → ∫ ω, o.eval (hC ω) (hcirc ω) ∂P = 0
  /-- The covariance is the kernel `wholePlaneCov` integrated against the smearing measures. -/
  covariance_eq : ∀ o o' : GFFObservable, o.IsAdmissible → o'.IsAdmissible →
    cov[fun ω => o.eval (hC ω) (hcirc ω), fun ω => o'.eval (hC ω) (hcirc ω); P] = wholePlaneGFFCov o o'
  /-- A.s. the circle average process is continuous in `(r, z) ∈ (0, ∞) × ℂ`. -/
  ae_continuousOn_circle :
    ∀ᵐ ω ∂P, ContinuousOn (fun p : ℝ × ℂ => hcirc ω p.1 p.2) (Set.Ioi 0 ×ˢ Set.univ)

/-- The pairing `(h, φ) = hC φ - α₀ ∫ φ(x) log |x| dx` of the logarithmically shifted field `h = h^ℂ - α₀ log |·|`,
given the pairings `hC` of `h^ℂ`. -/
noncomputable def fieldPairing (α₀ : ℝ) (hC : (ℂ → ℝ) → ℝ) (φ : ℂ → ℝ) : ℝ :=
  hC φ - α₀ * ∫ x, φ x * Real.log ‖x‖

/-- The circle average `h_r(z) = hcirc r z - α₀ · (average of log |·| over ∂B_r(z))` of the logarithmically shifted
field `h = h^ℂ - α₀ log |·|`, given the circle averages `hcirc` of `h^ℂ`. -/
noncomputable def fieldCircleAverage (α₀ : ℝ) (hcirc : ℝ → ℂ → ℝ) (r : ℝ) (z : ℂ) : ℝ :=
  hcirc r z - α₀ * Real.circleAverage (fun x => Real.log ‖x‖) z r

/-- The σ-algebra generated by the restriction of the logarithmically shifted field `h = h^ℂ - α₀ log |·|` to `U`,
i.e. by the pairings `(h, φ)` with test functions `φ` whose support lies in `U`. -/
@[instance_reducible]
noncomputable def fieldSigmaAlgebra {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    MeasurableSpace Ω :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction U φ),
    MeasurableSpace.comap (fun ω => fieldPairing α₀ (hC ω) φ) inferInstance

/-- The pairing functional of `h + f` for a function `f : ℂ → ℝ`: `(h + f, φ) = (h, φ) + ∫ f φ`. -/
noncomputable def addFunPairing (T : (ℂ → ℝ) → ℝ) (f : ℂ → ℝ) : (ℂ → ℝ) → ℝ :=
  fun φ => T φ + ∫ x, f x * φ x

/-- The pairing functional of the affine pullback `h(r · + z)` for `r > 0` and `z ∈ ℂ`:
`(h(r · + z), φ) = r⁻² (h, φ((· - z) / r))`. -/
noncomputable def affinePullbackPairing (T : (ℂ → ℝ) → ℝ) (r : ℝ) (z : ℂ) : (ℂ → ℝ) → ℝ :=
  fun φ => (r ^ 2)⁻¹ * T fun y => φ ((y - z) / r)

/-- The σ-algebra on the space `(ℂ → ℝ) → ℝ` of pairing functionals generated by the evaluations `T ↦ T φ` at test
functions `φ` on `ℂ`; the analogue of the Borel σ-algebra of the space of distributions. -/
@[instance_reducible]
noncomputable def distributionMeasurableSpace : MeasurableSpace ((ℂ → ℝ) → ℝ) :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction Set.univ φ), MeasurableSpace.comap (fun T => T φ) inferInstance

/-- The σ-algebra on `Ω` generated by the pairings `ω ↦ h ω φ` with test functions `φ` supported in `U`, for a random
pairing functional `h : Ω → (ℂ → ℝ) → ℝ`. -/
@[instance_reducible]
noncomputable def pairingSigmaAlgebra {Ω : Type*} (h : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) : MeasurableSpace Ω :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction U φ), MeasurableSpace.comap (fun ω => h ω φ) inferInstance

/-- The circle averages `(h + f)_r(z) = h_r(z) + f_r(z)` of `h + f`, given the circle averages `hε` of `h` and a
function `f : ℂ → ℝ`. -/
noncomputable def addCircleAverage (hε : ℝ → ℂ → ℝ) (f : ℂ → ℝ) : ℝ → ℂ → ℝ :=
  fun r z => hε r z + Real.circleAverage f z r

/-- An event family `E r` occurs with polynomially high probability as `r → 0` if there is a real exponent `p > 0`
with `P[(E r)ᶜ] ≤ C r^p` for all small `r > 0`. The good event need not be measurable: the probability of the
complement is an outer measure. The exponent is real. -/
def PolyHighProb {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (E : ℝ → Set Ω) : Prop :=
  ∃ p : ℝ, 0 < p ∧ ∃ C : ℝ, ∃ r₀ > 0, ∀ r : ℝ, 0 < r → r < r₀ → P (E r)ᶜ ≤ ENNReal.ofReal (C * r ^ p)

/-- Extend a continuous positive-radius profile of circle averages arbitrarily (by `0`) to nonpositive radii. -/
noncomputable def circleProfile (F : C(CircleParameter, ℝ)) (r : ℝ) (z : ℂ) : ℝ :=
  if hr : 0 < r then F (⟨r, hr⟩, z) else 0

/-- Local test functions on `U` whose integral vanishes. -/
def LocalZeroMeanTest (U : Set ℂ) :=
  {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0}

/-- The joint process of the pairings of the logarithmically shifted field `h = h^ℂ - α₀ log |·|` with the local
zero-integral test functions on `U`. -/
noncomputable def localModConstPairings {Ω : Type*} (α : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (ω : Ω) :
    LocalZeroMeanTest U → ℝ :=
  fun φ => fieldPairing α (hC ω) φ.1

end LatticeProb.Gauss
