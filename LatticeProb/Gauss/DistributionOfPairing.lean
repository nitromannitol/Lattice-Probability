import LatticeProb.Gauss.GFF
import LatticeProb.Bonanno.LQGMetric.Field.RandomDistVersion

/-!
# Measurable decoding of a distribution from its pairings with test functions

A pairing functional `T : (ℂ → ℝ) → ℝ` (a family of pairings with functions on `ℂ`) is decoded into a distribution on an
open set `U` (`LQGMetric.DistOn U`) through its values on the countable family of test functions `LQGMetric.comb U c`,
`c : LQGMetric.CoordJ`, with the measurable left inverse `LQGMetric.pairJInv U` of the coordinate map
`LQGMetric.pairJ U`:

* `distOnOfPairing_eq`: if `T` agrees with a distribution `H` on every test function on `U`, the decoding of `T` is `H`;
* `measurable_distOnOfPairing_comp`: for a family of pairing functionals `X a` whose pairings with the test functions
  supported in `U` are measurable in `a`, the decoding `a ↦ distOnOfPairing U (X a)` is measurable; in particular the
  decoder is measurable for the σ-algebra of test-function evaluations (`measurable_distOnOfPairing`), and the decoding
  of a random pairing functional `h` on `U` is measurable for the σ-algebra generated by the pairings of `h` with test
  functions supported in `U` (`measurable_distOnOfPairing_pairingSigmaAlgebra`);
* `ae_distOnOfPairing_eq`: if a random pairing functional `F` agrees almost surely with a random distribution `H` on
  each test function on `U` (the exceptional event may depend on the test function), then almost surely the decoding
  of `F ω` is `H ω`, since only countably many test functions enter the decoding.
-/

open MeasureTheory LQGMetric TopologicalSpace

namespace LatticeProb.Gauss

/-- A test function on the open set `U` (an element of `𝓓(U)`) is a test function on `ℂ` supported in `U`. -/
theorem isTestFunction_testOn (U : Opens ℂ) (φ : TestOn U) : IsTestFunction (U : Set ℂ) φ :=
  ⟨φ.contDiff, φ.hasCompactSupport, φ.tsupport_subset⟩

/-- The decoding of a pairing functional `T` into a distribution on `U`, through its values on the countable family of
test functions `comb U c`. -/
noncomputable def distOnOfPairing (U : Opens ℂ) (T : (ℂ → ℝ) → ℝ) : DistOn U :=
  pairJInv U fun c => T (comb U c)

/-- If `T` agrees with the distribution `H` on every test function on `U`, the decoding of `T` is `H`. -/
theorem distOnOfPairing_eq {U : Opens ℂ} {T : (ℂ → ℝ) → ℝ} {H : DistOn U} (hT : ∀ φ : TestOn U, T φ = H φ) :
    distOnOfPairing U T = H := by
  have h : (fun c => T (comb U c)) = pairJ U H := funext fun c => hT (comb U c)
  rw [distOnOfPairing, h, pairJInv_pairJ]

/-- The decoding of a family of pairing functionals whose pairings with the test functions supported in `U` are
measurable is measurable. -/
theorem measurable_distOnOfPairing_comp {α : Type*} [MeasurableSpace α] {U : Opens ℂ} {X : α → (ℂ → ℝ) → ℝ}
    (hX : ∀ φ : ℂ → ℝ, IsTestFunction (U : Set ℂ) φ → Measurable fun a => X a φ) :
    Measurable fun a => distOnOfPairing U (X a) :=
  (measurable_pairJInv U).comp (measurable_pi_iff.mpr fun c => hX _ (isTestFunction_testOn U (comb U c)))

/-- The decoder into `𝒟'(ℂ)` is measurable for the σ-algebra of test-function evaluations. -/
theorem measurable_distOnOfPairing :
    Measurable[distributionMeasurableSpace] (distOnOfPairing ⊤) :=
  @measurable_distOnOfPairing_comp _ distributionMeasurableSpace ⊤ id fun φ hφ =>
    Measurable.of_comap_le (le_iSup₂_of_le (f := fun (ψ : ℂ → ℝ) (_ : IsTestFunction Set.univ ψ) =>
      MeasurableSpace.comap (fun T : (ℂ → ℝ) → ℝ => T ψ) inferInstance) φ
      (by simpa only [Opens.coe_top] using hφ) le_rfl)

/-- The decoding on `U` of a random pairing functional `h` is measurable for the σ-algebra generated by the pairings of
`h` with test functions supported in `U`. -/
theorem measurable_distOnOfPairing_pairingSigmaAlgebra {Ω : Type*} (h : Ω → (ℂ → ℝ) → ℝ) (U : Opens ℂ) :
    Measurable[pairingSigmaAlgebra h U] fun ω => distOnOfPairing U (h ω) :=
  @measurable_distOnOfPairing_comp _ (pairingSigmaAlgebra h U) U h fun φ hφ =>
    Measurable.of_comap_le (le_iSup₂_of_le (f := fun (ψ : ℂ → ℝ) (_ : IsTestFunction (U : Set ℂ) ψ) =>
      MeasurableSpace.comap (fun ω => h ω ψ) inferInstance) φ hφ le_rfl)

/-- If the random pairing functional `F` agrees almost surely with the random distribution `H` on each test function on
`U` (the exceptional event may depend on the test function), then almost surely the decoding of `F ω` is `H ω`. -/
theorem ae_distOnOfPairing_eq {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {U : Opens ℂ}
    {F : Ω → (ℂ → ℝ) → ℝ} {H : Ω → DistOn U} (hFH : ∀ φ : TestOn U, ∀ᵐ ω ∂μ, F ω φ = H ω φ) :
    ∀ᵐ ω ∂μ, distOnOfPairing U (F ω) = H ω := by
  have hall : ∀ᵐ ω ∂μ, ∀ c : CoordJ, F ω (comb U c) = H ω (comb U c) :=
    ae_all_iff.2 fun c => hFH (comb U c)
  filter_upwards [hall] with ω hω
  have h : (fun c => F ω (comb U c)) = pairJ U (H ω) := funext hω
  rw [distOnOfPairing, h, pairJInv_pairJ]

/-- Two random pairing functionals that agree almost surely on each test function on `U` have almost surely the same
decoding on `U`. -/
theorem ae_distOnOfPairing_eq_distOnOfPairing {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {U : Opens ℂ}
    {F G : Ω → (ℂ → ℝ) → ℝ} (hFG : ∀ φ : TestOn U, ∀ᵐ ω ∂μ, F ω φ = G ω φ) :
    ∀ᵐ ω ∂μ, distOnOfPairing U (F ω) = distOnOfPairing U (G ω) := by
  have hall : ∀ᵐ ω ∂μ, ∀ c : CoordJ, F ω (comb U c) = G ω (comb U c) :=
    ae_all_iff.2 fun c => hFG (comb U c)
  filter_upwards [hall] with ω hω
  rw [distOnOfPairing, distOnOfPairing, funext hω]

end LatticeProb.Gauss
