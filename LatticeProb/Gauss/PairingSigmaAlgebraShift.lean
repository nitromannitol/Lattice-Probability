import LatticeProb.Gauss.GFF

/-!
# Deterministic shifts of a field do not change its local σ-algebras

For a random field given by its pairings `T_ω(φ)` with test functions, adding a deterministic function `f` shifts every
pairing by the deterministic number `∫ f φ`. Hence the σ-algebra `σ(h|_U)` generated by the pairings with test functions
supported in `U` does not change:

* `LatticeProb.Gauss.comap_add_const_eq`: `σ(g + c) = σ(g)` for a real random variable `g` and a constant `c`.
* `LatticeProb.Gauss.pairingSigmaAlgebra_addFunPairing`: `σ((h + f)|_U) = σ(h|_U)` for every deterministic `f`.
* `LatticeProb.Gauss.fieldSigmaAlgebra_eq_pairingSigmaAlgebra`: the σ-algebra of the logarithmically shifted field
  `h^ℂ - α₀ log |·|` on `U` is the σ-algebra `σ(h^ℂ|_U)` of the whole-plane field.
* `LatticeProb.Gauss.pairingSigmaAlgebra_addFunPairing_eq_fieldSigmaAlgebra`: hence `σ((h^ℂ + f)|_U)` is the
  σ-algebra of the logarithmically shifted field on `U`.
-/

open MeasureTheory

namespace LatticeProb.Gauss

/-- Adding a constant to a real random variable does not change the σ-algebra it generates. -/
theorem comap_add_const_eq {Ω : Type*} (g : Ω → ℝ) (c : ℝ) :
    MeasurableSpace.comap (fun ω => g ω + c) (inferInstance : MeasurableSpace ℝ) =
      MeasurableSpace.comap g inferInstance := by
  apply le_antisymm
  · exact ((comap_measurable g).add_const c).comap_le
  · have h : Measurable[MeasurableSpace.comap (fun ω => g ω + c) inferInstance] fun ω => g ω + c - c :=
      (comap_measurable _).sub_const c
    simp only [add_sub_cancel_right] at h
    exact h.comap_le

/-- **The local σ-algebra of `h + f` is that of `h`** for a deterministic function `f`: the pairings of `h + f` with
test functions are those of `h` shifted by the deterministic numbers `∫ f φ`. -/
theorem pairingSigmaAlgebra_addFunPairing {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (f : ℂ → ℝ) (U : Set ℂ) :
    pairingSigmaAlgebra (fun ω => addFunPairing (hC ω) f) U = pairingSigmaAlgebra hC U := by
  unfold pairingSigmaAlgebra
  refine iSup_congr fun φ => iSup_congr fun _ => ?_
  exact comap_add_const_eq (fun ω => hC ω φ) (∫ x, f x * φ x)

/-- **The local σ-algebra of the logarithmically shifted field** `h = h^ℂ - α₀ log |·|` on `U` is the local σ-algebra
`σ(h^ℂ|_U)` of the whole-plane field: the term `α₀ ∫ φ log |·|` is deterministic. -/
theorem fieldSigmaAlgebra_eq_pairingSigmaAlgebra {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    fieldSigmaAlgebra α₀ hC U = pairingSigmaAlgebra hC U := by
  unfold fieldSigmaAlgebra pairingSigmaAlgebra fieldPairing
  refine iSup_congr fun φ => iSup_congr fun _ => ?_
  simp_rw [sub_eq_add_neg]
  exact comap_add_const_eq (fun ω => hC ω φ) (-(α₀ * ∫ x, φ x * Real.log ‖x‖))

/-- The local σ-algebra of `h^ℂ + f`, `f` deterministic, is the σ-algebra of the logarithmically shifted field
`h^ℂ - α₀ log |·|` on `U`. -/
theorem pairingSigmaAlgebra_addFunPairing_eq_fieldSigmaAlgebra {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ)
    (f : ℂ → ℝ) (U : Set ℂ) :
    pairingSigmaAlgebra (fun ω => addFunPairing (hC ω) f) U = fieldSigmaAlgebra α₀ hC U := by
  rw [pairingSigmaAlgebra_addFunPairing, fieldSigmaAlgebra_eq_pairingSigmaAlgebra]

end LatticeProb.Gauss
