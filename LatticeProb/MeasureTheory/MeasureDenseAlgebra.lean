import Mathlib.MeasureTheory.Measure.SeparableMeasure

/-! # Measure-dense algebras -/

set_option autoImplicit false

open MeasureTheory

namespace LatticeProb

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-- The algebra generated by a measure-dense family remains measure-dense. -/
theorem measureDense_generateSetAlgebra {𝒜 : Set (Set α)}
    (h𝒜 : μ.MeasureDense 𝒜) : μ.MeasureDense (generateSetAlgebra 𝒜) where
  measurable s hs := by
    induction hs using generateSetAlgebra_induction with
    | base t ht => exact h𝒜.measurable t ht
    | empty => exact MeasurableSet.empty
    | compl _ _ ht => exact ht.compl
    | union _ _ _ _ ht hu => exact ht.union hu
  approx s hs hμs ε hε := by
    obtain ⟨t, ht, hst⟩ := h𝒜.approx s hs hμs ε hε
    exact ⟨t, self_subset_generateSetAlgebra ht, hst⟩

/-- A separable measure has a countable measure-dense algebra of sets. -/
theorem exists_countable_measureDense_algebra (μ : Measure α) [IsSeparable μ] :
    ∃ 𝒜 : Set (Set α), 𝒜.Countable ∧ IsSetAlgebra 𝒜 ∧ μ.MeasureDense 𝒜 := by
  obtain ⟨𝒜, hcount, hdense⟩ := exists_countable_measureDense μ
  exact ⟨generateSetAlgebra 𝒜, countable_generateSetAlgebra hcount,
    isSetAlgebra_generateSetAlgebra, measureDense_generateSetAlgebra hdense⟩

end LatticeProb
