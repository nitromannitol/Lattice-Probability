import LatticeProb.Bonanno.MatedCRTHarmonic.IGLaw.CurveLaws

/-!
# Laws of circle-average processes and transfer of almost sure events

Measure-theoretic tools for comparing laws of random elements of `ℝ → ℂ → ℝ` (the circle-average
processes the imaginary-geometry map `Φ` reads) with the product σ-algebra:

* `map_eq_of_forall_ae_eq_pi`, `map_eq_of_forall_ae_eq`: two processes that agree coordinatewise almost
  surely have the same law (the product σ-algebra is generated by the finite-dimensional cylinders);
* `ae_of_map_eq`: an almost sure measurable property transfers along an equality of laws;
* `measurableSet_eq_curve`: equality of two measurable `C(ℝ, ℂ)`-valued maps is a measurable event;
* `map_pair_shift_mod`: shifting an independent uniform `[0, r)` scalar by a measurable function of the other
  coordinate and reducing modulo `r` preserves the joint law, and differs from the unreduced shift by an
  integer multiple of `r`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set

namespace MatedCRTHarmonic.IGLaw

/-! ## Coordinatewise a.e. equality gives equality of laws -/

/-- Processes indexed by any type that agree coordinatewise almost surely have the same law on the product
σ-algebra. -/
theorem map_eq_of_forall_ae_eq_pi {Ω ι : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P] {X Y : Ω → ι → ℝ} (hX : AEMeasurable X P) (hY : AEMeasurable Y P)
    (hXY : ∀ i, (fun ω => X ω i) =ᵐ[P] fun ω => Y ω i) : P.map X = P.map Y := by
  have : IsFiniteMeasure (P.map X) := Measure.isFiniteMeasure_map P X
  refine ext_of_generate_finite (measurableCylinders fun _ : ι => ℝ)
    generateFrom_measurableCylinders.symm isPiSystem_measurableCylinders ?_ ?_
  · intro t ht
    obtain ⟨s, S, hS, rfl⟩ := (mem_measurableCylinders t).1 ht
    rw [Measure.map_apply_of_aemeasurable hX (MeasurableSet.cylinder s hS),
      Measure.map_apply_of_aemeasurable hY (MeasurableSet.cylinder s hS)]
    refine measure_congr ?_
    have hall : ∀ᵐ ω ∂P, ∀ i : s, X ω i = Y ω i := ae_all_iff.2 fun i => hXY i
    filter_upwards [hall] with ω hω
    have hres : s.restrict (X ω) = s.restrict (Y ω) := funext fun i => hω i
    change (s.restrict (X ω) ∈ S) = (s.restrict (Y ω) ∈ S)
    rw [hres]
  · rw [Measure.map_apply_of_aemeasurable hX MeasurableSet.univ,
      Measure.map_apply_of_aemeasurable hY MeasurableSet.univ]
    simp

/-- Uncurrying `ℝ → ℂ → ℝ` to `ℝ × ℂ → ℝ`. -/
def uncurryProc (f : ℝ → ℂ → ℝ) : ℝ × ℂ → ℝ := fun p => f p.1 p.2

/-- Currying `ℝ × ℂ → ℝ` to `ℝ → ℂ → ℝ`. -/
def curryProc (g : ℝ × ℂ → ℝ) : ℝ → ℂ → ℝ := fun ρ w => g (ρ, w)

lemma measurable_uncurryProc : Measurable uncurryProc :=
  measurable_pi_iff.2 fun p => (measurable_pi_apply p.2).comp (measurable_pi_apply p.1)

lemma measurable_curryProc : Measurable curryProc :=
  measurable_pi_iff.2 fun ρ => measurable_pi_iff.2 fun w => measurable_pi_apply (ρ, w)

/-- **Circle-average processes that agree coordinatewise a.s. have the same law.** -/
theorem map_eq_of_forall_ae_eq {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P] {X Y : Ω → ℝ → ℂ → ℝ} (hX : AEMeasurable X P) (hY : AEMeasurable Y P)
    (hXY : ∀ ρ w, (fun ω => X ω ρ w) =ᵐ[P] fun ω => Y ω ρ w) : P.map X = P.map Y := by
  have hUX : AEMeasurable (fun ω => uncurryProc (X ω)) P :=
    measurable_uncurryProc.comp_aemeasurable hX
  have hUY : AEMeasurable (fun ω => uncurryProc (Y ω)) P :=
    measurable_uncurryProc.comp_aemeasurable hY
  have hU : P.map (fun ω => uncurryProc (X ω)) = P.map (fun ω => uncurryProc (Y ω)) :=
    map_eq_of_forall_ae_eq_pi hUX hUY fun p => hXY p.1 p.2
  calc P.map X = P.map (fun ω => curryProc (uncurryProc (X ω))) := rfl
    _ = (P.map (fun ω => uncurryProc (X ω))).map curryProc :=
        (AEMeasurable.map_map_of_aemeasurable measurable_curryProc.aemeasurable hUX).symm
    _ = (P.map (fun ω => uncurryProc (Y ω))).map curryProc := by rw [hU]
    _ = P.map (fun ω => curryProc (uncurryProc (Y ω))) :=
        AEMeasurable.map_map_of_aemeasurable measurable_curryProc.aemeasurable hUY
    _ = P.map Y := rfl

/-! ## Transfer of almost sure events -/

/-- An almost sure measurable property transfers along an equality of laws. -/
theorem ae_of_map_eq {Ω Ω' α : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] [MeasurableSpace α]
    {P : Measure Ω} {Q : Measure Ω'} {X : Ω → α} {Y : Ω' → α} (hX : AEMeasurable X P)
    (hY : AEMeasurable Y Q) (hlaw : P.map X = Q.map Y) {S : Set α} (hS : MeasurableSet S)
    (hae : ∀ᵐ ω ∂P, X ω ∈ S) : ∀ᵐ ω ∂Q, Y ω ∈ S := by
  have h1 : ∀ᵐ x ∂(P.map X), x ∈ S := (ae_map_iff hX hS).2 hae
  rw [hlaw] at h1
  exact (ae_map_iff hY hS).1 h1

/-- Equality of two measurable curve-valued maps is a measurable event. -/
theorem measurableSet_eq_curve {α : Type*} [MeasurableSpace α] {f g : α → C(ℝ, ℂ)}
    (hf : Measurable f) (hg : Measurable g) : MeasurableSet {x | f x = g x} :=
  measurableSet_eq_fun hf hg

/-! ## Shifting an independent uniform scalar modulo the period -/

/-- Reducing a real number into `[0, r)` through the additive circle. -/
def modRep (r : ℝ) [Fact (0 < r)] (x : ℝ) : ℝ := addCircleRepresentative ((x : AddCircle r))

lemma measurable_modRep (r : ℝ) [Fact (0 < r)] : Measurable (modRep r) :=
  (measurable_addCircleRepresentative (r := r)).comp AddCircle.measurable_mk'

/-- The reduction differs from the number by an integer multiple of the period. -/
lemma exists_int_eq_modRep_add (r : ℝ) [Fact (0 < r)] (x : ℝ) :
    ∃ k : ℤ, x = modRep r x + r * k := by
  have hcoe : ((modRep r x : ℝ) : AddCircle r) = (x : AddCircle r) := by
    unfold modRep addCircleRepresentative
    exact (AddCircle.equivIco r 0).symm_apply_apply (x : AddCircle r)
  have hmem := (QuotientAddGroup.eq (s := AddSubgroup.zmultiples r)).1 hcoe
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 hmem
  refine ⟨k, ?_⟩
  rw [zsmul_eq_mul] at hk
  linarith

/-- **Uniform shift modulo the period.** If `U` is uniform on `[0, r)` and independent of `F`, then for every
measurable shift `V(F)` the reduced scalar `modRep r (V(F) + U)` is again uniform and independent of `F`:
the pair keeps its law. -/
theorem map_pair_shift_mod {Ω α : Type*} [MeasurableSpace Ω] [MeasurableSpace α]
    {P : Measure Ω} [IsProbabilityMeasure P] {r : ℝ} [Fact (0 < r)] {F : Ω → α} {U : Ω → ℝ}
    (hF : Measurable F) (hU : P.map U = volume[|Ico (0 : ℝ) r]) (hFU : IndepFun F U P)
    {V : α → ℝ} (hV : Measurable V) :
    P.map (fun ω => (F ω, modRep r (V (F ω) + U ω))) = P.map (fun ω => (F ω, U ω)) := by
  have hUm : AEMeasurable U P :=
    MoTPort.WPGFFMod.aemeasurable_of_map_eq_unif Fact.out hU
  set Uc : Ω → AddCircle r := fun ω => (U ω : AddCircle r)
  have hUc : AEMeasurable Uc P := AddCircle.measurable_mk'.comp_aemeasurable hUm
  have hUcLaw : P.map Uc = AddCircle.haarAddCircle := map_uniform_period_to_addCircle hU
  have hFUc : IndepFun F Uc P := hFU.comp measurable_id AddCircle.measurable_mk'
  set V' : α → AddCircle r := fun a => (V a : AddCircle r)
  have hV' : Measurable V' := AddCircle.measurable_mk'.comp hV
  have hShift := indepFun_addCircleShift hF hUc hV' hFUc hUcLaw
  have hrep : (fun ω => modRep r (V (F ω) + U ω)) =
      fun ω => addCircleRepresentative (V' (F ω) + Uc ω) := by
    funext ω
    simp only [modRep, V', Uc, AddCircle.coe_add]
  have hZm : AEMeasurable (fun ω => V' (F ω) + Uc ω) P := (hV'.comp hF).aemeasurable.add hUc
  have hlawU' : P.map (fun ω => modRep r (V (F ω) + U ω)) = volume[|Ico (0 : ℝ) r] := by
    rw [hrep]
    calc P.map (fun ω => addCircleRepresentative (V' (F ω) + Uc ω)) =
        (P.map (fun ω => V' (F ω) + Uc ω)).map (addCircleRepresentative (r := r)) :=
          (AEMeasurable.map_map_of_aemeasurable
            (measurable_addCircleRepresentative (r := r)).aemeasurable hZm).symm
      _ = AddCircle.haarAddCircle.map (addCircleRepresentative (r := r)) := by rw [hShift.2]
      _ = volume[|Ico (0 : ℝ) r] := map_addCircleRepresentative_haar
  have hindU' : IndepFun F (fun ω => modRep r (V (F ω) + U ω)) P := by
    rw [hrep]
    exact hShift.1.comp measurable_id (measurable_addCircleRepresentative (r := r))
  have hU'm : AEMeasurable (fun ω => modRep r (V (F ω) + U ω)) P :=
    (measurable_modRep r).comp_aemeasurable ((hV.comp hF).aemeasurable.add hUm)
  rw [(indepFun_iff_map_prod_eq_prod_map_map hF.aemeasurable hU'm).1 hindU',
    (indepFun_iff_map_prod_eq_prod_map_map hF.aemeasurable hUm).1 hFU, hlawU', hU]

end MatedCRTHarmonic.IGLaw
