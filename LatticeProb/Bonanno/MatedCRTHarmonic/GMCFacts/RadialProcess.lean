/-! ### The covariance of a two-sided Brownian motion -/

/-- `log b + log⁺(a/b) = log max(a, b)`. -/
lemma log_add_posLog_div {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    Real.log b + Real.posLog (b⁻¹ * a) = Real.log (max a b) := by
  rcases le_total a b with hab | hab
  · rw [max_eq_right hab, (Real.posLog_eq_zero_iff _).mpr ?_, add_zero]
    rw [abs_of_pos (by positivity), inv_mul_le_iff₀ hb, mul_one]
    exact hab
  · rw [max_eq_left hab, Real.posLog_eq_log ?_, Real.log_mul (inv_pos.2 hb).ne' ha.ne',
      Real.log_inv]
    · ring
    · rw [abs_of_pos (by positivity), le_inv_mul_iff₀ hb, mul_one]
      exact hab

/-- The circle covariance of two concentric circles: `circCov 0 a 0 b = log max(a, b)`. -/
lemma circCov_concentric {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    circCov 0 a 0 b = Real.log (max a b) := by
  rw [circCov_center 0 ha b hb, log_add_posLog_div ha hb]

