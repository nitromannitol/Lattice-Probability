/-! ### 2. Telescoping on a uniform partition -/

/-- If the increments of `ψ` over `[a, a+h] ⊆ [s,t]` are `O(h^{3/2})`, then `ψ t = ψ s`. -/
theorem eq_of_step_bound {ψ : ℝ → ℝ} {s t K : ℝ} (hst : s ≤ t)
    (hstep : ∀ a h, s ≤ a → 0 ≤ h → a + h ≤ t → |ψ (a + h) - ψ a| ≤ K * (h * Real.sqrt h)) :
    ψ t = ψ s := by
  have hbound : ∀ n : ℕ, 0 < n →
      |ψ t - ψ s| ≤ K * ((t - s) * Real.sqrt ((t - s) / n)) := by
    intro n hn
    have hnR : (0 : ℝ) < n := by exact_mod_cast hn
    set h := (t - s) / n with hh
    have hh0 : 0 ≤ h := div_nonneg (sub_nonneg.2 hst) hnR.le
    set pts : ℕ → ℝ := fun j => s + j * h with hpts
    have hptsn : pts n = t := by
      simp only [hpts, hh]; field_simp; ring
    have htel : ψ t - ψ s = ∑ j ∈ Finset.range n, (ψ (pts (j + 1)) - ψ (pts j)) := by
      rw [Finset.sum_range_sub (fun j => ψ (pts j)), hptsn]
      simp [hpts]
    rw [htel]
    calc |∑ j ∈ Finset.range n, (ψ (pts (j + 1)) - ψ (pts j))|
        ≤ ∑ j ∈ Finset.range n, |ψ (pts (j + 1)) - ψ (pts j)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j ∈ Finset.range n, K * (h * Real.sqrt h) := by
          apply Finset.sum_le_sum
          intro j hj
          have hjn : (j : ℝ) + 1 ≤ n := by
            have := Finset.mem_range.1 hj; exact_mod_cast this
          have hsucc : pts (j + 1) = pts j + h := by simp only [hpts]; push_cast; ring
          rw [hsucc]
          refine hstep _ _ ?_ hh0 ?_
          · simp only [hpts]; nlinarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]
          · have : pts j + h = s + ((j : ℝ) + 1) * h := by simp only [hpts]; ring
            rw [this]
            have : ((j : ℝ) + 1) * h ≤ n * h := mul_le_mul_of_nonneg_right hjn hh0
            have hnh : (n : ℝ) * h = t - s := by simp only [hh]; field_simp
            linarith
      _ = K * ((t - s) * Real.sqrt h) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          have hnh : (n : ℝ) * h = t - s := by simp only [hh]; field_simp
          rw [← hnh]; ring
  have hlim : Tendsto (fun n : ℕ => K * ((t - s) * Real.sqrt ((t - s) / n))) atTop (𝓝 0) := by
    have h1 : Tendsto (fun n : ℕ => (t - s) / (n : ℝ)) atTop (𝓝 0) :=
      tendsto_const_div_atTop_nhds_zero_nat (t - s)
    have h2 : Tendsto (fun n : ℕ => Real.sqrt ((t - s) / n)) atTop (𝓝 0) := by
      have := (Real.continuous_sqrt.tendsto 0).comp h1
      rw [Real.sqrt_zero] at this
      exact this
    have := (h2.const_mul (t - s)).const_mul K
    simpa only [mul_zero] using this
  have hle : |ψ t - ψ s| ≤ 0 :=
    ge_of_tendsto hlim (Filter.eventually_atTop.2 ⟨1, fun n hn => hbound n hn⟩)
  have := abs_nonpos_iff.1 hle
  linarith

/-! ### 3. A second-order Taylor bound with third-derivative remainder -/

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- `D²F(y)[v,w]` through `iteratedFDeriv`. -/
theorem iteratedFDeriv_two_vec (F : E → ℝ) (y v w : E) :
    iteratedFDeriv ℝ 2 F y ![v, w] = fderiv ℝ (fderiv ℝ F) y v w := by
  rw [iteratedFDeriv_two_apply]; simp

theorem norm_fderiv_fderiv_apply_le (F : E → ℝ) (y v w : E) :
    ‖fderiv ℝ (fderiv ℝ F) y v w‖ ≤ ‖iteratedFDeriv ℝ 2 F y‖ * ‖v‖ * ‖w‖ := by
  rw [← iteratedFDeriv_two_vec]
  have := (iteratedFDeriv ℝ 2 F y).le_opNorm ![v, w]
  simpa [Fin.prod_univ_two, mul_assoc] using this

theorem abs_sub_apply_two_le (A A' : ContinuousMultilinearMap ℝ (fun _ : Fin 2 => E) ℝ) (v : E) :
    |A ![v, v] - A' ![v, v]| ≤ ‖A - A'‖ * ‖v‖ ^ 2 := by
  rw [← ContinuousMultilinearMap.sub_apply]
  have := (A - A').le_opNorm ![v, v]
  simpa [Fin.prod_univ_two, sq] using this

/-- `|F(x+w) - F(x) - DF(x)w - ½ D²F(x)[w,w]| ≤ C ‖w‖³` when `D²F` is `C`-Lipschitz. -/
theorem taylor2_bound {F : E → ℝ} (hF : ContDiff ℝ 3 F) {C : ℝ} (hC0 : 0 ≤ C)
    (hLip2 : ∀ y z, ‖iteratedFDeriv ℝ 2 F y - iteratedFDeriv ℝ 2 F z‖ ≤ C * ‖y - z‖) (x w : E) :
    |F (x + w) - F x - fderiv ℝ F x w - (1 / 2) * iteratedFDeriv ℝ 2 F x ![w, w]|
      ≤ C * ‖w‖ ^ 3 := by
  have hF2 : ContDiff ℝ 2 (fderiv ℝ F) := hF.fderiv_right (by norm_num)
  have hd1 : ∀ y, HasFDerivAt F (fderiv ℝ F y) y :=
    fun y => ((hF.differentiable (by norm_num)) y).hasFDerivAt
  have hd2 : ∀ y, HasFDerivAt (fderiv ℝ F) (fderiv ℝ (fderiv ℝ F) y) y :=
    fun y => ((hF2.differentiable (by norm_num)) y).hasFDerivAt
  set D1 := fderiv ℝ F
  set D2 := fderiv ℝ (fderiv ℝ F)
  have hQv : ∀ y, iteratedFDeriv ℝ 2 F y ![w, w] = D2 y w w := fun y => iteratedFDeriv_two_vec F y w w
  have hline : ∀ τ : ℝ, HasDerivAt (fun τ : ℝ => x + τ • w) w τ := by
    intro τ
    simpa using ((hasDerivAt_id τ).smul_const w).const_add x
  -- step 1
  set k1 : ℝ → ℝ := fun τ => D1 (x + τ • w) w - τ * D2 x w w with hk1
  have hk1d : ∀ τ, HasDerivAt k1 (D2 (x + τ • w) w w - D2 x w w) τ := by
    intro τ
    have hA : HasDerivAt (fun τ : ℝ => D1 (x + τ • w)) (D2 (x + τ • w) w) τ :=
      (hd2 _).comp_hasDerivAt τ (hline τ)
    have hB := hA.clm_apply (hasDerivAt_const τ w)
    have hC := (hasDerivAt_id τ).mul_const (D2 x w w)
    rw [hk1]
    refine (hB.sub hC).congr_deriv ?_
    simp
  have hk1b : ∀ τ ∈ Set.Icc (0 : ℝ) 1, ‖k1 τ - k1 0‖ ≤ C * ‖w‖ ^ 3 * (τ - 0) := by
    refine norm_image_sub_le_of_norm_deriv_le_segment'
      (fun τ _ => (hk1d τ).hasDerivWithinAt) ?_
    intro τ hτ
    rw [← hQv, ← hQv, Real.norm_eq_abs]
    refine (abs_sub_apply_two_le _ _ w).trans ?_
    have h2 : ‖iteratedFDeriv ℝ 2 F (x + τ • w) - iteratedFDeriv ℝ 2 F x‖ ≤ C * ‖w‖ := by
      refine (hLip2 _ _).trans ?_
      simp only [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg hτ.1]
      have : τ * ‖w‖ ≤ ‖w‖ := by nlinarith [norm_nonneg w, hτ.2]
      exact mul_le_mul_of_nonneg_left this hC0
    calc ‖iteratedFDeriv ℝ 2 F (x + τ • w) - iteratedFDeriv ℝ 2 F x‖ * ‖w‖ ^ 2
        ≤ C * ‖w‖ * ‖w‖ ^ 2 := by gcongr
      _ = C * ‖w‖ ^ 3 := by ring
  -- step 2
  set k : ℝ → ℝ := fun τ => F (x + τ • w) - τ * D1 x w - τ ^ 2 / 2 * D2 x w w with hk
  have hkd : ∀ τ, HasDerivAt k (k1 τ - k1 0) τ := by
    intro τ
    have hA : HasDerivAt (fun τ : ℝ => F (x + τ • w)) (D1 (x + τ • w) w) τ :=
      (hd1 _).comp_hasDerivAt τ (hline τ)
    have hB := (hasDerivAt_id τ).mul_const (D1 x w)
    have hC := ((hasDerivAt_pow 2 τ).div_const 2).mul_const (D2 x w w)
    rw [hk]
    refine ((hA.sub hB).sub hC).congr_deriv ?_
    simp only [hk1, zero_smul, add_zero, zero_mul, sub_zero, one_mul, id]
    norm_num
    ring
  have hkb : ∀ τ ∈ Set.Icc (0 : ℝ) 1, ‖k τ - k 0‖ ≤ C * ‖w‖ ^ 3 * (τ - 0) := by
    refine norm_image_sub_le_of_norm_deriv_le_segment'
      (fun τ _ => (hkd τ).hasDerivWithinAt) ?_
    intro τ hτ
    have := hk1b τ (Set.Ico_subset_Icc_self hτ)
    have hτ1 : τ - 0 ≤ 1 := by linarith [hτ.2]
    calc ‖k1 τ - k1 0‖ ≤ C * ‖w‖ ^ 3 * (τ - 0) := this
      _ ≤ C * ‖w‖ ^ 3 * 1 := by gcongr
      _ = C * ‖w‖ ^ 3 := mul_one _
  have := hkb 1 ⟨zero_le_one, le_rfl⟩
  have hk10 : k 1 - k 0 = F (x + w) - F x - D1 x w - (1 / 2) * D2 x w w := by
    simp [hk]; ring
  rw [hk10, Real.norm_eq_abs] at this
  rw [hQv]
  simpa using this

