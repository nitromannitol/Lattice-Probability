/-!
* `bmFiltration B` : the natural filtration `σ(B_r : r ≤ t)`.
* `bm_incr_moment` (IL-1) : for bounded `𝓕_t`-measurable `ξ`,
  `E[ξ (B_{t+s} - B_t)^k] = E[ξ] * m_k(s)`.
* `bmOsc`, `measurable_bmOsc`, `bmOsc_eq_iSup_dense` (IL-2) : the oscillation of a continuous
  path on `[t, t+s]` is the supremum over any countable dense set of times, hence measurable.
-/

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped ENNReal NNReal

namespace QuantumZipper

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {B : ℝ≥0 → Ω → ℝ} {P : Measure Ω}

/-- The natural filtration of `B`: `𝓕_t = ⨆ s ≤ t, σ(B s)`. -/
def bmFiltration (B : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ s, ⨆ (_ : s ≤ t), (inferInstance : MeasurableSpace ℝ).comap (B s)

/-- `𝓕_t` is contained in the σ-algebra generated by the stopped path `(B r)_{r ≤ t}`. -/
theorem bmFiltration_le_comap_restrict (t : ℝ≥0) :
    bmFiltration B t ≤
      MeasurableSpace.comap (fun ω (r : Set.Iic t) => B r ω) MeasurableSpace.pi := by
  refine iSup₂_le fun s hs => ?_
  have hm : Measurable[MeasurableSpace.comap (fun ω (r : Set.Iic t) => B r ω)
      MeasurableSpace.pi] (fun ω => B s ω) :=
    (@measurable_pi_apply (Set.Iic t) (fun _ => ℝ) _ ⟨s, hs⟩).comp
      (comap_measurable (fun ω (r : Set.Iic t) => B r ω))
  exact hm.comap_le

theorem bmFiltration_le (hBm : ∀ r, Measurable (B r)) (t : ℝ≥0) : bmFiltration B t ≤ mΩ :=
  iSup₂_le fun s _ => (hBm s).comap_le

/-! ### IL-2: oscillation of continuous paths through a countable dense set of times -/

end QuantumZipper
