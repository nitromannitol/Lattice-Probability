   source module HigherDimLFPP.Field.FiniteRange at commit fdb5cad; only the module paths of local imports are changed.
   Declarations, examples and checks that the copied results do not use are omitted. -/
import LatticeProb.Bonanno.HigherDimLFPP.Field.BandFacts

/-!
# Finite range of the band fields (packet P-X2, target T2)

Source: `source/higher-dimensional-lfpp-limit.pdf`, (1.1) and §3.1 (`κ` compactly supported);
planning audit HA5, Details D14 (finite range: DGZ Lemma 2.2(3), Lemma 2.6 and the product bound
of D6), HA2 Details D2.

If `κ` vanishes outside the ball `B(0, ρ)` (`hρ : ∀ y, ρ ≤ ‖y‖ → κ y = 0`, the form of
`IsLFPPKernel.exists_radius`), then `C = κ ⋆ κ` vanishes for `‖x‖ ≥ 2ρ`
(`autoCorr_eq_zero_of_two_mul_le`), so by the Gram formula `inner_bandVec`
`⟪k_{a,b,z}, k_{a',b',w}⟫ = ∫_{(max a a', min b b')} C(t⁻¹(z - w)) dt/t = 0`
as soon as `2ρ min(b, b') ≤ ‖z - w‖` (every `t` in the band satisfies `t < min(b, b')`).
For jointly Gaussian families, orthogonality is independence
(Mathlib `IsGaussianProcess.indepFun_of_covariance_eq_zero`,
`IsGaussianProcess.iIndepFun_of_covariance_eq_zero`).

Main results (namespace `HigherDimLFPP`; `0 < a`, `0 < a'` throughout):

* `IsLFPPKernel.radius_pos`: a support radius of an admissible kernel is positive;
* `inner_bandVec_eq_zero_of_two_mul_min_le` (`2ρ min(b, b') ≤ ‖z - w‖`) and the packet form
  `inner_bandVec_eq_zero_of_far` (`2ρ max(b, b') < ‖z - w‖`);
* families of white-noise values, any index types: `IsWhiteNoise.indepFun_bandVec_of_far`
  (two families) and `IsWhiteNoise.iIndepFun_bandVec_of_far` (mutual independence of pairwise far
  families);
* modifications (versions): `IsWhiteNoise.indepFun_of_ae_eq`, `IsWhiteNoise.iIndepFun_of_ae_eq`
  (orthogonal kernel vectors give independent modifications);
* continuous versions restricted to sets: `IsBandVersion.indepFun_restrict_of_far` (two sets, two
  bands; the σ-algebras generated by `(H z)_{z ∈ A}` and `(H' w)_{w ∈ B}` are independent),
  `IsBandVersion.indepFun_restrict_of_two_mul_lt` (packet form), and
  `IsBandVersion.iIndepFun_restrict_of_far` (mutual independence over pairwise far sets: DGZ
  Lemma 2.2(3), Lemma 2.6, the product bound of D6);
* versions of disjoint scale bands are independent: `IsBandVersion.indepFun_of_le` (HA2 D2.1).

Templates: `IsWhiteNoise.indepFun_bands` (`Field/BandFacts.lean`) and LQGMetric's
`IsWhiteNoise.iIndepFun_of_pairwise_disjoint` (`LQGMetric/Field/WhiteNoiseIndep.lean`).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped RealInnerProductSpace

namespace HigherDimLFPP

variable {d : ℕ} {κ : Rd d → ℝ}

/-- A support radius of an admissible kernel is positive (otherwise `κ = 0`, contradicting
`∫ κ² = 1`). -/
theorem IsLFPPKernel.radius_pos (hκ : IsLFPPKernel κ) {ρ : ℝ} (hρ : ∀ y, ρ ≤ ‖y‖ → κ y = 0) :
    0 < ρ := by
  by_contra h
  have h0 : ∀ y, κ y = 0 := fun y => hρ y ((not_lt.1 h).trans (norm_nonneg y))
  have h1 := hκ.integral_sq
  simp only [h0, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, integral_zero] at h1
  exact zero_ne_one h1

/-! ### Orthogonality of far band vectors -/

/-- **Finite range** (target T2): band vectors at points with `2ρ min(b, b') ≤ ‖z - w‖` are
orthogonal, for a support radius `ρ` of `κ`. -/
theorem inner_bandVec_eq_zero_of_two_mul_min_le (hκ : IsLFPPKernel κ) {ρ : ℝ}
    (hρ : ∀ y, ρ ≤ ‖y‖ → κ y = 0) {a a' b b' : ℝ} (ha : 0 < a) (ha' : 0 < a') {z w : Rd d}
    (h : 2 * ρ * min b b' ≤ ‖z - w‖) : ⟪bandVec κ a b z, bandVec κ a' b' w⟫ = 0 := by
  have hρ0 := hκ.radius_pos hρ
  rw [inner_bandVec hκ ha ha']
  refine setIntegral_eq_zero_of_forall_eq_zero fun t ht => ?_
  have ht0 : 0 < t := lt_of_le_of_lt (le_max_of_le_left ha.le) ht.1
  have hC : autoCorr κ (t⁻¹ • (z - w)) = 0 := by
    refine autoCorr_eq_zero_of_two_mul_le hρ ?_
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 ht0.le), le_inv_mul_iff₀ ht0]
    calc t * (2 * ρ) ≤ min b b' * (2 * ρ) := mul_le_mul_of_nonneg_right ht.2.le (by positivity)
      _ = 2 * ρ * min b b' := by ring
      _ ≤ ‖z - w‖ := h
  rw [hC, zero_div]

/-- Covariances only depend on the a.e. classes of the random variables. -/
theorem covariance_congr_ae {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {X X' Y Y' : Ω → ℝ}
    (hX : X =ᵐ[P] X') (hY : Y =ᵐ[P] Y') : cov[X, Y; P] = cov[X', Y'; P] := by
  unfold covariance
  rw [integral_congr_ae hX, integral_congr_ae hY]
  refine integral_congr_ae ?_
  filter_upwards [hX, hY] with ω h1 h2
  rw [h1, h2]

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {W : WN d → Ω → ℝ}

namespace IsWhiteNoise

/-! ### Independence for families of white-noise values -/

/-! ### Modifications -/

/-- Modifications of white-noise families with mutually orthogonal kernel vectors are mutually
independent. -/
theorem iIndepFun_of_ae_eq (hW : IsWhiteNoise P W) {K : Type*} {S : K → Type*}
    (F : (k : K) → S k → WN d)
    (h : ∀ k₁ k₂, k₁ ≠ k₂ → ∀ (s₁ : S k₁) (s₂ : S k₂), ⟪F k₁ s₁, F k₂ s₂⟫ = 0)
    {X : (k : K) → S k → Ω → ℝ} (hX : ∀ k s, X k s =ᵐ[P] W (F k s)) :
    iIndepFun (fun k ω (s : S k) => X k s ω) P := by
  have hG := hW.isGaussianProcess_comp (fun p : (k : K) × S k => F p.1 p.2)
  have hG' : IsGaussianProcess (fun (p : (k : K) × S k) ω => X p.1 p.2 ω) P :=
    hG.congr fun p => (hX p.1 p.2).symm
  refine IsGaussianProcess.iIndepFun_of_covariance_eq_zero hG'
    (fun k s => (hW.measurable (F k s)).aemeasurable.congr (hX k s).symm)
    fun k₁ k₂ hk s₁ s₂ => ?_
  rw [covariance_congr_ae (hX k₁ s₁) (hX k₂ s₂), hW.cov_eq]
  exact h k₁ k₂ hk s₁ s₂

end IsWhiteNoise

/-! ### Continuous versions restricted to far sets -/

namespace IsBandVersion

variable {a b a' b' : ℝ} {H H' : Rd d → Ω → ℝ}

/-- **Mutual independence over pairwise far sets** (DGZ Lemma 2.2(3), Lemma 2.6; the product
bound of HA5 D6): if `2ρb ≤ ‖z - w‖` whenever `z ∈ A k₁`, `w ∈ A k₂`, `k₁ ≠ k₂`, then the
restrictions `((H z)_{z ∈ A k})_k` of a version of `H_{a,b}` are mutually independent. -/
theorem iIndepFun_restrict_of_far (hW : IsWhiteNoise P W) (hκ : IsLFPPKernel κ) {ρ : ℝ}
    (hρ : ∀ y, ρ ≤ ‖y‖ → κ y = 0) (hH : IsBandVersion P W κ a b H) (ha : 0 < a) {K : Type*}
    (A : K → Set (Rd d))
    (hA : ∀ k₁ k₂, k₁ ≠ k₂ → ∀ z ∈ A k₁, ∀ w ∈ A k₂, 2 * ρ * b ≤ ‖z - w‖) :
    iIndepFun (fun k ω (z : A k) => H z ω) P :=
  hW.iIndepFun_of_ae_eq (fun k (z : A k) => bandVec κ a b z)
    (fun k₁ k₂ hk z w => inner_bandVec_eq_zero_of_two_mul_min_le hκ hρ ha ha (by
      rw [min_self]; exact hA k₁ k₂ hk z z.2 w w.2))
    (X := fun k (z : A k) => H z) fun k z => hH.ae_eq z

end IsBandVersion

end HigherDimLFPP
