import LatticeProb.Bonanno.LQGMetric.Prob.Quantile

/-!
# The site percolation model of DGZ Lemma 3.3 (packet P-X7a, target T3)

Source: DGZ arXiv:2310.03996, proof of Lemma 3.3, Step 3 ((3.22)–(3.23) and the `M`-dependence
paragraph); planning audit HA5, Details D9 ("Open sites") and D14 (similarity laws, finite range),
findings G3 (sites outside the inner region are open) and G9 (a signed permutation maps the box to
the box).

Setting: a fine lattice `s ℤ^d` (`s = 2^{-m-k}` in DGZ), a continuous random field `H` (the fine
band `h_{m+k,n}`), a threshold `b` and a region radius `ϱ` (`2 - 2^{-m-3}` in HA5 D9). The site `y`
is *closed* (`SiteClosed`, event `closedSite`) if `|s y|_∞ ≤ ϱ` and for some L-neighbour `y'`
`D^ξ_{obox (s y) (2 s)}(s y, s y')(H) > s b`; all other sites are open. This is exactly the
open-site hypothesis of target T2 (`lfppDistOn_le_of_not_siteClosed`).

Main results (namespace `HigherDimLFPP.DGZ`):

* `measurableSet_closedSite_comap`: the event `closedSite y` is measurable for the σ-algebra
  generated by the field on the closed box `cbox (s y) (2 s)` (locality; via the clamped field and
  P-X1's countable family of rational polygons), hence (`measurableSet_closedSite`) measurable.
* `measure_lt_lfppDistOn_nbr` (DGZ (3.23), HA5 D14): for a continuous version `H` of the band
  `H_{a,c}` (`0 < a`) and any continuous version `H'` of `H_{a/s,c/s}` (any white noise),
  `P[D^ξ_{obox (s y) (2 s)}(s y, s y')(H) > s b] = P'[D^ξ(H') > b]` for every L-neighbour `y'` of
  `y`: the similarity `z ↦ s y + s O z` with a signed coordinate permutation `O`, `O e₁ = ± e_i`
  (`signedSwap`), maps `U` onto `obox (s y) (2 s)`, `0 ↦ s y`, `e₁ ↦ s y'` (`lfppDistOn_sim`), and
  `z ↦ H(s y + s O z)` is a version of `H_{a/s,c/s}` for the white noise `W ∘ V_T`
  (`IsBandVersion.comp_sim`); then law transfer (`IsBandVersion.measure_comp_mem_eq`).
* `measure_closedSite_le`: if `P'[D^ξ(H') ≤ b] ≥ p`, then `P(closedSite y) ≤ 2d(1 - p)`;
  `measure_closedSite_le_lowerQuantile`: the same for `b` the lower `p`-quantile of `D^ξ(H')`
  (`LQGMetric.lowerQuantile`, HA5 D3).
* `productBound_closedSite` (DGZ's `M`-dependence, HA5 D9/D14): for `c ≤ s` and a support radius
  `ρ` of `κ`, the events `closedSite y` satisfy `Perc.ProductBound` with range
  `M = ⌈2(2 + ρ)⌉`: sites at lattice `ℓ^∞`-distance `> M` have boxes at Euclidean distance
  `≥ 2ρ c`, so the restricted fields are mutually independent
  (`IsBandVersion.iIndepFun_restrict_of_far`, P-X2) and the events are independent.
* `lfppDistance_le_of_good_sites`, `lfppDistance_le_of_good_sites_exp`: target T2
  (`lfppDistance_le_of_good`, `lfppDistance_le_of_good_exp`) with the open sites of the site model,
  `O = {y | ¬ SiteClosed ξ φ₂ 2^{-m-k} b (2 - 2^{-m-3}) y}`; for a random field `H₂`,
  `{y | ω ∉ closedSite ξ H₂ … y}` is this set for `φ₂ = H₂(·, ω)` (definitionally).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped ENNReal
open HigherDimLFPP.Perc (Zd LAdj WithinInf ProductBound IsClosedCluster Encloses)

namespace HigherDimLFPP

namespace DGZ

variable {d : ℕ}

/-! ### Closed sites -/

/-- The fine site `y` of the lattice `s ℤ^d` is *closed* for the field `φ`, the threshold `b` and
the region radius `ϱ` (DGZ (3.22), HA5 D9): `|s y|_∞ ≤ ϱ`, and for some L-neighbour `y'` the
internal distance of `φ` from `s y` to `s y'` in the open box `obox (s y) (2 s)` exceeds `s b`.
Sites outside the region are open. -/
def SiteClosed (ξ : ℝ) (φ : Rd d → ℝ) (s b ϱ : ℝ) (y : Zd d) : Prop :=
  (∀ i, |latPt s y i| ≤ ϱ) ∧
    ∃ y', LAdj y y' ∧ s * b < lfppDistOn ξ φ (obox (latPt s y) (2 * s)) (latPt s y) (latPt s y')

/-- The event that the fine site `y` is closed for the random field `H`. -/
def closedSite {Ω : Type*} (ξ : ℝ) (H : Rd d → Ω → ℝ) (s b ϱ : ℝ) (y : Zd d) : Set Ω :=
  {ω | SiteClosed ξ (fun z => H z ω) s b ϱ y}

/-- An open site of the region satisfies the open-site bound of target T2. -/
theorem lfppDistOn_le_of_not_siteClosed {ξ : ℝ} {φ : Rd d → ℝ} {s b ϱ : ℝ} {y : Zd d}
    (hy : ¬ SiteClosed ξ φ s b ϱ y) (hreg : ∀ i, |latPt s y i| ≤ ϱ) {y' : Zd d}
    (hyy' : LAdj y y') :
    lfppDistOn ξ φ (obox (latPt s y) (2 * s)) (latPt s y) (latPt s y') ≤ s * b := by
  by_contra h
  exact hy ⟨hreg, y', hyy', not_le.1 h⟩

/-! ### Locality -/

/-- The coordinatewise clamp of `ℝ^d` onto the closed box `cbox c r`. -/
def clampBox (c : Rd d) (r : ℝ) (z : Rd d) : Rd d :=
  WithLp.toLp 2 (fun i => max (c i - r) (min (c i + r) (z i)))

theorem clampBox_apply (c : Rd d) (r : ℝ) (z : Rd d) (i : Fin d) :
    clampBox c r z i = max (c i - r) (min (c i + r) (z i)) := rfl

theorem continuous_clampBox (c : Rd d) (r : ℝ) : Continuous (clampBox c r) :=
  (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i =>
    continuous_const.max (continuous_const.min (PiLp.continuous_apply 2 _ i)))

theorem clampBox_mem (c : Rd d) {r : ℝ} (hr : 0 ≤ r) (z : Rd d) : clampBox c r z ∈ cbox c r := by
  intro i
  rw [clampBox_apply, abs_le]
  have h1 : max (c i - r) (min (c i + r) (z i)) ≤ c i + r :=
    max_le (by linarith) (min_le_left _ _)
  constructor <;> linarith [le_max_left (c i - r) (min (c i + r) (z i))]

theorem clampBox_of_mem {c : Rd d} {r : ℝ} {z : Rd d} (hz : z ∈ cbox c r) : clampBox c r z = z := by
  ext i
  rw [clampBox_apply]
  have h := abs_le.1 (hz i)
  rw [min_eq_right (by linarith), max_eq_right (by linarith)]

/-- Internal distances in `V` only depend on the field on `V`. -/
theorem lfppDistOn_congr {ζ : ℝ} {φ ψ : Rd d → ℝ} {V : Set (Rd d)} (h : ∀ z ∈ V, φ z = ψ z)
    (x y : Rd d) : lfppDistOn ζ φ V x y = lfppDistOn ζ ψ V x y := by
  unfold lfppDistOn
  congr 1
  funext γ
  unfold lfppLength
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [uIcc_of_le zero_le_one] at ht
  simp only [h _ (γ.2.2 ht)]

/-- **Locality of the closed-site events**: `closedSite y` is measurable for the σ-algebra generated
by the field on the closed box `cbox (s y) (2 s)` (only continuity of the field is needed). -/
theorem measurableSet_closedSite_comap {Ω : Type*} {H : Rd d → Ω → ℝ}
    (hc : ∀ ω, Continuous fun z => H z ω) {s : ℝ} (hs : 0 < s) (ξ b ϱ : ℝ) (y : Zd d) :
    MeasurableSet[MeasurableSpace.comap (fun ω (z : cbox (latPt s y) (2 * s)) => H z ω)
      MeasurableSpace.pi] (closedSite ξ H s b ϱ y) := by
  set A : Set (Rd d) := cbox (latPt s y) (2 * s) with hA
  set Y : Ω → A → ℝ := fun ω z => H z ω with hY
  let mΩ : MeasurableSpace Ω := MeasurableSpace.comap Y MeasurableSpace.pi
  set Ht : Rd d → Ω → ℝ := fun z ω => H (clampBox (latPt s y) (2 * s) z) ω with hHt
  have hct : ∀ ω, Continuous fun z => Ht z ω := fun ω =>
    (hc ω).comp (continuous_clampBox _ _)
  have hmt : ∀ z, Measurable (Ht z) := fun z =>
    (measurable_pi_apply (⟨clampBox (latPt s y) (2 * s) z,
      clampBox_mem _ (by positivity) z⟩ : A)).comp (comap_measurable Y)
  have hD : ∀ y', Measurable fun ω =>
      lfppDistOn ξ (fun z => H z ω) (obox (latPt s y) (2 * s)) (latPt s y) (latPt s y') := by
    intro y'
    have h := measurable_lfppDistOn hct hmt (isOpen_obox (latPt s y) (2 * s)) ξ (latPt s y)
      (latPt s y')
    have heq : (fun ω => lfppDistOn ξ (fun z => H z ω) (obox (latPt s y) (2 * s)) (latPt s y)
        (latPt s y')) = fun ω => lfppDistOn ξ (fun z => Ht z ω) (obox (latPt s y) (2 * s))
          (latPt s y) (latPt s y') := by
      funext ω
      refine lfppDistOn_congr (fun z hz => ?_) _ _
      simp only [hHt, clampBox_of_mem (obox_subset_cbox _ _ hz)]
    rw [heq]
    exact h
  have he : closedSite ξ H s b ϱ y = {_ω | ∀ i, |latPt s y i| ≤ ϱ} ∩ ⋃ y' : Zd d,
      ({_ω | LAdj y y'} ∩ {ω | s * b <
        lfppDistOn ξ (fun z => H z ω) (obox (latPt s y) (2 * s)) (latPt s y) (latPt s y')}) := by
    ext ω
    simp only [closedSite, SiteClosed, mem_inter_iff, mem_iUnion, mem_ofPred_eq]
  rw [he]
  exact (MeasurableSet.const _).inter (MeasurableSet.iUnion fun y' =>
    (MeasurableSet.const _).inter (measurableSet_lt measurable_const (hD y')))

/-! ### The law of a neighbour distance -/

/-- The signed coordinate swap of `ℝ^d`: exchange the coordinates `i₀` and `i`, then change the sign
of coordinate `i` if `neg`. -/
def signedSwap (i₀ i : Fin d) (neg : Bool) : Rd d ≃ₗᵢ[ℝ] Rd d :=
  (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (Equiv.swap i₀ i)).trans
    (LinearIsometryEquiv.piLpCongrRight 2 fun l =>
      if l = i ∧ neg = true then LinearIsometryEquiv.neg ℝ else LinearIsometryEquiv.refl ℝ ℝ)

theorem signedSwap_apply (i₀ i : Fin d) (neg : Bool) (z : Rd d) (l : Fin d) :
    signedSwap i₀ i neg z l = (if l = i ∧ neg = true then -1 else 1) * z (Equiv.swap i₀ i l) := by
  simp only [signedSwap, LinearIsometryEquiv.trans_apply]
  rw [LinearIsometryEquiv.piLpCongrRight_apply]
  show (if l = i ∧ neg = true then LinearIsometryEquiv.neg ℝ else LinearIsometryEquiv.refl ℝ ℝ)
    ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (Equiv.swap i₀ i) z) l) = _
  simp only [LinearIsometryEquiv.piLpCongrLeft_apply, Equiv.piCongrLeft', Equiv.symm_swap]
  split_ifs <;> simp

theorem abs_signedSwap_apply (i₀ i : Fin d) (neg : Bool) (z : Rd d) (l : Fin d) :
    |signedSwap i₀ i neg z l| = |z (Equiv.swap i₀ i l)| := by
  rw [signedSwap_apply, abs_mul]
  split_ifs <;> simp

/-- The neighbour `y ± e_i` of a site (`-` if `neg`). -/
def nbr (y : Zd d) (i : Fin d) (neg : Bool) : Zd d := y + Pi.single i (if neg then -1 else 1)

/-- Every L-neighbour of `y` is some `nbr y i neg`. -/
theorem exists_eq_nbr {y y' : Zd d} (h : LAdj y y') : ∃ i neg, y' = nbr y i neg := by
  obtain ⟨i, hi | hi⟩ := h.exists_eq_add_single
  · exact ⟨i, false, by rw [hi]; rfl⟩
  · refine ⟨i, true, ?_⟩
    show y' = y + Pi.single i (-1)
    rw [Pi.single_neg, ← sub_eq_add_neg, hi, add_sub_cancel_right]

/-- The similarity `z ↦ s y + s O z` (`O = signedSwap 0 i neg`) maps `e₁` to `s (y ± e_i)`. -/
theorem latPt_add_smul_signedSwap_e₁ {s : ℝ} (y : Zd d) (i₀ i : Fin d) (hi₀ : (i₀ : ℕ) = 0)
    (neg : Bool) :
    latPt s y + s • signedSwap i₀ i neg (e₁ d) = latPt s (nbr y i neg) := by
  ext l
  rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, signedSwap_apply, e₁_ofLp, latPt_apply,
    latPt_apply, nbr]
  have hsw : ((Equiv.swap i₀ i l : Fin d) : ℕ) = 0 ↔ l = i := by
    constructor
    · intro h
      have h' : Equiv.swap i₀ i l = i₀ := Fin.ext (by rw [h, hi₀])
      rw [Equiv.swap_apply_eq_iff, Equiv.swap_apply_left] at h'
      exact h'
    · rintro rfl
      rw [Equiv.swap_apply_right, hi₀]
  by_cases hl : l = i
  · subst hl
    simp only [hsw, Pi.add_apply, Pi.single_eq_same, ite_true, true_and]
    cases neg <;> simp <;> ring
  · have h1 : ¬ ((Equiv.swap i₀ i l : Fin d) : ℕ) = 0 := fun h => hl (hsw.1 h)
    simp only [h1, hl, false_and, ite_false, Pi.add_apply, Pi.single_eq_of_ne hl, add_zero,
      mul_zero]

/-- The similarity `z ↦ s y + s O z` maps the cube `U` onto the box `obox (s y) (2 s)`. -/
theorem preimage_obox_signedSwap {s : ℝ} (hs : 0 < s) (y : Zd d) (i₀ i : Fin d) (neg : Bool) :
    (fun z => latPt s y + s • signedSwap i₀ i neg z) ⁻¹' obox (latPt s y) (2 * s) = cube d := by
  ext z
  simp only [mem_preimage, obox, mem_ofPred_eq, cube, PiLp.add_apply, PiLp.smul_apply,
    smul_eq_mul, add_sub_cancel_left, abs_mul, abs_of_pos hs, abs_signedSwap_apply]
  constructor
  · intro h l
    have := h (Equiv.swap i₀ i l)
    rw [Equiv.swap_apply_self] at this
    nlinarith
  · intro h l
    nlinarith [h (Equiv.swap i₀ i l)]

/-- The frozen LFPP distance is Borel measurable on `C(ℝ^d, ℝ)`. -/
theorem measurable_lfppDistance_continuousMap (ξ : ℝ) :
    Measurable fun f : C(Rd d, ℝ) => lfppDistance d ξ f := by
  simp_rw [lfppDistance_eq_lfppDistOn]
  exact measurable_lfppDistOn_continuousMap (isOpen_cube d) ξ 0 (e₁ d)

variable {κ : Rd d → ℝ} {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
  {P : Measure Ω} {P' : Measure Ω'} {W : WN d → Ω → ℝ} {W' : WN d → Ω' → ℝ}

/-- **DGZ (3.23)** (HA5 D9, D14): the internal distance of the band field `H = H_{a,c}` from `s y`
to a lattice neighbour inside `obox (s y) (2 s)` has the law of `s D^ξ(H')`, `H'` any continuous
version of `H_{a/s,c/s}`: `P[… > s b] = P'[D^ξ(H') > b]`. -/
theorem measure_lt_lfppDistOn_nbr (hκ : IsLFPPKernel κ) (hW : IsWhiteNoise P W)
    (hW' : IsWhiteNoise P' W') {a c : ℝ} (ha : 0 < a) {H : Rd d → Ω → ℝ}
    {H' : Rd d → Ω' → ℝ} (hH : IsBandVersion P W κ a c H) {s : ℝ} (hs : 0 < s)
    (hH' : IsBandVersion P' W' κ (a / s) (c / s) H') (ξ b : ℝ) (y : Zd d) (i : Fin d)
    (neg : Bool) :
    P {ω | s * b < lfppDistOn ξ (fun z => H z ω) (obox (latPt s y) (2 * s)) (latPt s y)
        (latPt s (nbr y i neg))} =
      P' {ω | b < lfppDistance d ξ (fun z => H' z ω)} := by
  have hd : 0 < d := Fin.pos i
  set i₀ : Fin d := ⟨0, hd⟩ with hi₀
  set O := signedSwap i₀ i neg with hO
  set c₀ := latPt s y with hc₀
  have hT0 : c₀ + s • O 0 = c₀ := by rw [map_zero, smul_zero, add_zero]
  have hT1 : c₀ + s • O (e₁ d) = latPt s (nbr y i neg) :=
    latPt_add_smul_signedSwap_e₁ y i₀ i rfl neg
  have key : ∀ ω, lfppDistOn ξ (fun z => H z ω) (obox c₀ (2 * s)) c₀ (latPt s (nbr y i neg)) =
      s * lfppDistance d ξ (fun z => H (c₀ + s • O z) ω) := by
    intro ω
    have h := lfppDistOn_sim O c₀ hs ξ (fun z => H z ω) (obox c₀ (2 * s)) 0 (e₁ d)
    rw [hT0, hT1, preimage_obox_signedSwap hs y i₀ i neg, ← lfppDistance_eq_lfppDistOn] at h
    exact h
  have hset : {ω | s * b < lfppDistOn ξ (fun z => H z ω) (obox c₀ (2 * s)) c₀
      (latPt s (nbr y i neg))} =
      {ω | (lfppDistance d ξ fun z => H (c₀ + s • O z) ω) ∈ Ioi b} := by
    ext ω
    simp only [mem_ofPred_eq, key, mem_Ioi]
    exact mul_lt_mul_iff_right₀ hs
  rw [hset]
  have h := (hH.comp_sim hκ O c₀ hs ha).measure_comp_mem_eq hH' (hW.comp_simL2 O c₀ hs) hW'
    (measurable_lfppDistance_continuousMap ξ) (measurableSet_Ioi (a := b))
  exact h

/-- **Probability of a closed site** (DGZ (3.23), HA5 D9): if `D^ξ(H') ≤ b` with probability at
least `p` for a continuous version `H'` of `H_{a/s,c/s}`, then every site is closed with
probability at most `2d(1 - p)`. -/
theorem measure_closedSite_le (hκ : IsLFPPKernel κ) (hW : IsWhiteNoise P W)
    (hW' : IsWhiteNoise P' W') {a c : ℝ} (ha : 0 < a) {H : Rd d → Ω → ℝ}
    {H' : Rd d → Ω' → ℝ} (hH : IsBandVersion P W κ a c H) {s : ℝ} (hs : 0 < s)
    (hH' : IsBandVersion P' W' κ (a / s) (c / s) H') {ξ b : ℝ} {p : ℝ≥0∞}
    (hb : p ≤ P' {ω | lfppDistance d ξ (fun z => H' z ω) ≤ b}) (ϱ : ℝ) (y : Zd d) :
    P (closedSite ξ H s b ϱ y) ≤ 2 * d * (1 - p) := by
  have := hW'.isProbabilityMeasure
  have hD' : Measurable fun ω => lfppDistance d ξ (fun z => H' z ω) :=
    hH'.measurable_lfppDistance ξ
  have hone : P' {ω | b < lfppDistance d ξ (fun z => H' z ω)} ≤ 1 - p := by
    have e : {ω | b < lfppDistance d ξ (fun z => H' z ω)} =
        {ω | lfppDistance d ξ (fun z => H' z ω) ≤ b}ᶜ := by
      ext ω; simp only [mem_ofPred_eq, mem_compl_iff, not_le]
    rw [e, prob_compl_eq_one_sub (measurableSet_le hD' measurable_const)]
    exact tsub_le_tsub_left hb 1
  have hsub : closedSite ξ H s b ϱ y ⊆ ⋃ i : Fin d, ⋃ neg : Bool, {ω | s * b <
      lfppDistOn ξ (fun z => H z ω) (obox (latPt s y) (2 * s)) (latPt s y)
        (latPt s (nbr y i neg))} := by
    rintro ω ⟨-, y', hyy', hlt⟩
    obtain ⟨i, neg, rfl⟩ := exists_eq_nbr hyy'
    exact mem_iUnion.2 ⟨i, mem_iUnion.2 ⟨neg, hlt⟩⟩
  calc P (closedSite ξ H s b ϱ y)
      ≤ P (⋃ i : Fin d, ⋃ neg : Bool, {ω | s * b < lfppDistOn ξ (fun z => H z ω)
          (obox (latPt s y) (2 * s)) (latPt s y) (latPt s (nbr y i neg))}) := measure_mono hsub
    _ ≤ ∑ i : Fin d, ∑ neg : Bool, P {ω | s * b < lfppDistOn ξ (fun z => H z ω)
          (obox (latPt s y) (2 * s)) (latPt s y) (latPt s (nbr y i neg))} :=
        (measure_iUnion_fintype_le _ _).trans
          (Finset.sum_le_sum fun i _ => measure_iUnion_fintype_le _ _)
    _ = ∑ _i : Fin d, ∑ _neg : Bool, P' {ω | b < lfppDistance d ξ (fun z => H' z ω)} := by
        simp_rw [measure_lt_lfppDistOn_nbr hκ hW hW' ha hH hs hH' ξ b y]
    _ ≤ ∑ _i : Fin d, ∑ _neg : Bool, (1 - p) :=
        Finset.sum_le_sum fun _ _ => Finset.sum_le_sum fun _ _ => hone
    _ = 2 * d * (1 - p) := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_bool, Fintype.card_fin,
          nsmul_eq_mul]
        push_cast
        ring

/-- **Probability of a closed site, quantile form** (HA5 D3, D9): with `b` the lower `p`-quantile of
the law of `D^ξ(H')` (`LQGMetric.lowerQuantile`), every site is closed with probability at most
`2d(1 - p)`. -/
theorem measure_closedSite_le_lowerQuantile (hκ : IsLFPPKernel κ) (hW : IsWhiteNoise P W)
    (hW' : IsWhiteNoise P' W') {a c : ℝ} (ha : 0 < a) {H : Rd d → Ω → ℝ}
    {H' : Rd d → Ω' → ℝ} (hH : IsBandVersion P W κ a c H) {s : ℝ} (hs : 0 < s)
    (hH' : IsBandVersion P' W' κ (a / s) (c / s) H') (ξ : ℝ) {p : ℝ≥0∞} (hp0 : 0 < p)
    (hp1 : p < 1) (ϱ : ℝ) (y : Zd d) :
    P (closedSite ξ H s (LQGMetric.lowerQuantile
        (P'.map fun ω => lfppDistance d ξ (fun z => H' z ω)) p) ϱ y) ≤ 2 * d * (1 - p) := by
  have := hW'.isProbabilityMeasure
  have hD' : Measurable fun ω => lfppDistance d ξ (fun z => H' z ω) :=
    hH'.measurable_lfppDistance ξ
  have : IsProbabilityMeasure (P'.map fun ω => lfppDistance d ξ (fun z => H' z ω)) :=
    inferInstance
  refine measure_closedSite_le hκ hW hW' ha hH hs hH' ?_ ϱ y
  have h := (LQGMetric.le_measure_Iic_iff_lowerQuantile_le
    (μ := P'.map fun ω => lfppDistance d ξ (fun z => H' z ω)) hp0 hp1).2 le_rfl
  rw [Measure.map_apply hD' measurableSet_Iic] at h
  exact h

/-- **Probability of a closed site, DGZ's band** (`c = s`: the fine field is a version of `H_{a,s}`
and `H'` a version of `H_{a/s,1}`, e.g. `a = 2^{-n}`, `s = 2^{-m-k}`, `H'` the field `h_{n-m-k}`):
with `b` the lower `p`-quantile of `D^ξ(H')`, every site is closed with probability at most
`2d(1 - p)`. -/
theorem measure_closedSite_le_lowerQuantile_of_band (hκ : IsLFPPKernel κ)
    (hW : IsWhiteNoise P W) (hW' : IsWhiteNoise P' W') {a : ℝ} (ha : 0 < a)
    {H : Rd d → Ω → ℝ} {H' : Rd d → Ω' → ℝ} {s : ℝ} (hs : 0 < s)
    (hH : IsBandVersion P W κ a s H) (hH' : IsBandVersion P' W' κ (a / s) 1 H') (ξ : ℝ)
    {p : ℝ≥0∞} (hp0 : 0 < p) (hp1 : p < 1) (ϱ : ℝ) (y : Zd d) :
    P (closedSite ξ H s (LQGMetric.lowerQuantile
        (P'.map fun ω => lfppDistance d ξ (fun z => H' z ω)) p) ϱ y) ≤ 2 * d * (1 - p) := by
  have hH'' : IsBandVersion P' W' κ (a / s) (s / s) H' := by rw [div_self hs.ne']; exact hH'
  exact measure_closedSite_le_lowerQuantile hκ hW hW' ha hH hs hH'' ξ hp0 hp1 ϱ y

/-! ### Finite-range dependence: the product bound -/

/-- **The product bound** (DGZ's `M`-dependence, HA5 D9 and D14): for a continuous version `H` of
`H_{a,c}` (`0 < a`, `c ≤ s`) and a support radius `ρ` of `κ`, the closed-site events satisfy
`Perc.ProductBound` with range `M = ⌈2(2 + ρ)⌉`: for sites pairwise at lattice `ℓ^∞`-distance `> M`,
`P(⋂ closed) = ∏ P(closed)`. -/
theorem productBound_closedSite (hκ : IsLFPPKernel κ) (hW : IsWhiteNoise P W) {ρ : ℝ}
    (hρ : ∀ y, ρ ≤ ‖y‖ → κ y = 0) {a c : ℝ} (ha : 0 < a) {H : Rd d → Ω → ℝ}
    (hH : IsBandVersion P W κ a c H) {s : ℝ} (hs : 0 < s) (hcs : c ≤ s) (ξ b ϱ : ℝ) :
    ProductBound P (closedSite ξ H s b ϱ) ((⌈2 * (2 + ρ)⌉₊ : ℕ) : ℤ) := by
  intro S hS
  set M : ℕ := ⌈2 * (2 + ρ)⌉₊ with hMdef
  have hρ0 : 0 < ρ := hκ.radius_pos hρ
  have hM : 2 * (2 + ρ) ≤ (M : ℝ) := Nat.le_ceil _
  set A : S → Set (Rd d) := fun x => cbox (latPt s x) (2 * s) with hA
  have hfar : ∀ x₁ x₂ : S, x₁ ≠ x₂ → ∀ z ∈ A x₁, ∀ w ∈ A x₂, 2 * ρ * c ≤ ‖z - w‖ := by
    intro x₁ x₂ hne z hz w hw
    have hnot := hS x₁ x₁.2 x₂ x₂.2 fun h => hne (Subtype.ext h)
    simp only [WithinInf, not_forall, not_le] at hnot
    obtain ⟨l, hl⟩ := hnot
    have hl1 : (M : ℤ) + 1 ≤ |(x₁ : Zd d) l - (x₂ : Zd d) l| := hl
    have hl' : (M : ℝ) + 1 ≤ |((x₁ : Zd d) l : ℝ) - ((x₂ : Zd d) l : ℝ)| := by
      exact_mod_cast hl1
    have h1 := hz l
    have h2 := hw l
    rw [latPt_apply] at h1 h2
    have h3 : |s * ((x₁ : Zd d) l : ℝ) - s * ((x₂ : Zd d) l : ℝ)| ≤
        |z l - s * ((x₁ : Zd d) l : ℝ)| + |z l - w l| + |w l - s * ((x₂ : Zd d) l : ℝ)| := by
      have e : s * ((x₁ : Zd d) l : ℝ) - s * ((x₂ : Zd d) l : ℝ) =
          -(z l - s * ((x₁ : Zd d) l : ℝ)) + (z l - w l) + (w l - s * ((x₂ : Zd d) l : ℝ)) := by
        ring
      rw [e]
      refine (abs_add_le _ _).trans (add_le_add_left ((abs_add_le _ _).trans ?_) _)
      rw [abs_neg]
    have h4 : |s * ((x₁ : Zd d) l : ℝ) - s * ((x₂ : Zd d) l : ℝ)| =
        s * |((x₁ : Zd d) l : ℝ) - ((x₂ : Zd d) l : ℝ)| := by
      rw [← mul_sub, abs_mul, abs_of_pos hs]
    have h5 := abs_apply_le_norm (z - w) l
    rw [PiLp.sub_apply] at h5
    nlinarith
  have hind := hH.iIndepFun_restrict_of_far hW hκ hρ ha A hfar
  have hmeas : ∀ x : S, MeasurableSet[MeasurableSpace.comap (fun ω (z : A x) => H z ω)
      MeasurableSpace.pi] (closedSite ξ H s b ϱ x) :=
    fun x => measurableSet_closedSite_comap hH.continuous hs ξ b ϱ x
  have h := hind.meas_iInter (s := fun x : S => closedSite ξ H s b ϱ x) hmeas
  have e : (⋂ x ∈ S, closedSite ξ H s b ϱ x) = ⋂ x : S, closedSite ξ H s b ϱ x := by
    ext ω
    simp only [mem_iInter, Subtype.forall]
  rw [e, h, Finset.prod_coe_sort S fun x => P (closedSite ξ H s b ϱ x)]

/-! ### Target T2 for the site model -/

/-- **Target T2 for the site model, DGZ's parameters** (`θ = n^{2/3}`, `k = ⌊(log m)²⌋`,
`8 ≤ m ≤ n`): `lfppDistance_le_of_good_exp` with the open sites of the fine field `φ₂`. -/
theorem lfppDistance_le_of_good_sites_exp (hd : 0 < d) {n m k : ℕ} (hm : 8 ≤ m) (hmn : m ≤ n)
    (hk : k = ⌊Real.log m ^ 2⌋₊) {ξ S a b : ℝ} (hξ : 0 ≤ ξ) {φ₀ φ₁ φ₂ : Rd d → ℝ}
    (h₀ : Continuous φ₀) (h₁ : Continuous φ₁) (h₂ : Continuous φ₂)
    (hosc : ∀ x : Zd d, latPt ((2 : ℝ)⁻¹ ^ m) x ∈ cube d →
      ∀ z ∈ cbox (latPt ((2 : ℝ)⁻¹ ^ m) x) (3 * (2 : ℝ)⁻¹ ^ m),
        |φ₀ z - φ₀ (latPt ((2 : ℝ)⁻¹ ^ m) x)| ≤ (n : ℝ) ^ (2 / 3 : ℝ))
    (hsup : ∀ z ∈ cube d, φ₁ z ≤ S)
    {P : ℝ → Rd d} (hP : IsAdmissiblePath d P) (hPa : lfppLength ξ φ₀ P ≤ 2 * a)
    (hdiam : ∀ C, IsClosedCluster
        {y | ¬ SiteClosed ξ φ₂ ((2 : ℝ)⁻¹ ^ (m + k)) b (2 - (2 : ℝ)⁻¹ ^ (m + 3)) y} C →
      (∃ z ∈ C, WithinInf ((2 ^ (m + k + 1) : ℕ) : ℤ) z 0) →
      ∀ y ∈ C, ∀ y' ∈ C, WithinInf ((2 ^ (k - 2) : ℕ) : ℤ) y y')
    (h0 : ¬ SiteClosed ξ φ₂ ((2 : ℝ)⁻¹ ^ (m + k)) b (2 - (2 : ℝ)⁻¹ ^ (m + 3)) 0)
    (h1 : ¬ SiteClosed ξ φ₂ ((2 : ℝ)⁻¹ ^ (m + k)) b (2 - (2 : ℝ)⁻¹ ^ (m + 3))
      (latE1 d (2 ^ (m + k))))
    (hencl0 : ∀ C, IsClosedCluster
        {y | ¬ SiteClosed ξ φ₂ ((2 : ℝ)⁻¹ ^ (m + k)) b (2 - (2 : ℝ)⁻¹ ^ (m + 3)) y} C →
      ¬ Encloses C 0)
    (hencl1 : ∀ C, IsClosedCluster
        {y | ¬ SiteClosed ξ φ₂ ((2 : ℝ)⁻¹ ^ (m + k)) b (2 - (2 : ℝ)⁻¹ ^ (m + 3)) y} C →
      ¬ Encloses C (latE1 d (2 ^ (m + k)))) :
    lfppDistance d ξ (fun z => φ₀ z + φ₁ z + φ₂ z) ≤
      Real.exp ((14 * d + 1 + 2 * ξ) * (n : ℝ) ^ (2 / 3 : ℝ) + ξ * S) * a * b :=
  lfppDistance_le_of_good_exp hd hm hmn hk hξ h₀ h₁ h₂ hosc hsup hP hPa _
    (fun _ hy hreg _ hyy' => lfppDistOn_le_of_not_siteClosed hy hreg hyy') hdiam h0 h1 hencl0
    hencl1

end DGZ

