import LatticeProb.Bonanno.LQGMetric.Field.LQGMeasureFieldMeasurable

/-!
# Measurable versions of the γ-LQG area measure over an ambient σ-algebra

`LatticeProb.exists_measurable_version_of_lqgArea` takes the sub-σ-algebra `m` of the field as an explicit binder,
which shadows the ambient instance `[MeasurableSpace Ω]`: there the probability measure `P` and the predicate
`IsLQGAreaOf` are elaborated on `m`. This file states the same theorem with the ambient σ-algebra `mΩ` kept separate
from the sub-σ-algebra `m`. The measure `P` lives on `mΩ`, the circle averages are measurable for `m`, and the
conclusion is an `m`-measurable random measure which agrees with the area measure `P`-almost surely.

The proof is that of `exists_measurable_version_of_lqgArea` with the instances made explicit. No relation between `m`
and `mΩ` is needed: the measurability of the vague limit is a statement about `m` alone, and the almost sure
statements are taken for `P` on `mΩ`.
-/

noncomputable section
open MeasureTheory Filter Topology Set Metric
open scoped ENNReal NNReal
open MatedCRTHarmonic.GMSLemma27

namespace LatticeProb

/-- **Measurable version of the γ-LQG area measure over an ambient σ-algebra.** Let `mΩ` be the ambient σ-algebra of
`Ω`, let `P` be a probability measure on it, and let `m ⊆ mΩ` be a sub-σ-algebra (in applications, the σ-algebra
generated by the field). Let `H ε z ω` be circle averages of a whole-plane Gaussian free field such that, at each
dyadic radius `ε = 2^{-k}`, the map `(ω, z) ↦ H ε z ω` is jointly `m ⊗ 𝓑(ℂ)`-measurable, and such that for `P`-almost
every `ω` the map `z ↦ H ε z ω` is continuous for every dyadic `ε`. If `μ` is the γ-LQG area measure of `H` under `P`
(`IsLQGAreaOf`: the almost sure vague limit of the approximations `ε^{γ²/2} e^{γ h_ε(z)} dz`), then `μ` agrees
`P`-almost surely with an `m`-measurable random measure (Duplantier–Sheffield, arXiv:0808.1560v2, Proposition 1.1,
p. 5; the measurable choice of vague limits is `VagueWholePlane.exists_measurable_vagueLimit`). -/
theorem exists_measurable_version_of_lqgArea_ambient {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (m : MeasurableSpace Ω) (P : @Measure Ω mΩ) (γ : ℝ) (H : ℝ → ℂ → Ω → ℝ) (μ : Ω → Measure ℂ)
    (hH : ∀ k : ℕ, Measurable[m.prod (inferInstance : MeasurableSpace ℂ)]
      (Function.uncurry fun ω z => H (dyadicRadius k) z ω))
    (hHc : ∀ᵐ ω ∂P, ∀ k : ℕ, Continuous fun z => H (dyadicRadius k) z ω)
    (hμ : @IsLQGAreaOf Ω mΩ γ H μ P) :
    ∃ μ' : Ω → Measure ℂ, Measurable[m] μ' ∧ ∀ᵐ ω ∂P, μ' ω = μ ω := by
  have hd : ∀ k : ℕ, Measurable[m.prod (inferInstance : MeasurableSpace ℂ)]
      (Function.uncurry fun ω z => dyadicRadius k ^ (γ ^ 2 / 2) * Real.exp (γ * H (dyadicRadius k) z ω)) :=
    fun k => measurable_const.mul (Real.measurable_exp.comp (measurable_const.mul (hH k)))
  have hd0 : ∀ k : ℕ, ∀ ω z, 0 ≤ dyadicRadius k ^ (γ ^ 2 / 2) * Real.exp (γ * H (dyadicRadius k) z ω) :=
    fun k ω z => mul_nonneg (Real.rpow_nonneg (by unfold dyadicRadius; positivity) _) (Real.exp_pos _).le
  have hν : ∀ k : ℕ, Measurable[m] fun ω => lqgApprox γ H k ω := fun k =>
    measurable_withDensity_ofReal_uncurry (mΩ := m) (hd k)
  have hint : ∀ (k : ℕ) (f : ℂ → ℝ), Continuous f → HasCompactSupport f →
      Measurable[m] fun ω => ∫ z, f z ∂(lqgApprox γ H k ω) := fun k f hf _ =>
    measurable_integral_withDensity_ofReal_uncurry (mΩ := m) (hd k) (hd0 k) hf.measurable
  obtain ⟨μ', hμ'm, hμ'⟩ := VagueWholePlane.exists_measurable_vagueLimit (mΩ := m)
    (fun k ω => lqgApprox γ H k ω) hν hint
  refine ⟨μ', hμ'm, ?_⟩
  filter_upwards [hHc, hμ] with ω hc hω
  obtain ⟨hloc, hconv⟩ := hω
  have := hloc
  refine hμ' ω (μ ω) (fun K hK => Eventually.of_forall fun k => ?_) ⟨by simp, fun K hK _ => hK.measure_lt_top,
    fun f hf hfc _ => hconv f hf hfc⟩
  exact withDensity_ofReal_lt_top_of_continuous
    (continuous_const.mul (Real.continuous_exp.comp (continuous_const.mul (hc k)))) hK

end LatticeProb
