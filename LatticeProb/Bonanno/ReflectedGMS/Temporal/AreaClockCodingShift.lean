/-! ## The weighted fixed-environment mixture on the coding -/

/-- The σ-finite fixed-environment path measure `𝕢 = ∑_v a_v ℙ^v` of `p:eq:sigmapath`, on the
càdlàg coding.  No finiteness of the total weight. -/
noncomputable def weightedPathMixture {ι : Type*} (a : ι → ℝ≥0∞)
    (P : ι → Measure (CadlagPath S)) : Measure (CadlagPath S) :=
  Measure.sum fun v => a v • P v

/-- **The fixed-environment hypothesis of `p:lem:timeMTP`**, abstractly: the weighted
mixture is invariant under every real time shift, and each `P v` starts at its label. -/
def IsShiftInvariantMixture {ι : Type*} (a : ι → ℝ≥0∞) (P : ι → Measure (CadlagPath S))
    (label : ι → S) : Prop :=
  (∀ r : ℝ, MeasurePreserving (timeShift r) (weightedPathMixture a P) (weightedPathMixture a P))
    ∧ ∀ v, ∀ᵐ ω ∂P v, ω.toFun 0 = label v

