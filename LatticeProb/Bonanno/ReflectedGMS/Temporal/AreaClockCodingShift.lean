section Bridge

variable {G : ConductanceGraph V} {rate : V → ℝ} {hmin : G.EnergyMinimizer}
  {PF : ProcessFamily V}

/-- **The coded area mixture is invariant under every real time shift, and each coded law
starts at its vertex.**  From finite-dimensional agreement with the two-sided process and
detailed balance at every time. -/
theorem isShiftInvariantMixture_of_codedTwoSidedLaw [Countable S]
    (h : IsReflectedWalk G rate hmin PF) (w : V → ℝ)
    (hrev : ∀ (t : ℝ≥0) (x y : V),
      ENNReal.ofReal (w x) * PF.transition x t y = ENNReal.ofReal (w y) * PF.transition y t x)
    (code : Option V → S) (hcode : Function.Injective code)
    (P : V → Measure (CadlagPath S)) (hP : CodedTwoSidedLaw PF code P) :
    IsShiftInvariantMixture (fun v => ENNReal.ofReal (w v)) P fun v => code (some v) := by
  classical
  set Q := weightedPathMixture (fun v => ENNReal.ofReal (w v)) P with hQ
  -- the start
  have hstart : ∀ v, ∀ᵐ ω ∂P v, ω.toFun 0 = code (some v) := by
    intro v
    have huniv : P v univ = 1 := by
      have := hP v ∅ (fun _ => 0) (fun _ => code none)
      have hl : {ω : CadlagPath S | ∀ q ∈ (∅ : Finset ℚ), ω.toFun ((fun _ => (0 : ℝ)) q) =
          (fun _ => code none) q} = univ := by
        ext ω
        simp
      have hr : codedCyl PF code ∅ (fun _ => 0) (fun _ => code none) = univ := by
        ext ω
        simp [codedCyl]
      rw [hl, hr, measure_univ (μ := twoSidedStartLaw PF v)] at this
      exact this
    haveI : IsProbabilityMeasure (P v) := ⟨huniv⟩
    have hmeas : MeasurableSet {ω : CadlagPath S | ω.toFun 0 = code (some v)} :=
      (measurable_eval 0) (measurableSet_singleton _)
    have hone : P v {ω : CadlagPath S | ω.toFun 0 = code (some v)} = 1 := by
      have := hP v {0} (fun _ => 0) (fun _ => code (some v))
      have hl : {ω : CadlagPath S | ∀ q ∈ ({0} : Finset ℚ), ω.toFun ((fun _ => (0 : ℝ)) q) =
          (fun _ => code (some v)) q} = {ω : CadlagPath S | ω.toFun 0 = code (some v)} := by
        ext ω
        simp
      have hr : codedCyl PF code {0} (fun _ => 0) (fun _ => code (some v)) =
          {ω₁ : PF.Ω | PF.X 0 ω₁ = some v} ×ˢ (univ : Set PF.Ω) := by
        ext ω
        simp [codedCyl, twoSidedReal, hcode.eq_iff]
      rw [hl, hr, twoSidedStartLaw, Measure.prod_prod, measure_univ, mul_one] at this
      rw [this]
      have hm0 : MeasurableSet {ω : PF.Ω | PF.X 0 ω = some v} :=
        PF.measurable_X 0 (measurableSet_singleton _)
      have hc : PF.P v {ω : PF.Ω | PF.X 0 ω = some v}ᶜ = 0 := by
        rw [compl_setOf]
        exact ae_iff.1 (h v).1
      exact (prob_compl_eq_zero_iff hm0).1 hc
    rw [ae_iff]
    have hc : {ω : CadlagPath S | ¬ ω.toFun 0 = code (some v)} =
        {ω : CadlagPath S | ω.toFun 0 = code (some v)}ᶜ := rfl
    rw [hc]
    exact (prob_compl_eq_zero_iff hmeas).2 hone
  refine ⟨fun r => ?_, hstart⟩
  refine measurePreserving_timeShift_of_ratEval_law Q r ?_
  -- identify the two σ-finite laws on `ℚ → S`
  have hF : Measurable fun ω : CadlagPath S => fun q : ℚ => ω.toFun ((q : ℝ) + r) :=
    measurable_pi_iff.2 fun q => measurable_eval ((q : ℝ) + r)
  have hcyl : ∀ (J : Finset ℚ) (s : ℚ → S),
      Q.map (fun ω : CadlagPath S => fun q : ℚ => ω.toFun ((q : ℝ) + r)) (ptCyl J s) =
        Q.map ratEval (ptCyl J s) := by
    intro J s
    rw [Measure.map_apply hF (measurableSet_ptCyl J s),
      Measure.map_apply measurable_ratEval (measurableSet_ptCyl J s)]
    have h1 : (fun ω : CadlagPath S => fun q : ℚ => ω.toFun ((q : ℝ) + r)) ⁻¹' ptCyl J s =
        {ω : CadlagPath S | ∀ q ∈ J, ω.toFun ((fun q : ℚ => (q : ℝ) + r) q) = s q} := rfl
    have h2 : ratEval ⁻¹' ptCyl J s =
        {ω : CadlagPath S | ∀ q ∈ J, ω.toFun ((fun q : ℚ => (q : ℝ)) q) = s q} := rfl
    rw [h1, h2, hQ, weightedPathMixture_pathCyl PF code P hP w,
      weightedPathMixture_pathCyl PF code P hP w,
      twoSidedSpeedLaw_codedCyl_shift h w hrev code hcode J s r]
  haveI : Nonempty S := ⟨code none⟩
  obtain ⟨enum, henum⟩ := exists_surjective_nat S
  refine Measure.ext_of_generateFrom_of_iUnion ptCyls (fun n => ptCyl {0} fun _ => enum n)
    generateFrom_ptCyls.symm isPiSystem_ptCyls ?_ (fun n => ⟨{0}, fun _ => enum n, rfl⟩) ?_ ?_
  · refine eq_univ_of_forall fun ξ => ?_
    obtain ⟨n, hn⟩ := henum (ξ 0)
    exact mem_iUnion.2 ⟨n, fun q hq => by rw [Finset.mem_singleton.1 hq, hn]⟩
  · intro n
    rw [hcyl, Measure.map_apply measurable_ratEval (measurableSet_ptCyl _ _)]
    have h2 : ratEval ⁻¹' ptCyl {0} (fun _ => enum n) =
        {ω : CadlagPath S | ∀ q ∈ ({0} : Finset ℚ), ω.toFun ((fun q : ℚ => (q : ℝ)) q) =
          (fun _ => enum n) q} := rfl
    rw [h2, hQ, weightedPathMixture_pathCyl PF code P hP w]
    exact twoSidedSpeedLaw_codedCyl_singleton_ne_top h w hrev code hcode 0 _ (enum n)
  · rintro _ ⟨J, s, rfl⟩
    exact hcyl J s

end Bridge

/-! ## The area clock -/

/-- **The area instance.**  For the area-speed reflected process, any family of coded laws
with its two-sided finite-dimensional distributions has a real-time shift-invariant
area mixture `∑_v a_v P v`, each `P v` starting at `v` — the fixed-environment input
`IsShiftInvariantMixture` of `sum_mul_lintegral_pathNumerator_eq`, unconditional except for
the coded law itself. -/
theorem isShiftInvariantMixture_cellArea [Countable S] {G : ConductanceGraph V}
    {hmin : G.EnergyMinimizer} {PF : ProcessFamily V} (F : IndexedCells V) (hF : Geometry F)
    (h : IsReflectedWalk G (fun v => G.pi v / StatementIngredients.cellArea F v) hmin PF)
    (hG : G.toSimpleGraph.Connected) (code : Option V → S) (hcode : Function.Injective code)
    (P : V → Measure (CadlagPath S)) (hP : CodedTwoSidedLaw PF code P) :
    IsShiftInvariantMixture (fun v => ENNReal.ofReal (StatementIngredients.cellArea F v)) P
      fun v => code (some v) :=
  isShiftInvariantMixture_of_codedTwoSidedLaw h _
    (fun t x y => ofReal_mul_transition_comm PF _ (cellArea_nonneg F)
      (AreaReversibility.processTransitionReversible_cellArea F hF h hG t) x y)
    code hcode P hP

