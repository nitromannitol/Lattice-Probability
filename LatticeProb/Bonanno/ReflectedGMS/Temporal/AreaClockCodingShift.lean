/-! ## Coded cylinders of the two-sided process -/

/-- The coded two-sided cylinder `{code (X_{τ q}) = s q for all q ∈ J}`. -/
def codedCyl (PF : ProcessFamily V) (code : Option V → S) (J : Finset ℚ) (τ : ℚ → ℝ)
    (s : ℚ → S) : Set (PF.Ω × PF.Ω) :=
  {ω | ∀ q ∈ J, code (twoSidedReal PF ω (τ q)) = s q}

theorem measurableSet_codedCyl (PF : ProcessFamily V) (code : Option V → S) (J : Finset ℚ)
    (τ : ℚ → ℝ) (s : ℚ → S) : MeasurableSet (codedCyl PF code J τ s) := by
  have hset : codedCyl PF code J τ s = ⋂ q ∈ (J : Set ℚ),
      (fun ω => twoSidedReal PF ω (τ q)) ⁻¹' (code ⁻¹' {s q}) := by
    ext ω
    simp [codedCyl]
  rw [hset]
  exact MeasurableSet.biInter J.countable_toSet fun q _ =>
    measurable_twoSidedReal PF (τ q) (measurableSet_option _)

section Process

variable {G : ConductanceGraph V} {rate : V → ℝ} {hmin : G.EnergyMinimizer}
  {PF : ProcessFamily V}

/-- The two-sided path is a.s. at a vertex at every fixed real time, also for the σ-finite
weighted mixture. -/
theorem twoSidedSpeedLaw_twoSidedReal_none (h : IsReflectedWalk G rate hmin PF) (w : V → ℝ)
    (t : ℝ) : twoSidedSpeedLaw PF w {ω | twoSidedReal PF ω t = none} = 0 := by
  have hmeas : MeasurableSet {ω : PF.Ω × PF.Ω | twoSidedReal PF ω t = none} :=
    measurable_twoSidedReal PF t (measurableSet_option {none})
  rw [twoSidedSpeedLaw_apply PF w hmeas]
  refine ENNReal.tsum_eq_zero.2 fun z => ?_
  rw [twoSidedStartLaw]
  by_cases ht : 0 ≤ t
  · have hset : {ω : PF.Ω × PF.Ω | twoSidedReal PF ω t = none} =
        {ω₁ | PF.X t.toNNReal ω₁ = none} ×ˢ (univ : Set PF.Ω) := by
      ext ω
      simp [twoSidedReal, ht]
    rw [hset, Measure.prod_prod, measure_none_eq_zero (h z).2.1, zero_mul, mul_zero]
  · have hset : {ω : PF.Ω × PF.Ω | twoSidedReal PF ω t = none} =
        (univ : Set PF.Ω) ×ˢ {ω₂ | PF.X (-t).toNNReal ω₂ = none} := by
      ext ω
      simp [twoSidedReal, ht]
    rw [hset, Measure.prod_prod, measure_none_eq_zero (h z).2.1, mul_zero, mul_zero]

/-- **Real-time shift invariance of coded two-sided cylinders.**  Prescribed codes outside the
vertex codes give null cylinders; otherwise the cylinder is a real-time vertex cylinder and
`twoSidedSpeedLaw_realCyl_shift` applies. -/
theorem twoSidedSpeedLaw_codedCyl_shift (h : IsReflectedWalk G rate hmin PF) (w : V → ℝ)
    (hrev : ∀ (t : ℝ≥0) (x y : V),
      ENNReal.ofReal (w x) * PF.transition x t y = ENNReal.ofReal (w y) * PF.transition y t x)
    (code : Option V → S) (hcode : Function.Injective code) (J : Finset ℚ) (s : ℚ → S)
    (r : ℝ) :
    twoSidedSpeedLaw PF w (codedCyl PF code J (fun q => (q : ℝ) + r) s) =
      twoSidedSpeedLaw PF w (codedCyl PF code J (fun q => (q : ℝ)) s) := by
  classical
  by_cases hall : ∀ q ∈ J, ∃ x : V, s q = code (some x)
  · choose! g hg using hall
    let g' : ℝ → V := Function.extend (fun q : ℚ => (q : ℝ)) g fun _ => g 0
    have hg' : ∀ q : ℚ, g' (q : ℝ) = g q := fun q =>
      (Rat.cast_injective (α := ℝ)).extend_apply g _ q
    have hset : ∀ r' : ℝ, codedCyl PF code J (fun q => (q : ℝ) + r') s =
        {ω | ∀ i ∈ J.image (fun q : ℚ => (q : ℝ)), twoSidedReal PF ω (i + r') = some (g' i)} := by
      intro r'
      ext ω
      simp only [codedCyl, mem_setOf_eq, Finset.forall_mem_image, hg']
      refine forall₂_congr fun q hq => ?_
      rw [hg q hq]
      exact hcode.eq_iff
    have h0 := hset 0
    simp only [add_zero] at h0
    rw [hset r, h0]
    exact twoSidedSpeedLaw_realCyl_shift h w hrev _ g' r
  · push_neg at hall
    obtain ⟨q, hq, hne⟩ := hall
    have hsub : ∀ r' : ℝ, codedCyl PF code J (fun q => (q : ℝ) + r') s ⊆
        {ω | twoSidedReal PF ω ((q : ℝ) + r') = none} := by
      intro r' ω hω
      have hcq := hω q hq
      simp only [mem_setOf_eq]
      cases hX : twoSidedReal PF ω ((q : ℝ) + r') with
      | none => rfl
      | some x =>
          rw [hX] at hcq
          exact absurd hcq.symm (hne x)
    have h0 := hsub 0
    simp only [add_zero] at h0
    have e1 : twoSidedSpeedLaw PF w (codedCyl PF code J (fun q => (q : ℝ) + r) s) = 0 :=
      measure_mono_null (hsub r) (twoSidedSpeedLaw_twoSidedReal_none h w _)
    have e2 : twoSidedSpeedLaw PF w (codedCyl PF code J (fun q => (q : ℝ)) s) = 0 :=
      measure_mono_null h0 (twoSidedSpeedLaw_twoSidedReal_none h w _)
    rw [e1, e2]

/-- A one-time coded cylinder has finite weighted mass (at most one weight). -/
theorem twoSidedSpeedLaw_codedCyl_singleton_ne_top (h : IsReflectedWalk G rate hmin PF)
    (w : V → ℝ)
    (hrev : ∀ (t : ℝ≥0) (x y : V),
      ENNReal.ofReal (w x) * PF.transition x t y = ENNReal.ofReal (w y) * PF.transition y t x)
    (code : Option V → S) (hcode : Function.Injective code) (q : ℚ) (τ : ℚ → ℝ) (c : S) :
    twoSidedSpeedLaw PF w (codedCyl PF code {q} τ fun _ => c) ≠ ∞ := by
  classical
  by_cases hc : ∃ x : V, c = code (some x)
  · obtain ⟨x, rfl⟩ := hc
    have hset : codedCyl PF code {q} τ (fun _ => code (some x)) =
        realCyl PF {τ q} fun _ => x := by
      ext ω
      simp only [codedCyl, realCyl, mem_setOf_eq, Finset.mem_singleton, forall_eq]
      exact hcode.eq_iff
    rw [hset, twoSidedSpeedLaw_realCyl_singleton h w hrev]
    exact ENNReal.ofReal_ne_top
  · push_neg at hc
    have hsub : codedCyl PF code {q} τ (fun _ => c) ⊆ {ω | twoSidedReal PF ω (τ q) = none} := by
      intro ω hω
      have hcq := hω q (Finset.mem_singleton_self q)
      simp only [mem_setOf_eq]
      cases hX : twoSidedReal PF ω (τ q) with
      | none => rfl
      | some x =>
          rw [hX] at hcq
          exact absurd hcq.symm (hc x)
    have e1 : twoSidedSpeedLaw PF w (codedCyl PF code {q} τ fun _ => c) = 0 :=
      measure_mono_null hsub (twoSidedSpeedLaw_twoSidedReal_none h w _)
    rw [e1]
    exact ENNReal.zero_ne_top

end Process

/-! ## Coded laws and their weighted mixture -/

/-- **Finite-dimensional agreement of a family of coded laws with the two-sided process**: at
any finitely many real times, `P v` has the law of the coded two-sided process from `v`. -/
def CodedTwoSidedLaw (PF : ProcessFamily V) (code : Option V → S)
    (P : V → Measure (CadlagPath S)) : Prop :=
  ∀ (v : V) (J : Finset ℚ) (τ : ℚ → ℝ) (s : ℚ → S),
    P v {ω | ∀ q ∈ J, ω.toFun (τ q) = s q} = twoSidedStartLaw PF v (codedCyl PF code J τ s)

theorem measurableSet_pathCyl (J : Finset ℚ) (τ : ℚ → ℝ) (s : ℚ → S) :
    MeasurableSet {ω : CadlagPath S | ∀ q ∈ J, ω.toFun (τ q) = s q} := by
  have hset : {ω : CadlagPath S | ∀ q ∈ J, ω.toFun (τ q) = s q} =
      ⋂ q ∈ (J : Set ℚ), (fun ω : CadlagPath S => ω.toFun (τ q)) ⁻¹' {s q} := by
    ext ω
    simp
  rw [hset]
  exact MeasurableSet.biInter J.countable_toSet fun q _ =>
    measurable_eval (τ q) (measurableSet_singleton _)

/-- The weighted coded mixture of a cylinder is the weighted two-sided law of the coded
cylinder. -/
theorem weightedPathMixture_pathCyl (PF : ProcessFamily V) (code : Option V → S)
    (P : V → Measure (CadlagPath S)) (hP : CodedTwoSidedLaw PF code P) (w : V → ℝ)
    (J : Finset ℚ) (τ : ℚ → ℝ) (s : ℚ → S) :
    weightedPathMixture (fun v => ENNReal.ofReal (w v)) P
        {ω | ∀ q ∈ J, ω.toFun (τ q) = s q} =
      twoSidedSpeedLaw PF w (codedCyl PF code J τ s) := by
  rw [weightedPathMixture, Measure.sum_apply _ (measurableSet_pathCyl J τ s),
    twoSidedSpeedLaw_apply PF w (measurableSet_codedCyl PF code J τ s)]
  refine tsum_congr fun v => ?_
  rw [Measure.smul_apply, smul_eq_mul, hP v J τ s]

/-! ## Point cylinders on `ℚ → S` -/

/-- The point cylinder `{ξ | ξ q = s q for all q ∈ J}` on rational-time paths. -/
def ptCyl (J : Finset ℚ) (s : ℚ → S) : Set (ℚ → S) := {ξ | ∀ q ∈ J, ξ q = s q}

/-- The π-system of point cylinders. -/
def ptCyls : Set (Set (ℚ → S)) := {A | ∃ (J : Finset ℚ) (s : ℚ → S), A = ptCyl J s}

theorem measurableSet_ptCyl (J : Finset ℚ) (s : ℚ → S) : MeasurableSet (ptCyl J s) := by
  have hset : ptCyl J s = ⋂ q ∈ (J : Set ℚ), (fun ξ : ℚ → S => ξ q) ⁻¹' {s q} := by
    ext ξ
    simp [ptCyl]
  rw [hset]
  exact MeasurableSet.biInter J.countable_toSet fun q _ =>
    measurable_pi_apply q (measurableSet_singleton _)

theorem isPiSystem_ptCyls : IsPiSystem (ptCyls (S := S)) := by
  classical
  rintro _ ⟨J₁, s₁, rfl⟩ _ ⟨J₂, s₂, rfl⟩ ⟨ξ₀, hξ₁, hξ₂⟩
  refine ⟨J₁ ∪ J₂, fun q => if q ∈ J₁ then s₁ q else s₂ q, ?_⟩
  ext ξ
  simp only [ptCyl, mem_inter_iff, mem_setOf_eq, Finset.mem_union]
  constructor
  · rintro ⟨h₁, h₂⟩ q hq
    by_cases hq₁ : q ∈ J₁
    · rw [if_pos hq₁]
      exact h₁ q hq₁
    · rw [if_neg hq₁]
      exact h₂ q (hq.resolve_left hq₁)
  · intro hξ
    refine ⟨fun q hq => ?_, fun q hq => ?_⟩
    · have := hξ q (Or.inl hq)
      rwa [if_pos hq] at this
    · have := hξ q (Or.inr hq)
      by_cases hq₁ : q ∈ J₁
      · rw [if_pos hq₁] at this
        rw [this, ← hξ₁ q hq₁, hξ₂ q hq]
      · rwa [if_neg hq₁] at this

theorem generateFrom_ptCyls [Countable S] :
    MeasurableSpace.generateFrom (ptCyls (S := S)) = MeasurableSpace.pi := by
  refine le_antisymm (MeasurableSpace.generateFrom_le ?_) ?_
  · rintro _ ⟨J, s, rfl⟩
    exact measurableSet_ptCyl J s
  · refine iSup_le fun q => ?_
    refine MeasurableSpace.comap_le_iff_le_map.2 fun A _ => ?_
    change MeasurableSet[MeasurableSpace.generateFrom ptCyls] ((fun ξ : ℚ → S => ξ q) ⁻¹' A)
    have hset : (fun ξ : ℚ → S => ξ q) ⁻¹' A = ⋃ a ∈ A, ptCyl {q} fun _ => a := by
      ext ξ
      simp [ptCyl]
    rw [hset]
    exact MeasurableSet.biUnion A.to_countable fun a _ =>
      MeasurableSpace.measurableSet_generateFrom ⟨{q}, fun _ => a, rfl⟩

