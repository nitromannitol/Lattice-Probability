/- Adapted from Leonardo Bonanno's lean-formalizations (https://github.com/leobon12/lean-formalizations),
   source module ReflectedGMS.Forms.LaplaceMeasureUniqueness at commit fdb5cad; only the module paths of local imports are changed. -/
import Mathlib.MeasureTheory.Measure.FiniteMeasureExt

/-!
# Uniqueness from integer Laplace moments

Finite Borel measures on `ℝ≥0` are determined by their Laplace transforms at
the nonnegative integers.  The proof applies finite-measure extensionality to
the star subalgebra generated by `t ↦ exp (-t)`.
-/

set_option autoImplicit false

open MeasureTheory
open scoped NNReal BoundedContinuousFunction

namespace ReflectedGMS

private noncomputable def expNeg : ℝ≥0 →ᵇ ℝ :=
  BoundedContinuousFunction.ofNormedAddCommGroup
    (fun t : ℝ≥0 => Real.exp (-(t : ℝ)))
    (Real.continuous_exp.comp continuous_subtype_val.neg) 1 fun t => by
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact (Real.exp_le_one_iff.mpr (neg_nonpos.mpr t.2))

private theorem expNeg_apply (t : ℝ≥0) : expNeg t = Real.exp (-(t : ℝ)) := rfl

private theorem expNeg_pow_apply (n : ℕ) (t : ℝ≥0) :
    (expNeg ^ n) t = Real.exp (-(n : ℝ) * (t : ℝ)) := by
  rw [BoundedContinuousFunction.pow_apply, expNeg_apply, ← Real.exp_nat_mul]
  congr 1
  ring

/-- Two finite Borel measures on `ℝ≥0` with the same integer Laplace moments
are equal.  The zeroth moment records equality of total mass. -/
theorem measure_eq_of_integral_exp_neg_nat_mul_eq
    (μ ν : Measure ℝ≥0) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ n : ℕ,
      (∫ t : ℝ≥0, Real.exp (-(n : ℝ) * (t : ℝ)) ∂μ) =
        ∫ t : ℝ≥0, Real.exp (-(n : ℝ) * (t : ℝ)) ∂ν) :
    μ = ν := by
  let A : StarSubalgebra ℝ (ℝ≥0 →ᵇ ℝ) :=
    { Algebra.adjoin ℝ ({expNeg} : Set (ℝ≥0 →ᵇ ℝ)) with
      star_mem' := by
        intro f hf
        have hstar : star f = f := by
          ext t
          simp only [BoundedContinuousFunction.star_apply, star_trivial]
        rw [hstar]
        exact hf }
  apply ext_of_forall_mem_subalgebra_integral_eq_of_polish
      (A := A) (P := μ) (P' := ν)
  · intro x y hxy
    refine ⟨(BoundedContinuousFunction.toContinuousMapStarₐ ℝ) expNeg, ?_, ?_⟩
    · refine ⟨(BoundedContinuousFunction.toContinuousMapStarₐ ℝ) expNeg, ?_, rfl⟩
      refine ⟨expNeg, ?_, rfl⟩
      change expNeg ∈ Algebra.adjoin ℝ ({expNeg} : Set (ℝ≥0 →ᵇ ℝ))
      exact Algebra.subset_adjoin (Set.mem_singleton expNeg)
    · simp only [BoundedContinuousFunction.toContinuousMapStarₐ_apply_apply, expNeg_apply]
      intro heq
      have : (x : ℝ) = (y : ℝ) := by
        apply neg_injective
        exact Real.exp_injective heq
      exact hxy (NNReal.eq this)
  · intro g hg
    change g ∈ Algebra.adjoin ℝ ({expNeg} : Set (ℝ≥0 →ᵇ ℝ)) at hg
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hg
    obtain ⟨p, rfl⟩ := hg
    change (∫ x : ℝ≥0,
      (Polynomial.eval₂ (algebraMap ℝ (ℝ≥0 →ᵇ ℝ)) expNeg p) x ∂μ) =
        ∫ x : ℝ≥0,
          (Polynomial.eval₂ (algebraMap ℝ (ℝ≥0 →ᵇ ℝ)) expNeg p) x ∂ν
    rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def]
    have hsum (s : Finset ℕ) (x : ℝ≥0) :
        (∑ n ∈ s,
          (algebraMap ℝ (ℝ≥0 →ᵇ ℝ)) (p.coeff n) * expNeg ^ n) x =
          ∑ n ∈ s, p.coeff n * (expNeg ^ n) x := by
      induction s using Finset.induction_on with
      | empty => simp
      | @insert n s hns ih =>
        simp only [Finset.sum_insert hns, BoundedContinuousFunction.add_apply, ih,
          BoundedContinuousFunction.mul_apply, BoundedContinuousFunction.algebraMap_apply,
          smul_eq_mul, mul_one]
    simp_rw [hsum p.support]
    rw [integral_finsetSum, integral_finsetSum]
    · congr with n
      rw [integral_const_mul, integral_const_mul]
      exact congrArg (fun z => p.coeff n * z) (by
        simpa only [expNeg_pow_apply] using h n)
    · intro n hn
      exact Integrable.const_mul (BoundedContinuousFunction.integrable ν (expNeg ^ n)) _
    · intro n hn
      exact Integrable.const_mul (BoundedContinuousFunction.integrable μ (expNeg ^ n)) _

end ReflectedGMS
