import LatticeProb.Prob.PerStepHistoryTrial
import LatticeProb.Topology.MeasurableSegmentBall
import LatticeProb.Topology.RealFirstExitClock
import LatticeProb.Prob.BrownianOpenExitStopping

/-!
# Nested exit trials observed from a stopped curve

For a continuous curve `w : ℝ → E` started at a time `t₀`, the `i`-th nested exit trial asks
that some ball of radius `a` lie in the trace of `w` between its first exits, after `t₀`, from
the concentric balls of radii `r i` and `r (i + 1)`.

* `measurableSet_nestedExitTrialEvent`: the trial event is measurable whenever the curve and
  the start time are measurable.
* `measurableSet_exit_inter_nestedExitTrialEvent_of_stopped`: if both radii are at most `ρ`,
  then on the event that the curve leaves `ball z ρ` after `t₀`, the trial is determined by
  the start time, the first exit time `T` from `ball z ρ` and the curve stopped at `T`.
* `nestedExitTrialEvent_mem_completed_stopped_history`: when that exit occurs almost surely,
  the trial event lies in the completion of the σ-algebra generated by this observation.
* `measureReal_firstExitTrace_failure_le_floor_inv_of_completed_stopped_history`: for
  nondecreasing radii, conditional success bounds given histories that contain these completed
  stopped-curve histories yield the inverse-scale exponential bound for the failure of the
  first-exit trace.
-/

set_option autoImplicit false

open MeasureTheory Set Metric
open scoped NNReal ENNReal

namespace LatticeProb

/-- A curve indexed by the real line, stopped at the time `T`. -/
def realStoppedCurve {E : Type*} [TopologicalSpace E] (T : ℝ) (w : C(ℝ, E)) : C(ℝ, E) :=
  w.comp ⟨fun t => min t T, continuous_id.min continuous_const⟩

@[simp] theorem realStoppedCurve_apply {E : Type*} [TopologicalSpace E] (T : ℝ) (w : C(ℝ, E))
    (t : ℝ) : realStoppedCurve T w t = w (min t T) := rfl

/-- Two sets of reals that contain `T`, are bounded below and agree below `T` have the same
infimum. -/
theorem csInf_eq_of_mem_of_agree_le {S₁ S₂ : Set ℝ} {T : ℝ} (h₁ : T ∈ S₁) (h₂ : T ∈ S₂)
    (hb₁ : BddBelow S₁) (hb₂ : BddBelow S₂) (h : ∀ x ≤ T, x ∈ S₁ ↔ x ∈ S₂) :
    sInf S₁ = sInf S₂ := by
  apply le_antisymm
  · refine le_csInf ⟨T, h₂⟩ fun x hx => ?_
    rcases le_or_gt x T with hxT | hxT
    · exact csInf_le hb₁ ((h x hxT).2 hx)
    · exact (csInf_le hb₁ h₁).trans hxT.le
  · refine le_csInf ⟨T, h₁⟩ fun x hx => ?_
    rcases le_or_gt x T with hxT | hxT
    · exact csInf_le hb₂ ((h x hxT).1 hx)
    · exact (csInf_le hb₂ h₂).trans hxT.le

/-- If a continuous curve leaves an open set after `t₀`, the first such time is attained. -/
theorem sInf_outside_mem {E : Type*} [TopologicalSpace E] {w : ℝ → E} (hw : Continuous w)
    {U : Set E} (hU : IsOpen U) {t₀ : ℝ} (hne : ∃ t, t₀ ≤ t ∧ w t ∉ U) :
    sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ U} ∈ {t : ℝ | t₀ ≤ t ∧ w t ∉ U} := by
  have hc : IsClosed {t : ℝ | t₀ ≤ t ∧ w t ∉ U} :=
    (isClosed_le continuous_const continuous_id).inter (hU.isClosed_compl.preimage hw)
  exact hc.csInf_mem hne ⟨t₀, fun _ ht => ht.1⟩

/-- Stopping a curve at its first exit `T` after `t₀` from `ball z ρ` does not change its first
exit after `t₀` from a concentric ball of radius at most `ρ`, and that exit occurs by `T`. -/
theorem sInf_outside_realStoppedCurve_ball {E : Type*} [PseudoMetricSpace E] (w : C(ℝ, E))
    (t₀ : ℝ) (z : E) {ρ r' : ℝ} (hr : r' ≤ ρ) (hne : ∃ t, t₀ ≤ t ∧ w t ∉ ball z ρ) :
    sInf {t : ℝ | t₀ ≤ t ∧
        realStoppedCurve (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ}) w t ∉ ball z r'} =
      sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z r'} ∧
    sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z r'} ≤ sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ} := by
  have hT := sInf_outside_mem w.continuous isOpen_ball hne
  have hT1 : sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ} ∈ {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z r'} :=
    ⟨hT.1, fun h => hT.2 (ball_subset_ball hr h)⟩
  refine ⟨csInf_eq_of_mem_of_agree_le ?_ hT1 ⟨t₀, fun _ ht => ht.1⟩ ⟨t₀, fun _ ht => ht.1⟩ ?_,
    csInf_le ⟨t₀, fun _ ht => ht.1⟩ hT1⟩
  · refine ⟨hT1.1, ?_⟩
    rw [realStoppedCurve_apply, min_self]
    exact hT1.2
  · intro x hx
    simp only [mem_ofPred_eq, realStoppedCurve_apply, min_eq_left hx]

/-- On a curve that leaves `ball z ρ` after `t₀`, a nested exit trial with radii at most `ρ`
is unchanged by stopping the curve at that exit. -/
theorem exists_ball_subset_realStoppedCurve_trace_iff {E : Type*} [PseudoMetricSpace E]
    (w : C(ℝ, E)) (t₀ : ℝ) (z : E) (r : ℕ → ℝ) (a : ℝ) {ρ : ℝ} (i : ℕ) (hi : r i ≤ ρ)
    (hi1 : r (i + 1) ≤ ρ) (hne : ∃ t, t₀ ≤ t ∧ w t ∉ ball z ρ) :
    (∃ x, ball x a ⊆ realStoppedCurve (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ}) w '' Icc
        (sInf {t : ℝ | t₀ ≤ t ∧
          realStoppedCurve (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ}) w t ∉ ball z (r i)})
        (sInf {t : ℝ | t₀ ≤ t ∧
          realStoppedCurve (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ}) w t ∉
            ball z (r (i + 1))})) ↔
      ∃ x, ball x a ⊆ w '' Icc (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z (r i)})
        (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z (r (i + 1))}) := by
  obtain ⟨h0, -⟩ := sInf_outside_realStoppedCurve_ball w t₀ z hi hne
  obtain ⟨h1, hle⟩ := sInf_outside_realStoppedCurve_ball w t₀ z hi1 hne
  rw [h0, h1]
  have himage : realStoppedCurve (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z ρ}) w '' Icc
      (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z (r i)})
      (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z (r (i + 1))}) =
      w '' Icc (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z (r i)})
        (sInf {t : ℝ | t₀ ≤ t ∧ w t ∉ ball z (r (i + 1))}) := by
    refine Set.EqOn.image_eq fun t ht => ?_
    rw [realStoppedCurve_apply, min_eq_left (ht.2.trans hle)]
  rw [himage]

/-- For a positive radius, an open ball lies in the trace of a continuous curve on `[s, t]`
exactly when the segment is nonempty and the closed ball lies in that trace. -/
theorem exists_ball_subset_image_Icc_iff {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (w : C(ℝ, E)) {a : ℝ} (ha : 0 < a) (s t : ℝ) :
    (∃ x, ball x a ⊆ w '' Icc s t) ↔ s ≤ t ∧ 0 ≤ a ∧ ∃ x, closedBall x a ⊆ w '' Icc s t := by
  constructor
  · rintro ⟨x, hx⟩
    have hK : IsClosed (w '' Icc s t) := (isCompact_Icc.image w.continuous).isClosed
    obtain ⟨u, hu, -⟩ := hx (mem_ball_self ha)
    refine ⟨hu.1.trans hu.2, ha.le, x, ?_⟩
    rw [← closure_ball x ha.ne']
    exact closure_minimal hx hK
  · rintro ⟨-, -, x, hx⟩
    exact ⟨x, ball_subset_closedBall.trans hx⟩

variable {d : ℕ}

/-- The first exit time, after a measurable start time, of a measurable continuous curve from
an open set is measurable; it takes the value `0` on curves that do not exit after the start. -/
theorem measurable_sInf_outside {Ω : Type*} [MeasurableSpace Ω]
    {g : Ω → C(ℝ, EuclideanSpace ℝ (Fin d))} {t₀ : Ω → ℝ} (hg : Measurable g)
    (ht₀ : Measurable t₀) {U : Set (EuclideanSpace ℝ (Fin d))} (hU : IsOpen U) :
    Measurable fun ω => sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ U} := by
  classical
  let τ : Ω → ℝ≥0∞ := fun ω => openExitTime (fun s (_ : Unit) => g ω (t₀ ω + (s : ℝ))) U ()
  have hτ : Measurable τ := by
    apply measurable_openExitTime (B := fun s ω => g ω (t₀ ω + (s : ℝ)))
    · intro s
      exact (ContinuousEval.continuous_eval.measurable.comp
        (hg.prodMk (ht₀.add_const (s : ℝ)))).stronglyMeasurable
    · intro ω
      exact (g ω).continuous.comp (continuous_const.add NNReal.continuous_coe)
    · exact hU
  have heq : (fun ω => sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ U}) =
      fun ω => if τ ω = ⊤ then 0 else t₀ ω + ((τ ω).toNNReal : ℝ) := by
    funext ω
    split_ifs with h
    · have hemp : {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ U} = ∅ := by
        ext t
        simp only [mem_ofPred_eq, mem_empty_iff_false, iff_false]
        rintro ⟨ht0, htU⟩
        have hsum : t₀ ω + (((t - t₀ ω).toNNReal : ℝ≥0) : ℝ) = t := by
          rw [Real.coe_toNNReal _ (sub_nonneg.2 ht0)]
          ring
        have hle : τ ω ≤ (((t - t₀ ω).toNNReal : ℝ≥0) : ℝ≥0∞) :=
          openExitTime_le_of_not_mem (B := fun s (_ : Unit) => g ω (t₀ ω + (s : ℝ)))
            (U := U) (ω := ()) (by show g ω (t₀ ω + _) ∉ U; rw [hsum]; exact htU)
        rw [h] at hle
        exact absurd hle (not_le.2 ENNReal.coe_lt_top)
      rw [hemp, Real.sInf_empty]
    · exact sInf_outside_eq_forward_openExitTime (g ω) U (t₀ ω) (g ω).continuous hU h
  rw [heq]
  exact Measurable.ite (hτ (measurableSet_singleton ⊤)) measurable_const
    (ht₀.add (NNReal.continuous_coe.measurable.comp (ENNReal.measurable_toNNReal.comp hτ)))

/-- The nested exit trial of a measurable continuous curve after a measurable start time is
measurable. -/
theorem measurableSet_nestedExitTrialEvent {Ω : Type*} [MeasurableSpace Ω]
    {g : Ω → C(ℝ, EuclideanSpace ℝ (Fin d))} {t₀ : Ω → ℝ} (hg : Measurable g)
    (ht₀ : Measurable t₀) (z : EuclideanSpace ℝ (Fin d)) (r : ℕ → ℝ) {a : ℝ} (ha : 0 < a)
    (i : ℕ) :
    MeasurableSet (nestedExitTrialEvent (fun ω => ⇑(g ω)) t₀ z r a i) := by
  have h := measurableSet_exists_closedBall_subset_segment hg
    (measurable_sInf_outside hg ht₀ (isOpen_ball : IsOpen (ball z (r i))))
    (measurable_sInf_outside hg ht₀ (isOpen_ball : IsOpen (ball z (r (i + 1)))))
    (measurable_const : Measurable fun _ : Ω => a)
  convert h using 1
  ext ω
  exact exists_ball_subset_image_Icc_iff (g ω) ha _ _

/-- On the event that the curve leaves `ball z ρ` after the start time, every nested exit trial
with radii at most `ρ` is measurable for any σ-algebra making the start time, the first exit
time `T` from `ball z ρ` and the curve stopped at `T` measurable. -/
theorem measurableSet_exit_inter_nestedExitTrialEvent_of_stopped {Ω : Type*}
    [G : MeasurableSpace Ω] {g : Ω → C(ℝ, EuclideanSpace ℝ (Fin d))} {t₀ : Ω → ℝ}
    (z : EuclideanSpace ℝ (Fin d)) {ρ : ℝ} (r : ℕ → ℝ) {a : ℝ} (ha : 0 < a) {i : ℕ}
    (hi : r i ≤ ρ) (hi1 : r (i + 1) ≤ ρ) (ht₀ : Measurable t₀)
    (hT : Measurable fun ω => sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ})
    (hs : Measurable fun ω =>
      realStoppedCurve (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}) (g ω)) :
    MeasurableSet ({ω | ∃ t, t₀ ω ≤ t ∧ g ω t ∉ ball z ρ} ∩
      nestedExitTrialEvent (fun ω => ⇑(g ω)) t₀ z r a i) := by
  have hF : MeasurableSet ({ω | t₀ ω ≤ sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}} ∩
      {ω | realStoppedCurve (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}) (g ω)
        (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}) ∉ ball z ρ}) :=
    (measurableSet_le ht₀ hT).inter
      ((ContinuousEval.continuous_eval.measurable.comp (hs.prodMk hT))
        isOpen_ball.measurableSet.compl)
  have htrial := measurableSet_nestedExitTrialEvent hs ht₀ z r ha i
  convert hF.inter htrial using 1
  ext ω
  simp only [mem_inter_iff, mem_ofPred_eq]
  constructor
  · rintro ⟨hne, htr⟩
    have hT' := sInf_outside_mem (g ω).continuous isOpen_ball hne
    refine ⟨⟨hT'.1, ?_⟩, ?_⟩
    · rw [realStoppedCurve_apply, min_self]
      exact hT'.2
    · exact (exists_ball_subset_realStoppedCurve_trace_iff (g ω) (t₀ ω) z r a i hi hi1 hne).2
        htr
  · rintro ⟨⟨h0, h1⟩, htr⟩
    rw [realStoppedCurve_apply, min_self] at h1
    have hne : ∃ t, t₀ ω ≤ t ∧ g ω t ∉ ball z ρ := ⟨_, h0, h1⟩
    exact ⟨hne,
      (exists_ball_subset_realStoppedCurve_trace_iff (g ω) (t₀ ω) z r a i hi hi1 hne).1 htr⟩

/-- The σ-algebra generated by the start time, the first exit time from `ball z ρ` after the
start and the curve stopped at that exit contains, on the event of that exit, every nested exit
trial with radii at most `ρ`. -/
theorem measurableSet_comap_stopped_exit_inter_nestedExitTrialEvent {Ω : Type*}
    (g : Ω → C(ℝ, EuclideanSpace ℝ (Fin d))) (t₀ : Ω → ℝ) (z : EuclideanSpace ℝ (Fin d))
    {ρ : ℝ} (r : ℕ → ℝ) {a : ℝ} (ha : 0 < a) {i : ℕ} (hi : r i ≤ ρ) (hi1 : r (i + 1) ≤ ρ) :
    MeasurableSet[MeasurableSpace.comap (fun ω => (t₀ ω,
        sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ},
        realStoppedCurve (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}) (g ω))) inferInstance]
      ({ω | ∃ t, t₀ ω ≤ t ∧ g ω t ∉ ball z ρ} ∩
        nestedExitTrialEvent (fun ω => ⇑(g ω)) t₀ z r a i) := by
  let O : Ω → ℝ × ℝ × C(ℝ, EuclideanSpace ℝ (Fin d)) := fun ω => (t₀ ω,
    sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ},
    realStoppedCurve (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}) (g ω))
  have hO : Measurable[MeasurableSpace.comap O inferInstance] O := comap_measurable O
  exact measurableSet_exit_inter_nestedExitTrialEvent_of_stopped
    (G := MeasurableSpace.comap O inferInstance) z r ha hi hi1
    (measurable_fst.comp hO) (measurable_fst.comp (measurable_snd.comp hO))
    (measurable_snd.comp (measurable_snd.comp hO))

/-- If the curve almost surely leaves `ball z ρ` after the start time, every nested exit trial
with radii at most `ρ` lies in the completion of the σ-algebra generated by the start time,
the first exit time from `ball z ρ` and the curve stopped at that exit. -/
theorem nestedExitTrialEvent_mem_completed_stopped_history {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (g : Ω → C(ℝ, EuclideanSpace ℝ (Fin d))) (t₀ : Ω → ℝ)
    (z : EuclideanSpace ℝ (Fin d)) {ρ : ℝ} (r : ℕ → ℝ) {a : ℝ} (ha : 0 < a) {i : ℕ}
    (hi : r i ≤ ρ) (hi1 : r (i + 1) ≤ ρ)
    (hexit : ∀ᵐ ω ∂μ, ∃ t, t₀ ω ≤ t ∧ g ω t ∉ ball z ρ) :
    MeasurableSet[eventuallyMeasurableSpace (MeasurableSpace.comap (fun ω => (t₀ ω,
        sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ},
        realStoppedCurve (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z ρ}) (g ω))) inferInstance)
        (ae μ)]
      (nestedExitTrialEvent (fun ω => ⇑(g ω)) t₀ z r a i) := by
  refine ⟨_, measurableSet_comap_stopped_exit_inter_nestedExitTrialEvent g t₀ z r ha hi hi1,
    Filter.eventuallyEqSet_iff.2 ?_⟩
  filter_upwards [hexit] with ω hω
  exact ⟨fun h => ⟨hω, h⟩, fun h => h.2⟩


/-- Nested exit trials of a measurable continuous curve with nondecreasing radii up to `R`
yield the inverse-scale exponential bound for the failure of the first-exit trace from
`ball z R`, provided each trial succeeds with conditional probability at least `p` given a
history that contains the completed σ-algebra of the start time, the first exit time from the
inner ball of the trial and the curve stopped at that exit. -/
theorem measureReal_firstExitTrace_failure_le_floor_inv_of_completed_stopped_history
    {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
    (G : ℕ → MeasurableSpace Ω) {g : Ω → C(ℝ, EuclideanSpace ℝ (Fin d))} {t₀ : Ω → ℝ}
    (hg : Measurable g) (ht₀ : Measurable t₀) (z : EuclideanSpace ℝ (Fin d))
    {r : ℕ → ℝ} (hr : Monotone r) {R a C ε : ℝ} (ha : 0 < a)
    (hrR : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, r (k + 1) ≤ R)
    (hexit : ∀ᵐ ω ∂μ, ∃ t, t₀ ω ≤ t ∧ g ω t ∉ ball z R)
    (hG : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, G k ≤ m)
    (hGO : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1,
      eventuallyMeasurableSpace (MeasurableSpace.comap (fun ω => (t₀ ω,
        sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z (r k)},
        realStoppedCurve (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z (r k)}) (g ω)))
          inferInstance) (ae μ) ≤ G k)
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1)
    (hp : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, ∀ᵐ ω ∂μ,
      p ≤ μ[(nestedExitTrialEvent (fun ω => ⇑(g ω)) t₀ z r a k).indicator
        (fun _ => (1 : ℝ)) | G k] ω) :
    μ.real {ω | ¬ ∃ w, ball w a ⊆ g ω '' Icc (t₀ ω)
      (sInf {t : ℝ | t₀ ω ≤ t ∧ g ω t ∉ ball z R})} ≤
      Real.exp (p ^ 2) * Real.exp (-(p ^ 2 / 2) * (C * ε)⁻¹) := by
  have hrk : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, r k ≤ R := fun k hk =>
    (hr (Nat.le_succ k)).trans (hrR k hk)
  refine measureReal_firstExitTrace_failure_le_floor_inv_of_perStepHistory G
    (fun ω => ⇑(g ω)) t₀ z r R a C ε (fun k hk => ⟨hrk k hk, hrR k hk⟩) ?_ hG
    (fun k _ => measurableSet_nestedExitTrialEvent hg ht₀ z r ha k) ?_ hp0 hp1 hp
  · filter_upwards [hexit] with ω hω
    obtain ⟨t, ht0, htR⟩ := hω
    refine ⟨(g ω).continuous, ?_⟩
    have hsum : t₀ ω + (((t - t₀ ω).toNNReal : ℝ≥0) : ℝ) = t := by
      rw [Real.coe_toNNReal _ (sub_nonneg.2 ht0)]
      ring
    exact ne_top_of_le_ne_top ENNReal.coe_ne_top
      (openExitTime_le_of_not_mem (B := fun s (_ : Unit) => g ω (t₀ ω + (s : ℝ)))
        (U := ball z R) (ω := ()) (by show g ω (t₀ ω + _) ∉ ball z R; rw [hsum]; exact htR))
  · intro k hk i hi
    have hexitk : ∀ᵐ ω ∂μ, ∃ t, t₀ ω ≤ t ∧ g ω t ∉ ball z (r k) := by
      filter_upwards [hexit] with ω hω
      obtain ⟨t, ht0, htR⟩ := hω
      exact ⟨t, ht0, fun h => htR (ball_subset_ball (hrk k hk) h)⟩
    exact hGO k hk _ (nestedExitTrialEvent_mem_completed_stopped_history μ g t₀ z r ha
      (hr hi.le) (hr (Nat.succ_le_of_lt hi)) hexitk)

end LatticeProb
