import Mathlib.MeasureTheory.Measure.AEMeasurable

/-!
# Events measurable for a family of random variables, up to null sets

If two families of random variables `X i` and `Y i` agree almost surely coordinatewise, then every set measurable for the
σ-algebra generated by the `X i` is almost surely equal to a set measurable for the σ-algebra generated by the `Y i`.
The point is that no simultaneous null set is needed: a set of the generated σ-algebra depends on countably many
coordinates, and a countable union of null sets is null. This is what allows an event defined through an arbitrary family
of pairings of a random field to be transferred to a regular version of the field, which agrees with the pairings
almost surely for each test function separately.

## Main statement

* `LatticeProb.exists_measurableSet_ae_eq_iSup_comap`
-/

open MeasureTheory Filter

namespace LatticeProb

variable {Ω ι : Type*} {α : ι → Type*} [∀ i, MeasurableSpace (α i)]

/-- **Transfer of events between almost surely equal families.** Let `X Y` be two families of maps out of `Ω` with
`X i = Y i` almost surely for each index `i`. Every set `s` measurable for the σ-algebra generated by the `X i` is
almost surely equal to a set `t` measurable for the σ-algebra generated by the `Y i`. -/
theorem exists_measurableSet_ae_eq_iSup_comap {m0 : MeasurableSpace Ω} {P : Measure Ω}
    (X Y : ∀ i, Ω → α i) (hXY : ∀ i, X i =ᵐ[P] Y i) {s : Set Ω}
    (hs : MeasurableSet[⨆ i, MeasurableSpace.comap (X i) inferInstance] s) :
    ∃ t : Set Ω, MeasurableSet[⨆ i, MeasurableSpace.comap (Y i) inferInstance] t ∧ s =ᵐ[P] t := by
  let M : MeasurableSpace Ω := ⨆ i, MeasurableSpace.comap (Y i) inferInstance
  let G : MeasurableSpace Ω :=
    { MeasurableSet' := fun s => ∃ t : Set Ω, MeasurableSet[M] t ∧ s =ᵐ[P] t
      measurableSet_empty := ⟨∅, @MeasurableSet.empty Ω M, EventuallyEq.rfl⟩
      measurableSet_compl := fun s ⟨t, ht, hst⟩ => ⟨tᶜ, @MeasurableSet.compl Ω t M ht, hst.compl⟩
      measurableSet_iUnion := fun f hf => by
        choose t ht hft using hf
        exact ⟨⋃ n, t n, @MeasurableSet.iUnion Ω ℕ M _ t ht, Filter.EventuallyEqSet.countable_iUnion hft⟩ }
  have hle : (⨆ i, MeasurableSpace.comap (X i) inferInstance) ≤ G := by
    refine iSup_le fun i => ?_
    rintro _ ⟨A, hA, rfl⟩
    refine ⟨Y i ⁻¹' A, ?_, ?_⟩
    · exact le_iSup (fun i => MeasurableSpace.comap (Y i) inferInstance) i _ ⟨A, hA, rfl⟩
    · filter_upwards [hXY i] with ω hω
      show (X i ω ∈ A) = (Y i ω ∈ A)
      rw [hω]
  exact hle _ hs

end LatticeProb
