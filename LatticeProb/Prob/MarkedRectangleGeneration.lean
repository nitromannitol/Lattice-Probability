import Mathlib.MeasureTheory.MeasurableSpace.Prod
import Mathlib.MeasureTheory.MeasurableSpace.Pi
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

/-! Measurable marked finite-dimensional rectangles generate the product σ-algebra. -/

open Set MeasurableSpace

namespace LatticeProb

private theorem intervals_countably_spanning :
    IsCountablySpanning {s : Set ℝ | ∃ u v : ℝ, s = Ico u v} := by
  refine ⟨fun n : ℕ => Ico (-(n : ℝ)) (n : ℝ), ?_, ?_⟩
  · intro n
    exact ⟨_, _, rfl⟩
  · ext x
    simp only [mem_iUnion, mem_Ico, mem_univ, iff_true]
    obtain ⟨n, hn⟩ := exists_nat_gt |x|
    refine ⟨n, ?_, ?_⟩
    · have := neg_abs_le x
      linarith
    · exact lt_of_le_of_lt (le_abs_self x) hn

private theorem intervals_generate :
    generateFrom {s : Set ℝ | ∃ u v : ℝ, s = Ico u v} = (inferInstance : MeasurableSpace ℝ) := by
  apply le_antisymm
  · apply generateFrom_le
    rintro s ⟨u, v, rfl⟩
    exact measurableSet_Ico
  · change borel ℝ ≤ _
    rw [borel_eq_generateFrom_Ico ℝ]
    apply generateFrom_mono
    rintro s ⟨u, v, _, h⟩
    exact ⟨u, v, h.symm⟩

/-- The product σ-algebra on a measurable space and a finite real coordinate
space is generated by measurable marks times half-open boxes. -/
theorem generateFrom_marked_Ico_boxes {E ι : Type*} [MeasurableSpace E] [Finite ι] :
    generateFrom (Set.image2 (· ×ˢ ·) {s : Set E | MeasurableSet s}
      (Set.univ.pi '' Set.univ.pi (fun _ : ι =>
        {s : Set ℝ | ∃ u v : ℝ, s = Ico u v}))) =
      (inferInstance : MeasurableSpace (E × (ι → ℝ))) := by
  apply generateFrom_eq_prod generateFrom_measurableSet
  · exact generateFrom_eq_pi (fun _ => intervals_generate)
      (fun _ => intervals_countably_spanning)
  · exact isCountablySpanning_measurableSet
  · exact IsCountablySpanning.pi (fun _ => intervals_countably_spanning)

end LatticeProb
