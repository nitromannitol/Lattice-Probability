/-
Measurability of first hitting times, last zeros and up-crossing pieces on the space of
continuous paths.

On `C(ℝ≥0, ℝ)` with the Borel σ-algebra of the compact-open topology (which is the σ-algebra
generated by the evaluations), the evaluation at a random time `w ↦ w (τ w)` is measurable for a
measurable `τ`.  Consequently the set of paths that hit a level inside a random window
`[lo w, hi w]` is measurable (a countable-dense-set description of the minimum of `|w - a|` over
a compact interval), and so are the first hit of a level after a random time, the last zero before
a random time, the ends `d₁`, `d₂` and the start `g₁` of the first two up-crossing intervals, and
the pieces of the path on them.
-/
import Mathlib
import LatticeProb.Prob.UpcrossIntervals
import LatticeProb.Topology.ContinuousMapBorel

open MeasureTheory Set
open scoped ENNReal NNReal

noncomputable section

namespace LatticeProb

/-- The first hit time `≤ t` iff some `s ∈ [r, t]` has `w s = a` (continuous `w`). -/
lemma hitFrom_le_iff {w : ℝ≥0 → ℝ} (hw : Continuous w) {a : ℝ} {r : ℝ≥0∞} {t : ℝ≥0} :
    hitFrom a r w ≤ t ↔ ∃ s : ℝ≥0, r ≤ s ∧ s ≤ t ∧ w s = a := by
  constructor
  · intro h
    have hne : hitFrom a r w ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top h
    obtain ⟨s, hs, hrs, hws, -⟩ := exists_hitFrom_eq hw hne
    exact ⟨s, hrs, by rw [hs] at h; exact_mod_cast h, hws⟩
  · rintro ⟨s, hrs, hst, hws⟩
    exact (hitFrom_le hrs hws).trans (by exact_mod_cast hst)

/-- The evaluation of a continuous path at a random time is measurable. -/
lemma measurable_eval_comp {τ : C(ℝ≥0, ℝ) → ℝ≥0} (hτ : Measurable τ) :
    Measurable fun w : C(ℝ≥0, ℝ) => w (τ w) :=
  (continuous_eval : Continuous fun p : C(ℝ≥0, ℝ) × ℝ≥0 => p.1 p.2).measurable.comp
    (measurable_id.prodMk hτ)

/-- The set of continuous paths that take the value `a` somewhere in a random window
`[lo w, hi w]` is measurable. -/
lemma measurableSet_exists_window {lo hi : C(ℝ≥0, ℝ) → ℝ≥0} (hlo : Measurable lo)
    (hhi : Measurable hi) (a : ℝ) :
    MeasurableSet {w : C(ℝ≥0, ℝ) | ∃ s : ℝ≥0, lo w ≤ s ∧ s ≤ hi w ∧ w s = a} := by
  obtain ⟨D, hDc, hDd⟩ := TopologicalSpace.exists_countable_dense ℝ≥0
  have key : ∀ w : C(ℝ≥0, ℝ), (∃ s : ℝ≥0, lo w ≤ s ∧ s ≤ hi w ∧ w s = a) ↔
      lo w ≤ hi w ∧ ∀ n : ℕ, ∃ q ∈ D,
        |w (max (lo w) (min q (hi w))) - a| < 1 / ((n : ℝ) + 1) := by
    intro w
    constructor
    · rintro ⟨s, hls, hsh, hws⟩
      refine ⟨hls.trans hsh, fun n => ?_⟩
      have hcont : Continuous fun q : ℝ≥0 => |w (max (lo w) (min q (hi w))) - a| := by
        have h1 : Continuous fun q : ℝ≥0 => max (lo w) (min q (hi w)) :=
          continuous_const.max (continuous_id.min continuous_const)
        exact (((w.continuous).comp h1).sub continuous_const).abs
      have hopen : IsOpen {q : ℝ≥0 | |w (max (lo w) (min q (hi w))) - a| < 1 / ((n : ℝ) + 1)} :=
        isOpen_lt hcont continuous_const
      have hs : s ∈ {q : ℝ≥0 | |w (max (lo w) (min q (hi w))) - a| < 1 / ((n : ℝ) + 1)} := by
        show |w (max (lo w) (min s (hi w))) - a| < _
        rw [min_eq_left hsh, max_eq_right hls, hws, sub_self, abs_zero]
        positivity
      obtain ⟨q, hqD, hq⟩ := hDd.exists_mem_open hopen ⟨s, hs⟩
      exact ⟨q, hqD, hq⟩
    · rintro ⟨hlh, h⟩
      have hcf : Continuous fun s : ℝ≥0 => |w s - a| :=
        ((w.continuous).sub continuous_const).abs
      obtain ⟨s, hs, hmin⟩ :=
        isCompact_Icc.exists_isMinOn (nonempty_Icc.2 hlh) hcf.continuousOn
      refine ⟨s, hs.1, hs.2, ?_⟩
      by_contra hne
      have hpos : 0 < |w s - a| := abs_pos.2 (sub_ne_zero.2 hne)
      obtain ⟨n, hn⟩ := exists_nat_one_div_lt hpos
      obtain ⟨q, -, hq⟩ := h n
      have hmem : max (lo w) (min q (hi w)) ∈ Icc (lo w) (hi w) :=
        ⟨le_max_left _ _, max_le hlh (min_le_right _ _)⟩
      have := hmin hmem
      simp only [mem_ofPred_eq] at this
      linarith
  have hset : {w : C(ℝ≥0, ℝ) | ∃ s : ℝ≥0, lo w ≤ s ∧ s ≤ hi w ∧ w s = a} =
      {w | lo w ≤ hi w} ∩ ⋂ n : ℕ, ⋃ q ∈ D,
        {w : C(ℝ≥0, ℝ) | |w (max (lo w) (min q (hi w))) - a| < 1 / ((n : ℝ) + 1)} := by
    ext w
    simp only [mem_ofPred_eq, mem_inter_iff, mem_iInter, mem_iUnion, exists_prop]
    exact key w
  rw [hset]
  refine (measurableSet_le hlo hhi).inter
    (MeasurableSet.iInter fun n => MeasurableSet.biUnion hDc fun q _ => ?_)
  have hm : Measurable fun w : C(ℝ≥0, ℝ) => w (max (lo w) (min q (hi w))) :=
    measurable_eval_comp (hlo.max (measurable_const.min hhi))
  exact measurableSet_lt (continuous_abs.measurable.comp (hm.sub_const a)) measurable_const

/-- The first hit of `a` after a random time `r w` is measurable on continuous paths. -/
lemma measurable_hitFrom {r : C(ℝ≥0, ℝ) → ℝ≥0∞} (hr : Measurable r) (a : ℝ) :
    Measurable fun w : C(ℝ≥0, ℝ) => hitFrom a (r w) w := by
  refine measurable_of_Iic fun t => ?_
  by_cases ht : t = ⊤
  · simp [ht]
  · lift t to ℝ≥0 using ht
    have : (fun w : C(ℝ≥0, ℝ) => hitFrom a (r w) w) ⁻¹' Iic (t : ℝ≥0∞) =
        {w | r w ≤ t} ∩ {w | ∃ s : ℝ≥0, (r w).toNNReal ≤ s ∧ s ≤ t ∧ w s = a} := by
      ext w
      simp only [mem_preimage, mem_Iic, hitFrom_le_iff w.continuous, mem_inter_iff, mem_ofPred_eq]
      constructor
      · rintro ⟨s, hrs, hst, hws⟩
        have hrt : r w ≤ t := hrs.trans (by exact_mod_cast hst)
        have hrne : r w ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top hrt
        refine ⟨hrt, s, ?_, hst, hws⟩
        rw [← ENNReal.coe_le_coe, ENNReal.coe_toNNReal hrne]
        exact hrs
      · rintro ⟨hrt, s, hrs, hst, hws⟩
        have hrne : r w ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top hrt
        refine ⟨s, ?_, hst, hws⟩
        rw [← ENNReal.coe_toNNReal hrne]
        exact_mod_cast hrs
    rw [this]
    exact (measurableSet_le hr measurable_const).inter
      (measurableSet_exists_window hr.ennreal_toNNReal measurable_const a)

/-- The last zero before a random time is measurable on continuous paths. -/
lemma measurable_lastZeroBefore {hi : C(ℝ≥0, ℝ) → ℝ≥0} (hhi : Measurable hi) :
    Measurable fun w : C(ℝ≥0, ℝ) => lastZeroBefore w (hi w) := by
  refine measurable_of_Ici fun x => ?_
  rcases eq_or_ne x 0 with rfl | hx
  · simp
  · have : (fun w : C(ℝ≥0, ℝ) => lastZeroBefore w (hi w)) ⁻¹' Ici x =
        {w | ∃ s : ℝ≥0, x ≤ s ∧ s ≤ hi w ∧ w s = 0} := by
      ext w
      simp only [mem_preimage, mem_Ici, mem_ofPred_eq]
      constructor
      · intro h
        set S : Set ℝ≥0 := {s | s ≤ hi w ∧ w s = 0} with hS
        by_cases hne : S.Nonempty
        · have hcl : IsClosed S :=
            (isClosed_le continuous_id continuous_const).inter
              (isClosed_eq w.continuous continuous_const)
          have hmem : sSup S ∈ S := hcl.csSup_mem hne ⟨hi w, fun s hs => hs.1⟩
          exact ⟨sSup S, h, hmem.1, hmem.2⟩
        · exfalso
          rw [Set.not_nonempty_iff_eq_empty] at hne
          have h0 : lastZeroBefore w (hi w) = 0 := by
            unfold lastZeroBefore
            rw [← hS, hne]
            simp
          rw [h0] at h
          exact hx (le_zero_iff.1 h)
      · rintro ⟨s, hxs, hsh, hws⟩
        exact hxs.trans (le_csSup ⟨hi w, fun s hs => hs.1⟩ ⟨hsh, hws⟩)
    rw [this]
    exact measurableSet_exists_window measurable_const hhi 0

lemma measurable_upcrossEnd₁ (c : ℝ) : Measurable fun w : C(ℝ≥0, ℝ) => upcrossEnd₁ c w :=
  measurable_hitFrom (measurable_hitFrom (r := fun _ => 0) measurable_const 0) c

lemma measurable_upcrossEnd₂ (c : ℝ) : Measurable fun w : C(ℝ≥0, ℝ) => upcrossEnd₂ c w :=
  measurable_hitFrom (measurable_hitFrom (measurable_upcrossEnd₁ c) 0) c

lemma measurable_upcrossStart₁ (c : ℝ) : Measurable fun w : C(ℝ≥0, ℝ) => upcrossStart₁ c w :=
  measurable_lastZeroBefore (measurable_upcrossEnd₁ c).ennreal_toNNReal

/-- The piece of the path on a random interval `[g w, d w]`, as a path-valued map. -/
lemma measurable_pieceAt {g d : C(ℝ≥0, ℝ) → ℝ≥0} (hg : Measurable g) (hd : Measurable d) :
    Measurable fun w : C(ℝ≥0, ℝ) => pieceAt w (g w) (d w) :=
  measurable_pi_iff.2 fun s =>
    measurable_eval_comp (τ := fun w => min (g w + s) (d w)) ((hg.add_const s).min hd)

/-- The piece of the path on its first up-crossing interval `[g₁, d₁]`. -/
def firstUpcrossPiece (c : ℝ) (w : ℝ≥0 → ℝ) : ℝ≥0 → ℝ :=
  pieceAt w (upcrossStart₁ c w) (upcrossEnd₁ c w).toNNReal

lemma measurable_firstUpcrossPiece (c : ℝ) :
    Measurable fun w : C(ℝ≥0, ℝ) => firstUpcrossPiece c w :=
  measurable_pieceAt (measurable_upcrossStart₁ c) (measurable_upcrossEnd₁ c).ennreal_toNNReal

/-- The event that a continuous path has exactly one up-crossing interval ending in `[0, t]`
is measurable. -/
lemma measurableSet_existsUnique_upcross (c : ℝ) (hc : 0 < c) (t : ℝ≥0) :
    MeasurableSet {w : C(ℝ≥0, ℝ) |
      ∃! p : ℝ≥0 × ℝ≥0, IsUpcross c w p.1 p.2 ∧ p.2 ≤ t} := by
  have : {w : C(ℝ≥0, ℝ) | ∃! p : ℝ≥0 × ℝ≥0, IsUpcross c w p.1 p.2 ∧ p.2 ≤ t} =
      {w : C(ℝ≥0, ℝ) | upcrossEnd₁ c w ≤ t} ∩ {w : C(ℝ≥0, ℝ) | (t : ℝ≥0∞) < upcrossEnd₂ c w} := by
    ext w
    simp only [mem_ofPred_eq, mem_inter_iff]
    exact existsUnique_upcross_iff w.continuous hc t
  rw [this]
  exact (measurableSet_le (measurable_upcrossEnd₁ c) measurable_const).inter
    (measurableSet_lt measurable_const (measurable_upcrossEnd₂ c))

end LatticeProb
