import LatticeProb.Prob.AdaptedOfCondIndep
import LatticeProb.Prob.AEDetermined

/-!
# Past-measurable versions with standard Borel values

Conditional independence localizes a random variable from a larger σ-algebra to a smaller one.
For a standard Borel target this localization yields an almost surely equal measurable version,
including for random vectors.
-/

open MeasureTheory MeasurableSpace

namespace LatticeProb

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}
variable {G U V P : MeasurableSpace Ω}
variable {β : Type*} [mβ : MeasurableSpace β] [StandardBorelSpace β] [Nonempty β]

/-- A standard Borel-valued variable determined by the past and by a smaller σ-algebra together
with a conditionally independent complement has a version measurable for the smaller σ-algebra. -/
theorem exists_measurable_ae_eq_of_condIndepEv_past_standardBorel
    [IsProbabilityMeasure μ] {Y : Ω → β}
    (hGU : G ≤ U) (hUP : U ≤ P) (hP : P ≤ mΩ) (hV : V ≤ mΩ)
    (h : CondIndepEv G V P μ)
    (hYP : AELeSigma (MeasurableSpace.comap Y mβ) P μ)
    (hYUV : AELeSigma (MeasurableSpace.comap Y mβ) (U ⊔ V) μ) :
    ∃ g : Ω → β, Measurable[U] g ∧ Y =ᵐ[μ] g :=
  exists_ae_eq_measurable_of_aeDeterminedSigma
    (AELeSigma.of_condIndepEv_past hGU hUP hP hV h hYP hYUV)

/-- When the smaller σ-algebra is generated by a variable, the version can be expressed as a
measurable function of that variable. -/
theorem aeDeterminedBy_of_condIndepEv_past_standardBorel
    [IsProbabilityMeasure μ] {α : Type*} [mα : MeasurableSpace α]
    {X : Ω → α} {Y : Ω → β}
    (hGU : G ≤ MeasurableSpace.comap X mα)
    (hUP : MeasurableSpace.comap X mα ≤ P) (hP : P ≤ mΩ) (hV : V ≤ mΩ)
    (h : CondIndepEv G V P μ)
    (hYP : AELeSigma (MeasurableSpace.comap Y mβ) P μ)
    (hYUV : AELeSigma (MeasurableSpace.comap Y mβ)
      (MeasurableSpace.comap X mα ⊔ V) μ) :
    @AEDeterminedBy Ω mΩ α β mα mβ Y X μ :=
  aeDeterminedBy_of_aeDeterminedSigma
    (AELeSigma.of_condIndepEv_past hGU hUP hP hV h hYP hYUV)

end LatticeProb
