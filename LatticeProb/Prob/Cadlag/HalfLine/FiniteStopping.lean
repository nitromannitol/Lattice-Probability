import LatticeProb.Prob.Cadlag.HalfLine.ConstantExtension
import LatticeProb.Prob.Cadlag.HalfLine.Laws

/-!
# Raw finite stopping times and constant extension

The canonical finite-path information is generated by evaluations through the given time.
Constant extension identifies this information with the raw half-line information at the
clamped time and transports stopping events and clipped increments exactly.
-/

namespace LatticeProb.Cadlag.HalfLine

open Set TopologicalSpace

noncomputable section

variable {T : ℝ} {E : Type*} [NormedAddCommGroup E]

/-- Literal raw information generated by finite-path evaluations through `t`. -/
@[reducible] def finiteNaturalSigma (t : Icc (0 : ℝ) T) : MeasurableSpace (Cadlag.D T E) :=
  ⨆ s : Icc (0 : ℝ) T, ⨆ (_ : s ≤ t),
    MeasurableSpace.comap (fun x : Cadlag.D T E => x.1 s) (borel E)

/-- A finite stopping time has measurable comparison events in the canonical raw information. -/
def finiteIsStopping (tau : Cadlag.D T E → Icc (0 : ℝ) T) : Prop :=
  ∀ t, @MeasurableSet (Cadlag.D T E) (finiteNaturalSigma t) {x | tau x ≤ t}

/-- Add a nonnegative deterministic increment and clip to the finite horizon. -/
def clipFiniteTime (t : Icc (0 : ℝ) T) (u : Time) : Icc (0 : ℝ) T :=
  ⟨min ((t : ℝ) + u) T, le_min (add_nonneg t.2.1 u.2) (t.2.1.trans t.2.2),
    min_le_right _ _⟩

/-- Clamping is monotone on half-line times. -/
theorem clampTime_mono (hT : 0 ≤ T) : Monotone (clampTime hT) := by
  intro s t hst
  exact min_le_min (show (s : ℝ) ≤ t from hst) le_rfl

/-- Every finite time before the clamped time embeds before the original half-line time. -/
theorem intervalTime_le_of_le_clampTime (hT : 0 ≤ T) {v : Icc (0 : ℝ) T}
    {s : Time} (hv : v ≤ clampTime hT s) : intervalTime v ≤ s :=
  (show (v : ℝ) ≤ min (s : ℝ) T from hv).trans (min_le_left _ _)

/-- Both inclusions identify the raw information of constant extension exactly. -/
theorem naturalSigma_constantExtension_eq (hT : 0 < T) (s : Time) :
    @naturalSigma E _ (borel E) _ (constantExtension hT) s =
      finiteNaturalSigma (E := E) (clampTime hT.le s) := by
  apply le_antisymm
  · refine iSup_le fun v => iSup_le fun hv => ?_
    exact le_iSup_of_le (clampTime hT.le v)
      (le_iSup_of_le (clampTime_mono hT.le hv) le_rfl)
  · refine iSup_le fun v => iSup_le fun hv => ?_
    have heval : (fun x : Cadlag.D T E =>
        (constantExtension hT x).1 (intervalTime v)) = fun x => x.1 v := by
      funext x
      exact constantExtension_apply_intervalTime hT x v
    rw [← heval]
    exact le_iSup_of_le (intervalTime v)
      (le_iSup_of_le (intervalTime_le_of_le_clampTime hT.le hv) le_rfl)

/-- Below the terminal time, clamped comparison is the original half-line comparison. -/
theorem clampTime_le_iff (hT : 0 ≤ T) (s : Time) (t : Icc (0 : ℝ) T)
    (ht : (t : ℝ) < T) :
    clampTime hT s ≤ t ↔ s ≤ intervalTime t := by
  change min (s : ℝ) T ≤ (t : ℝ) ↔ (s : ℝ) ≤ t
  rw [min_le_iff]
  exact or_iff_left (not_le.mpr ht)

/-- Clipping any raw-natural half-line stopping time gives a finite raw stopping time. -/
theorem finiteIsStopping_clampTime (hT : 0 < T) (sigma : Cadlag.D T E → Time)
    (hsigma : ∀ s, @MeasurableSet (Cadlag.D T E)
      (@naturalSigma E _ (borel E) _ (constantExtension hT) s) {x | sigma x ≤ s}) :
    finiteIsStopping (fun x => clampTime hT.le (sigma x)) := by
  intro t
  by_cases ht : (t : ℝ) < T
  · have hevent : {x | clampTime hT.le (sigma x) ≤ t} =
        {x | sigma x ≤ intervalTime t} := by
      ext x
      exact clampTime_le_iff hT.le (sigma x) t ht
    rw [hevent]
    have h := hsigma (intervalTime t)
    rw [naturalSigma_constantExtension_eq, clampTime_intervalTime] at h
    exact h
  · have htT : (t : ℝ) = T := le_antisymm t.2.2 (le_of_not_gt ht)
    have hevent : {x | clampTime hT.le (sigma x) ≤ t} = Set.univ := by
      ext x
      simp only [mem_setOf_eq, mem_univ, iff_true]
      change min (sigma x : ℝ) T ≤ (t : ℝ)
      rw [htT]
      exact min_le_right _ _
    rw [hevent]
    exact MeasurableSet.univ

/-- Nonnegative increments commute with clipping an already clipped scalar time. -/
theorem min_add_clip (s u T : ℝ) (hu : 0 ≤ u) :
    min (min s T + u) T = min (s + u) T := by
  by_cases hs : s ≤ T
  · rw [min_eq_left hs]
  · have hTs : T ≤ s := le_of_not_ge hs
    rw [min_eq_right hTs, min_eq_right (le_add_of_nonneg_right hu),
      min_eq_right (hTs.trans (le_add_of_nonneg_right hu))]

/-- Clamping an increment equals incrementing the clamped time and clipping again. -/
theorem clampTime_add (hT : 0 ≤ T) (s u : Time) :
    clampTime hT (s + u) = clipFiniteTime (clampTime hT s) u := by
  apply Subtype.ext
  exact (min_add_clip (s : ℝ) (u : ℝ) T u.2).symm

/-- Extension evaluates an increment at the exact finite clipped increment time. -/
theorem constantExtension_apply_add (hT : 0 < T) (x : Cadlag.D T E) (s u : Time) :
    (constantExtension hT x).1 (s + u) =
      x.1 (clipFiniteTime (clampTime hT.le s) u) := by
  rw [constantExtension_apply, clampTime_add]

/-- Stopped increments agree pointwise with the finite clipped stopped increments. -/
theorem constantExtension_stopped_increment (hT : 0 < T)
    (sigma : Cadlag.D T E → Time) (x : Cadlag.D T E) (u : Time) :
    (constantExtension hT x).1 (sigma x + u) - (constantExtension hT x).1 (sigma x) =
      x.1 (clipFiniteTime (clampTime hT.le (sigma x)) u) -
        x.1 (clampTime hT.le (sigma x)) := by
  rw [constantExtension_apply_add, constantExtension_apply]

/-- Every predicate on the stopped increment therefore gives exactly the same event. -/
theorem constantExtension_stopped_increment_event (hT : 0 < T)
    (sigma : Cadlag.D T E → Time) (u : Time) (A : Set E) :
    {x | (constantExtension hT x).1 (sigma x + u) -
      (constantExtension hT x).1 (sigma x) ∈ A} =
    {x | x.1 (clipFiniteTime (clampTime hT.le (sigma x)) u) -
      x.1 (clampTime hT.le (sigma x)) ∈ A} := by
  ext x
  simp only [mem_setOf_eq]
  rw [constantExtension_stopped_increment hT sigma x u]

/-- The distance-threshold event used by the finite Aldous condition is preserved exactly. -/
theorem constantExtension_stopped_dist_event (hT : 0 < T)
    (sigma : Cadlag.D T E → Time) (u : Time) (eta : ℝ) :
    {x | eta ≤ dist ((constantExtension hT x).1 (sigma x + u))
      ((constantExtension hT x).1 (sigma x))} =
    {x | eta ≤ dist (x.1 (clipFiniteTime (clampTime hT.le (sigma x)) u))
      (x.1 (clampTime hT.le (sigma x)))} := by
  ext x
  simp only [mem_setOf_eq]
  rw [constantExtension_apply_add hT x (sigma x) u, constantExtension_apply]

/-- Constant finite times are stopping times since their comparison events are trivial. -/
theorem finiteIsStopping_const (c : Icc (0 : ℝ) T) :
    finiteIsStopping (E := E) (fun _ => c) := by
  intro t
  by_cases hct : c ≤ t
  · simpa only [hct, Set.setOf_true] using
      (@MeasurableSet.univ (Cadlag.D T E) (finiteNaturalSigma t))
  · simpa only [hct, Set.setOf_false] using
      (@MeasurableSet.empty (Cadlag.D T E) (finiteNaturalSigma t))

/-- Zero is an actual finite stopping time for every positive horizon. -/
theorem finiteIsStopping_zero (hT : 0 < T) :
    finiteIsStopping (E := E) (fun _ => ⟨0, le_rfl, hT.le⟩) :=
  finiteIsStopping_const _

end

end LatticeProb.Cadlag.HalfLine
