import Mathlib

/-! # Sigma algebras of centered path increments -/

set_option autoImplicit false

open MeasureTheory MeasurableSpace Set

namespace LatticeProb

variable {Ω ι : Type*}

/-- The sigma algebra generated by coordinate increments at times in `T` from `c`. -/
abbrev incrementSigma (X : ι → ℝ → Ω → ℝ) (T : Set ℝ) (c : ℝ) : MeasurableSpace Ω :=
  ⨆ i, ⨆ t ∈ T, MeasurableSpace.comap (fun ω => X i t ω - X i c ω) inferInstance

private theorem measurable_increment (X : ι → ℝ → Ω → ℝ) (T : Set ℝ) (c : ℝ)
    (i : ι) {t : ℝ} (ht : t ∈ T) :
    Measurable[incrementSigma X T c] (fun ω => X i t ω - X i c ω) :=
  measurable_iff_comap_le.mpr <| le_iSup_of_le i <| le_iSup_of_le t <| le_iSup_of_le ht le_rfl

/-- A centered segment is measurable from the past centered at its right endpoint. -/
theorem incrementSigma_segment_le_past (X : ι → ℝ → Ω → ℝ) {a b : ℝ} (hab : a ≤ b) :
    incrementSigma X (Icc a b) a ≤ incrementSigma X (Iic b) b := by
  change (⨆ i, ⨆ t ∈ Icc a b, MeasurableSpace.comap (fun ω => X i t ω - X i a ω) inferInstance) ≤ _
  refine iSup_le fun i => iSup_le fun t => iSup_le fun ht => ?_
  apply measurable_iff_comap_le.mp
  have ht' := measurable_increment X (Iic b) b i ht.2
  have ha' := measurable_increment X (Iic b) b i hab
  have heq : (fun ω => X i t ω - X i a ω) =
      (fun ω => (X i t ω - X i b ω) - (X i a ω - X i b ω)) := by
    funext ω; ring
  rw [heq]
  exact ht'.sub ha'

/-- A future centered at the left endpoint is generated by the segment and the
future centered at the right endpoint. -/
theorem incrementSigma_future_le (X : ι → ℝ → Ω → ℝ) {a b : ℝ} (hab : a ≤ b) :
    incrementSigma X (Ici a) a ≤
      incrementSigma X (Ici b) b ⊔ incrementSigma X (Icc a b) a := by
  change (⨆ i, ⨆ t ∈ Ici a, MeasurableSpace.comap (fun ω => X i t ω - X i a ω) inferInstance) ≤ _
  refine iSup_le fun i => iSup_le fun t => iSup_le fun ht => ?_
  apply measurable_iff_comap_le.mp
  by_cases htb : t ≤ b
  · exact (measurable_increment X (Icc a b) a i ⟨ht, htb⟩).mono le_sup_right le_rfl
  · have ht' : Measurable[incrementSigma X (Ici b) b ⊔ incrementSigma X (Icc a b) a]
        (fun ω => X i t ω - X i b ω) :=
      (measurable_increment X (Ici b) b i (le_of_not_ge htb)).mono le_sup_left le_rfl
    have hb' : Measurable[incrementSigma X (Ici b) b ⊔ incrementSigma X (Icc a b) a]
        (fun ω => X i b ω - X i a ω) :=
      (measurable_increment X (Icc a b) a i ⟨hab, le_rfl⟩).mono le_sup_right le_rfl
    have heq : (fun ω => X i t ω - X i a ω) =
        (fun ω => (X i t ω - X i b ω) + (X i b ω - X i a ω)) := by
      funext ω; ring
    rw [heq]
    exact ht'.add hb'

end LatticeProb
