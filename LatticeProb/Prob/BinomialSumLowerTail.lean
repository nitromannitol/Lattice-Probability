import LatticeProb.Prob.BinomialDomination
import Mathlib.Probability.ConditionalExpectation
import Mathlib.Probability.Independence.Basic

/-!
# Lower tail of a sum of nonnegative variables dominating a binomial count

Let `τ 0, τ 1, …` be nonnegative random variables, `τ k` measurable with respect to `ℱ (k + 1)` for a
filtration `ℱ`, and suppose that, conditionally on `ℱ k`, the event `{a ≤ τ k}` has probability at least
`q` almost surely. Then `Σ_{i<K} τ i ≥ a · #{i < K : a ≤ τ i}`, and the count `#{i < K : a ≤ τ i}`
stochastically dominates a binomial random variable with `K` trials and success probability `q`. Hoeffding's
inequality for the binomial law gives

  `P[Σ_{i<K} τ i < a (q - δ) K] ≤ exp(-2 δ² K)`

(`measureReal_sum_lt_le_of_condExp_ge`). This is the binomial concentration step of the iterated-conditioning
argument of `LatticeProb.Prob.BinomialDomination`, specialised to the selection events `G k = Ω` and the
success events `A k = {a ≤ τ k}`.

When the `τ i` are independent, the hypothesis holds for the filtration of the strict past
`pastFiltration τ k = σ(τ 0, …, τ (k - 1))`, with conditional probability equal to `P[a ≤ τ k]`
(`measureReal_sum_lt_le_of_iIndepFun`).
-/

open MeasureTheory ProbabilityTheory Finset

namespace LatticeProb

variable {Ω : Type*} {m0 : MeasurableSpace Ω}

/-- **Lower tail of a sum dominating a binomial count.** Let `τ k ≥ 0` be `ℱ (k + 1)`-measurable and let
`P[a ≤ τ k | ℱ k] ≥ q` almost surely for every `k`, with `a > 0`, `0 ≤ q ≤ 1` and `δ ≥ 0`. Then
`P[Σ_{i<K} τ i < a (q - δ) K] ≤ exp(-2 δ² K)` for every `K`. -/
theorem measureReal_sum_lt_le_of_condExp_ge {μ : Measure Ω} [IsProbabilityMeasure μ]
    (ℱ : Filtration ℕ m0) {τ : ℕ → Ω → ℝ} (hτ0 : ∀ k ω, 0 ≤ τ k ω)
    (hτ : ∀ k, Measurable[ℱ (k + 1)] (τ k)) {a q δ : ℝ} (ha : 0 < a) (hq0 : 0 ≤ q)
    (hq1 : q ≤ 1) (hδ : 0 ≤ δ)
    (hq : ∀ k, ∀ᵐ ω ∂μ, q ≤ μ[{ω | a ≤ τ k ω}.indicator (fun _ => (1 : ℝ)) | ℱ k] ω) (K : ℕ) :
    μ.real {ω | ∑ i ∈ Finset.range K, τ i ω < a * (q - δ) * K} ≤ Real.exp (-2 * δ ^ 2 * K) := by
  have hA : ∀ k, MeasurableSet[ℱ (k + 1)] {ω | a ≤ τ k ω} := fun k => hτ k measurableSet_Ici
  have hmain := measureReal_binomDom_hoeffding ℱ (G := fun _ => Set.univ)
    (A := fun k => {ω | a ≤ τ k ω}) (fun _ => MeasurableSet.univ) hA hq0 hq1 hδ
    (fun k => (hq k).mono fun _ h _ => h) K K
  have hsub : {ω | ∑ i ∈ Finset.range K, τ i ω < a * (q - δ) * K} ⊆
      {ω | ((K : ℕ) : ℝ) ≤ binomDomCount (fun _ => Set.univ) K ω ∧
        binomDomHits (fun _ => Set.univ) (fun k => {ω | a ≤ τ k ω}) K ω ≤ (q - δ) * K} := by
    intro ω hω
    simp only [Set.mem_ofPred_eq] at hω ⊢
    have hcount : binomDomCount (fun _ => (Set.univ : Set Ω)) K ω = K := by
      simp [binomDomCount]
    have hhits : a * binomDomHits (fun _ => Set.univ) (fun k => {ω | a ≤ τ k ω}) K ω ≤
        ∑ i ∈ Finset.range K, τ i ω := by
      rw [binomDomHits, Finset.mul_sum]
      refine Finset.sum_le_sum fun k _ => ?_
      by_cases h : a ≤ τ k ω
      · simp [Set.indicator, h]
      · simp [Set.indicator, h, hτ0 k ω]
    have hlt : a * binomDomHits (fun _ => Set.univ) (fun k => {ω | a ≤ τ k ω}) K ω <
        a * ((q - δ) * K) :=
      lt_of_le_of_lt hhits (lt_of_lt_of_eq hω (by ring))
    exact ⟨hcount.ge, (lt_of_mul_lt_mul_left hlt ha.le).le⟩
  exact (measureReal_mono hsub).trans hmain

/-- The filtration of the strict past of a sequence of real random variables: at time `k` it is the
σ-algebra `σ(τ 0, …, τ (k - 1))` generated by the variables of index `< k`. -/
noncomputable def pastFiltration (τ : ℕ → Ω → ℝ) (hτ : ∀ i, Measurable (τ i)) :
    Filtration ℕ m0 :=
  ⟨fun k => ⨆ i ∈ Set.Iio k, MeasurableSpace.comap (τ i) inferInstance,
    fun _ _ hjk => biSup_mono fun _ hi => Set.Iio_subset_Iio hjk hi,
    fun _ => iSup₂_le fun i _ => measurable_iff_comap_le.mp (hτ i)⟩

/-- `τ k` is measurable with respect to the strict past at time `k + 1`. -/
lemma measurable_pastFiltration_succ {τ : ℕ → Ω → ℝ} (hτ : ∀ i, Measurable (τ i)) (k : ℕ) :
    Measurable[pastFiltration τ hτ (k + 1)] (τ k) :=
  measurable_iff_comap_le.mpr
    (le_biSup (fun i => MeasurableSpace.comap (τ i) inferInstance)
      (Set.mem_Iio.2 (Nat.lt_add_one k)))

/-- For independent `τ i`, the variable `τ k` is independent of the strict past at time `k`. -/
lemma indep_comap_pastFiltration {μ : Measure Ω} [IsProbabilityMeasure μ] {τ : ℕ → Ω → ℝ}
    (hτ : ∀ i, Measurable (τ i)) (hind : iIndepFun τ μ) (k : ℕ) :
    Indep (MeasurableSpace.comap (τ k) inferInstance) (pastFiltration τ hτ k) μ := by
  have h_le : ∀ i, MeasurableSpace.comap (τ i) inferInstance ≤ m0 :=
    fun i => measurable_iff_comap_le.mp (hτ i)
  have hST : Disjoint ({k} : Set ℕ) (Set.Iio k) :=
    Set.disjoint_singleton_left.2 (lt_irrefl k)
  have h1 := indep_iSup_of_disjoint h_le hind.iIndep hST
  rw [_root_.iSup_singleton] at h1
  exact h1

/-- **Lower tail of a sum of independent nonnegative variables.** Let `τ i ≥ 0` be independent with
`P[a ≤ τ i] ≥ q` for every `i`, with `a > 0`, `q ≥ 0` and `δ ≥ 0`. Then
`P[Σ_{i<K} τ i < a (q - δ) K] ≤ exp(-2 δ² K)` for every `K`. -/
theorem measureReal_sum_lt_le_of_iIndepFun {μ : Measure Ω} [IsProbabilityMeasure μ]
    {τ : ℕ → Ω → ℝ} (hτ0 : ∀ k ω, 0 ≤ τ k ω) (hτ : ∀ k, Measurable (τ k))
    (hind : iIndepFun τ μ) {a q δ : ℝ} (ha : 0 < a) (hq0 : 0 ≤ q) (hδ : 0 ≤ δ)
    (hq : ∀ k, q ≤ μ.real {ω | a ≤ τ k ω}) (K : ℕ) :
    μ.real {ω | ∑ i ∈ Finset.range K, τ i ω < a * (q - δ) * K} ≤ Real.exp (-2 * δ ^ 2 * K) := by
  have hcond : ∀ k, ∀ᵐ ω ∂μ,
      q ≤ μ[{ω | a ≤ τ k ω}.indicator (fun _ => (1 : ℝ)) | pastFiltration τ hτ k] ω := by
    intro k
    have hcomap : Measurable[MeasurableSpace.comap (τ k) inferInstance] (τ k) :=
      measurable_iff_comap_le.mpr le_rfl
    have hA : MeasurableSet[MeasurableSpace.comap (τ k) inferInstance] {ω | a ≤ τ k ω} :=
      hcomap measurableSet_Ici
    have hAm : MeasurableSet {ω | a ≤ τ k ω} := hτ k measurableSet_Ici
    have hf : StronglyMeasurable[MeasurableSpace.comap (τ k) inferInstance]
        ({ω | a ≤ τ k ω}.indicator fun _ => (1 : ℝ)) :=
      (measurable_const.indicator hA).stronglyMeasurable
    have h := condExp_indep_eq (μ := μ) (measurable_iff_comap_le.mp (hτ k))
      ((pastFiltration τ hτ).le k) hf (indep_comap_pastFiltration hτ hind k)
    filter_upwards [h] with ω hω
    rw [hω, integral_indicator hAm, setIntegral_const, smul_eq_mul, mul_one]
    exact hq k
  exact measureReal_sum_lt_le_of_condExp_ge (pastFiltration τ hτ) hτ0
    (measurable_pastFiltration_succ hτ) ha hq0 ((hq 0).trans measureReal_le_one) hδ hcond K

end LatticeProb
