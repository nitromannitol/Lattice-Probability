import Mathlib

/-!
# Finite Borel measures on a compact metric space form a standard Borel space

Let `E` be a compact metric space with its Borel σ-algebra. The space of finite Borel measures
`{μ : Measure E // IsFiniteMeasure μ}` carries the σ-algebra generated by the evaluations
`μ ↦ μ A` (Mathlib's `Measure.instMeasurableSpace`). It is a standard Borel space
(Kechris, *Classical Descriptive Set Theory*, §17.E, Thms 17.23-17.24; Parthasarathy,
*Probability Measures on Metric Spaces*, Thm II.6.2).

Proof outline.
* The weak topology of Borel probability measures (Mathlib's `ProbabilityMeasure`) is compact
  metrizable; its Borel σ-algebra is the evaluation σ-algebra. Upper semicontinuity of `Q ↦ Q F`
  for closed `F` (Portmanteau) and a Dynkin argument give `evaluation ≤ Borel`. For a dense
  sequence `Dₙ` in `C(E, ℝ)`, the moment map `Q ↦ (∫ Dₙ dQ)ₙ` is a closed embedding into `ℕ → ℝ`,
  whose coordinates are evaluation-measurable; this gives `Borel ≤ evaluation`.
* Finite measures are identified with a Borel subset of `ProbabilityMeasure E × ℝ` by
  normalization (the Dirac mass at a fixed point when the total mass vanishes).
* Finite measures on `X` concentrated on a measurable `S` (`ν.restrict S = ν`) are identified with
  finite measures on `S` by restriction and push-forward along the measurable embedding `S ↪ X`.
-/

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal

namespace LatticeProb

/-! ### Transport of standard Borel structures along measurable equivalences -/

/-- A measurable equivalence onto a standard Borel space transports the standard Borel structure. -/
theorem standardBorelSpace_of_measurableEquiv {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [StandardBorelSpace β] (e : α ≃ᵐ β) : StandardBorelSpace α := by
  obtain ⟨τ, hB, hP⟩ := StandardBorelSpace.polish (α := β)
  have hσ : ‹MeasurableSpace α› = MeasurableSpace.comap e ‹MeasurableSpace β› := by
    refine le_antisymm (fun s hs => ?_) e.measurable.comap_le
    exact MeasurableSpace.measurableSet_comap.2
      ⟨e '' s, e.measurableSet_image.2 hs, e.toEquiv.preimage_image s⟩
  let τ' : TopologicalSpace α := TopologicalSpace.induced e τ
  have hBα : BorelSpace α := by
    refine ⟨?_⟩
    show ‹MeasurableSpace α› = @borel α (TopologicalSpace.induced e τ)
    rw [borel_comap, ← hB.measurable_eq]
    exact hσ
  have hPα : @PolishSpace α τ' := @Equiv.polishSpace_induced _ _ τ hP e.toEquiv
  exact ⟨⟨τ', hBα, hPα⟩⟩

/-! ### Upper semicontinuity and Dynkin induction on a compact metric space -/

section Compact

variable {E : Type*} [MetricSpace E] [CompactSpace E] [MeasurableSpace E] [BorelSpace E]

omit [CompactSpace E] in
/-- For a closed set `F`, the evaluation `Q ↦ Q F` is upper semicontinuous on probability measures
(Portmanteau theorem). -/
theorem probabilityMeasure_usc_of_isClosed {F : Set E} (hF : IsClosed F) :
    UpperSemicontinuous fun Q : ProbabilityMeasure E => (Q : Measure E) F := by
  intro Q y hy
  by_contra h
  have hfreq : Filter.Frequently (fun Q' : ProbabilityMeasure E => y ≤ (Q' : Measure E) F) (𝓝 Q) := by
    simpa only [not_lt] using Filter.not_eventually.1 h
  have hfreqL : Filter.Frequently (fun Q' : ProbabilityMeasure E => y ≤ (Q' : Measure E) F)
      (𝓝 Q ⊓ 𝓟 {Q' : ProbabilityMeasure E | y ≤ (Q' : Measure E) F}) :=
    Filter.frequently_inf_principal.2 (hfreq.mono fun _ h' => ⟨h', h'⟩)
  have hlim : Tendsto (fun Q' : ProbabilityMeasure E => Q')
      (𝓝 Q ⊓ 𝓟 {Q' : ProbabilityMeasure E | y ≤ (Q' : Measure E) F}) (𝓝 Q) :=
    tendsto_id.mono_left inf_le_left
  have hle := ProbabilityMeasure.limsup_measure_closed_le_of_tendsto hlim hF
  have hy' := le_limsup_of_frequently_le hfreqL
  exact not_lt.2 (hy'.trans hle) hy

/-- An upper semicontinuous `ℝ≥0∞`-valued function is Borel measurable. -/
theorem measurable_of_usc_borel {δ : Type*} [TopologicalSpace δ] {f : δ → ℝ≥0∞}
    (hf : UpperSemicontinuous f) : Measurable[borel δ] f := by
  refine measurable_of_Iio fun x => ?_
  exact MeasurableSpace.measurableSet_generateFrom (hf.isOpen_preimage x)

omit [CompactSpace E] in
/-- The evaluations `Q ↦ Q A` are Borel measurable for the topology of probability measures. -/
theorem measurable_measure_apply_borel {A : Set E} (hA : MeasurableSet A) :
    Measurable[borel (ProbabilityMeasure E)] fun Q : ProbabilityMeasure E => (Q : Measure E) A := by
  refine MeasurableSpace.induction_on_inter (m := inferInstance)
    (C := fun s _ => Measurable[borel (ProbabilityMeasure E)]
      fun Q : ProbabilityMeasure E => (Q : Measure E) s)
    (s := {t : Set E | IsClosed t}) ?_ isPiSystem_isClosed ?_ ?_ ?_ ?_ A hA
  · exact (BorelSpace.measurable_eq).trans borel_eq_generateFrom_isClosed
  · simp only [measure_empty]
    exact measurable_const
  · intro t ht
    exact measurable_of_usc_borel (probabilityMeasure_usc_of_isClosed ht)
  · intro t htm ih
    simp only [prob_compl_eq_one_sub htm]
    exact measurable_const.sub ih
  · intro f hd hfm ih
    simp only [measure_iUnion hd hfm]
    let _ : MeasurableSpace (ProbabilityMeasure E) := borel (ProbabilityMeasure E)
    exact Measurable.tsum ih

omit [CompactSpace E] in
/-- The map `Q ↦ Q` into finite measures is Borel measurable. -/
theorem measurable_toMeasure_borel :
    Measurable[borel (ProbabilityMeasure E)] fun Q : ProbabilityMeasure E => (Q : Measure E) :=
  Measure.measurable_of_measurable_coe _ fun _ hA => measurable_measure_apply_borel hA

omit [CompactSpace E] in
/-- The evaluation σ-algebra of probability measures is contained in their Borel σ-algebra. -/
theorem inst_le_borel :
    (inferInstance : MeasurableSpace (ProbabilityMeasure E)) ≤ borel (ProbabilityMeasure E) := by
  show MeasurableSpace.comap (fun Q : ProbabilityMeasure E => (Q : Measure E))
    Measure.instMeasurableSpace ≤ borel (ProbabilityMeasure E)
  exact measurable_toMeasure_borel.comap_le

/-! ### The moment map -/

/-- Integrals of a continuous function are evaluation-measurable. -/
theorem measurable_integral_probabilityMeasure {f : E → ℝ} (hf : Continuous f) :
    Measurable fun Q : ProbabilityMeasure E => ∫ x, f x ∂(Q : Measure E) := by
  have hint : ∀ Q : ProbabilityMeasure E, ∫ x, f x ∂(Q : Measure E) =
      (∫⁻ x, ENNReal.ofReal (f x) ∂(Q : Measure E)).toReal -
        (∫⁻ x, ENNReal.ofReal (-f x) ∂(Q : Measure E)).toReal := by
    intro Q
    have hi : Integrable f (Q : Measure E) :=
      (BoundedContinuousFunction.mkOfCompact (⟨f, hf⟩ : C(E, ℝ))).integrable _
    exact integral_eq_lintegral_pos_part_sub_lintegral_neg_part hi
  have hm1 : Measurable fun Q : ProbabilityMeasure E =>
      ∫⁻ x, ENNReal.ofReal (f x) ∂(Q : Measure E) :=
    (Measure.measurable_lintegral hf.measurable.ennreal_ofReal).comp measurable_subtype_coe
  have hm2 : Measurable fun Q : ProbabilityMeasure E =>
      ∫⁻ x, ENNReal.ofReal (-f x) ∂(Q : Measure E) :=
    (Measure.measurable_lintegral hf.neg.measurable.ennreal_ofReal).comp measurable_subtype_coe
  simp only [hint]
  exact hm1.ennreal_toReal.sub hm2.ennreal_toReal

/-- The moment map `Q ↦ (∫ Dₙ dQ)ₙ` along a sequence of continuous functions. -/
noncomputable def momentMap (D : ℕ → C(E, ℝ)) : ProbabilityMeasure E → (ℕ → ℝ) :=
  fun Q n => ∫ x, D n x ∂(Q : Measure E)

theorem momentMap_measurable (D : ℕ → C(E, ℝ)) : Measurable (momentMap D) :=
  measurable_pi_iff.2 fun n => measurable_integral_probabilityMeasure (D n).continuous

theorem momentMap_continuous (D : ℕ → C(E, ℝ)) : Continuous (momentMap D) := by
  unfold momentMap
  refine continuous_pi fun n => continuous_iff_continuousAt.2 fun Q => ?_
  exact ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.1 tendsto_id
    (BoundedContinuousFunction.mkOfCompact (D n))

omit [CompactSpace E] in
/-- Two probability measures with equal integrals of every continuous function on a metric space
are equal. -/
theorem eq_of_forall_integral_continuous {Q₁ Q₂ : ProbabilityMeasure E}
    (h : ∀ g : C(E, ℝ), ∫ x, g x ∂(Q₁ : Measure E) = ∫ x, g x ∂(Q₂ : Measure E)) : Q₁ = Q₂ := by
  refine (ProbabilityMeasure.toFiniteMeasure_isEmbedding E).injective ?_
  exact FiniteMeasure.ext_of_forall_integral_eq fun f => h f.toContinuousMap

theorem momentMap_injective {D : ℕ → C(E, ℝ)} (hD : DenseRange D) :
    Function.Injective (momentMap D) := by
  intro Q₁ Q₂ h
  -- a uniform approximation by `D n` moves the integral by at most `δ`
  have approx : ∀ (Q : ProbabilityMeasure E) (g k : C(E, ℝ)) (δ : ℝ), dist g k ≤ δ →
      |∫ x, g x ∂(Q : Measure E) - ∫ x, k x ∂(Q : Measure E)| ≤ δ := by
    intro Q g k δ hgk
    have hpt : ∀ x, ‖g x - k x‖ ≤ δ := fun x => by
      rw [← dist_eq_norm, Real.dist_eq] at *
      exact (ContinuousMap.dist_apply_le_dist (f := g) (g := k) x).trans hgk
    have hi : ∫ x, g x - k x ∂(Q : Measure E) = ∫ x, g x ∂(Q : Measure E) - ∫ x, k x ∂(Q : Measure E) :=
      integral_sub ((BoundedContinuousFunction.mkOfCompact g).integrable (Q : Measure E))
        ((BoundedContinuousFunction.mkOfCompact k).integrable (Q : Measure E))
    rw [← hi, ← Real.norm_eq_abs]
    refine (norm_integral_le_of_norm_le_const (C := δ) (Filter.Eventually.of_forall hpt)).trans ?_
    simp
  refine eq_of_forall_integral_continuous fun g => ?_
  refine eq_of_forall_dist_le fun ε hε => ?_
  obtain ⟨n, hn⟩ := Metric.denseRange_iff.1 hD g (ε / 3) (by positivity)
  have hn' : dist g (D n) ≤ ε / 3 := hn.le
  have h1 := approx Q₁ g (D n) (ε / 3) hn'
  have h2 := approx Q₂ g (D n) (ε / 3) hn'
  have h3 : ∫ x, D n x ∂(Q₁ : Measure E) = ∫ x, D n x ∂(Q₂ : Measure E) := congrFun h n
  rw [Real.dist_eq]
  rw [abs_le] at h1 h2 ⊢
  constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]

theorem momentMap_isClosedEmbedding {D : ℕ → C(E, ℝ)} (hD : DenseRange D) :
    IsClosedEmbedding (momentMap D) :=
  (momentMap_continuous D).isClosedEmbedding (momentMap_injective hD)

/-- The Borel σ-algebra of the weak topology is contained in the evaluation σ-algebra, because the
moment map is an embedding into a second countable space whose coordinates are evaluation-measurable
(Kechris, Thm 17.24). -/
theorem borel_le_inst {D : ℕ → C(E, ℝ)} (hΨ : IsEmbedding (momentMap D)) :
    borel (ProbabilityMeasure E) ≤ (inferInstance : MeasurableSpace (ProbabilityMeasure E)) := by
  show MeasurableSpace.generateFrom {t : Set (ProbabilityMeasure E) | IsOpen t} ≤ _
  refine MeasurableSpace.generateFrom_le fun U hU => ?_
  obtain ⟨V, hV, rfl⟩ := hΨ.isInducing.isOpen_iff.1 hU
  exact momentMap_measurable D hV.measurableSet

/-- The weak topology on probability measures on a compact metric space has Borel σ-algebra equal
to the evaluation σ-algebra (Kechris, Classical Descriptive Set Theory, Thm 17.24). -/
instance borelSpace_probabilityMeasure : BorelSpace (ProbabilityMeasure E) := by
  obtain ⟨D, hD⟩ := TopologicalSpace.exists_dense_seq C(E, ℝ)
  exact ⟨le_antisymm inst_le_borel (borel_le_inst (momentMap_isClosedEmbedding hD).isEmbedding)⟩

/-- The space of probability measures on a compact metric space is Polish (it is homeomorphic to a
closed subset of `ℕ → ℝ`), hence standard Borel (Kechris, Thm 17.23). -/
instance polishSpace_probabilityMeasure : PolishSpace (ProbabilityMeasure E) := by
  obtain ⟨D, hD⟩ := TopologicalSpace.exists_dense_seq C(E, ℝ)
  exact (momentMap_isClosedEmbedding hD).polishSpace

/-- The probability measures on a compact metric space form a standard Borel space. -/
instance standardBorelSpace_probabilityMeasure : StandardBorelSpace (ProbabilityMeasure E) :=
  inferInstance

end Compact

/-! ### Finite measures as a Borel subset of probability measures times `ℝ` -/

section Normalization

variable {E : Type*} [MeasurableSpace E]

/-- The normalized measure `μ / μ(E)`, or the Dirac mass at `x₀` when `μ = 0`. -/
noncomputable def normalizeOr (x₀ : E) (μ : Measure E) : Measure E :=
  if μ univ = 0 then Measure.dirac x₀ else (μ univ)⁻¹ • μ

theorem isProbabilityMeasure_normalizeOr (x₀ : E) {μ : Measure E}
    (hμ : IsFiniteMeasure μ) : IsProbabilityMeasure (normalizeOr x₀ μ) := by
  unfold normalizeOr
  split_ifs with h
  · infer_instance
  · refine ⟨?_⟩
    rw [Measure.smul_apply, smul_eq_mul, ENNReal.inv_mul_cancel h (measure_ne_top μ univ)]

theorem measurable_normalizeOr (x₀ : E) :
    Measurable fun μ : {μ : Measure E // IsFiniteMeasure μ} => normalizeOr x₀ μ.1 := by
  refine Measure.measurable_of_measurable_coe _ fun A hA => ?_
  have h1 : Measurable fun μ : {μ : Measure E // IsFiniteMeasure μ} => μ.1 univ :=
    (Measure.measurable_coe MeasurableSet.univ).comp measurable_subtype_coe
  have h2 : Measurable fun μ : {μ : Measure E // IsFiniteMeasure μ} => μ.1 A :=
    (Measure.measurable_coe hA).comp measurable_subtype_coe
  have hset : MeasurableSet {μ : {μ : Measure E // IsFiniteMeasure μ} | μ.1 univ = 0} :=
    h1 (measurableSet_singleton 0)
  have heq : (fun μ : {μ : Measure E // IsFiniteMeasure μ} => normalizeOr x₀ μ.1 A) =
      fun μ => if μ.1 univ = 0 then Measure.dirac x₀ A else (μ.1 univ)⁻¹ * μ.1 A := by
    funext μ
    unfold normalizeOr
    split_ifs <;> simp [Measure.smul_apply]
  rw [heq]
  exact Measurable.ite hset measurable_const (h1.inv.mul h2)

/-- The normalized probability measure of a finite measure. -/
noncomputable def normalizeProb (x₀ : E) (μ : {μ : Measure E // IsFiniteMeasure μ}) :
    ProbabilityMeasure E :=
  ⟨normalizeOr x₀ μ.1, isProbabilityMeasure_normalizeOr x₀ μ.2⟩

theorem measurable_normalizeProb (x₀ : E) : Measurable (normalizeProb x₀) :=
  Measurable.subtype_mk (measurable_normalizeOr x₀)

/-- The Dirac mass at `x₀` as a probability measure. -/
noncomputable def diracProb (x₀ : E) : ProbabilityMeasure E :=
  ⟨Measure.dirac x₀, inferInstance⟩

/-- The Borel set `{(Q, t) : t > 0} ∪ {(δ_{x₀}, 0)}` of `ProbabilityMeasure E × ℝ`. -/
def normDomain (x₀ : E) : Set (ProbabilityMeasure E × ℝ) :=
  {p | 0 < p.2} ∪ {(diracProb x₀, 0)}

end Normalization

section Standard

variable {E : Type*} [MetricSpace E] [CompactSpace E] [MeasurableSpace E] [BorelSpace E]

theorem measurableSet_normDomain (x₀ : E) : MeasurableSet (normDomain x₀) :=
  (measurableSet_lt measurable_const measurable_snd).union (measurableSet_singleton _)

/-- The evaluations `μ ↦ μ A` of probability measures are measurable for the evaluation σ-algebra
(with the Borel structure of the weak topology identified with it). -/
theorem measurable_measure_apply {A : Set E} (hA : MeasurableSet A) :
    Measurable fun Q : ProbabilityMeasure E => (Q : Measure E) A :=
  (measurable_measure_apply_borel hA).mono (le_of_eq (BorelSpace.measurable_eq (α := ProbabilityMeasure E)).symm) le_rfl

omit [MetricSpace E] [CompactSpace E] [BorelSpace E] in
theorem mem_normDomain (x₀ : E) (μ : {μ : Measure E // IsFiniteMeasure μ}) :
    (normalizeProb x₀ μ, (μ.1 univ).toReal) ∈ normDomain x₀ := by
  unfold normDomain
  rw [Set.mem_union]
  by_cases h : μ.1 univ = 0
  · refine Or.inr ?_
    rw [Set.mem_singleton_iff, Prod.mk.injEq]
    refine ⟨Subtype.ext ?_, by rw [h, ENNReal.toReal_zero]⟩
    show normalizeOr x₀ μ.1 = Measure.dirac x₀
    unfold normalizeOr
    simp only [h, ↓reduceIte]
  · have := μ.2
    exact Or.inl (ENNReal.toReal_pos h (measure_ne_top μ.1 univ))

/-- Finite measures on `E` as the Borel subset `normDomain x₀` of `ProbabilityMeasure E × ℝ`,
`μ ↦ (μ / μ(E), μ(E))`, with inverse `(Q, t) ↦ t • Q`. -/
noncomputable def finiteMeasureEquivNorm (x₀ : E) :
    {μ : Measure E // IsFiniteMeasure μ} ≃ᵐ normDomain x₀ where
  toFun μ := ⟨(normalizeProb x₀ μ, (μ.1 univ).toReal), mem_normDomain x₀ μ⟩
  invFun p := ⟨p.1.2.toNNReal • ((p.1.1 : ProbabilityMeasure E) : Measure E), inferInstance⟩
  left_inv μ := by
    apply Subtype.ext
    by_cases h : μ.1 univ = 0
    · have hμ : μ.1 = 0 := Measure.measure_univ_eq_zero.1 h
      show (μ.1 univ).toReal.toNNReal • normalizeOr x₀ μ.1 = μ.1
      rw [h, ENNReal.toReal_zero, Real.toNNReal_zero, zero_smul, hμ]
    · have := μ.2
      have hfin : μ.1 univ ≠ ⊤ := measure_ne_top μ.1 univ
      have hc : (((μ.1 univ).toReal.toNNReal : ℝ≥0) : ℝ≥0∞) = μ.1 univ := by
        rw [ENNReal.toReal, Real.toNNReal_coe, ENNReal.coe_toNNReal hfin]
      show (μ.1 univ).toReal.toNNReal • normalizeOr x₀ μ.1 = μ.1
      unfold normalizeOr
      simp only [h, ↓reduceIte]
      refine Measure.ext fun A _ => ?_
      simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
      rw [hc, ← mul_assoc, ENNReal.mul_inv_cancel h hfin, one_mul]
  right_inv p := by
    obtain ⟨⟨Q, t⟩, hp⟩ := p
    rcases hp with ht | hQ
    · have ht' : 0 < t := ht
      have hc0 : (t.toNNReal : ℝ≥0∞) ≠ 0 := by
        rw [ne_eq, ENNReal.coe_eq_zero, Real.toNNReal_eq_zero, not_le]
        exact ht'
      have hmass : (t.toNNReal • (Q : Measure E)) univ = (t.toNNReal : ℝ≥0∞) := by
        rw [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul, measure_univ, mul_one]
      apply Subtype.ext
      refine Prod.ext ?_ ?_
      · apply Subtype.ext
        show normalizeOr x₀ (t.toNNReal • (Q : Measure E)) = Q
        unfold normalizeOr
        rw [hmass]
        simp only [hc0, ↓reduceIte]
        refine Measure.ext fun A _ => ?_
        simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
        rw [← mul_assoc, ENNReal.inv_mul_cancel hc0 ENNReal.coe_ne_top, one_mul]
      · show ((t.toNNReal • (Q : Measure E)) univ).toReal = t
        rw [hmass, ENNReal.coe_toReal, Real.coe_toNNReal t ht'.le]
    · rw [Set.mem_singleton_iff, Prod.mk.injEq] at hQ
      obtain ⟨rfl, rfl⟩ := hQ
      apply Subtype.ext
      apply Prod.ext
      · apply Subtype.ext
        show normalizeOr x₀ ((0 : ℝ).toNNReal • ((diracProb x₀ : ProbabilityMeasure E) : Measure E)) =
          Measure.dirac x₀
        rw [Real.toNNReal_zero, zero_smul]
        unfold normalizeOr
        simp
      · show (((0 : ℝ).toNNReal • ((diracProb x₀ : ProbabilityMeasure E) : Measure E)) univ).toReal = 0
        rw [Real.toNNReal_zero, zero_smul]
        simp
  measurable_toFun := by
    refine Measurable.subtype_mk (Measurable.prodMk (measurable_normalizeProb x₀) ?_)
    exact ((Measure.measurable_coe MeasurableSet.univ).comp measurable_subtype_coe).ennreal_toReal
  measurable_invFun := by
    refine Measurable.subtype_mk ?_
    refine Measure.measurable_of_measurable_coe _ fun A hA => ?_
    simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
    have hc : Measurable fun p : normDomain x₀ => (p.1.2).toNNReal :=
      (measurable_snd.comp measurable_subtype_coe).real_toNNReal
    have hq : Measurable fun p : normDomain x₀ => ((p.1.1 : ProbabilityMeasure E) : Measure E) A :=
      (measurable_measure_apply hA).comp (measurable_fst.comp measurable_subtype_coe)
    exact (measurable_coe_nnreal_ennreal.comp hc).mul hq

theorem standardBorelSpace_finiteMeasure (x₀ : E) :
    StandardBorelSpace {μ : Measure E // IsFiniteMeasure μ} := by
  have : StandardBorelSpace (normDomain x₀) :=
    MeasurableSet.standardBorel (measurableSet_normDomain x₀)
  exact standardBorelSpace_of_measurableEquiv (finiteMeasureEquivNorm x₀)

end Standard

section Concentrated

variable {X : Type*} [MeasurableSpace X]

/-- The restriction of a finite measure concentrated on `S` to `S` is finite. -/
theorem isFiniteMeasure_comap_subtype {S : Set X} (hS : MeasurableSet S) (ν : Measure X)
    [IsFiniteMeasure ν] : IsFiniteMeasure (ν.comap (Subtype.val : S → X)) := by
  constructor
  rw [(MeasurableEmbedding.subtype_coe hS).comap_apply]
  exact measure_lt_top _ _

/-- Finite measures on `X` concentrated on a measurable set `S` form a standard Borel space as soon
as finite measures on `S` do: restriction to `S` and push-forward along `S ↪ X` are inverse
measurable bijections. -/
theorem standardBorelSpace_concentrated {S : Set X} (hS : MeasurableSet S)
    [StandardBorelSpace {μ : Measure S // IsFiniteMeasure μ}] :
    StandardBorelSpace {ν : Measure X // IsFiniteMeasure ν ∧ ν.restrict S = ν} := by
  have hemb : MeasurableEmbedding (Subtype.val : S → X) := MeasurableEmbedding.subtype_coe hS
  have hmapmem : ∀ μ : {μ : Measure S // IsFiniteMeasure μ},
      IsFiniteMeasure (μ.1.map (Subtype.val : S → X)) ∧
        (μ.1.map (Subtype.val : S → X)).restrict S = μ.1.map (Subtype.val : S → X) := by
    intro μ
    have := μ.2
    refine ⟨inferInstance, Measure.restrict_eq_self_of_ae_mem ?_⟩
    exact (ae_map_iff measurable_subtype_coe.aemeasurable hS).2 (ae_of_all _ fun x => x.2)
  let e : {ν : Measure X // IsFiniteMeasure ν ∧ ν.restrict S = ν} ≃ᵐ
      {μ : Measure S // IsFiniteMeasure μ} :=
    { toFun := fun ν => ⟨ν.1.comap (Subtype.val : S → X), by
        have := ν.2.1
        exact isFiniteMeasure_comap_subtype hS ν.1⟩
      invFun := fun μ => ⟨μ.1.map (Subtype.val : S → X), hmapmem μ⟩
      left_inv := fun ν => by
        apply Subtype.ext
        show (ν.1.comap (Subtype.val : S → X)).map (Subtype.val : S → X) = ν.1
        rw [hemb.map_comap, Subtype.range_coe]
        exact ν.2.2
      right_inv := fun μ => by
        apply Subtype.ext
        show (μ.1.map (Subtype.val : S → X)).comap (Subtype.val : S → X) = μ.1
        exact hemb.comap_map μ.1
      measurable_toFun := by
        refine Measurable.subtype_mk ?_
        refine Measure.measurable_of_measurable_coe _ fun B hB => ?_
        simp only [hemb.comap_apply]
        exact (Measure.measurable_coe (hemb.measurableSet_image.2 hB)).comp measurable_subtype_coe
      measurable_invFun := by
        refine Measurable.subtype_mk ?_
        exact (Measure.measurable_map (Subtype.val : S → X) measurable_subtype_coe).comp
          measurable_subtype_coe }
  exact standardBorelSpace_of_measurableEquiv e

end Concentrated

end LatticeProb
