import LatticeProb.Prob.ProbabilityMeasureSeparable

/-!
# The Borel structure of the space of probability measures

Let `E` be a separable pseudo-metrizable space with its Borel `σ`-algebra. The space
`ProbabilityMeasure E` of Borel probability measures with the topology of convergence in
distribution carries two natural `σ`-algebras: the Giry `σ`-algebra generated by the evaluations
`ν ↦ ν A`, and the Borel `σ`-algebra of the weak topology. They coincide (Kechris, *Classical
Descriptive Set Theory*, Thm 17.24; Parthasarathy, *Probability Measures on Metric Spaces*,
Thm II.6.2), that is `BorelSpace (ProbabilityMeasure E)`.

* Giry `≤` Borel: for an open set `U`, `ν ↦ ν U` is lower semicontinuous (Portmanteau), hence
  Borel measurable; a Dynkin argument over the `π`-system of open sets extends this to all
  Borel sets.
* Borel `≤` Giry: the weak topology is generated by the maps `ν ↦ ∫ f dν`, `f` bounded continuous,
  each of which is Giry measurable. The space is second countable, so every open set is a
  countable union of finite intersections of the generating sets.
-/

open MeasureTheory Filter Topology Set TopologicalSpace
open scoped ENNReal NNReal BoundedContinuousFunction

namespace LatticeProb

section Borel

variable {E : Type*} [TopologicalSpace E] [PseudoMetrizableSpace E] [SeparableSpace E]
  [MeasurableSpace E] [BorelSpace E]

omit [SeparableSpace E] in
/-- For an open set `U`, the evaluation `ν ↦ ν U` is lower semicontinuous for the topology of
convergence in distribution (Portmanteau). -/
theorem lowerSemicontinuous_probabilityMeasure_apply {U : Set E} (hU : IsOpen U) :
    LowerSemicontinuous (fun ν : ProbabilityMeasure E => (ν : Measure E) U) := by
  let := TopologicalSpace.pseudoMetrizableSpacePseudoMetric E
  intro P y hy
  exact eventually_lt_of_lt_liminf (lt_of_lt_of_le hy
    (ProbabilityMeasure.le_liminf_measure_open_of_tendsto (L := 𝓝 P) (μs := id) tendsto_id hU))

omit [PseudoMetrizableSpace E] [SeparableSpace E] in
/-- If every evaluation at an open set of a family of probability measures indexed by a Borel
space is lower semicontinuous, the family is measurable for the Giry `σ`-algebra. -/
theorem measurable_of_lowerSemicontinuous_apply {P : Type*} [TopologicalSpace P]
    (m : MeasurableSpace P) [@BorelSpace P _ m] (μ : P → Measure E)
    [∀ p, IsProbabilityMeasure (μ p)]
    (h : ∀ U : Set E, IsOpen U → LowerSemicontinuous fun p => μ p U) :
    @Measurable P (Measure E) m _ μ :=
  @Measurable.measure_of_isPiSystem_of_isProbabilityMeasure P E m _ μ _ {U : Set E | IsOpen U}
    BorelSpace.measurable_eq isPiSystem_isOpen
    (fun U hU => (h U hU).measurable)

omit [SeparableSpace E] in
/-- The Giry `σ`-algebra of `ProbabilityMeasure E` is contained in the Borel `σ`-algebra of the
weak topology. -/
theorem giry_le_borel_probabilityMeasure :
    (inferInstance : MeasurableSpace (ProbabilityMeasure E)) ≤ borel (ProbabilityMeasure E) := by
  have hb : @BorelSpace (ProbabilityMeasure E) _ (borel (ProbabilityMeasure E)) :=
    @BorelSpace.mk _ _ (borel _) rfl
  have hm : @Measurable (ProbabilityMeasure E) (Measure E) (borel (ProbabilityMeasure E)) _
      (fun ν => (ν : Measure E)) :=
    measurable_of_lowerSemicontinuous_apply (borel (ProbabilityMeasure E))
      (fun ν : ProbabilityMeasure E => (ν : Measure E))
      (fun _ hU => lowerSemicontinuous_probabilityMeasure_apply hU)
  exact hm.comap_le

omit [PseudoMetrizableSpace E] [SeparableSpace E] in
/-- `ν ↦ ∫ f dν` is measurable for the Giry `σ`-algebra, `f` bounded and continuous. -/
theorem measurable_integral_probabilityMeasure (f : E →ᵇ ℝ) :
    Measurable (fun ν : ProbabilityMeasure E => ∫ x, f x ∂(ν : Measure E)) := by
  have hcoe : Measurable (fun ν : ProbabilityMeasure E => (ν : Measure E)) :=
    measurable_subtype_coe
  have hfm : Measurable fun x => f x := f.continuous.measurable
  have h1 : Measurable fun ν : ProbabilityMeasure E =>
      ∫⁻ x, ENNReal.ofReal (f x) ∂(ν : Measure E) :=
    (Measure.measurable_lintegral (ENNReal.measurable_ofReal.comp hfm)).comp hcoe
  have h2 : Measurable fun ν : ProbabilityMeasure E =>
      ∫⁻ x, ENNReal.ofReal (-f x) ∂(ν : Measure E) :=
    (Measure.measurable_lintegral (ENNReal.measurable_ofReal.comp hfm.neg)).comp hcoe
  have h3 : (fun ν : ProbabilityMeasure E => ∫ x, f x ∂(ν : Measure E)) = fun ν : ProbabilityMeasure E =>
      (∫⁻ x, ENNReal.ofReal (f x) ∂(ν : Measure E)).toReal
        - (∫⁻ x, ENNReal.ofReal (-f x) ∂(ν : Measure E)).toReal := by
    funext ν
    exact integral_eq_lintegral_pos_part_sub_lintegral_neg_part (f.integrable _)
  rw [h3]
  exact h1.ennreal_toReal.sub h2.ennreal_toReal

/-- The generating sets `{ν | ∫ f dν ∈ V}`, `f` bounded continuous and `V ⊆ ℝ` open, of the weak
topology on probability measures. -/
def weakSubbasis (E : Type*) [TopologicalSpace E] [MeasurableSpace E] [OpensMeasurableSpace E] :
    Set (Set (ProbabilityMeasure E)) :=
  {s | ∃ (f : E →ᵇ ℝ) (V : Set ℝ), IsOpen V ∧ s = (fun ν : ProbabilityMeasure E =>
    ∫ x, f x ∂(ν : Measure E)) ⁻¹' V}

omit [PseudoMetrizableSpace E] [SeparableSpace E] in
/-- The topology of convergence in distribution is generated by the maps `ν ↦ ∫ f dν`. -/
theorem topology_eq_generateFrom_weakSubbasis :
    (inferInstance : TopologicalSpace (ProbabilityMeasure E)) =
      generateFrom (weakSubbasis E) := by
  have hcont : ∀ f : E →ᵇ ℝ, @Continuous (ProbabilityMeasure E) ℝ (generateFrom (weakSubbasis E))
      _ (fun ν => ∫ x, f x ∂(ν : Measure E)) := fun f => by
    refine @continuous_def _ _ (generateFrom (weakSubbasis E)) _ _ |>.2 fun V hV => ?_
    exact isOpen_generateFrom_of_mem ⟨f, V, hV, rfl⟩
  refine le_antisymm (le_generateFrom ?_) ?_
  · rintro s ⟨f, V, hV, rfl⟩
    exact hV.preimage (ProbabilityMeasure.continuous_integral_boundedContinuousFunction f)
  · refine continuous_id_iff_le.1 ?_
    refine (@continuous_iff_continuousAt _ _ (generateFrom (weakSubbasis E)) _ _).2 fun ν => ?_
    refine ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.2 fun f => ?_
    exact @Continuous.continuousAt _ _ (generateFrom (weakSubbasis E)) _ _ _ (hcont f)

/-- The Borel `σ`-algebra of the weak topology on probability measures is contained in the Giry
`σ`-algebra. -/
theorem borel_le_giry_probabilityMeasure :
    borel (ProbabilityMeasure E) ≤ (inferInstance : MeasurableSpace (ProbabilityMeasure E)) := by
  refine MeasurableSpace.generateFrom_le fun O hO => ?_
  have hB := TopologicalSpace.isTopologicalBasis_of_subbasis
    (topology_eq_generateFrom_weakSubbasis (E := E))
  obtain ⟨s, hsB, hsc, rfl⟩ := hB.exists_countable_biUnion_of_isOpen hO
  refine MeasurableSet.biUnion hsc fun a ha => ?_
  obtain ⟨g, ⟨hgfin, hgsub⟩, rfl⟩ := hsB ha
  refine MeasurableSet.sInter hgfin.countable fun t ht => ?_
  obtain ⟨f, V, hV, rfl⟩ := hgsub ht
  exact (measurable_integral_probabilityMeasure f) hV.measurableSet

/-- The Borel `σ`-algebra of the weak topology on `ProbabilityMeasure E` is the Giry `σ`-algebra
(Kechris, Thm 17.24), for `E` separable pseudo-metrizable with its Borel `σ`-algebra. -/
instance borelSpace_probabilityMeasure_of_separable : BorelSpace (ProbabilityMeasure E) :=
  ⟨le_antisymm giry_le_borel_probabilityMeasure borel_le_giry_probabilityMeasure⟩

end Borel

end LatticeProb
