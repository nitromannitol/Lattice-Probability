import Mathlib.Probability.Distributions.Uniform
import LatticeProb.Prob.CondIndepEv

/-!
# σ-algebras determined almost surely by another σ-algebra

`LatticeProb.AEDeterminedSigma A G μ` says that every event of the σ-algebra `A` agrees almost
surely with an event of the σ-algebra `G`. For `A = σ(X)` and `G` this is the event form of
"`X` is almost surely determined by `G`".

Main results:
* `LatticeProb.ae_eq_set_of_condExp_eq_indOne`: if the conditional probability of an event `s`
  given `G` is, almost surely, the indicator of a `G`-event `t`, then `s` agrees almost surely
  with `t`.
* `LatticeProb.exists_ae_eq_set_of_condIndep_self`: if an event `s` agrees almost surely with `s'`,
  and `s` and `s'` are conditionally independent given `G`, then `s` agrees almost surely with an
  event of `G`.
* `LatticeProb.aeDeterminedSigma_of_condIndepEv_of_ae_eq`: if `X` and `Y` are conditionally
  independent given `G` and `X = Y` almost surely, then the σ-algebra generated by `X` is almost
  surely determined by `G`. Two conditionally independent copies that agree almost surely carry
  no information beyond the conditioning σ-algebra.

The core fact is that a conditional probability `P[s | G] = P[s | G]²` almost surely takes only the
values `0` and `1`, and the set where it equals `1` is a `G`-event that agrees with `s`.
-/

open MeasureTheory ProbabilityTheory MeasurableSpace Set Filter

namespace LatticeProb

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}

/-- The σ-algebra `A` is almost surely determined by `G` under `μ`: every event of `A` agrees
almost surely with some event of `G`. -/
def AEDeterminedSigma (A G : MeasurableSpace Ω) (μ : Measure[mΩ] Ω) : Prop :=
  ∀ s, MeasurableSet[A] s → ∃ t, MeasurableSet[G] t ∧ s =ᵐ[μ] t

/-- Sets that agree almost surely have indicator functions (with value `1`) that agree almost
surely. -/
lemma indOne_ae_eq_of_ae_eq {s t : Set Ω} (h : s =ᵐ[μ] t) :
    (s.indicator fun _ => (1 : ℝ)) =ᵐ[μ] t.indicator fun _ => (1 : ℝ) :=
  indicator_ae_eq_of_ae_eq_set h

/-- If the conditional probability of the event `s` given `G` agrees almost surely with the
indicator of a `G`-event `t`, then `s` agrees almost surely with `t`. -/
lemma ae_eq_set_of_condExp_eq_indOne [IsFiniteMeasure μ] {G : MeasurableSpace Ω}
    (hG : G ≤ mΩ) {s t : Set Ω} (hs : MeasurableSet[mΩ] s) (ht : MeasurableSet[G] t)
    (h : μ⟦s | G⟧ =ᵐ[μ] t.indicator fun _ => (1 : ℝ)) : s =ᵐ[μ] t := by
  have ht0 := hG t ht
  have key : ∀ u, MeasurableSet[G] u → μ.real (u ∩ s) = μ.real (u ∩ t) := by
    intro u hu
    have e := setIntegral_condExp hG (integrable_indOne (μ := μ) hs) hu
    rw [setIntegral_congr_ae (hG u hu) (h.mono fun x hx _ => hx), setIntegral_indicator ht0,
      setIntegral_indicator hs, setIntegral_const, setIntegral_const] at e
    simpa using e.symm
  have h1 := key t ht
  have h2 := key tᶜ ht.compl
  rw [compl_inter_self, measureReal_empty] at h2
  rw [inter_self] at h1
  rw [ae_eq_set]
  constructor
  · have e : s \ t = tᶜ ∩ s := by ext; simp [and_comm]
    rw [e]
    exact (measureReal_eq_zero_iff).1 h2
  · have e := measureReal_inter_add_sdiff (μ := μ) (s := t) hs
    rw [h1] at e
    exact (measureReal_eq_zero_iff).1 (by linarith)

/-- Set-level core of the two-copies criterion. If `s` agrees almost surely with `s'`, and `s` and
`s'` are conditionally independent given `G` (so `P[s ∩ s' | G] = P[s | G] · P[s' | G]` almost
surely), then `s` agrees almost surely with an event of `G`. -/
lemma exists_ae_eq_set_of_condIndep_self [IsProbabilityMeasure μ] {G : MeasurableSpace Ω}
    (hG : G ≤ mΩ) {s s' : Set Ω} (hs : MeasurableSet[mΩ] s)
    (hss' : s =ᵐ[μ] s') (h : μ⟦s ∩ s' | G⟧ =ᵐ[μ] μ⟦s | G⟧ * μ⟦s' | G⟧) :
    ∃ t, MeasurableSet[G] t ∧ s =ᵐ[μ] t := by
  set p := μ⟦s | G⟧ with hp
  have hq : μ⟦s' | G⟧ =ᵐ[μ] p := condExp_congr_ae (indOne_ae_eq_of_ae_eq hss'.symm)
  have hr : μ⟦s ∩ s' | G⟧ =ᵐ[μ] p := by
    refine condExp_congr_ae (indOne_ae_eq_of_ae_eq ?_)
    have := EventuallyEq.inter (EventuallyEq.refl _ s) hss'.symm
    rwa [inter_self] at this
  have hpp : ∀ᵐ x ∂μ, p x = p x * p x := by
    filter_upwards [hr, h, hq] with x h1 h2 h3
    have e := h1.symm.trans h2
    rw [Pi.mul_apply, h3] at e
    exact e
  refine ⟨p ⁻¹' {1}, stronglyMeasurable_condExp.measurable (measurableSet_singleton 1), ?_⟩
  refine ae_eq_set_of_condExp_eq_indOne hG hs
    (stronglyMeasurable_condExp.measurable (measurableSet_singleton 1)) ?_
  filter_upwards [hpp] with x hx
  have h01 : p x = 0 ∨ p x = 1 := by
    have : p x * (p x - 1) = 0 := by linear_combination -hx
    rcases mul_eq_zero.1 this with h | h
    · exact Or.inl h
    · exact Or.inr (by linarith)
  rcases h01 with h0 | h1
  · have : x ∉ p ⁻¹' {1} := by simp [h0]
    rw [indicator_of_notMem this]; exact h0
  · have : x ∈ p ⁻¹' {1} := by simp [h1]
    rw [indicator_of_mem this]; exact h1

/-- Two-copies criterion. Let `X` be measurable and `Y` be arbitrary, with `X` and `Y`
conditionally independent given `G` (in event form) and `X = Y` almost surely. Then the
σ-algebra generated by `X` is almost surely determined by `G`. -/
theorem aeDeterminedSigma_of_condIndepEv_of_ae_eq [IsProbabilityMeasure μ] {β : Type*}
    [mβ : MeasurableSpace β] {G : MeasurableSpace Ω} (hG : G ≤ mΩ) {X Y : Ω → β}
    (hX : Measurable[mΩ] X) (hXY : CondIndepEv G (mβ.comap X) (mβ.comap Y) μ)
    (heq : X =ᵐ[μ] Y) : AEDeterminedSigma (mβ.comap X) G μ := by
  rintro _ ⟨B, hB, rfl⟩
  refine exists_ae_eq_set_of_condIndep_self hG (hX hB) ?_ (hXY _ _ ⟨B, hB, rfl⟩
    ⟨B, hB, rfl⟩)
  rw [eventuallyEq_set]
  filter_upwards [heq] with x hx
  simp [hx]

namespace AEDeterminedSigmaExample

/-- The fair coin on `Bool`: a two-point probability space. -/
noncomputable def coin : Measure Bool := (PMF.uniformOfFintype Bool).toMeasure

instance : IsProbabilityMeasure coin := by
  unfold coin; infer_instance

/-- The hypotheses of `aeDeterminedSigma_of_condIndepEv_of_ae_eq` hold on the two-point space
`(Bool, coin)` with `G` the full σ-algebra and `X = Y = id`: `σ(X)` is contained in `G`, so any two
of its σ-algebras are conditionally independent given `G`, and `X = Y` holds trivially. -/
example : AEDeterminedSigma (MeasurableSpace.comap (id : Bool → Bool) inferInstance)
    inferInstance coin :=
  aeDeterminedSigma_of_condIndepEv_of_ae_eq (G := inferInstance) le_rfl measurable_id
    (condIndepEv_top (Measurable.comap_le measurable_id) (Measurable.comap_le measurable_id))
    (EventuallyEq.refl _ _)

end AEDeterminedSigmaExample

end LatticeProb
