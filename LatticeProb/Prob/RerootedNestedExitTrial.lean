import LatticeProb.Topology.RerootedExitWindowLaw
import LatticeProb.Prob.IntegratedConditionalLowerBound
import LatticeProb.Bonanno.MatedCRTHarmonic.GMS4cO.Lemma49Core

/-!
# Nested exit trials after a first hit, given the re-rooted forward window

Let `c` be a random continuous plane curve, proper almost surely (it leaves every compact set
as `|t| → ∞`), whose law is invariant under re-rooting at `z` and rescaling by `s`
(`t ↦ s⁻¹ (c (τ_z + s ^ 2 t) - z)`, with `τ_z` the first hit of `z`). Suppose that, for
every measurable set `S` of windows, the event that some ball of radius `a` lies in the
trace of `c` between its exits from `ball 0 1` and `ball 0 R` has probability at least `p`
on the event that the exit window of `c` at radius `1` lies in `S`, in integrated form.

Then the `k`-th nested exit trial of `c` after `τ_z`, with radii `r k = s` and
`r (k + 1) ≥ s R` and ball radius `s a`, has conditional probability at least `p` given the
forward window of `c` from `τ_z` until its exit from `ball z s`, re-rooted at `z`
(`rerootedExitWindow`). The conditioning σ-algebra is the completion of the σ-algebra
generated by this window, intersected with the ambient one.
-/

set_option autoImplicit false

open MeasureTheory Set Metric Filter Topology

namespace LatticeProb

open MatedCRTHarmonic.MatedCRT

/-- The forward window of `c` from its first hit `τ` of `z` until its first exit `T` from
`ball z R` after `τ`, re-rooted at `z`: the duration `T - τ` and the curve
`t ↦ c (τ + t) - z` observed on `[0, T - τ]`. -/
noncomputable def rerootedExitWindow (c : C(ℝ, ℂ)) (z : ℂ) (R : ℝ) : ℝ × C(ℝ, ℂ) :=
  (exitTimeAfter c (firstHit c z) z R - firstHit c z,
    realWindowCurve 0 (exitTimeAfter c (firstHit c z) z R - firstHit c z)
      (affineReroot z 1 0 c))

/-- The first hit of a fixed point by a measurable random curve is measurable. -/
theorem measurable_firstHit_const {Ω : Type*} [MeasurableSpace Ω] {c : Ω → C(ℝ, ℂ)}
    (hc : Measurable c) (z : ℂ) : Measurable fun ω => firstHit (c ω) z :=
  MatedCRTHarmonic.GMS4b.measurable_hitTime.comp (hc.prodMk measurable_const)

/-- Integrated form: on every preimage of the re-rooted forward window at radius `r k`, the
`k`-th nested exit trial after the first hit of `z` has probability at least `p` times the
probability of the preimage. -/
theorem rerootedExitWindow_nestedExitTrial_bound {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} {c : Ω → C(ℝ, ℂ)} (hc : Measurable c)
    (hprop : ∀ᵐ ω ∂P, Tendsto (c ω) (cocompact ℝ) (cocompact ℂ)) (z : ℂ) (r : ℕ → ℝ)
    (k : ℕ) (hs : 0 < r k) (hmap : P.map (fun ω => affineReroot z (r k) 0 (c ω)) = P.map c)
    {p a R : ℝ} (ha : 0 < a) (hR : r k * R ≤ r (k + 1))
    (hbound : ∀ S : Set (ℝ × C(ℝ, ℂ)), MeasurableSet S →
      ENNReal.ofReal p * P {ω | originExitWindow 1 (c ω) ∈ S} ≤
        P ({ω | originExitWindow 1 (c ω) ∈ S} ∩
          {ω | ∃ x, ball x a ⊆ c ω '' Icc (exitTimeAfter (c ω) 0 0 1)
            (exitTimeAfter (c ω) 0 0 R)}))
    {S : Set (ℝ × C(ℝ, ℂ))} (hS : MeasurableSet S) :
    ENNReal.ofReal p * P {ω | rerootedExitWindow (c ω) z (r k) ∈ S} ≤
      P ({ω | rerootedExitWindow (c ω) z (r k) ∈ S} ∩
        nestedExitTrialEvent (fun ω => ⇑(c ω)) (fun ω => firstHit (c ω) z) z r (r k * a) k) := by
  set ĉ : Ω → C(ℝ, ℂ) := fun ω => affineReroot z (r k) 0 (c ω) with hĉ_def
  have hĉ : Measurable ĉ := (MatedCRTHarmonic.L43O.measurable_affineReroot z (r k) 0).comp hc
  have hS' : MeasurableSet (spaceTimeScale (r k) ⁻¹' S) := measurable_spaceTimeScale (r k) hS
  have h1 := originExitWindow_ball_bound_of_map_eq hc.aemeasurable hĉ.aemeasurable hmap ha hS'
    (hbound _ hS')
  have hex : ∀ᵐ ω ∂P, ∀ r' : ℝ, ∃ t, firstHit (c ω) z ≤ t ∧ c ω t ∉ ball z r' :=
    hprop.mono fun ω hω r' => exists_exit_of_tendsto_cocompact hω _ z r'
  have hid : ∀ᵐ ω ∂P, rerootedExitWindow (c ω) z (r k) =
      spaceTimeScale (r k) (originExitWindow 1 (ĉ ω)) :=
    hex.mono fun ω hω => rerootedExitWindow_eq_spaceTimeScale (c ω) z hs (hω (r k))
  have hset : {ω | rerootedExitWindow (c ω) z (r k) ∈ S} =ᵐ[P]
      {ω | originExitWindow 1 (ĉ ω) ∈ spaceTimeScale (r k) ⁻¹' S} := by
    filter_upwards [hid] with ω hω
    change (rerootedExitWindow (c ω) z (r k) ∈ S) =
      (spaceTimeScale (r k) (originExitWindow 1 (ĉ ω)) ∈ S)
    rw [hω]
  have hsub : ({ω | originExitWindow 1 (ĉ ω) ∈ spaceTimeScale (r k) ⁻¹' S} ∩
      {ω | ∃ x, ball x a ⊆ ĉ ω '' Icc (exitTimeAfter (ĉ ω) 0 0 1)
        (exitTimeAfter (ĉ ω) 0 0 R)}) ≤ᵐ[P]
      ({ω | rerootedExitWindow (c ω) z (r k) ∈ S} ∩
        nestedExitTrialEvent (fun ω => ⇑(c ω)) (fun ω => firstHit (c ω) z) z r (r k * a) k) := by
    filter_upwards [hid, hex] with ω hω hωex
    intro hmem
    obtain ⟨hw, hb⟩ := hmem
    refine ⟨?_, mem_nestedExitTrialEvent_of_affineReroot z r k hs hR hωex hb⟩
    change rerootedExitWindow (c ω) z (r k) ∈ S
    rw [hω]
    exact hw
  calc ENNReal.ofReal p * P {ω | rerootedExitWindow (c ω) z (r k) ∈ S}
      = ENNReal.ofReal p * P {ω | originExitWindow 1 (ĉ ω) ∈ spaceTimeScale (r k) ⁻¹' S} := by
        rw [measure_congr hset]
    _ ≤ _ := h1
    _ ≤ _ := measure_mono_ae hsub

/-- Conditional form: the `k`-th nested exit trial after the first hit of `z` has
conditional probability at least `p` given the re-rooted forward window at radius `r k`. -/
theorem le_condExp_nestedExitTrial_rerootedExitWindow {Ω : Type*} [m : MeasurableSpace Ω]
    {P : Measure Ω} [IsFiniteMeasure P] {c : Ω → C(ℝ, ℂ)} (hc : Measurable c)
    (hprop : ∀ᵐ ω ∂P, Tendsto (c ω) (cocompact ℝ) (cocompact ℂ)) (z : ℂ) (r : ℕ → ℝ)
    (k : ℕ) (hs : 0 < r k) (hmap : P.map (fun ω => affineReroot z (r k) 0 (c ω)) = P.map c)
    {p a R : ℝ} (ha : 0 < a) (hR : r k * R ≤ r (k + 1))
    (hbound : ∀ S : Set (ℝ × C(ℝ, ℂ)), MeasurableSet S →
      ENNReal.ofReal p * P {ω | originExitWindow 1 (c ω) ∈ S} ≤
        P ({ω | originExitWindow 1 (c ω) ∈ S} ∩
          {ω | ∃ x, ball x a ⊆ c ω '' Icc (exitTimeAfter (c ω) 0 0 1)
            (exitTimeAfter (c ω) 0 0 R)})) :
    ∀ᵐ ω ∂P, p ≤ P[(nestedExitTrialEvent (fun ω => ⇑(c ω)) (fun ω => firstHit (c ω) z) z r
        (r k * a) k).indicator (fun _ => (1 : ℝ)) |
      eventuallyMeasurableSpace (MeasurableSpace.comap
        (fun ω => rerootedExitWindow (c ω) z (r k)) inferInstance) (ae P) ⊓ m] ω :=
  le_condExp_indicator_of_forall_preimage (fun ω => rerootedExitWindow (c ω) z (r k))
    (measurableSet_nestedExitTrialEvent_complex hc (measurable_firstHit_const hc z) z r
      (mul_pos hs ha) k)
    (fun _ hS => rerootedExitWindow_nestedExitTrial_bound hc hprop z r k hs hmap ha hR hbound hS)

end LatticeProb
