import Mathlib
import LatticeProb.Prob.MarkovPathKernelStrong

/-!
# Paths of a Markov path kernel with nonconstant initial segments have no limit

Let `K : E → Prob C(ℝ≥0, E)` be a continuous family of path laws with the Markov property at every
integer time (`MarkovAt K z n`, `n : ℕ`).  Let `H : C(ℝ≥0, E) → ℝ` be a continuous functional with
values in `[0, 1]`, depending only on the restriction of a path to `[0, 1]`, such that

* `H (x (n + ·)) → 0` as `n → ∞` along every path `x` that converges at infinity, and
* the mean `∫ H d(K w)` is positive for every starting point `w`.

(For instance `H w = min 1 (sup_{r ≤ 1} dist (w r) (w 0))`: positivity says that the path started at
`w` is not constant on `[0, 1]` with positive probability.)  Then `K z`-almost every path has no
limit at infinity.

The proof is the conditional Borel–Cantelli lemma of Lévy for the events `{H (x (n + ·)) > a}`, whose
conditional probabilities given the stopped path at time `n` are `K (x n) {H > a} ≥ ∫ H d(K (x n)) - a`
by the Markov property, and are bounded below along a convergent path since `w ↦ ∫ H d(K w)` is
continuous and positive.

## Main results

* `stoppedPathFiltrationNat`: the filtration of stopped paths at the integer times.
* `condExp_indicator_pathShift_ae_eq`: Markov property at a deterministic time in conditional
  expectation form.
* `ae_not_exists_limit_of_markovAt_nat`: the no-limit statement above.
-/

open MeasureTheory Filter Topology ProbabilityTheory
open scoped BoundedContinuousFunction ENNReal NNReal

namespace LatticeProb

attribute [local instance] dUnifMetricSpace

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
  [MeasurableSpace C(ℝ≥0, E)] [BorelSpace C(ℝ≥0, E)]

/-- The filtration of the path space generated by the stopped paths `x (· ∧ n)` at the integer
times `n`. -/
def stoppedPathFiltrationNat : Filtration ℕ (inferInstance : MeasurableSpace C(ℝ≥0, E)) where
  seq n := (stoppedPathFiltration (E := E)) (n : ℝ≥0)
  mono' _ _ hmn := (stoppedPathFiltration (E := E)).mono (by exact_mod_cast hmn)
  le' n := (stoppedPathFiltration (E := E)).le _

/-- **The Markov property at a deterministic time, in conditional expectation form.**  If `K z` has
the Markov property at the integer time `n`, then for a measurable set `S` of paths the conditional
probability that the shifted path `x (n + ·)` lies in `S` given the stopped path `x (· ∧ n)` is
`K (x n) S`. -/
theorem condExp_indicator_pathShift_ae_eq {K : E → ProbabilityMeasure C(ℝ≥0, E)}
    (hK : Continuous K) {z : E} {n : ℕ} (hM : MarkovAt K z (n : ℝ≥0)) {S : Set C(ℝ≥0, E)}
    (hS : MeasurableSet S) :
    (K z : Measure C(ℝ≥0, E))[((fun x => pathShift x (n : ℝ≥0)) ⁻¹' S).indicator
        (1 : C(ℝ≥0, E) → ℝ) | stoppedPathFiltrationNat n] =ᵐ[(K z : Measure C(ℝ≥0, E))]
      fun x => ((K (x (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal := by
  classical
  have hshift : Measurable fun x : C(ℝ≥0, E) => pathShift x (n : ℝ≥0) :=
    (continuous_pathShift_uncurry.comp (continuous_id.prodMk continuous_const)).measurable
  have hA : MeasurableSet ((fun x => pathShift x (n : ℝ≥0)) ⁻¹' S) := hshift hS
  have hKm : Measurable fun q : C(ℝ≥0, E) =>
      ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal :=
    ((Measure.measurable_coe hS).comp (measurable_measure_comp_of_continuous hK
      (r := fun q : C(ℝ≥0, E) => q (n : ℝ≥0))
      (continuous_eval_const (n : ℝ≥0)).measurable)).ennreal_toReal
  have hle : ∀ q : C(ℝ≥0, E), ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal ≤ 1 := fun q => by
    simpa using ENNReal.toReal_mono ENNReal.one_ne_top
      (prob_le_one (μ := (K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E))) (s := S))
  have hfi : Integrable (((fun x => pathShift x (n : ℝ≥0)) ⁻¹' S).indicator
      (1 : C(ℝ≥0, E) → ℝ)) (K z : Measure C(ℝ≥0, E)) :=
    (integrable_const (1 : ℝ)).indicator hA
  have hgi : Integrable (fun q : C(ℝ≥0, E) =>
      ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal) (K z : Measure C(ℝ≥0, E)) :=
    Integrable.mono' (integrable_const (1 : ℝ)) hKm.aestronglyMeasurable
      (Eventually.of_forall fun q => by
        rw [Real.norm_of_nonneg ENNReal.toReal_nonneg]
        exact hle q)
  have hgm : Measurable[stoppedPathFiltrationNat n] fun q : C(ℝ≥0, E) =>
      ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal := by
    have h1 : Measurable[stoppedPathFiltrationNat n] fun x : C(ℝ≥0, E) => stopPath x (n : ℝ≥0) :=
      comap_measurable _
    have hcomp : (fun q : C(ℝ≥0, E) => ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal) =
        (fun q : C(ℝ≥0, E) => ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal) ∘
          (fun x : C(ℝ≥0, E) => stopPath x (n : ℝ≥0)) := by
      funext x
      simp [stopPath]
    rw [hcomp]
    exact hKm.comp h1
  refine (ae_eq_condExp_of_forall_setIntegral_eq (stoppedPathFiltrationNat.le n) hfi
    (fun s _ _ => hgi.integrableOn) ?_ hgm.stronglyMeasurable.aestronglyMeasurable).symm
  rintro s ⟨B, hB, rfl⟩ _
  let g' : C(ℝ≥0, E) × C(ℝ≥0, E) → ℝ := fun p =>
    B.indicator (1 : C(ℝ≥0, E) → ℝ) p.1 * S.indicator (1 : C(ℝ≥0, E) → ℝ) p.2
  have hg'm : Measurable g' :=
    ((measurable_one.indicator hB).comp measurable_fst).mul
      ((measurable_one.indicator hS).comp measurable_snd)
  have hg'b : ∀ p, ‖g' p‖ ≤ 1 := fun p => by
    simp only [g', Set.indicator_apply, Pi.one_apply]
    split_ifs <;> simp
  have key := MarkovAt.integral_eq_of_measurable hK hM hg'm hg'b
  have hpre : MeasurableSet ((fun x : C(ℝ≥0, E) => stopPath x (n : ℝ≥0)) ⁻¹' B) :=
    (continuous_stopPath_uncurry.comp (continuous_id.prodMk continuous_const)).measurable hB
  have hL : ∀ x : C(ℝ≥0, E), g' (stopPath x (n : ℝ≥0), pathShift x (n : ℝ≥0)) =
      ((fun x : C(ℝ≥0, E) => stopPath x (n : ℝ≥0)) ⁻¹' B).indicator
        (((fun x => pathShift x (n : ℝ≥0)) ⁻¹' S).indicator (1 : C(ℝ≥0, E) → ℝ)) x := by
    intro x
    simp only [g', Set.indicator_apply, Set.mem_preimage, Pi.one_apply]
    split_ifs <;> simp
  have hR : ∀ x : C(ℝ≥0, E), ∫ w, g' (stopPath x (n : ℝ≥0), w) ∂(K (x (n : ℝ≥0)) :
      Measure C(ℝ≥0, E)) = ((fun x : C(ℝ≥0, E) => stopPath x (n : ℝ≥0)) ⁻¹' B).indicator
        (fun q : C(ℝ≥0, E) => ((K (q (n : ℝ≥0)) : Measure C(ℝ≥0, E)) S).toReal) x := by
    intro x
    simp only [g', Set.indicator_apply, Set.mem_preimage]
    split_ifs
    · simpa [Set.indicator_apply, Measure.real] using
        integral_indicator_one (μ := (K (x (n : ℝ≥0)) : Measure C(ℝ≥0, E))) hS
    · simp
  simp only [hL, hR] at key
  rw [integral_indicator hpre, integral_indicator hpre] at key
  exact key.symm

/-- The event that the shifted path `x (k + ·)` lies in `S`, indexed by `k + 1`, with the empty
set at index `0`. -/
def shiftEvent (S : Set C(ℝ≥0, E)) : ℕ → Set C(ℝ≥0, E)
  | 0 => ∅
  | k + 1 => (fun x => pathShift x (k : ℝ≥0)) ⁻¹' S

/-- A `[0, 1]`-valued measurable function has mean at most `a` plus the probability that it exceeds
`a`. -/
theorem integral_le_add_toReal_measure_gt {X : Type*} [MeasurableSpace X] {ν : Measure X}
    [IsProbabilityMeasure ν] {H : X → ℝ} (hHm : Measurable H) (h0 : ∀ w, 0 ≤ H w)
    (h1 : ∀ w, H w ≤ 1) {a : ℝ} (ha : 0 ≤ a) :
    ∫ w, H w ∂ν ≤ a + (ν {w | a < H w}).toReal := by
  classical
  have hS : MeasurableSet {w | a < H w} := measurableSet_lt measurable_const hHm
  have hint : Integrable H ν :=
    Integrable.mono' (integrable_const (1 : ℝ)) hHm.aestronglyMeasurable
      (Eventually.of_forall fun w => by
        rw [Real.norm_of_nonneg (h0 w)]
        exact h1 w)
  have hind : Integrable ({w | a < H w}.indicator (1 : X → ℝ)) ν :=
    (integrable_const (1 : ℝ)).indicator hS
  calc ∫ w, H w ∂ν ≤ ∫ w, (a + {w | a < H w}.indicator (1 : X → ℝ) w) ∂ν := by
        refine integral_mono hint ((integrable_const _).add hind) fun w => ?_
        by_cases hw : a < H w
        · have hw' : w ∈ {w | a < H w} := hw
          simp only [Set.indicator_of_mem hw', Pi.one_apply]
          linarith [h1 w]
        · have hw' : w ∉ {w | a < H w} := hw
          simp only [Set.indicator_of_notMem hw']
          linarith [not_lt.1 hw]
    _ = a + (ν {w | a < H w}).toReal := by
        rw [integral_add (integrable_const _) hind]
        simp [integral_indicator_one hS, Measure.real]

/-- **Paths of a Markov path kernel with nonconstant initial segments do not converge.**  See the
module documentation. -/
theorem ae_not_exists_limit_of_markovAt_nat {K : E → ProbabilityMeasure C(ℝ≥0, E)}
    (hK : Continuous K) {z : E} (hM : ∀ n : ℕ, MarkovAt K z (n : ℝ≥0))
    {H : C(ℝ≥0, E) → ℝ} (hHc : Continuous H) (hH0 : ∀ w, 0 ≤ H w) (hH1 : ∀ w, H w ≤ 1)
    (hHloc : ∀ w w' : C(ℝ≥0, E), (∀ r : ℝ≥0, r ≤ 1 → w r = w' r) → H w = H w')
    (hHlim : ∀ (x : C(ℝ≥0, E)) (L : E), Tendsto (fun u : ℝ≥0 => x u) atTop (𝓝 L) →
      Tendsto (fun n : ℕ => H (pathShift x (n : ℝ≥0))) atTop (𝓝 0))
    (hpos : ∀ w : E, 0 < ∫ y, H y ∂(K w : Measure C(ℝ≥0, E))) :
    ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ¬ ∃ L : E, Tendsto (fun u : ℝ≥0 => x u) atTop (𝓝 L) := by
  classical
  set μ : Measure C(ℝ≥0, E) := (K z : Measure C(ℝ≥0, E)) with hμ
  set h : E → ℝ := fun y => ∫ w, H w ∂(K y : Measure C(ℝ≥0, E)) with hh_def
  have hh : Continuous h :=
    continuous_integral_of_continuous_measure (X := C(ℝ≥0, E)) (τ := E) hK
      (G := fun p : C(ℝ≥0, E) × E => H p.1) (hHc.comp continuous_fst) (C := 1)
      (fun p => by rw [Real.norm_of_nonneg (hH0 _)]; exact hH1 _)
  have ha_pos : ∀ m : ℕ, 0 < (1 : ℝ) / ((m : ℝ) + 1) := fun m => by positivity
  set T : ℕ → Set C(ℝ≥0, E) := fun m => {w | 1 / ((m : ℝ) + 1) < H w} with hT
  have hTm : ∀ m, MeasurableSet (T m) := fun m => measurableSet_lt measurable_const hHc.measurable
  set p : ℕ → E → ℝ := fun m y => ((K y : Measure C(ℝ≥0, E)) (T m)).toReal with hp
  have hp0 : ∀ (m : ℕ) (y : E), 0 ≤ p m y := fun _ _ => ENNReal.toReal_nonneg
  have hp_ge : ∀ (m : ℕ) (y : E), h y - 1 / ((m : ℝ) + 1) ≤ p m y := fun m y => by
    have h1 := integral_le_add_toReal_measure_gt (ν := (K y : Measure C(ℝ≥0, E)))
      hHc.measurable hH0 hH1 (ha_pos m).le
    have h2 : p m y = ((K y : Measure C(ℝ≥0, E)) {w | 1 / ((m : ℝ) + 1) < H w}).toReal := rfl
    have h3 : h y = ∫ w, H w ∂(K y : Measure C(ℝ≥0, E)) := rfl
    linarith
  -- events and their measurability
  have hs_meas : ∀ m n, MeasurableSet[stoppedPathFiltrationNat n] (shiftEvent (T m) n) := by
    intro m n
    cases n with
    | zero => exact @MeasurableSet.empty _ (stoppedPathFiltrationNat (E := E) 0)
    | succ k =>
      have hT' : MeasurableSet ((fun q : C(ℝ≥0, E) => pathShift q (k : ℝ≥0)) ⁻¹' T m) :=
        (continuous_pathShift_uncurry.comp
          (continuous_id.prodMk continuous_const)).measurable (hTm m)
      refine ⟨_, hT', ?_⟩
      ext x
      simp only [Set.mem_preimage, shiftEvent, hT, Set.mem_ofPred_eq]
      rw [hHloc (pathShift (stopPath x ((k + 1 : ℕ) : ℝ≥0)) (k : ℝ≥0)) (pathShift x (k : ℝ≥0))
        (fun r hr => by
          simp only [pathShift_apply, stopPath_apply]
          rw [min_eq_left (by push_cast; gcongr)])]
  have hcond : ∀ m k, (μ[(shiftEvent (T m) (k + 1)).indicator (1 : C(ℝ≥0, E) → ℝ) |
      stoppedPathFiltrationNat k]) =ᵐ[μ] fun x => p m (x (k : ℝ≥0)) := fun m k =>
    condExp_indicator_pathShift_ae_eq hK (hM k) (hTm m)
  have hLevy : ∀ m, ∀ᵐ x ∂μ, (x ∈ limsup (shiftEvent (T m)) atTop ↔
      Tendsto (fun n => ∑ k ∈ Finset.range n, p m (x (k : ℝ≥0))) atTop atTop) := by
    intro m
    have h1 := ae_mem_limsup_atTop_iff (ℱ := stoppedPathFiltrationNat (E := E)) μ (hs_meas m)
    have h2 : ∀ᵐ x ∂μ, ∀ k : ℕ, (μ[(shiftEvent (T m) (k + 1)).indicator
        (1 : C(ℝ≥0, E) → ℝ) | stoppedPathFiltrationNat k]) x = p m (x (k : ℝ≥0)) :=
      ae_all_iff.2 (hcond m)
    filter_upwards [h1, h2] with x hx1 hx2
    rw [hx1]
    simp only [hx2]
  have hall := ae_all_iff.2 hLevy
  filter_upwards [hall] with x hx
  rintro ⟨L, hL⟩
  have hLn : Tendsto (fun k : ℕ => x (k : ℝ≥0)) atTop (𝓝 L) :=
    hL.comp tendsto_natCast_atTop_atTop
  have hhL : Tendsto (fun k : ℕ => h (x (k : ℝ≥0))) atTop (𝓝 (h L)) := (hh.tendsto L).comp hLn
  have hpL : 0 < h L := hpos L
  obtain ⟨m, hm⟩ := exists_nat_one_div_lt (show 0 < h L / 4 by positivity)
  have hev : ∀ᶠ k : ℕ in atTop, h L / 2 < h (x (k : ℝ≥0)) :=
    hhL.eventually_const_lt (by linarith)
  have hev2 : ∀ᶠ k : ℕ in atTop, h L / 4 ≤ p m (x (k : ℝ≥0)) :=
    hev.mono fun k hk => by
      have := hp_ge m (x (k : ℝ≥0))
      linarith
  have hsum : Tendsto (fun n => ∑ k ∈ Finset.range n, p m (x (k : ℝ≥0))) atTop atTop := by
    obtain ⟨N0, hN0⟩ := eventually_atTop.1 hev2
    have hlow : ∀ n, N0 ≤ n →
        ((n : ℝ) - N0) * (h L / 4) ≤ ∑ k ∈ Finset.range n, p m (x (k : ℝ≥0)) := by
      intro n hn
      induction n, hn using Nat.le_induction with
      | base =>
        rw [sub_self, zero_mul]
        exact Finset.sum_nonneg fun k _ => hp0 m (x (k : ℝ≥0))
      | succ n hn ih =>
        rw [Finset.sum_range_succ]
        have := hN0 n hn
        push_cast
        linarith
    refine tendsto_atTop_mono' atTop (eventually_atTop.2 ⟨N0, hlow⟩) ?_
    have h1 : Tendsto (fun n : ℕ => (n : ℝ) - N0) atTop atTop :=
      (tendsto_atTop_add_const_right _ (-(N0 : ℝ)) tendsto_natCast_atTop_atTop).congr
        fun n => by ring
    exact h1.atTop_mul_const (by positivity)
  have hlim := (hx m).2 hsum
  have hev3 : ∀ᶠ k : ℕ in atTop, H (pathShift x (k : ℝ≥0)) < 1 / ((m : ℝ) + 1) :=
    (hHlim x L hL).eventually (gt_mem_nhds (ha_pos m))
  obtain ⟨N, hN⟩ := eventually_atTop.1 hev3
  rw [mem_limsup_iff_frequently_mem, frequently_atTop] at hlim
  obtain ⟨k, hk, hxk⟩ := hlim (N + 1)
  cases k with
  | zero => omega
  | succ j =>
    have h1 : 1 / ((m : ℝ) + 1) < H (pathShift x (j : ℝ≥0)) := hxk
    have h2 := hN j (by omega)
    linarith

end LatticeProb
