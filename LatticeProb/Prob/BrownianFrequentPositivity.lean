import Mathlib
import LatticeProb.Prob.BrownianGermZeroOne

/-!
# A real Brownian motion is positive at arbitrarily small times

For a real Brownian motion `X` (`ProbabilityTheory.IsBrownianReal`), almost surely `X t > 0` for
times `t` decreasing to `0`, that is `∃ᶠ t in 𝓝[>] 0, 0 < X t`.

The proof uses Blumenthal's zero-one law for the germ σ-algebra at zero, stated as the explicit
hypothesis `hBlum` (Mörters–Peres, *Brownian Motion*, Theorem 2.7). The event
`⋂ₘ {X is positive at a rational time in (0, εₘ)}` lies in the germ σ-algebra and has probability at
least `1/2`, since `X q` is a centred Gaussian of positive variance for every positive time `q`, so
`P (X q > 0) = 1/2`.
-/

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology

noncomputable section

namespace LatticeProb

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The σ-algebra generated by the path of the process `X` on `[0, u]`. -/
@[reducible] def pathSigmaTo (X : ℝ≥0 → Ω → ℝ) (u : ℝ≥0) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (t : Set.Iic u) => X t ω) inferInstance

/-- The times `((n : ℝ≥0) + 1)⁻¹`, which decrease to `0`. -/
def freqEps (n : ℕ) : ℝ≥0 := ((n : ℝ≥0) + 1)⁻¹

lemma freqEps_pos (n : ℕ) : 0 < freqEps n := by
  unfold freqEps; positivity

lemma freqEps_antitone : Antitone freqEps := by
  intro m n hmn
  unfold freqEps
  exact inv_anti₀ (by positivity) (by exact_mod_cast Nat.add_le_add_right hmn 1)

lemma tendsto_freqEps : Tendsto freqEps atTop (𝓝 0) := by
  apply NNReal.tendsto_coe.1
  simp only [NNReal.coe_zero]
  refine tendsto_one_div_add_atTop_nhds_zero_nat.congr fun n => ?_
  simp [freqEps]

omit [MeasurableSpace Ω] in
lemma measurable_pathSigmaTo_coord {X : ℝ≥0 → Ω → ℝ} {u s : ℝ≥0} (hs : s ≤ u) :
    Measurable[pathSigmaTo X u] (X s) :=
  (measurable_pi_apply (⟨s, hs⟩ : Set.Iic u)).comp
    (comap_measurable (fun ω (t : Set.Iic u) => X t ω))

omit [MeasurableSpace Ω] in
lemma pathSigmaTo_mono (X : ℝ≥0 → Ω → ℝ) {u v : ℝ≥0} (huv : u ≤ v) :
    pathSigmaTo X u ≤ pathSigmaTo X v := by
  let g : (Set.Iic v → ℝ) → (Set.Iic u → ℝ) := fun h t => h ⟨t, t.2.trans huv⟩
  have hg : Measurable g := measurable_pi_iff.2 fun t => measurable_pi_apply _
  have hcomp : (fun ω (t : Set.Iic u) => X t ω) = g ∘ (fun ω (t : Set.Iic v) => X t ω) := rfl
  unfold pathSigmaTo
  rw [hcomp, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hg.comap_le

lemma pathSigmaTo_le (X : ℝ≥0 → Ω → ℝ) (hXm : ∀ t, Measurable (X t)) (u : ℝ≥0) :
    pathSigmaTo X u ≤ ‹MeasurableSpace Ω› :=
  (measurable_pi_iff.2 fun t : Set.Iic u => hXm t).comap_le

/-- The event that the real process `X` is positive at some rational time in `(0, u)`. -/
def positiveAtRationalBefore (X : ℝ≥0 → Ω → ℝ) (u : ℝ≥0) : Set Ω :=
  ⋃ (q : ℚ) (_ : 0 < q ∧ (q : ℝ) < u), {ω | 0 < X (Real.toNNReal (q : ℝ)) ω}

omit [MeasurableSpace Ω] in
/-- The event `positiveAtRationalBefore X u` is measurable for the σ-algebra of the path on `[0, u]`. -/
lemma measurableSet_positiveAtRationalBefore (X : ℝ≥0 → Ω → ℝ) (u : ℝ≥0) :
    MeasurableSet[pathSigmaTo X u] (positiveAtRationalBefore X u) := by
  refine MeasurableSet.iUnion fun q => MeasurableSet.iUnion fun hq => ?_
  have hle : Real.toNNReal (q : ℝ) ≤ u := Real.toNNReal_le_iff_le_coe.2 hq.2.le
  have hm : Measurable[pathSigmaTo X u] (X (Real.toNNReal (q : ℝ))) :=
    measurable_pathSigmaTo_coord hle
  exact hm measurableSet_Ioi

omit [MeasurableSpace Ω] in
/-- The events `positiveAtRationalBefore X (freqEps m)` decrease in `m`. -/
lemma positiveAtRationalBefore_anti (X : ℝ≥0 → Ω → ℝ) :
    Antitone fun m : ℕ => positiveAtRationalBefore X (freqEps m) := by
  intro m n hmn ω hω
  simp only [positiveAtRationalBefore, mem_iUnion] at hω ⊢
  obtain ⟨q, hq, h⟩ := hω
  exact ⟨q, ⟨hq.1, lt_of_lt_of_le hq.2 (freqEps_antitone hmn)⟩, h⟩

omit [MeasurableSpace Ω] in
/-- The intersection of the events `positiveAtRationalBefore X (freqEps m)` lies in the germ
σ-algebra at zero. -/
lemma measurableSet_germ_positiveAtRationalBefore (X : ℝ≥0 → Ω → ℝ) :
    MeasurableSet[⨅ n, pathSigmaTo X (freqEps n)]
      (⋂ m : ℕ, positiveAtRationalBefore X (freqEps m)) := by
  refine MeasurableSpace.measurableSet_iInf.2 fun n => ?_
  have heq : (⋂ m : ℕ, positiveAtRationalBefore X (freqEps m))
      = ⋂ m : ℕ, positiveAtRationalBefore X (freqEps (m + n)) := by
    apply Set.Subset.antisymm
    · intro ω hω
      exact mem_iInter.2 fun m => mem_iInter.1 hω (m + n)
    · intro ω hω
      exact mem_iInter.2 fun m => positiveAtRationalBefore_anti X (Nat.le_add_right m n)
        (mem_iInter.1 hω m)
  rw [heq]
  refine MeasurableSet.iInter fun m => ?_
  have hle : freqEps (m + n) ≤ freqEps n := freqEps_antitone (Nat.le_add_left n m)
  exact (pathSigmaTo_mono X hle) _ (measurableSet_positiveAtRationalBefore X _)

/-- The Gaussian law `N(0, t)` gives the half-line `(0, ∞)` mass `1/2`, for `t ≠ 0`. -/
lemma gaussianReal_zero_measure_Ioi {t : ℝ≥0} (ht : t ≠ 0) :
    gaussianReal 0 t (Ioi 0) = 2⁻¹ := by
  set μ := gaussianReal 0 t with hμ
  have hneg : μ.map (fun x : ℝ => -x) = μ := by
    rw [hμ, gaussianReal_map_neg, neg_zero]
  have h1 : μ (Iio 0) = μ (Ioi 0) := by
    have h' : μ.map (fun x : ℝ => -x) (Ioi 0) = μ (Ioi 0) := by rw [hneg]
    rw [Measure.map_apply measurable_neg measurableSet_Ioi] at h'
    have hset : (fun x : ℝ => -x) ⁻¹' Ioi 0 = Iio 0 := by
      ext x; simp
    rw [hset] at h'
    exact h'
  have h0 : μ {0} = 0 := by
    have hac := gaussianReal_absolutelyContinuous (0 : ℝ) ht
    exact hac (Real.volume_singleton)
  have hunion : (Iio (0 : ℝ) ∪ {0}) ∪ Ioi 0 = univ := by
    ext x
    rcases lt_trichotomy x 0 with h | h | h <;> simp [h]
  have hdisj1 : Disjoint (Iio (0 : ℝ)) {0} := by
    rw [Set.disjoint_singleton_right]; simp
  have hdisj2 : Disjoint (Iio (0 : ℝ) ∪ {0}) (Ioi 0) := by
    rw [Set.disjoint_union_left]
    constructor
    · exact Set.disjoint_left.2 fun x (hx : x < 0) (hy : 0 < x) => lt_asymm hy hx
    · rw [Set.disjoint_singleton_left]; simp
  have hsum : μ (Iio 0) + μ {0} + μ (Ioi 0) = 1 := by
    rw [← measure_univ (μ := μ), ← hunion, measure_union hdisj2 measurableSet_Ioi,
      measure_union hdisj1 (measurableSet_singleton 0)]
  rw [h0, h1, add_zero] at hsum
  have h2 : μ (Ioi 0) * 2 = 1 := by
    rw [mul_two, hsum]
  exact ENNReal.eq_inv_of_mul_eq_one_left h2

/-- For a real Brownian motion, the event `positiveAtRationalBefore X u` has probability at least
`1/2` for each `u > 0`. -/
lemma half_le_measure_positiveAtRationalBefore {X : ℝ≥0 → Ω → ℝ} {P : Measure Ω}
    [IsProbabilityMeasure P] (hX : IsBrownianReal X P) (u : ℝ≥0) (hu : 0 < u) :
    2⁻¹ ≤ P (positiveAtRationalBefore X u) := by
  obtain ⟨q, hq0, hq1⟩ := exists_rat_btwn (show (0 : ℝ) < (u : ℝ) from hu)
  have hq0q : (0 : ℚ) < q := by exact_mod_cast hq0
  have hsub : {ω | 0 < X (Real.toNNReal (q : ℝ)) ω} ⊆ positiveAtRationalBefore X u :=
    fun ω hω => mem_iUnion.2 ⟨q, mem_iUnion.2 ⟨⟨hq0q, hq1⟩, hω⟩⟩
  have hne : Real.toNNReal (q : ℝ) ≠ 0 := by
    rw [Ne, Real.toNNReal_eq_zero]; exact not_le.2 hq0
  have hlaw := hX.toIsPreBrownianReal.hasLaw_eval (Real.toNNReal (q : ℝ))
  have hpre : P {ω | 0 < X (Real.toNNReal (q : ℝ)) ω}
      = gaussianReal 0 (Real.toNNReal (q : ℝ)) (Ioi 0) := by
    rw [← hlaw.map_eq, Measure.map_apply_of_aemeasurable hlaw.aemeasurable measurableSet_Ioi]
    rfl
  calc (2⁻¹ : ℝ≥0∞) = gaussianReal 0 (Real.toNNReal (q : ℝ)) (Ioi 0) :=
        (gaussianReal_zero_measure_Ioi hne).symm
    _ = P {ω | 0 < X (Real.toNNReal (q : ℝ)) ω} := hpre.symm
    _ ≤ P (positiveAtRationalBefore X u) := measure_mono hsub

/-- **A real Brownian motion is positive at arbitrarily small times, almost surely.** For a real
Brownian motion `X` with measurable coordinates, almost surely `X t > 0` for a sequence of times `t`
decreasing to `0`, that is `∃ᶠ t in 𝓝[>] 0, 0 < X t`.

The hypothesis `hBlum` is Blumenthal's zero-one law for the germ σ-algebra at zero of `X`
(Mörters–Peres, *Brownian Motion*, Theorem 2.7): every event of the germ σ-algebra
`⨅ n, σ(X s : s ≤ 1/(n+1))` has probability `0` or `1`. -/
theorem ae_frequently_pos_of_isBrownianReal {X : ℝ≥0 → Ω → ℝ} {P : Measure Ω}
    (hX : IsBrownianReal X P) (hXm : ∀ t, Measurable (X t))
    (hBlum : ∀ A : Set Ω, MeasurableSet[⨅ n : ℕ, pathSigmaTo X (freqEps n)] A → P A = 0 ∨ P A = 1) :
    ∀ᵐ ω ∂P, ∃ᶠ t in 𝓝[>] (0 : ℝ≥0), 0 < X t ω := by
  have : IsProbabilityMeasure P := hX.toIsPreBrownianReal.isGaussianProcess.isProbabilityMeasure
  set A : Set Ω := ⋂ m : ℕ, positiveAtRationalBefore X (freqEps m) with hAdef
  have hAgerm : MeasurableSet[⨅ n, pathSigmaTo X (freqEps n)] A :=
    measurableSet_germ_positiveAtRationalBefore X
  have hAmeas : MeasurableSet A :=
    (pathSigmaTo_le X hXm (freqEps 0)) A ((iInf_le (fun n => pathSigmaTo X (freqEps n)) 0) A hAgerm)
  have hlow : (2⁻¹ : ℝ≥0∞) ≤ P A := by
    have hmeas : ∀ m : ℕ, NullMeasurableSet (positiveAtRationalBefore X (freqEps m)) P :=
      fun m => ((pathSigmaTo_le X hXm (freqEps m)) _
        (measurableSet_positiveAtRationalBefore X (freqEps m))).nullMeasurableSet
    have ht := tendsto_measure_iInter_atTop (μ := P) hmeas (positiveAtRationalBefore_anti X)
      ⟨0, measure_ne_top P _⟩
    exact ge_of_tendsto' ht fun m =>
      half_le_measure_positiveAtRationalBefore hX (freqEps m) (freqEps_pos m)
  have hone : P A = 1 := by
    rcases hBlum A hAgerm with h | h
    · exact absurd h (ne_of_gt (lt_of_lt_of_le (ENNReal.inv_pos.2 (by norm_num)) hlow))
    · exact h
  have hae : ∀ᵐ ω ∂P, ω ∈ A := ae_iff.2 ((prob_compl_eq_zero_iff hAmeas).2 hone)
  filter_upwards [hae] with ω hω
  refine Filter.frequently_iff.2 fun {U} hU => ?_
  obtain ⟨u, hu, hUu⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hU
  have hu0 : (0 : ℝ≥0) < u := hu
  obtain ⟨m, hm⟩ : ∃ m : ℕ, freqEps m < u := ((tendsto_order.1 tendsto_freqEps).2 u hu0).exists
  have hm' : ω ∈ positiveAtRationalBefore X (freqEps m) := mem_iInter.1 hω m
  simp only [positiveAtRationalBefore, mem_iUnion] at hm'
  obtain ⟨q, hq, hpos⟩ := hm'
  refine ⟨Real.toNNReal (q : ℝ), hUu ⟨Real.toNNReal_pos.2 (Rat.cast_pos.2 hq.1), ?_⟩, hpos⟩
  rw [← NNReal.coe_lt_coe, Real.coe_toNNReal _ (Rat.cast_nonneg.2 hq.1.le)]
  exact lt_trans hq.2 (NNReal.coe_lt_coe.2 hm)

/-- **Positive values at arbitrarily small times, unconditionally.** For a real Brownian motion
`X` with measurable coordinates, almost surely `0 < X t` for arbitrarily small `t > 0`. This is
`ae_frequently_pos_of_isBrownianReal` with Blumenthal's zero-one law `isTrivialSigma_iInf_bmPast`
(Mörters–Peres, *Brownian Motion*, Theorem 2.7) supplying the hypothesis `hBlum`. -/
theorem ae_frequently_pos_of_isBrownianReal_blumenthal {X : ℝ≥0 → Ω → ℝ} {P : Measure Ω}
    (hX : IsBrownianReal X P) (hXm : ∀ t, Measurable (X t)) :
    ∀ᵐ ω ∂P, ∃ᶠ t in 𝓝[>] (0 : ℝ≥0), 0 < X t ω :=
  ae_frequently_pos_of_isBrownianReal hX hXm (isTrivialSigma_iInf_bmPast hX hXm)

end LatticeProb

end
