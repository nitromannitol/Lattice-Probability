import Mathlib
import LatticeProb.Prob.CrossingTimesClock10
import LatticeProb.Prob.AELeSigma

/-!
# Past and future at the inverse crossing clock

Fix `t` and write `A_t = pathClockInv m · t`, `T = A_t.toNNReal`, `x^A = stopPath x T` and
`θ x = pathShift x T`.

*Deterministic part.*  If the infimum defining `A_t` is attained, `t ≤ crossClock m x T`, then the
path stopped at `T` has the same inverse crossing clock `A_u` for every `u ≤ t`
(`pathClockInv_stopPath_eq`), hence the same path read in its clock at times `u ≤ t`
(`clockPath_stopPath_eq`).

*Probabilistic part.*  Let `pastSigma m t` (`futureSigma m t`) be generated by the path read in its
clock at the rational times `≤ t` (`≥ t`).  Up to null sets, `pastSigma m t` together with
any variables that are determined by the stopped path lies in the σ-algebra of the stopped path
(`aeLeSigma_past`), and `futureSigma m t` together with any variable determined by the shifted path
lies in the σ-algebra of the shifted path, by the shift identity (`aeLeSigma_future`).  Combined
with the conditional independence of the shifted and the stopped path given `x (A_t)`
(`condIndepEv_pathClockInv`), the past and the future at `A_t` are conditionally independent given
`x (A_t)` (`condIndepEv_past_future`).
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace LatticeProb

attribute [local instance] dUnifMetricSpace

section Deterministic

variable {E : Type*} [MetricSpace E]

/-- The crossing clock of the path stopped at `T` agrees with that of the path up to time `T`. -/
theorem crossClock_stopPath_of_le (m : ℝ≥0∞) (x : C(ℝ≥0, E)) {s T : ℝ≥0} (hs : s ≤ T) :
    crossClock m (fun w => stopPath x T w) s = crossClock m (fun w => x w) s := by
  have h1 := crossClock_stopped m (stopPath x T) s
  have h2 := crossClock_stopped m x s
  have h3 : (fun w => (stopPath x T) (min w s)) = fun w => x (min w s) := by
    funext w
    rw [stopPath_apply, min_eq_left ((min_le_right w s).trans hs)]
  rw [← h1, h3, h2]

/-- If the infimum defining `A_t` is attained, then the path stopped at `T = A_t` has the same
inverse crossing clock `A_u` as the path, for `u ≤ t`. -/
theorem pathClockInv_stopPath_eq (m : ℝ≥0∞) (x : C(ℝ≥0, E)) (T : ℝ≥0) {u : ℝ≥0}
    (hu : (u : ℝ≥0∞) ≤ crossClock m (fun w => x w) T) :
    pathClockInv m (stopPath x T) u = pathClockInv m x u := by
  have hiff : ∀ s : ℝ≥0, ((u : ℝ≥0∞) ≤ crossClock m (fun w => stopPath x T w) s ↔
      (u : ℝ≥0∞) ≤ crossClock m (fun w => x w) s) := by
    intro s
    by_cases hs : s ≤ T
    · rw [crossClock_stopPath_of_le m x hs]
    · have hs' : T ≤ s := (not_le.1 hs).le
      exact ⟨fun _ => hu.trans (crossClock_mono m _ hs'),
        fun _ => hu.trans ((crossClock_stopPath_of_le m x le_rfl).symm.le.trans
          (crossClock_mono m _ hs'))⟩
  unfold pathClockInv clockInv
  simp only [hiff]

/-- Under the same attainment, the path stopped at `T = A_t` read in its clock agrees with the path
read in its clock at times `u ≤ t` with `A_u ≤ T`. -/
theorem clockPath_stopPath_eq (m : ℝ≥0∞) (x : C(ℝ≥0, E)) (T : ℝ≥0) {u : ℝ≥0}
    (hu : (u : ℝ≥0∞) ≤ crossClock m (fun w => x w) T)
    (hT : (pathClockInv m x u).toNNReal ≤ T) :
    clockPath m (fun w => stopPath x T w) u = clockPath m (fun w => x w) u := by
  have h := pathClockInv_stopPath_eq m x T hu
  show (stopPath x T) (pathClockInv m (stopPath x T) u).toNNReal = x (pathClockInv m x u).toNNReal
  rw [h, stopPath_apply, min_eq_left hT]

end Deterministic

section Probabilistic

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]

/-- The σ-algebra generated by the path read in its clock at the rational times `≤ t`. -/
@[instance_reducible]
def pastSigma (m : ℝ≥0∞) (t : ℝ≥0) : MeasurableSpace C(ℝ≥0, E) :=
  ⨆ q : ℚ, ⨆ (_ : ratTime q ≤ t),
    MeasurableSpace.comap (fun x : C(ℝ≥0, E) => clockPath m (fun u => x u) (ratTime q)) inferInstance

/-- The σ-algebra generated by the path read in its clock at the rational times `≥ t`. -/
@[instance_reducible]
def futureSigma (m : ℝ≥0∞) (t : ℝ≥0) : MeasurableSpace C(ℝ≥0, E) :=
  ⨆ q : ℚ, ⨆ (_ : t ≤ ratTime q),
    MeasurableSpace.comap (fun x : C(ℝ≥0, E) => clockPath m (fun u => x u) (ratTime q)) inferInstance

omit [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E] in
/-- The path read in its clock at `t` is the value of the path at `A_t`. -/
theorem clockPath_eq_value (m : ℝ≥0∞) (t : ℝ≥0) (x : C(ℝ≥0, E)) :
    clockPath m (fun u => x u) t = x (pathClockInv m x t).toNNReal := rfl

omit [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E] in
/-- A variable that is almost surely equal to the same function of the stopped path is, up to null
sets, determined by the stopped path. -/
theorem aeLeSigma_comap_stopPath {μ : Measure C(ℝ≥0, E)} {m : ℝ≥0∞} {t : ℝ≥0}
    {β : Type*} [MeasurableSpace β] {f : C(ℝ≥0, E) → β} (hf : Measurable f)
    (h : ∀ᵐ x ∂μ, f x = f (stopPath x (pathClockInv m x t).toNNReal)) :
    AELeSigma (MeasurableSpace.comap f inferInstance)
      (MeasurableSpace.comap
        (fun x : C(ℝ≥0, E) => stopPath x (pathClockInv m x t).toNNReal) inferInstance) μ :=
  AELeSigma.comap_of_ae_eq (hf.comp (comap_measurable _)) h

omit [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E] in
/-- A variable that is almost surely equal to a measurable function of the shifted path is, up to
null sets, determined by the shifted path. -/
theorem aeLeSigma_comap_shift {μ : Measure C(ℝ≥0, E)} {m : ℝ≥0∞} {t : ℝ≥0}
    {β : Type*} [MeasurableSpace β] {f : C(ℝ≥0, E) → β} {g : C(ℝ≥0, E) → β} (hg : Measurable g)
    (h : ∀ᵐ x ∂μ, f x = g (pathShift x (pathClockInv m x t).toNNReal)) :
    AELeSigma (MeasurableSpace.comap f inferInstance)
      (MeasurableSpace.comap
        (fun x : C(ℝ≥0, E) => pathShift x (pathClockInv m x t).toNNReal) inferInstance) μ :=
  AELeSigma.comap_of_ae_eq (hg.comp (comap_measurable _)) h

/-- **The past at `A_t`, up to null sets, lies in the σ-algebra of the stopped path**, together with
any measurable variables that are almost surely functions of the stopped path. -/
theorem aeLeSigma_past {μ : Measure C(ℝ≥0, E)} {m : ℝ≥0∞} {t : ℝ≥0}
    (hfin : ∀ᵐ x ∂μ, pathClockInv m x t < ⊤)
    (hatt : ∀ᵐ x ∂μ, (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    {ι : Type*} {p : ι → Prop} {D : ι → C(ℝ≥0, E) → ℝ} (hD : ∀ i, Measurable (D i))
    (hDs : ∀ i, p i → ∀ᵐ x ∂μ, D i x = D i (stopPath x (pathClockInv m x t).toNNReal)) :
    AELeSigma (pastSigma m t ⊔ ⨆ i, ⨆ (_ : p i), MeasurableSpace.comap (D i) inferInstance)
      (MeasurableSpace.comap
        (fun x : C(ℝ≥0, E) => stopPath x (pathClockInv m x t).toNNReal) inferInstance) μ := by
  refine AELeSigma.sup (AELeSigma.iSup fun q => AELeSigma.iSup_prop fun hq => ?_)
    (AELeSigma.iSup fun i => AELeSigma.iSup_prop fun hi => aeLeSigma_comap_stopPath (hD i)
      (hDs i hi))
  refine aeLeSigma_comap_stopPath (measurable_clockPath m (ratTime q)) ?_
  filter_upwards [hfin, hatt] with x hx1 hx2
  have hu : (ratTime q : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal :=
    (ENNReal.coe_le_coe.2 hq).trans hx2
  have hT : (pathClockInv m x (ratTime q)).toNNReal ≤ (pathClockInv m x t).toNNReal :=
    ENNReal.toNNReal_mono hx1.ne (clockInv_mono _ hq)
  exact (clockPath_stopPath_eq m x _ hu hT).symm

/-- **The future at `A_t`, up to null sets, lies in the σ-algebra of the shifted path**, together with
any measurable variable that is almost surely a function of the shifted path: this is the shift
identity at `A_t`. -/
theorem aeLeSigma_future {μ : Measure C(ℝ≥0, E)} {m : ℝ≥0∞} {t : ℝ≥0}
    (hrat : ∀ᵐ x ∂μ, ∀ q : ℚ, ShiftIdentity m t (ratTime q - t) x)
    {Df g : C(ℝ≥0, E) → ℝ} (hg : Measurable g)
    (hDg : ∀ᵐ x ∂μ, Df x = g (pathShift x (pathClockInv m x t).toNNReal)) :
    AELeSigma (futureSigma m t ⊔ MeasurableSpace.comap Df inferInstance)
      (MeasurableSpace.comap
        (fun x : C(ℝ≥0, E) => pathShift x (pathClockInv m x t).toNNReal) inferInstance) μ := by
  refine AELeSigma.sup (AELeSigma.iSup fun q => AELeSigma.iSup_prop fun hq => ?_)
    (aeLeSigma_comap_shift hg hDg)
  refine aeLeSigma_comap_shift (g := fun y => clockPath m (fun u => y u) (ratTime q - t))
    (measurable_clockPath m (ratTime q - t)) ?_
  filter_upwards [hrat] with x hx
  have h3 := (hx q).2.2
  rw [add_tsub_cancel_of_le hq] at h3
  exact h3.symm

/-- **Conditional independence of the past and the future at the inverse crossing clock**: under
`K z`, the path read in its clock at the rational times `≤ t`, together with any variables
determined by the stopped path, is conditionally independent of the path read in its clock at the
rational times `≥ t`, together with any variable determined by the shifted path, given `x (A_t)`. -/
theorem condIndepEv_past_future {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K)
    {z : E} (hM : ∀ t, MarkovAt K z t) (m : ℝ≥0∞) (t : ℝ≥0)
    (hfin : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), pathClockInv m x t < ⊤)
    (hatt : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    (hrat : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ∀ q : ℚ, ShiftIdentity m t (ratTime q - t) x)
    {ι : Type*} {p : ι → Prop} {D : ι → C(ℝ≥0, E) → ℝ} (hD : ∀ i, Measurable (D i))
    (hDs : ∀ i, p i → ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      D i x = D i (stopPath x (pathClockInv m x t).toNNReal))
    {Df g : C(ℝ≥0, E) → ℝ} (hg : Measurable g)
    (hDg : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      Df x = g (pathShift x (pathClockInv m x t).toNNReal)) :
    CondIndepEv
      (MeasurableSpace.comap
        (fun x : C(ℝ≥0, E) => x (pathClockInv m x t).toNNReal) inferInstance)
      (pastSigma m t ⊔ ⨆ i, ⨆ (_ : p i), MeasurableSpace.comap (D i) inferInstance)
      (futureSigma m t ⊔ MeasurableSpace.comap Df inferInstance)
      (K z : Measure C(ℝ≥0, E)) :=
  (condIndepEv_pathClockInv hK hM m t hfin).symm.of_aeLe (aeLeSigma_past hfin hatt hD hDs)
    (aeLeSigma_future hrat hg hDg)

end Probabilistic

end LatticeProb
