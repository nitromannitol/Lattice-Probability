/-!
# Dyadic ancestors and descendants of the squares around the origin

Let `D` be a uniform dyadic system of the plane, with coordinates `q ∈ DyadicCoord` (scale `s` and
two offset sequences), and let `S_k = squareAt q k 0` be its square of generation `k` containing the
origin. Gwynne, Miller and Sheffield (*An invariance principle for ergodic scale-free random
environments*, arXiv 1807.07515, Lemma 2.8) transfer an event `E(S)` which almost surely occurs for
`S = S_k` for all large `k` to the dyadic ancestors of `S_k` of side at most `2 ^ l |S_k|` (also
those which do not belong to `D`) and to the dyadic descendants of `S_k` of side at least
`2 ^ (-l) |S_k|`.

This file proves the ancestor half, for every event of the square (no covariance is needed). The
proof is the stopping-time argument of arXiv 1807.07515: given the base offsets, the squares around
the origin form a chain driven by independent fair bits, each generation choosing one of the four
dyadic parents uniformly; we interleave the bits of the two coordinates into a single sequence of
fair bits, so that the dyadic ancestors within `l` generations are the states which the chain can
reach in at most `2 l` steps, and apply `LatticeProb.UniformChain.ae_eventually_forall_reach`.

## Main definitions
* `dyadicAncestors i a b ℓ`: the `4 ^ i` dyadic ancestors of side `2 ^ i ℓ` of the square
  `cornerSquare a b ℓ`.
* `dyadicDescendants i a b ℓ`: its `4 ^ i` dyadic descendants of side `2 ^ (-i) ℓ`.

## Main results
* `ae_dyadicLaw_iff`: Fubini for the law of the dyadic system: scale, two base offsets and one
  sequence of fair bits, interleaved between the two coordinates.
* `ae_eventually_forall_dyadicAncestors`: for a fixed configuration, if almost surely `E(S_k)` holds
  for all large `k`, then almost surely, for all large `k`, `E(S)` holds for every dyadic ancestor `S`
  of `S_k` of side at most `2 ^ l |S_k|` (arXiv 1807.07515, Lemma 2.8, first half).
* `ae_ae_eventually_forall_dyadicAncestors`: the same for a random cell configuration.
* `ae_ae_eventually_dyadicAncestor_side_four`: the dyadic ancestor of side `4 |S_k|` in which `S_k`
  occupies the second column and the second row (used in the proof of arXiv 1807.07515, Lemma 2.9).
-/

open MeasureTheory Filter Set Topology
open scoped ENNReal

namespace LatticeProb.CellConfigCappedSquare

open ReflectedGMS ReflectedGMS.GMS CellMass CappedSquare DyadicOffset UniformChain

/-! ### Dyadic ancestors and descendants of a square -/

/-- The dyadic ancestors of depth `i` of the square `cornerSquare a b ℓ` with lower left corner
`(a, b)` and side `ℓ`: the `4 ^ i` squares of side `2 ^ i ℓ` with lower left corner
`(a - n₁ ℓ, b - n₂ ℓ)`, `0 ≤ n₁, n₂ < 2 ^ i`, each of which has `cornerSquare a b ℓ` among its
dyadic descendants. They are ancestors in the full dyadic lattice generated by the square, whether or
not they belong to a given dyadic system (arXiv 1807.07515, §2.1). -/
def dyadicAncestors (i : ℕ) (a b ℓ : ℝ) : Set (Set ℂ) :=
  {S | ∃ n₁ n₂ : ℕ, n₁ < 2 ^ i ∧ n₂ < 2 ^ i ∧
    S = cornerSquare (a - n₁ * ℓ) (b - n₂ * ℓ) (2 ^ i * ℓ)}

/-- The dyadic descendants of depth `i` of the square `cornerSquare a b ℓ`: the `4 ^ i` squares of
side `ℓ / 2 ^ i` of the dyadic subdivision of depth `i` of the square. -/
def dyadicDescendants (i : ℕ) (a b ℓ : ℝ) : Set (Set ℂ) :=
  {S | ∃ n₁ n₂ : ℕ, n₁ < 2 ^ i ∧ n₂ < 2 ^ i ∧
    S = cornerSquare (a + n₁ * (ℓ / 2 ^ i)) (b + n₂ * (ℓ / 2 ^ i)) (ℓ / 2 ^ i)}

/-- A depth-`i` dyadic descendant has `4⁻ⁱ` times the area of its parent. -/
theorem volume_dyadicDescendant {i : ℕ} {a b ℓ : ℝ} (hℓ : 0 ≤ ℓ)
    {S : Set ℂ} (hS : S ∈ dyadicDescendants i a b ℓ) :
    volume S * (4 : ℝ≥0∞) ^ i = volume (cornerSquare a b ℓ) := by
  obtain ⟨n₁, n₂, _, _, rfl⟩ := hS
  rw [volume_cornerSquare, volume_cornerSquare]
  have hp : (0 : ℝ) < (2 : ℝ) ^ i := by positivity
  have heq : (ℓ / (2 : ℝ) ^ i) * (ℓ / (2 : ℝ) ^ i) * (4 : ℝ) ^ i = ℓ * ℓ := by
    rw [show (4 : ℝ) = 2 * 2 by norm_num, mul_pow]
    field_simp
  have hfour : (4 : ℝ≥0∞) ^ i = ENNReal.ofReal ((4 : ℝ) ^ i) := by
    rw [ENNReal.ofReal_pow (by norm_num : (0 : ℝ) ≤ 4)]
    norm_num
  rw [← ENNReal.ofReal_mul (div_nonneg hℓ hp.le),
    hfour,
    ← ENNReal.ofReal_mul (mul_nonneg (div_nonneg hℓ hp.le) (div_nonneg hℓ hp.le)),
    heq, ENNReal.ofReal_mul hℓ]

/-- A dyadic descendant is contained in its parent square. -/
theorem dyadicDescendant_subset {i : ℕ} {a b ℓ : ℝ} (hℓ : 0 ≤ ℓ)
    {S : Set ℂ} (hS : S ∈ dyadicDescendants i a b ℓ) :
    S ⊆ cornerSquare a b ℓ := by
  obtain ⟨n₁, n₂, hn₁, hn₂, rfl⟩ := hS
  have hp : (0 : ℝ) < (2 : ℝ) ^ i := by positivity
  have hd : 0 ≤ ℓ / (2 : ℝ) ^ i := div_nonneg hℓ hp.le
  have hn₁' : (n₁ : ℝ) + 1 ≤ (2 : ℝ) ^ i := by exact_mod_cast hn₁
  have hn₂' : (n₂ : ℝ) + 1 ≤ (2 : ℝ) ^ i := by exact_mod_cast hn₂
  have hu₁ : ((n₁ : ℝ) + 1) * (ℓ / (2 : ℝ) ^ i) ≤ ℓ := by
    calc
      _ ≤ (2 : ℝ) ^ i * (ℓ / (2 : ℝ) ^ i) := mul_le_mul_of_nonneg_right hn₁' hd
      _ = ℓ := by field_simp
  have hu₂ : ((n₂ : ℝ) + 1) * (ℓ / (2 : ℝ) ^ i) ≤ ℓ := by
    calc
      _ ≤ (2 : ℝ) ^ i * (ℓ / (2 : ℝ) ^ i) := mul_le_mul_of_nonneg_right hn₂' hd
      _ = ℓ := by field_simp
  intro z hz
  obtain ⟨h₁, h₂, h₃, h₄⟩ := mem_cornerSquare.mp hz
  have hl₁ : 0 ≤ (n₁ : ℝ) * (ℓ / (2 : ℝ) ^ i) := mul_nonneg (by positivity) hd
  have hl₂ : 0 ≤ (n₂ : ℝ) * (ℓ / (2 : ℝ) ^ i) := mul_nonneg (by positivity) hd
  apply mem_cornerSquare.mpr
  constructor
  · linarith
  constructor
  · nlinarith
  constructor
  · linarith
  · nlinarith

theorem forall_mem_dyadicAncestors_iff {P : Set ℂ → Prop} {i : ℕ} {a b ℓ : ℝ} :
    (∀ S ∈ dyadicAncestors i a b ℓ, P S) ↔ ∀ n₁ n₂ : ℕ, n₁ < 2 ^ i → n₂ < 2 ^ i →
      P (cornerSquare (a - n₁ * ℓ) (b - n₂ * ℓ) (2 ^ i * ℓ)) :=
  ⟨fun h n₁ n₂ h₁ h₂ => h _ ⟨n₁, n₂, h₁, h₂, rfl⟩,
    fun h _ ⟨n₁, n₂, h₁, h₂, hS⟩ => hS ▸ h n₁ n₂ h₁ h₂⟩

/-! ### One coordinate of a dyadic parent step -/

theorem bit_false_eq_zero : bit false = 0 := by simp [bit]

theorem bit_true_eq_one : bit true = 1 := by simp [bit]

/-- **One coordinate of a dyadic parent step.** Let `y` be the point of the progression `c + p ℤ`
with `y ≤ 0 < y + p`. For a suitable bit `b`, the point of the progression `c - p b + 2 p ℤ` of the
next generation with the same property is `y - ε p`, for a prescribed `ε ∈ {0, 1}`. -/
theorem exists_latticeFloor_parent {p : ℝ} (hp : 0 < p) (c : ℝ) {ε : ℕ} (hε : ε < 2) :
    ∃ b : Bool, latticeFloor (c - p * bit b) (2 * p) 0 = latticeFloor c p 0 - ε * p := by
  obtain ⟨m, hm⟩ := latticeFloor_mem c p 0
  have hle := latticeFloor_le hp c 0
  have hlt := lt_latticeFloor_add hp c 0
  have hε1 : (ε : ℝ) ≤ 1 := by exact_mod_cast Nat.le_of_lt_succ hε
  have h1 : 0 ≤ (ε : ℝ) * p := mul_nonneg (Nat.cast_nonneg ε) hp.le
  have h2 : (ε : ℝ) * p ≤ p := mul_le_of_le_one_left hp.le hε1
  have key : ∀ (b : Bool) (k : ℤ),
      latticeFloor c p 0 - ε * p = c - p * bit b + k * (2 * p) →
      latticeFloor (c - p * bit b) (2 * p) 0 = latticeFloor c p 0 - ε * p := fun b k hk =>
    (eq_latticeFloor (by linarith) ⟨k, hk⟩ (by linarith) (by linarith)).symm
  obtain ⟨k, hk | hk⟩ := Int.even_or_odd' m
  · interval_cases ε
    · exact ⟨false, key false k (by rw [hm, hk, bit_false_eq_zero]; push_cast; ring)⟩
    · exact ⟨true, key true k (by rw [hm, hk, bit_true_eq_one]; push_cast; ring)⟩
  · interval_cases ε
    · exact ⟨true, key true (k + 1) (by rw [hm, hk, bit_true_eq_one]; push_cast; ring)⟩
    · exact ⟨false, key false k (by rw [hm, hk, bit_false_eq_zero]; push_cast; ring)⟩

/-- The lower left corner coordinate of the interval of generation `n` containing `0`, for the
dyadic grid of scale `s` whose generation-`n` offset is `a`. -/
noncomputable def originCorner (s a : ℝ) (n : ℕ) : ℝ :=
  latticeFloor (-((2 : ℝ) ^ s * a)) ((2 : ℝ) ^ (s + n)) 0

theorem gridFloor_natCast_zero (s : ℝ) (o : ℕ → ℝ) (n : ℕ) :
    gridFloor s o (n : ℤ) 0 = originCorner s (o n) n := by
  simp only [gridFloor, originCorner, Int.toNat_natCast, Int.cast_natCast]

theorem squareAt_natCast_zero (s : ℝ) (o₁ o₂ : ℕ → ℝ) (n : ℕ) :
    squareAt s o₁ o₂ (n : ℤ) 0 =
      cornerSquare (originCorner s (o₁ n) n) (originCorner s (o₂ n) n) ((2 : ℝ) ^ (s + n)) := by
  simp only [squareAt, Complex.zero_re, Complex.zero_im, gridFloor_natCast_zero, Int.cast_natCast]

theorem two_rpow_add_succ (s : ℝ) (n : ℕ) :
    (2 : ℝ) ^ (s + ((n + 1 : ℕ) : ℝ)) = 2 * (2 : ℝ) ^ (s + n) := by
  rw [Nat.cast_succ, ← add_assoc, Real.rpow_add_one two_ne_zero (s + (n : ℝ))]
  ring

theorem two_rpow_add_add (s : ℝ) (n i : ℕ) :
    (2 : ℝ) ^ (s + ((n + i : ℕ) : ℝ)) = 2 ^ i * (2 : ℝ) ^ (s + n) := by
  rw [Nat.cast_add, ← add_assoc, Real.rpow_add (by norm_num : (0 : ℝ) < 2) (s + (n : ℝ)) (i : ℝ),
    Real.rpow_natCast]
  ring

/-- The parent step of `originCorner`: moving the offset by `2 ^ n b` and passing to generation
`n + 1`, a suitable bit `b` moves the corner by `-ε 2 ^ (s + n)`, for a prescribed `ε ∈ {0, 1}`. -/
theorem exists_originCorner_parent (s a : ℝ) (n : ℕ) {ε : ℕ} (hε : ε < 2) :
    ∃ b : Bool, originCorner s (a + 2 ^ n * bit b) (n + 1) =
      originCorner s a n - ε * (2 : ℝ) ^ (s + n) := by
  have hp : (0 : ℝ) < (2 : ℝ) ^ (s + n) := by positivity
  obtain ⟨b, hb⟩ := exists_latticeFloor_parent hp (-((2 : ℝ) ^ s * a)) hε
  refine ⟨b, ?_⟩
  have h1 : -((2 : ℝ) ^ s * (a + 2 ^ n * bit b)) =
      -((2 : ℝ) ^ s * a) - (2 : ℝ) ^ (s + n) * bit b := by
    rw [Real.rpow_add (by norm_num : (0 : ℝ) < 2) s (n : ℝ), Real.rpow_natCast]
    ring
  unfold originCorner
  rw [h1, two_rpow_add_succ, hb]

/-! ### The interleaved parent chain -/

/-- The state of the interleaved parent chain: the offsets of the two coordinates, the generation
`n`, and whether the first coordinate has already moved to generation `n + 1`. -/
abbrev ParentState : Type := ℝ × ℝ × ℕ × Bool

/-- One step of the interleaved parent chain: the bit moves the offset of the first coordinate (at
even times) or of the second coordinate (at odd times, which completes the passage to the next
generation). -/
noncomputable def parentStep (σ : ParentState) (b : Bool) : ParentState :=
  cond σ.2.2.2 (σ.1, σ.2.1 + 2 ^ σ.2.2.1 * bit b, σ.2.2.1 + 1, false)
    (σ.1 + 2 ^ σ.2.2.1 * bit b, σ.2.1, σ.2.2.1, true)

theorem parentStep_false (a₁ a₂ : ℝ) (n : ℕ) (b : Bool) :
    parentStep (a₁, a₂, n, false) b = (a₁ + 2 ^ n * bit b, a₂, n, true) := rfl

theorem parentStep_true (a₁ a₂ : ℝ) (n : ℕ) (b : Bool) :
    parentStep (a₁, a₂, n, true) b = (a₁, a₂ + 2 ^ n * bit b, n + 1, false) := rfl

/-- The square of generation `n` around the origin of a state of the parent chain. -/
noncomputable def parentSquare (s : ℝ) (σ : ParentState) : Set ℂ :=
  cornerSquare (originCorner s σ.1 σ.2.2.1) (originCorner s σ.2.1 σ.2.2.1) ((2 : ℝ) ^ (s + σ.2.2.1))

/-- At even times the interleaved parent chain carries the offsets of generation `n` of the two
coordinates, built from the even and the odd bits. -/
theorem chain_parentStep_two_mul (x₁ x₂ : ℝ) (e : ℕ → Bool) (n : ℕ) :
    chain parentStep (x₁, x₂, 0, false) e (2 * n) =
      (offsetsL 1 x₁ (fun j => e (2 * j)) n, offsetsL 1 x₂ (fun j => e (2 * j + 1)) n, n,
        false) := by
  induction n with
  | zero => simp [chain, offsetsL]
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by ring]
    show parentStep (parentStep (chain parentStep (x₁, x₂, 0, false) e (2 * n)) (e (2 * n)))
      (e (2 * n + 1)) = _
    rw [ih, parentStep_false, parentStep_true]
    refine Prod.ext ?_ (Prod.ext ?_ rfl)
    · simp only [offsetsL, Finset.sum_range_succ]
      ring
    · simp only [offsetsL, Finset.sum_range_succ]
      ring

/-- **The dyadic ancestors are reachable.** From a state at an even time, every dyadic ancestor of
depth `i` of its square is the square of a state reached in `2 i` steps of the parent chain. -/
theorem exists_chain_parentStep_ancestor (s : ℝ) (i : ℕ) : ∀ (a₁ a₂ : ℝ) (n n₁ n₂ : ℕ),
    n₁ < 2 ^ i → n₂ < 2 ^ i → ∃ f : ℕ → Bool,
      (chain parentStep (a₁, a₂, n, false) f (2 * i)).2.2 = (n + i, false) ∧
      originCorner s (chain parentStep (a₁, a₂, n, false) f (2 * i)).1 (n + i) =
        originCorner s a₁ n - n₁ * (2 : ℝ) ^ (s + n) ∧
      originCorner s (chain parentStep (a₁, a₂, n, false) f (2 * i)).2.1 (n + i) =
        originCorner s a₂ n - n₂ * (2 : ℝ) ^ (s + n) := by
  induction i with
  | zero =>
    intro a₁ a₂ n n₁ n₂ h₁ h₂
    have h₁' : n₁ = 0 := by simpa using h₁
    have h₂' : n₂ = 0 := by simpa using h₂
    subst h₁' h₂'
    exact ⟨fun _ => false, rfl, by simp [chain], by simp [chain]⟩
  | succ i ih =>
    intro a₁ a₂ n n₁ n₂ h₁ h₂
    obtain ⟨b₁, hb₁⟩ := exists_originCorner_parent s a₁ n (Nat.mod_lt n₁ two_pos)
    obtain ⟨b₂, hb₂⟩ := exists_originCorner_parent s a₂ n (Nat.mod_lt n₂ two_pos)
    have h₁' : n₁ / 2 < 2 ^ i :=
      (Nat.div_lt_iff_lt_mul two_pos).2 (by rw [← pow_succ]; exact h₁)
    have h₂' : n₂ / 2 < 2 ^ i :=
      (Nat.div_lt_iff_lt_mul two_pos).2 (by rw [← pow_succ]; exact h₂)
    obtain ⟨g, hg1, hg2, hg3⟩ :=
      ih (a₁ + 2 ^ n * bit b₁) (a₂ + 2 ^ n * bit b₂) (n + 1) (n₁ / 2) (n₂ / 2) h₁' h₂'
    refine ⟨consBit (b₁, consBit (b₂, g)), ?_⟩
    have h2step : chain parentStep (a₁, a₂, n, false) (consBit (b₁, consBit (b₂, g))) 2 =
        (a₁ + 2 ^ n * bit b₁, a₂ + 2 ^ n * bit b₂, n + 1, false) := rfl
    have hshift : (fun t => consBit (b₁, consBit (b₂, g)) (2 + t)) = g := by
      funext t
      show consBit (b₁, consBit (b₂, g)) (2 + t) = g t
      rw [Nat.add_comm]
      rfl
    have hchain : chain parentStep (a₁, a₂, n, false) (consBit (b₁, consBit (b₂, g))) (2 * (i + 1))
        = chain parentStep (a₁ + 2 ^ n * bit b₁, a₂ + 2 ^ n * bit b₂, n + 1, false) g (2 * i) := by
      rw [show 2 * (i + 1) = 2 + 2 * i by ring, chain_add, h2step, hshift]
    rw [hchain]
    have hn : n + 1 + i = n + (i + 1) := by omega
    have hdiv₁ : (n₁ : ℝ) = ((n₁ % 2 : ℕ) : ℝ) + 2 * ((n₁ / 2 : ℕ) : ℝ) := by
      exact_mod_cast (Nat.mod_add_div n₁ 2).symm
    have hdiv₂ : (n₂ : ℝ) = ((n₂ % 2 : ℕ) : ℝ) + 2 * ((n₂ / 2 : ℕ) : ℝ) := by
      exact_mod_cast (Nat.mod_add_div n₂ 2).symm
    refine ⟨?_, ?_, ?_⟩
    · rw [hg1, hn]
    · rw [← hn, hg2, hb₁, two_rpow_add_succ, hdiv₁]
      ring
    · rw [← hn, hg3, hb₂, two_rpow_add_succ, hdiv₂]
      ring

/-- **Look-ahead along the squares around the origin, for fixed base offsets.** If almost surely
(over the interleaved bits) `E` holds for the squares around the origin of all large generations,
then almost surely, for all large generations `n`, `E` holds for every dyadic ancestor of depth at
most `l` of the square of generation `n`. -/
theorem ae_bitLaw_eventually_forall_ancestor (s x₁ x₂ : ℝ) (E : Set ℂ → Prop)
    (h : ∀ᵐ e ∂bitLaw, ∀ᶠ n : ℕ in atTop,
      E (cornerSquare (originCorner s (offsetsL 1 x₁ (fun j => e (2 * j)) n) n)
        (originCorner s (offsetsL 1 x₂ (fun j => e (2 * j + 1)) n) n) ((2 : ℝ) ^ (s + n))))
    (l : ℕ) :
    ∀ᵐ e ∂bitLaw, ∀ᶠ n : ℕ in atTop, ∀ i ≤ l, ∀ n₁ n₂ : ℕ, n₁ < 2 ^ i → n₂ < 2 ^ i →
      E (cornerSquare
        (originCorner s (offsetsL 1 x₁ (fun j => e (2 * j)) n) n - n₁ * (2 : ℝ) ^ (s + n))
        (originCorner s (offsetsL 1 x₂ (fun j => e (2 * j + 1)) n) n - n₂ * (2 : ℝ) ^ (s + n))
        (2 ^ i * (2 : ℝ) ^ (s + n))) := by
  have hlaw : choiceLaw Bool = bitLaw := rfl
  have hG : ∀ᵐ e ∂choiceLaw Bool, ∀ᶠ t in atTop, chain parentStep (x₁, x₂, 0, false) e t ∈
      {σ : ParentState | σ.2.2.2 = false → E (parentSquare s σ)} := by
    rw [hlaw]
    filter_upwards [h] with e he
    obtain ⟨N, hN⟩ := eventually_atTop.1 he
    refine eventually_atTop.2 ⟨2 * N, fun t ht => ?_⟩
    obtain ⟨n, rfl | rfl⟩ := Nat.even_or_odd' t
    · refine fun _ => ?_
      rw [chain_parentStep_two_mul]
      exact hN n (by omega)
    · refine fun hph => absurd hph ?_
      rw [show chain parentStep (x₁, x₂, 0, false) e (2 * n + 1) =
          parentStep (chain parentStep (x₁, x₂, 0, false) e (2 * n)) (e (2 * n)) from rfl,
        chain_parentStep_two_mul, parentStep_false]
      simp
  have hreach := ae_eventually_forall_reach parentStep (x₁, x₂, 0, false)
    {σ : ParentState | σ.2.2.2 = false → E (parentSquare s σ)} hG (2 * l)
  rw [hlaw] at hreach
  filter_upwards [hreach] with e he
  obtain ⟨N, hN⟩ := eventually_atTop.1 he
  refine eventually_atTop.2 ⟨N, fun n hn i hi n₁ n₂ h₁ h₂ => ?_⟩
  obtain ⟨f, hf1, hf2, hf3⟩ := exists_chain_parentStep_ancestor s i
    (offsetsL 1 x₁ (fun j => e (2 * j)) n) (offsetsL 1 x₂ (fun j => e (2 * j + 1)) n) n n₁ n₂
    h₁ h₂
  have hmem := hN (2 * n) (by omega) (2 * i) (by omega) f
  rw [chain_parentStep_two_mul] at hmem
  set σ' := chain parentStep
    (offsetsL 1 x₁ (fun j => e (2 * j)) n, offsetsL 1 x₂ (fun j => e (2 * j + 1)) n, n, false) f
    (2 * i) with hσ'
  have hphase : σ'.2.2.2 = false := congrArg Prod.snd hf1
  have hgen : σ'.2.2.1 = n + i := congrArg Prod.fst hf1
  have hE' : E (parentSquare s σ') := hmem hphase
  rw [parentSquare, hgen, hf2, hf3, two_rpow_add_add] at hE'
  exact hE'

/-! ### The law of the dyadic system through interleaved bits -/

/-- Re-indexing an i.i.d. family along an injective map gives an i.i.d. family with the same
marginal. -/
theorem infinitePi_const_map_comp_of_injective {ι κ X : Type*} [MeasurableSpace X]
    (μ : Measure X) [IsProbabilityMeasure μ] {f : ι → κ} (hf : Function.Injective f) :
    (Measure.infinitePi fun _ : κ => μ).map (fun e => e ∘ f) =
      Measure.infinitePi fun _ : ι => μ := by
  classical
  refine Measure.eq_infinitePi _ fun s t ht => ?_
  have hm : Measurable fun e : κ → X => e ∘ f :=
    measurable_pi_iff.mpr fun i => measurable_pi_apply (f i)
  rw [Measure.map_apply hm (MeasurableSet.pi s.countable_toSet fun i _ => ht i)]
  have e : (fun e : κ → X => e ∘ f) ⁻¹' Set.pi (↑s) t =
      Set.pi (↑(s.map ⟨f, hf⟩)) (Function.extend f t fun _ => Set.univ) := by
    ext e
    constructor
    · intro he
      refine Set.mem_pi.mpr fun j hj => ?_
      obtain ⟨i, hi, rfl⟩ := Finset.mem_map.mp (Finset.mem_coe.mp hj)
      show e (f i) ∈ Function.extend f t (fun _ => Set.univ) (f i)
      rw [hf.extend_apply]
      exact Set.mem_pi.mp he i (Finset.mem_coe.mpr hi)
    · intro he
      refine Set.mem_pi.mpr fun i hi => ?_
      have := Set.mem_pi.mp he (f i)
        (Finset.mem_coe.mpr (Finset.mem_map_of_mem (⟨f, hf⟩ : ι ↪ κ) (Finset.mem_coe.mp hi)))
      rwa [hf.extend_apply] at this
  rw [e, Measure.infinitePi_pi, Finset.prod_map]
  · refine Finset.prod_congr rfl fun i _ => ?_
    show μ (Function.extend f t (fun _ => Set.univ) (f i)) = μ (t i)
    rw [hf.extend_apply]
  · intro j hj
    obtain ⟨i, -, rfl⟩ := Finset.mem_map.mp hj
    show MeasurableSet (Function.extend f t (fun _ => Set.univ) (f i))
    rw [hf.extend_apply]
    exact ht i

/-- The even and the odd bits of a sequence of fair bits are two independent sequences of fair
bits. -/
theorem map_evenOdd_bitLaw :
    bitLaw.map (fun e : ℕ → Bool => ((fun i => e (2 * i)), fun i => e (2 * i + 1))) =
      bitLaw.prod bitLaw := by
  have hinj : Function.Injective (Sum.elim (fun i : ℕ => 2 * i) (fun i : ℕ => 2 * i + 1)) := by
    intro a b hab
    rcases a with a | a <;> rcases b with b | b <;>
      simp only [Sum.elim_inl, Sum.elim_inr] at hab
    · rw [show a = b by omega]
    · omega
    · omega
    · rw [show a = b by omega]
  have h1 : (bitLaw.map fun e : ℕ → Bool =>
      e ∘ Sum.elim (fun i : ℕ => 2 * i) (fun i : ℕ => 2 * i + 1)) =
      Measure.infinitePi fun _ : ℕ ⊕ ℕ => bitProb :=
    infinitePi_const_map_comp_of_injective bitProb hinj
  have h2 := LatticeProb.infinitePi_sum (X := fun _ : ℕ ⊕ ℕ => Bool) (fun _ => bitProb)
  have hm1 : Measurable fun e : ℕ → Bool =>
      e ∘ Sum.elim (fun i : ℕ => 2 * i) (fun i : ℕ => 2 * i + 1) :=
    measurable_pi_iff.mpr fun i => measurable_pi_apply _
  have hm2 : Measurable fun ω : ℕ ⊕ ℕ → Bool =>
      ((fun i : ℕ => ω (Sum.inl i)), fun i : ℕ => ω (Sum.inr i)) :=
    (measurable_pi_iff.mpr fun i => measurable_pi_apply _).prodMk
      (measurable_pi_iff.mpr fun i => measurable_pi_apply _)
  calc bitLaw.map (fun e : ℕ → Bool => ((fun i => e (2 * i)), fun i => e (2 * i + 1)))
      = (bitLaw.map fun e : ℕ → Bool =>
          e ∘ Sum.elim (fun i : ℕ => 2 * i) (fun i : ℕ => 2 * i + 1)).map
          (fun ω : ℕ ⊕ ℕ → Bool => ((fun i : ℕ => ω (Sum.inl i)), fun i : ℕ => ω (Sum.inr i))) :=
        (Measure.map_map hm2 hm1).symm
    _ = bitLaw.prod bitLaw := by
        rw [h1]
        exact h2

/-- The shuffle `((b₁, c₁), (b₂, c₂)) ↦ ((b₁, b₂), (c₁, c₂))` preserves product measures. -/
theorem measurePreserving_prodProdShuffle {B C : Type*} [MeasurableSpace B] [MeasurableSpace C]
    (μB : Measure B) (μC : Measure C) [IsProbabilityMeasure μB] [IsProbabilityMeasure μC] :
    MeasurePreserving (fun p : (B × C) × (B × C) => ((p.1.1, p.2.1), (p.1.2, p.2.2)))
      ((μB.prod μC).prod (μB.prod μC)) ((μB.prod μB).prod (μC.prod μC)) := by
  have h1 : MeasurePreserving (fun p : (B × C) × (B × C) => (p.1.1, (p.1.2, (p.2.1, p.2.2))))
      ((μB.prod μC).prod (μB.prod μC)) (μB.prod (μC.prod (μB.prod μC))) :=
    measurePreserving_prodAssoc _ _ _
  have h2 : MeasurePreserving (Prod.map id (Prod.swap : C × (B × C) → (B × C) × C))
      (μB.prod (μC.prod (μB.prod μC))) (μB.prod ((μB.prod μC).prod μC)) := by
    refine MeasurePreserving.prod (MeasurePreserving.id _) ?_
    exact ⟨measurable_swap, Measure.prod_swap⟩
  have h3 : MeasurePreserving
      (Prod.map id (⇑(MeasurableEquiv.prodAssoc : (B × C) × C ≃ᵐ B × (C × C))))
      (μB.prod ((μB.prod μC).prod μC)) (μB.prod (μB.prod (μC.prod μC))) := by
    refine MeasurePreserving.prod (MeasurePreserving.id _) ?_
    exact measurePreserving_prodAssoc μB μC μC
  have h4 : MeasurePreserving (Prod.map id (Prod.map id (Prod.swap : C × C → C × C)))
      (μB.prod (μB.prod (μC.prod μC))) (μB.prod (μB.prod (μC.prod μC))) := by
    refine MeasurePreserving.prod (MeasurePreserving.id _) ?_
    refine MeasurePreserving.prod (MeasurePreserving.id _) ?_
    exact ⟨measurable_swap, Measure.prod_swap⟩
  have h5 : MeasurePreserving
      (⇑(MeasurableEquiv.prodAssoc : (B × B) × (C × C) ≃ᵐ B × (B × (C × C))).symm)
      (μB.prod (μB.prod (μC.prod μC))) ((μB.prod μB).prod (μC.prod μC)) :=
    MeasurePreserving.symm MeasurableEquiv.prodAssoc
      (measurePreserving_prodAssoc μB μB (μC.prod μC))
  exact h5.comp (h4.comp (h3.comp (h2.comp h1)))

/-- **The two offset sequences from one sequence of fair bits.** The law of the pair of offset
sequences of the uniform dyadic system is the image of two independent uniform base offsets and
one sequence of fair bits, the even bits driving the first coordinate and the odd bits the
second. -/
theorem offsetLaw_prod_offsetLaw :
    offsetLaw.prod offsetLaw = (((unifIco 1).prod (unifIco 1)).prod bitLaw).map
      (fun z : (ℝ × ℝ) × (ℕ → Bool) =>
        (offsetsL 1 z.1.1 (fun i => z.2 (2 * i)), offsetsL 1 z.1.2 (fun i => z.2 (2 * i + 1)))) := by
  have : IsProbabilityMeasure (unifIco 1) := isProbabilityMeasure_unifIco one_pos
  have hoff := measurable_offsetsL 1
  have hevo : Measurable (fun e : ℕ → Bool => ((fun i => e (2 * i)), fun i => e (2 * i + 1))) :=
    (measurable_pi_iff.mpr fun i => measurable_pi_apply _).prodMk
      (measurable_pi_iff.mpr fun i => measurable_pi_apply _)
  have hΨ₂ : Measurable (fun z : (ℝ × ℝ) × ((ℕ → Bool) × (ℕ → Bool)) =>
      (offsetsL 1 z.1.1 z.2.1, offsetsL 1 z.1.2 z.2.2)) :=
    (hoff.comp (measurable_fst.fst.prodMk measurable_snd.fst)).prodMk
      (hoff.comp (measurable_fst.snd.prodMk measurable_snd.snd))
  have hsh := measurePreserving_prodProdShuffle (unifIco 1) bitLaw
  calc offsetLaw.prod offsetLaw
      = (((unifIco 1).prod bitLaw).prod ((unifIco 1).prod bitLaw)).map
          (Prod.map (fun q : ℝ × (ℕ → Bool) => offsetsL 1 q.1 q.2)
            (fun q : ℝ × (ℕ → Bool) => offsetsL 1 q.1 q.2)) :=
        Measure.map_prod_map _ _ hoff hoff
    _ = ((((unifIco 1).prod bitLaw).prod ((unifIco 1).prod bitLaw)).map
          (fun p : (ℝ × (ℕ → Bool)) × (ℝ × (ℕ → Bool)) => ((p.1.1, p.2.1), (p.1.2, p.2.2)))).map
          (fun z : (ℝ × ℝ) × ((ℕ → Bool) × (ℕ → Bool)) =>
            (offsetsL 1 z.1.1 z.2.1, offsetsL 1 z.1.2 z.2.2)) :=
        (Measure.map_map hΨ₂ hsh.measurable).symm
    _ = (((unifIco 1).prod (unifIco 1)).prod (bitLaw.prod bitLaw)).map
          (fun z : (ℝ × ℝ) × ((ℕ → Bool) × (ℕ → Bool)) =>
            (offsetsL 1 z.1.1 z.2.1, offsetsL 1 z.1.2 z.2.2)) := by
        rw [hsh.map_eq]
    _ = ((((unifIco 1).prod (unifIco 1)).prod bitLaw).map
          (Prod.map id fun e : ℕ → Bool => ((fun i => e (2 * i)), fun i => e (2 * i + 1)))).map
          (fun z : (ℝ × ℝ) × ((ℕ → Bool) × (ℕ → Bool)) =>
            (offsetsL 1 z.1.1 z.2.1, offsetsL 1 z.1.2 z.2.2)) := by
        rw [← Measure.map_prod_map _ _ measurable_id hevo, Measure.map_id, map_evenOdd_bitLaw]
    _ = _ := Measure.map_map hΨ₂ (measurable_id.prodMap hevo)

theorem measurable_offsetsL_evenOdd : Measurable (fun z : (ℝ × ℝ) × (ℕ → Bool) =>
    (offsetsL 1 z.1.1 (fun i => z.2 (2 * i)), offsetsL 1 z.1.2 (fun i => z.2 (2 * i + 1)))) := by
  have hoff := measurable_offsetsL 1
  have hev : Measurable fun e : ℕ → Bool => fun i => e (2 * i) :=
    measurable_pi_iff.mpr fun i => measurable_pi_apply _
  have hod : Measurable fun e : ℕ → Bool => fun i => e (2 * i + 1) :=
    measurable_pi_iff.mpr fun i => measurable_pi_apply _
  exact (hoff.comp (measurable_fst.fst.prodMk (hev.comp measurable_snd))).prodMk
    (hoff.comp (measurable_fst.snd.prodMk (hod.comp measurable_snd)))

/-- **Fubini for the law of the dyadic system**: for a measurable event `p` of the coordinates,
`p` holds almost surely if and only if, for almost every scale and almost every pair of base
offsets, it holds for almost every sequence of interleaved fair bits. -/
theorem ae_dyadicLaw_iff {p : DyadicCoord → Prop} (hp : MeasurableSet {q | p q}) :
    (∀ᵐ q ∂dyadicLaw, p q) ↔ ∀ᵐ s ∂unifIco 1, ∀ᵐ x ∂(unifIco 1).prod (unifIco 1), ∀ᵐ e ∂bitLaw,
      p (s, offsetsL 1 x.1 (fun i => e (2 * i)), offsetsL 1 x.2 (fun i => e (2 * i + 1))) := by
  have : IsProbabilityMeasure (unifIco 1) := isProbabilityMeasure_unifIco one_pos
  rw [show dyadicLaw = (unifIco 1).prod (offsetLaw.prod offsetLaw) from rfl,
    Measure.ae_prod_iff_ae_ae hp]
  refine Filter.eventually_congr (Eventually.of_forall fun s => ?_)
  have hps : MeasurableSet {o : (ℕ → ℝ) × (ℕ → ℝ) | p (s, o)} := measurable_prodMk_left hp
  have hps' : MeasurableSet {z : (ℝ × ℝ) × (ℕ → Bool) |
      p (s, offsetsL 1 z.1.1 (fun i => z.2 (2 * i)), offsetsL 1 z.1.2 (fun i => z.2 (2 * i + 1)))} :=
    measurable_offsetsL_evenOdd hps
  rw [offsetLaw_prod_offsetLaw, ae_map_iff measurable_offsetsL_evenOdd.aemeasurable hps]
  exact Measure.ae_prod_iff_ae_ae hps'

/-! ### Measurability -/

theorem measurableSet_setOf_eventually_atTop_nat {α : Type*} [MeasurableSpace α]
    {R : ℕ → α → Prop} (h : ∀ n, MeasurableSet {a | R n a}) :
    MeasurableSet {a | ∀ᶠ n in atTop, R n a} := by
  have heq : {a | ∀ᶠ n in atTop, R n a} = ⋃ N : ℕ, ⋂ n : ℕ, ⋂ (_ : N ≤ n), {a | R n a} := by
    ext a
    rw [mem_iUnion]
    constructor
    · intro ha
      obtain ⟨N, hN⟩ := eventually_atTop.1 ha
      exact ⟨N, mem_iInter₂.2 fun n hn => hN n hn⟩
    · rintro ⟨N, hN⟩
      exact eventually_atTop.2 ⟨N, fun n hn => mem_iInter₂.1 hN n hn⟩
  rw [heq]
  exact MeasurableSet.iUnion fun N => MeasurableSet.iInter fun n => MeasurableSet.iInter fun _ => h n

theorem measurableSet_setOf_forall_countable {α ι : Type*} [MeasurableSpace α] [Countable ι]
    {p : ι → α → Prop} (h : ∀ i, MeasurableSet {a | p i a}) : MeasurableSet {a | ∀ i, p i a} := by
  have heq : {a | ∀ i, p i a} = ⋂ i, {a | p i a} := Set.ext fun a => Set.mem_iInter.symm
  rw [heq]
  exact MeasurableSet.iInter h

theorem measurableSet_setOf_imp {α : Type*} [MeasurableSpace α] {P : Prop} {p : α → Prop}
    (h : MeasurableSet {a | p a}) : MeasurableSet {a | P → p a} := by
  by_cases hP : P
  · have heq : {a | P → p a} = {a | p a} := Set.ext fun a => ⟨fun h' => h' hP, fun h' _ => h'⟩
    rw [heq]
    exact h
  · have heq : {a | P → p a} = Set.univ := Set.eq_univ_of_forall fun a hP' => absurd hP' hP
    rw [heq]
    exact MeasurableSet.univ

theorem measurableSet_cornerSquare_of {β : Type*} [MeasurableSpace β] {E : Set ℂ → Prop}
    (hE : MeasurableSet {p : ℝ × ℝ × ℝ | E (cornerSquare p.1 p.2.1 p.2.2)}) {a b ℓ : β → ℝ}
    (ha : Measurable a) (hb : Measurable b) (hℓ : Measurable ℓ) :
    MeasurableSet {x | E (cornerSquare (a x) (b x) (ℓ x))} :=
  hE.preimage (ha.prodMk (hb.prodMk hℓ))

theorem measurable_originCorner {β : Type*} [MeasurableSpace β] (n : ℕ) {s a : β → ℝ}
    (hs : Measurable s) (ha : Measurable a) : Measurable fun x => originCorner (s x) (a x) n :=
  measurable_latticeFloor ((measurable_const.pow hs).mul ha).neg
    (measurable_const.pow (hs.add_const _)) measurable_const

/-! ### The ancestor half of Lemma 2.8 -/

/-- **Dyadic ancestors of the squares around the origin** (arXiv 1807.07515, Lemma 2.8, first
half), for a fixed cell configuration. Let `E` be an event of the square, measurable in its lower
left corner and side. If almost surely `E(S_k)` holds for the squares `S_k` of generation `k`
around the origin for all large `k`, then for every `l` almost surely, for all large `k`, `E(S)`
holds for every dyadic ancestor `S` of `S_k` of side at most `2 ^ l |S_k|` (also those which do not
belong to the dyadic system). -/
theorem ae_eventually_forall_dyadicAncestors {E : Set ℂ → Prop}
    (hE : MeasurableSet {p : ℝ × ℝ × ℝ | E (cornerSquare p.1 p.2.1 p.2.2)})
    (h : ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ k : ℤ in atTop, E (squareAt q.1 q.2.1 q.2.2 k 0))
    (l : ℕ) :
    ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ k : ℤ in atTop, ∀ i ≤ l,
      ∀ S ∈ dyadicAncestors i (gridFloor q.1 q.2.1 k 0) (gridFloor q.1 q.2.2 k 0)
        ((2 : ℝ) ^ (q.1 + k)), E S := by
  have hP : MeasurableSet {q : DyadicCoord | ∀ᶠ n : ℕ in atTop,
      E (cornerSquare (originCorner q.1 (q.2.1 n) n) (originCorner q.1 (q.2.2 n) n)
        ((2 : ℝ) ^ (q.1 + n)))} :=
    measurableSet_setOf_eventually_atTop_nat fun n => measurableSet_cornerSquare_of hE
      (measurable_originCorner n measurable_fst ((measurable_pi_apply n).comp measurable_snd.fst))
      (measurable_originCorner n measurable_fst ((measurable_pi_apply n).comp measurable_snd.snd))
      (measurable_const.pow (measurable_fst.add_const _))
  have hQ : MeasurableSet {q : DyadicCoord | ∀ᶠ n : ℕ in atTop, ∀ i ≤ l, ∀ n₁ n₂ : ℕ,
      n₁ < 2 ^ i → n₂ < 2 ^ i →
      E (cornerSquare (originCorner q.1 (q.2.1 n) n - n₁ * (2 : ℝ) ^ (q.1 + n))
        (originCorner q.1 (q.2.2 n) n - n₂ * (2 : ℝ) ^ (q.1 + n))
        (2 ^ i * (2 : ℝ) ^ (q.1 + n)))} :=
    measurableSet_setOf_eventually_atTop_nat fun n =>
      measurableSet_setOf_forall_countable fun i => measurableSet_setOf_imp <|
      measurableSet_setOf_forall_countable fun n₁ => measurableSet_setOf_forall_countable fun n₂ =>
      measurableSet_setOf_imp <| measurableSet_setOf_imp <| measurableSet_cornerSquare_of hE
        ((measurable_originCorner n measurable_fst
          ((measurable_pi_apply n).comp measurable_snd.fst)).sub
          (measurable_const.mul (measurable_const.pow (measurable_fst.add_const _))))
        ((measurable_originCorner n measurable_fst
          ((measurable_pi_apply n).comp measurable_snd.snd)).sub
          (measurable_const.mul (measurable_const.pow (measurable_fst.add_const _))))
        (measurable_const.mul (measurable_const.pow (measurable_fst.add_const _)))
  have h' : ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ n : ℕ in atTop,
      E (cornerSquare (originCorner q.1 (q.2.1 n) n) (originCorner q.1 (q.2.2 n) n)
        ((2 : ℝ) ^ (q.1 + n))) := by
    filter_upwards [h] with q hq
    filter_upwards [tendsto_natCast_atTop_atTop.eventually hq] with n hn
    rwa [squareAt_natCast_zero] at hn
  have hQae := (ae_dyadicLaw_iff hQ).2 (by
    filter_upwards [(ae_dyadicLaw_iff hP).1 h'] with s hs
    filter_upwards [hs] with x hx
    exact ae_bitLaw_eventually_forall_ancestor s x.1 x.2 E hx l)
  filter_upwards [hQae] with q hq
  obtain ⟨N, hN⟩ := eventually_atTop.1 hq
  refine eventually_atTop.2 ⟨(N : ℤ), fun k hk i hi S hS => ?_⟩
  obtain ⟨n, rfl⟩ : ∃ n : ℕ, k = n := ⟨k.toNat, (Int.toNat_of_nonneg (by omega)).symm⟩
  obtain ⟨n₁, n₂, h₁, h₂, rfl⟩ := hS
  rw [gridFloor_natCast_zero, gridFloor_natCast_zero, Int.cast_natCast]
  exact hN n (by omega) i hi n₁ n₂ h₁ h₂

/-- **Dyadic ancestors of the squares around the origin, for a random cell configuration**
(arXiv 1807.07515, Lemma 2.8, first half). Let `E(S, H)` be an event of a square and a cell
configuration, measurable in the lower left corner and the side of the square for almost every
configuration. If almost surely `E(S_k, H)` holds for all large `k`, then for every `l` almost
surely, for all large `k`, `E(S, H)` holds for every dyadic ancestor `S` of `S_k` of side at most
`2 ^ l |S_k|`. -/
theorem ae_ae_eventually_forall_dyadicAncestors {μ : Measure GMSSpace}
    {E : Set ℂ → GMSSpace → Prop}
    (hEm : ∀ᵐ H ∂μ, MeasurableSet {p : ℝ × ℝ × ℝ | E (cornerSquare p.1 p.2.1 p.2.2) H})
    (hE : ∀ᵐ H ∂μ, ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ k : ℤ in atTop,
      E (squareAt q.1 q.2.1 q.2.2 k 0) H)
    (l : ℕ) :
    ∀ᵐ H ∂μ, ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ k : ℤ in atTop, ∀ i ≤ l,
      ∀ S ∈ dyadicAncestors i (gridFloor q.1 q.2.1 k 0) (gridFloor q.1 q.2.2 k 0)
        ((2 : ℝ) ^ (q.1 + k)), E S H := by
  filter_upwards [hEm, hE] with H hm hH
  exact ae_eventually_forall_dyadicAncestors (E := fun S => E S H) hm hH l

/-- **The dyadic ancestor of side `4 |S_k|` of `S_k` in the second column and the second row**
(arXiv 1807.07515, proof of Lemma 2.9): the instance `l = 2`, `n₁ = n₂ = 1` of
`ae_ae_eventually_forall_dyadicAncestors`, the ancestor of side `4 |S_k|` with lower left corner
`(a - |S_k|, b - |S_k|)` when `S_k` has lower left corner `(a, b)`. -/
theorem ae_ae_eventually_dyadicAncestor_side_four {μ : Measure GMSSpace}
    {E : Set ℂ → GMSSpace → Prop}
    (hEm : ∀ᵐ H ∂μ, MeasurableSet {p : ℝ × ℝ × ℝ | E (cornerSquare p.1 p.2.1 p.2.2) H})
    (hE : ∀ᵐ H ∂μ, ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ k : ℤ in atTop,
      E (squareAt q.1 q.2.1 q.2.2 k 0) H) :
    ∀ᵐ H ∂μ, ∀ᵐ q : DyadicCoord ∂dyadicLaw, ∀ᶠ k : ℤ in atTop,
      E (cornerSquare (gridFloor q.1 q.2.1 k (0 : ℂ).re - (2 : ℝ) ^ (q.1 + (k : ℝ)))
        (gridFloor q.1 q.2.2 k (0 : ℂ).im - (2 : ℝ) ^ (q.1 + (k : ℝ)))
        (4 * (2 : ℝ) ^ (q.1 + (k : ℝ)))) H := by
  filter_upwards [ae_ae_eventually_forall_dyadicAncestors hEm hE 2] with H hH
  filter_upwards [hH] with q hq
  filter_upwards [hq] with k hk
  have h := hk 2 le_rfl _ ⟨1, 1, by norm_num, by norm_num, rfl⟩
  rw [Nat.cast_one, one_mul, show ((2 : ℝ) ^ 2 : ℝ) = 4 by norm_num] at h
  rw [Complex.zero_re, Complex.zero_im]
  exact h

/-! ### Rooted bad-square mass tails -/

/-- A bad square at the root whose ancestor `d` generations above it has cell mass at least `m`. -/
def rootedBadSquareMassTail (E : Set ℂ → GMSSpace → Prop) (d : ℤ) (m : ℝ≥0∞) :
    Set (GMSSpace × DyadicCoord × ℂ) :=
  {p | ∃ j : ℤ, ¬ E (squareAt p.2.1.1 p.2.1.2.1 p.2.1.2.2 j p.2.2) p.1 ∧
    m ≤ cellMass volume (complexCells p.1.1)
      (squareAt p.2.1.1 p.2.1.2.1 p.2.1.2.2 (j + d) p.2.2)}

/-- The rooted bad-square mass tail is jointly measurable. -/
theorem measurableSet_rootedBadSquareMassTail {E : Set ℂ → GMSSpace → Prop}
    (hE : MeasurableSet {p : (ℝ × ℝ × ℝ) × GMSSpace |
      E (cornerSquare p.1.1 p.1.2.1 p.1.2.2) p.2}) (d : ℤ) (m : ℝ≥0∞) :
    MeasurableSet (rootedBadSquareMassTail E d m) := by
  have he (j : ℤ) : MeasurableSet {p : GMSSpace × DyadicCoord × ℂ |
      E (squareAt p.2.1.1 p.2.1.2.1 p.2.1.2.2 j p.2.2) p.1} := by
    have hs : Measurable fun p : GMSSpace × DyadicCoord × ℂ => p.2.1.1 :=
      measurable_snd.fst.fst
    have hw : Measurable fun p : GMSSpace × DyadicCoord × ℂ => p.2.2 :=
      measurable_snd.snd
    have hf := ((measurable_gridFloor j hs measurable_snd.fst.snd.fst
        (Complex.measurable_re.comp hw)).prodMk
      ((measurable_gridFloor j hs measurable_snd.fst.snd.snd
        (Complex.measurable_im.comp hw)).prodMk
        ((measurable_const : Measurable fun _ : GMSSpace × DyadicCoord × ℂ => (2 : ℝ)).pow
          (hs.add_const (j : ℝ))))).prodMk measurable_fst
    exact hE.preimage hf
  have hm (j : ℤ) : MeasurableSet {p : GMSSpace × DyadicCoord × ℂ |
      m ≤ cellMass volume (complexCells p.1.1)
        (squareAt p.2.1.1 p.2.1.2.1 p.2.1.2.2 (j + d) p.2.2)} := by
    exact measurableSet_le measurable_const ((measurable_cellMass_squareAt (j + d)).comp
      (measurable_fst.prodMk measurable_snd))
  convert (MeasurableSet.iUnion fun j : ℤ => (he j).compl.inter (hm j)) using 1
  ext p
  simp only [rootedBadSquareMassTail, mem_ofPred_eq, mem_iUnion, mem_inter_iff, mem_compl_iff]

/-- A covariant square event gives an invariant rooted mass tail. -/
theorem rootedBadSquareMassTail_similarity {E : Set ℂ → GMSSpace → Prop}
    (hE : ∀ (s : ℝ) (u : Plane) (hs : 0 < s) (H H' : GMSSpace),
      IsSimilar s u hs H H' → ∀ S : Set ℂ,
        (E ((fun z : ℂ => s • z + similarityOffset s u) '' S) H' ↔ E S H))
    (d : ℤ) (m : ℝ≥0∞) (s : ℝ) (u : Plane) (hs : 0 < s) (H H' : GMSSpace)
    (hHH' : IsSimilar s u hs H H') (q : DyadicCoord)
    (h₁ : IsCompatible q.2.1) (h₂ : IsCompatible q.2.2) (w : ℂ) :
    ((H', similarityCoord s u q, s • w + similarityOffset s u) ∈
      rootedBadSquareMassTail E d m ↔ (H, q, w) ∈ rootedBadSquareMassTail E d m) := by
  let δ : ℤ := ⌊q.1 + Real.logb 2 s⌋
  have hsq (j : ℤ) := squareAt_similarityCoord s u hs q h₁ h₂ j w
  have hmass (j : ℤ) :
      cellMass volume (complexCells H'.1)
        (squareAt (similarityCoord s u q).1 (similarityCoord s u q).2.1
          (similarityCoord s u q).2.2 (j + δ) (s • w + similarityOffset s u)) =
      cellMass volume (complexCells H.1) (squareAt q.1 q.2.1 q.2.2 j w) := by
    rw [hsq j, show H'.1 = H.1.similarity s u hs from hHH',
      cellMass_complexCells_similarity_image]
  have hindex (j : ℤ) :
      (¬ E (squareAt (similarityCoord s u q).1 (similarityCoord s u q).2.1
        (similarityCoord s u q).2.2 (j + δ) (s • w + similarityOffset s u)) H' ∧
        m ≤ cellMass volume (complexCells H'.1)
          (squareAt (similarityCoord s u q).1 (similarityCoord s u q).2.1
            (similarityCoord s u q).2.2 (j + δ + d) (s • w + similarityOffset s u))) ↔
      (¬ E (squareAt q.1 q.2.1 q.2.2 j w) H ∧
        m ≤ cellMass volume (complexCells H.1) (squareAt q.1 q.2.1 q.2.2 (j + d) w)) := by
    rw [hsq j, hE s u hs H H' hHH', show j + δ + d = (j + d) + δ by omega,
      hmass (j + d)]
  change (∃ j : ℤ, _) ↔ ∃ j : ℤ, _
  constructor
  · rintro ⟨j, hj⟩
    exact ⟨j - δ, (hindex (j - δ)).1 (by simpa using hj)⟩
  · rintro ⟨j, hj⟩
    exact ⟨j + δ, (hindex j).2 hj⟩

/-- If the squares around the origin are eventually good, the origin section of the
rooted bad-square mass tail is empty above a finite threshold. -/
theorem exists_forall_ge_not_mem_rootedBadSquareMassTail {E : Set ℂ → GMSSpace → Prop}
    (H : GMSSpace) (q : DyadicCoord) (h₁ : IsCompatible q.2.1)
    (h₂ : IsCompatible q.2.2) (d : ℤ)
    (hE : ∀ᶠ j : ℤ in atTop, E (squareAt q.1 q.2.1 q.2.2 j 0) H) :
    ∃ N : ℕ, ∀ m : ℝ≥0∞, (N : ℝ≥0∞) ≤ m →
      (H, q, 0) ∉ rootedBadSquareMassTail E d m := by
  obtain ⟨J, hJ⟩ := eventually_atTop.1 hE
  obtain ⟨N, hN⟩ := ENNReal.exists_nat_gt (cellMass_squareAt_ne_top H q (J + d))
  refine ⟨N, fun m hm hbad => ?_⟩
  obtain ⟨j, hj, hjm⟩ := hbad
  have hjJ : j < J := lt_of_not_ge fun h => hj (hJ j h)
  have hsub := squareAt_mono_of_isCompatible (s := q.1) h₁ h₂ 0
    (show j + d ≤ J + d by omega)
  have hmass := cellMass_mono volume (complexCells H.1) hsub
  exact (not_lt_of_ge (hm.trans (hjm.trans hmass))) hN

/-- Each dyadic descendant belongs to the corresponding finer generation. -/
theorem dyadicDescendant_mem_generationSquares {s : ℝ} {o₁ o₂ : ℕ → ℝ}
    (h₁ : IsCompatible o₁) (h₂ : IsCompatible o₂) (j : ℤ) (w : ℂ) (i : ℕ)
    {S : Set ℂ}
    (hS : S ∈ dyadicDescendants i (gridFloor s o₁ j w.re) (gridFloor s o₂ j w.im)
      ((2 : ℝ) ^ (s + (j : ℝ)))) :
    S ∈ generationSquares s o₁ o₂ (j - i) := by
  obtain ⟨n₁, n₂, _, _, rfl⟩ := hS
  have hp : (2 : ℝ) ^ (s + (j : ℝ)) / (2 : ℝ) ^ i =
      (2 : ℝ) ^ (s + ((j - i : ℤ) : ℝ)) := by
    have h := two_rpow_add_natCast s (j - i) i
    have hji : j - (i : ℤ) + i = j := by omega
    rw [hji] at h
    push_cast at h
    rw [h]
    field_simp
    push_cast
    rfl
  have hadd (o : ℕ → ℝ) (ho : IsCompatible o) (x : ℝ) (n : ℕ) :
      gridFloor s o j x + n * (2 : ℝ) ^ (s + ((j - i : ℤ) : ℝ)) ∈
        gridPoints s o (j - i) := by
    have hbase := gridPoints_subset_of_le ho s (show j - (i : ℤ) ≤ j by omega)
      (gridFloor_mem s o j x)
    simp only [gridPoints, mem_shiftedLattice] at hbase ⊢
    obtain ⟨k, hk⟩ := hbase
    refine ⟨k + n, ?_⟩
    push_cast
    rw [hk]
    ring
    push_cast
    congr 2
    ring
  refine ⟨gridFloor s o₁ j w.re + n₁ * ((2 : ℝ) ^ (s + (j : ℝ)) / (2 : ℝ) ^ i), ?_,
    gridFloor s o₂ j w.im + n₂ * ((2 : ℝ) ^ (s + (j : ℝ)) / (2 : ℝ) ^ i), ?_, ?_⟩
  · simpa only [hp] using hadd o₁ h₁ w.re n₁
  · simpa only [hp] using hadd o₂ h₂ w.im n₂
  · simp only [hp]

/-- Almost every point of a descendant selects that square in the finer generation. -/
theorem ae_squareAt_eq_dyadicDescendant {s : ℝ} {o₁ o₂ : ℕ → ℝ}
    (h₁ : IsCompatible o₁) (h₂ : IsCompatible o₂) (j : ℤ) (w : ℂ) (i : ℕ)
    {S : Set ℂ}
    (hS : S ∈ dyadicDescendants i (gridFloor s o₁ j w.re) (gridFloor s o₂ j w.im)
      ((2 : ℝ) ^ (s + (j : ℝ)))) :
    ∀ᵐ z ∂volume, z ∈ S → S = squareAt s o₁ o₂ (j - i) z := by
  have hgen := dyadicDescendant_mem_generationSquares h₁ h₂ j w i hS
  obtain ⟨a, ha, b, hb, rfl⟩ := hgen
  filter_upwards [ae_isOffGrid_volume s o₁ o₂] with z hz hmem
  obtain ⟨h1, h2, h3, h4⟩ := hmem
  have h2' : z.re < a + (2 : ℝ) ^ (s + ((j - i : ℤ) : ℝ)) :=
    lt_of_le_of_ne h2 fun h => (hz (j - i)).1 (h ▸ add_mem_shiftedLattice ha)
  have h4' : z.im < b + (2 : ℝ) ^ (s + ((j - i : ℤ) : ℝ)) :=
    lt_of_le_of_ne h4 fun h => (hz (j - i)).2 (h ▸ add_mem_shiftedLattice hb)
  have hp : (0 : ℝ) < (2 : ℝ) ^ (s + ((j - i : ℤ) : ℝ)) := by positivity
  have hA : a = gridFloor s o₁ (j - i) z.re := eq_latticeFloor hp ha h1 h2'
  have hB : b = gridFloor s o₂ (j - i) z.im := eq_latticeFloor hp hb h3 h4'
  rw [squareAt, hA, hB]

/-- A bad descendant gives a rooted mass-tail witness at almost every point of it,
provided the next generation of the parent has at least the threshold mass. -/
theorem ae_mem_rootedBadSquareMassTail_of_dyadicDescendant
    {E : Set ℂ → GMSSpace → Prop} {H : GMSSpace} {q : DyadicCoord}
    (h₁ : IsCompatible q.2.1) (h₂ : IsCompatible q.2.2) (j : ℤ) (w : ℂ)
    {i l : ℕ} (hil : i ≤ l) {S : Set ℂ}
    (hS : S ∈ dyadicDescendants i (gridFloor q.1 q.2.1 j w.re)
      (gridFloor q.1 q.2.2 j w.im) ((2 : ℝ) ^ (q.1 + (j : ℝ))))
    (hbad : ¬ E S H) {m : ℝ≥0∞}
    (hm : m ≤ cellMass volume (complexCells H.1) (squareAt q.1 q.2.1 q.2.2 (j + 1) w)) :
    ∀ᵐ z ∂volume, z ∈ S → (H, q, z) ∈ rootedBadSquareMassTail E (l + 1) m := by
  have hsub : S ⊆ squareAt q.1 q.2.1 q.2.2 j w := by
    exact dyadicDescendant_subset (by positivity) hS
  filter_upwards [ae_squareAt_eq_dyadicDescendant h₁ h₂ j w i hS,
    ae_isOffGrid_volume q.1 q.2.1 q.2.2] with z hzS hz hzmem
  have hzparent : z ∈ squareAt q.1 q.2.1 q.2.2 (j + 1) w :=
    squareAt_mono_of_isCompatible h₁ h₂ w (by omega) (hsub hzmem)
  have heq : squareAt q.1 q.2.1 q.2.2 (j + 1) w =
      squareAt q.1 q.2.1 q.2.2 (j + 1) z := squareAt_eq_of_mem hz hzparent
  have hmono := cellMass_mono volume (complexCells H.1)
    (squareAt_mono_of_isCompatible (s := q.1) h₁ h₂ z
      (show j + 1 ≤ j - (i : ℤ) + ((l : ℤ) + 1) by omega))
  refine ⟨j - i, ?_, ?_⟩
  · rw [← hzS hzmem]
    exact hbad
  · exact (heq ▸ hm).trans hmono

/-! ### A conditional resampling estimate -/

/-- If almost every point of a descendant belongs to a rooted event, its area gives a lower
bound for the event's average over the parent square. -/
theorem one_le_mul_cappedSquareAverage_of_descendant
    {m : ℝ≥0∞} {H : GMSSpace} {q : DyadicCoord} {a b ℓ : ℝ} (hℓ : 0 < ℓ)
    {i l : ℕ} (hil : i ≤ l) {S : Set ℂ}
    (hS : S ∈ dyadicDescendants i a b ℓ)
    (hparent : originCappedSquare m H q = cornerSquare a b ℓ)
    (hsub : S ⊆ originCappedSquare m H q)
    {B : Set (GMSSpace × DyadicCoord × ℂ)}
    (hbad : ∀ᵐ z ∂volume, z ∈ S → (H, q, z) ∈ B) :
    1 ≤ (4 : ℝ≥0∞) ^ l *
      cappedSquareAverage m (B.indicator (fun _ => (1 : ℝ≥0∞))) H q := by
  have hSm : MeasurableSet S := by
    obtain ⟨n₁, n₂, _, _, rfl⟩ := hS
    exact measurableSet_cornerSquare _ _ _
  have harea0 : volume (originCappedSquare m H q) ≠ 0 := by
    rw [hparent, volume_cornerSquare]
    exact mul_ne_zero (ENNReal.ofReal_pos.mpr hℓ).ne' (ENNReal.ofReal_pos.mpr hℓ).ne'
  have hareatop : volume (originCappedSquare m H q) ≠ ∞ := by
    rw [hparent, volume_cornerSquare]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
  have harea : volume (originCappedSquare m H q) ≤ (4 : ℝ≥0∞) ^ l * volume S := by
    rw [hparent, ← volume_dyadicDescendant hℓ.le hS, mul_comm]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) hil) (by positivity)
  have hint : (volume (originCappedSquare m H q))⁻¹ * volume S ≤
      cappedSquareAverage m (B.indicator (fun _ => (1 : ℝ≥0∞))) H q := by
    rw [cappedSquareAverage, ← lintegral_indicator_const hSm]
    refine lintegral_mono_ae ?_
    filter_upwards [hbad] with z hz
    by_cases hzS : z ∈ S
    · simp [hzS, hsub hzS, hz hzS]
    · simp [hzS]
  calc
    1 = (volume (originCappedSquare m H q))⁻¹ * volume (originCappedSquare m H q) :=
      (ENNReal.inv_mul_cancel harea0 hareatop).symm
    _ ≤ (volume (originCappedSquare m H q))⁻¹ * ((4 : ℝ≥0∞) ^ l * volume S) :=
      mul_le_mul_of_nonneg_left harea (by positivity)
    _ = (4 : ℝ≥0∞) ^ l * ((volume (originCappedSquare m H q))⁻¹ * volume S) := by
      ac_rfl
    _ ≤ (4 : ℝ≥0∞) ^ l *
        cappedSquareAverage m (B.indicator (fun _ => (1 : ℝ≥0∞))) H q :=
      mul_le_mul_of_nonneg_left hint (by positivity)

/-- The descendant average estimate with containment supplied by dyadic geometry. -/
theorem one_le_mul_cappedSquareAverage_of_descendant_mem
    {m : ℝ≥0∞} {H : GMSSpace} {q : DyadicCoord} {a b ℓ : ℝ} (hℓ : 0 < ℓ)
    {i l : ℕ} (hil : i ≤ l) {S : Set ℂ}
    (hS : S ∈ dyadicDescendants i a b ℓ)
    (hparent : originCappedSquare m H q = cornerSquare a b ℓ)
    {B : Set (GMSSpace × DyadicCoord × ℂ)}
    (hbad : ∀ᵐ z ∂volume, z ∈ S → (H, q, z) ∈ B) :
    1 ≤ (4 : ℝ≥0∞) ^ l *
      cappedSquareAverage m (B.indicator (fun _ => (1 : ℝ≥0∞))) H q :=
  one_le_mul_cappedSquareAverage_of_descendant hℓ hil hS hparent
    (hparent ▸ dyadicDescendant_subset hℓ.le hS) hbad

/-- A lower bound for a rooted event's capped-square average gives a conditional measure bound.
The geometric lower bound is an explicit hypothesis. -/
theorem measure_le_mul_measure_inter_of_kernelAverage {μ : Measure GMSSpace}
    (hMT : MassTransport μ) {m : ℝ≥0∞} (hm0 : m ≠ 0) (hmtop : m ≠ ∞)
    {B : Set (GMSSpace × DyadicCoord × ℂ)} (hB : MeasurableSet B)
    (hinv : ∀ (s : ℝ) (u : Plane) (hs : 0 < s) (H H' : GMSSpace),
      IsSimilar s u hs H H' → ∀ q : DyadicCoord, IsCompatible q.2.1 →
        IsCompatible q.2.2 → ∀ w : ℂ,
        ((H', similarityCoord s u q, s • w + similarityOffset s u) ∈ B ↔ (H, q, w) ∈ B))
    {A : Set (GMSSpace × DyadicCoord)} (hA : MeasurableSet[cappedSquareSigma m] A)
    {c : ℝ≥0∞}
    (hlower : ∀ᵐ p ∂(μ.prod dyadicLaw).restrict A,
      1 ≤ c * kernelAverage m (B.indicator (fun _ => (1 : ℝ≥0∞))) (p.1, p.2, 0)) :
    μ.prod dyadicLaw A ≤ c * μ.prod dyadicLaw (A ∩ {p | (p.1, p.2, (0 : ℂ)) ∈ B}) := by
  let G := B.indicator (fun _ => (1 : ℝ≥0∞))
  have hG : Measurable G := measurable_const.indicator hB
  have hGi : ∀ (s : ℝ) (u : Plane) (hs : 0 < s) (H H' : GMSSpace),
      IsSimilar s u hs H H' → ∀ q : DyadicCoord, IsCompatible q.2.1 →
        IsCompatible q.2.2 → ∀ w : ℂ,
        G (H', similarityCoord s u q, s • w + similarityOffset s u) = G (H, q, w) := by
    intro s u hs H H' h q h₁ h₂ w
    change B.indicator (fun _ => (1 : ℝ≥0∞))
      (H', similarityCoord s u q, s • w + similarityOffset s u) =
      B.indicator (fun _ => (1 : ℝ≥0∞)) (H, q, w)
    by_cases hw : (H, q, w) ∈ B
    · rw [Set.indicator_of_mem ((hinv s u hs H H' h q h₁ h₂ w).2 hw),
        Set.indicator_of_mem hw]
    · have hw' : (H', similarityCoord s u q, s • w + similarityOffset s u) ∉ B :=
        fun hmem => hw ((hinv s u hs H H' h q h₁ h₂ w).1 hmem)
      rw [Set.indicator_of_notMem hw', Set.indicator_of_notMem hw]
  have hT : MeasurableSet {p : GMSSpace × DyadicCoord | (p.1, p.2, (0 : ℂ)) ∈ B} :=
    (measurable_fst.prodMk (measurable_snd.prodMk measurable_const)) hB
  have hK : Measurable (fun p : GMSSpace × DyadicCoord => kernelAverage m G (p.1, p.2, 0)) :=
    (measurable_kernelAverage m hG).comp
      (measurable_fst.prodMk (measurable_snd.prodMk measurable_const))
  calc
    μ.prod dyadicLaw A = ∫⁻ _ in A, (1 : ℝ≥0∞) ∂μ.prod dyadicLaw := by simp
    _ ≤ ∫⁻ p in A, c * kernelAverage m G (p.1, p.2, 0) ∂μ.prod dyadicLaw :=
      lintegral_mono_ae hlower
    _ = c * ∫⁻ p in A, kernelAverage m G (p.1, p.2, 0) ∂μ.prod dyadicLaw :=
      lintegral_const_mul c hK
    _ = c * ∫⁻ p in A, G (p.1, p.2, 0) ∂μ.prod dyadicLaw := by
      rw [setLIntegral_kernelAverage_origin hMT hm0 hmtop hG hGi hA]
    _ = c * μ.prod dyadicLaw (A ∩ {p | (p.1, p.2, (0 : ℂ)) ∈ B}) := by
      congr 1
      rw [show (fun p : GMSSpace × DyadicCoord => G (p.1, p.2, 0)) =
        {p : GMSSpace × DyadicCoord | (p.1, p.2, (0 : ℂ)) ∈ B}.indicator (fun _ => 1) by
          funext p; rfl, lintegral_indicator_const hT, Measure.restrict_apply hT]
      simp [Set.inter_comm]

/-! ### Last-time decomposition over finitely many indices of a linear order -/

section LastTime

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-- The last-time piece over a finite set `F` of indices of a linear order: `ω ∈ Y i` and
`ω ∉ Y j` for every `j ∈ F` with `i < j`. -/
def lastPieceFinset {ι : Type*} [LinearOrder ι] (Y : ι → Set Ω) (F : Finset ι) (i : ι) :
    Set Ω :=
  Y i \ ⋃ j ∈ F.filter (fun j => i < j), Y j

theorem lastPieceFinset_subset {ι : Type*} [LinearOrder ι] (Y : ι → Set Ω) (F : Finset ι)
    (i : ι) : lastPieceFinset Y F i ⊆ Y i :=
  sdiff_subset

theorem pairwiseDisjoint_lastPieceFinset {ι : Type*} [LinearOrder ι] (Y : ι → Set Ω)
    (F : Finset ι) : PairwiseDisjoint (↑F : Set ι) (lastPieceFinset Y F) := by
  intro i hi j hj hne
  rw [Function.onFun, Set.disjoint_left]
  intro ω hω hω'
  rcases lt_or_gt_of_ne hne with h | h
  · exact hω.2 (mem_biUnion (Finset.mem_filter.2 ⟨Finset.mem_coe.1 hj, h⟩) hω'.1)
  · exact hω'.2 (mem_biUnion (Finset.mem_filter.2 ⟨Finset.mem_coe.1 hi, h⟩) hω.1)

theorem biUnion_lastPieceFinset {ι : Type*} [LinearOrder ι] (Y : ι → Set Ω) (F : Finset ι) :
    ⋃ i ∈ F, lastPieceFinset Y F i = ⋃ i ∈ F, Y i := by
  refine Subset.antisymm (iUnion₂_mono fun i _ => lastPieceFinset_subset Y F i) ?_
  intro ω hω
  simp only [mem_iUnion] at hω
  obtain ⟨i, hi, hωi⟩ := hω
  classical
  let s := F.filter (fun j => ω ∈ Y j)
  have hne : s.Nonempty := ⟨i, Finset.mem_filter.2 ⟨hi, hωi⟩⟩
  have hmax : s.max' hne ∈ F ∧ ω ∈ Y (s.max' hne) := Finset.mem_filter.1 (Finset.max'_mem s hne)
  refine mem_biUnion hmax.1 ⟨hmax.2, ?_⟩
  simp only [mem_iUnion, not_exists]
  intro j hj hωj
  have hj' := Finset.mem_filter.1 hj
  exact absurd (s.le_max' j (Finset.mem_filter.2 ⟨hj'.1, hωj⟩)) (not_le.2 hj'.2)

/-- **Last-time decomposition over a finite set of indices**: for an antitone family `G` of
sub-σ-algebras indexed by a linear order, `G i`-measurable events `Y i`, and the conditional lower
bound `μ A ≤ c * μ (A ∩ T i)` for every `G i`-measurable `A ⊆ Y i`, the union of the `Y i` over a
finite set `F` has measure at most `c` times the measure of the union of the `T i`. -/
theorem measure_biUnion_finset_le_mul {ι : Type*} [LinearOrder ι] {G : ι → MeasurableSpace Ω}
    (hG : Antitone G) (hle : ∀ i, G i ≤ m0) {Y T : ι → Set Ω}
    (hY : ∀ i, MeasurableSet[G i] (Y i)) {c : ℝ≥0∞}
    (hR : ∀ i (A : Set Ω), MeasurableSet[G i] A → A ⊆ Y i → μ A ≤ c * μ (A ∩ T i))
    (F : Finset ι) :
    μ (⋃ i ∈ F, Y i) ≤ c * μ (⋃ i ∈ F, T i) := by
  set T' := ⋃ i ∈ F, T i
  have hLG : ∀ i, MeasurableSet[G i] (lastPieceFinset Y F i) := fun i =>
    (hY i).diff (Finset.measurableSet_biUnion _ fun j hj =>
      hG (Finset.mem_filter.1 hj).2.le _ (hY j))
  have hmeas : ∀ i, MeasurableSet (lastPieceFinset Y F i) := fun i => hle i _ (hLG i)
  have hdisj := pairwiseDisjoint_lastPieceFinset Y F
  rw [← biUnion_lastPieceFinset]
  calc μ (⋃ i ∈ F, lastPieceFinset Y F i)
      = ∑ i ∈ F, μ (lastPieceFinset Y F i) :=
        measure_biUnion_finset hdisj fun i _ => hmeas i
    _ ≤ ∑ i ∈ F, c * μ (lastPieceFinset Y F i ∩ T i) :=
        Finset.sum_le_sum fun i _ => hR i _ (hLG i) (lastPieceFinset_subset Y F i)
    _ ≤ ∑ i ∈ F, c * μ.restrict T' (lastPieceFinset Y F i) := by
        refine Finset.sum_le_sum fun i hi => ?_
        rw [Measure.restrict_apply (hmeas i)]
        gcongr
        exact subset_biUnion_of_mem (u := T) hi
    _ = c * μ.restrict T' (⋃ i ∈ F, lastPieceFinset Y F i) := by
        rw [measure_biUnion_finset hdisj fun i _ => hmeas i, Finset.mul_sum]
    _ ≤ c * μ T' := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        calc μ.restrict T' (⋃ i ∈ F, lastPieceFinset Y F i) ≤ μ.restrict T' univ :=
              measure_mono (subset_univ _)
          _ = μ T' := Measure.restrict_apply_univ T'

/-- **Last-time decomposition, tail union over a countable linear order**: under the hypotheses
of `measure_biUnion_finset_le_mul`, `μ (⋃_{i ≥ M} Y i) ≤ c * μ (⋃_{i ≥ M} T i)`. -/
theorem measure_biUnion_ge_le_mul_of_countable {ι : Type*} [LinearOrder ι] [Countable ι]
    {G : ι → MeasurableSpace Ω} (hG : Antitone G) (hle : ∀ i, G i ≤ m0) {Y T : ι → Set Ω}
    (hY : ∀ i, MeasurableSet[G i] (Y i)) {c : ℝ≥0∞}
    (hR : ∀ i (A : Set Ω), MeasurableSet[G i] A → A ⊆ Y i → μ A ≤ c * μ (A ∩ T i)) (M : ι) :
    μ (⋃ i ≥ M, Y i) ≤ c * μ (⋃ i ≥ M, T i) := by
  have : Nonempty ι := ⟨M⟩
  obtain ⟨f, hf⟩ := exists_surjective_nat ι
  let F : ℕ → Finset ι := fun N => ((Finset.range N).image f).filter (fun i => M ≤ i)
  have hF : ∀ N i, i ∈ F N ↔ (∃ n, n < N ∧ f n = i) ∧ M ≤ i := fun N i => by
    simp only [F, Finset.mem_filter, Finset.mem_image, Finset.mem_range]
  have hU : ⋃ i ≥ M, Y i = ⋃ N, ⋃ i ∈ F N, Y i := by
    ext ω
    simp only [mem_iUnion, hF]
    constructor
    · rintro ⟨i, hi, hω⟩
      obtain ⟨n, rfl⟩ := hf i
      exact ⟨n + 1, f n, ⟨⟨n, Nat.lt_succ_self n, rfl⟩, hi⟩, hω⟩
    · rintro ⟨N, i, ⟨-, hi⟩, hω⟩
      exact ⟨i, hi, hω⟩
  have hmono : Monotone fun N => ⋃ i ∈ F N, Y i := by
    intro N N' hNN' ω hω
    simp only [mem_iUnion, hF] at hω ⊢
    obtain ⟨i, ⟨⟨n, hn, rfl⟩, hi⟩, hω⟩ := hω
    exact ⟨f n, ⟨⟨n, lt_of_lt_of_le hn hNN', rfl⟩, hi⟩, hω⟩
  rw [hU, hmono.measure_iUnion]
  refine iSup_le fun N => (measure_biUnion_finset_le_mul hG hle hY hR (F N)).trans ?_
  refine mul_le_mul_of_nonneg_left (measure_mono fun ω hω => ?_) (by positivity)
  simp only [mem_iUnion, hF] at hω ⊢
  obtain ⟨i, ⟨-, hi⟩, hω⟩ := hω
  exact ⟨i, hi, hω⟩

/-- **Almost surely `Y r` fails for all large rational indices**, from the same statement for `T`:
for a finite measure, an antitone family `G` of sub-σ-algebras indexed by `ℚ`, `G r`-measurable
events `Y r`, measurable `T r`, `c ≠ ∞` and the conditional lower bound
`μ A ≤ c * μ (A ∩ T r)` for every `G r`-measurable `A ⊆ Y r`. -/
theorem ae_exists_forall_ge_not_mem_rat [IsFiniteMeasure μ] {G : ℚ → MeasurableSpace Ω}
    (hG : Antitone G) (hle : ∀ r, G r ≤ m0) {Y T : ℚ → Set Ω}
    (hY : ∀ r, MeasurableSet[G r] (Y r)) {c : ℝ≥0∞} (hc : c ≠ ∞)
    (hR : ∀ r (A : Set Ω), MeasurableSet[G r] A → A ⊆ Y r → μ A ≤ c * μ (A ∩ T r))
    (hTm : ∀ r, MeasurableSet (T r)) (hT : ∀ᵐ ω ∂μ, ∃ M : ℚ, ∀ r ≥ M, ω ∉ T r) :
    ∀ᵐ ω ∂μ, ∃ M : ℚ, ∀ r ≥ M, ω ∉ Y r := by
  let U : ℕ → Set Ω := fun n => ⋃ r ≥ (n : ℚ), T r
  have hanti : Antitone U := by
    intro n n' hnn' ω hω
    obtain ⟨r, hr, hωr⟩ := mem_iUnion₂.1 hω
    exact mem_iUnion₂.2 ⟨r, le_trans (by exact_mod_cast hnn') hr, hωr⟩
  have hnull : ∀ n, NullMeasurableSet (U n) μ := fun n =>
    (MeasurableSet.biUnion (to_countable _) fun r _ => hTm r).nullMeasurableSet
  have h0 : μ (⋂ n, U n) = 0 := by
    rw [ae_iff] at hT
    refine measure_mono_null (fun ω hω => ?_) hT
    rw [mem_iInter] at hω
    show ¬∃ M : ℚ, ∀ r ≥ M, ω ∉ T r
    rintro ⟨M, hM⟩
    obtain ⟨n, hn⟩ := exists_nat_ge M
    obtain ⟨r, hr, hωr⟩ := mem_iUnion₂.1 (hω n)
    exact hM r (le_trans hn hr) hωr
  have hlim := tendsto_measure_iInter_atTop hnull hanti ⟨0, measure_ne_top μ _⟩
  rw [h0] at hlim
  have hclim : Tendsto (fun n => c * μ (U n)) atTop (𝓝 0) := by
    simpa using ENNReal.Tendsto.const_mul hlim (Or.inr hc)
  rw [ae_iff]
  refine nonpos_iff_eq_zero.1 (ge_of_tendsto' hclim fun n => ?_)
  refine (measure_mono fun ω hω => ?_).trans
    (measure_biUnion_ge_le_mul_of_countable hG hle hY hR (n : ℚ))
  have hω' : ¬∃ M : ℚ, ∀ r ≥ M, ω ∉ Y r := hω
  refine mem_iUnion₂.2 ?_
  by_contra hne
  exact hω' ⟨n, fun r hr hωr => hne ⟨r, hr, hωr⟩⟩

end LastTime

