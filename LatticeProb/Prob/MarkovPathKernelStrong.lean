import Mathlib
import LatticeProb.Prob.MarkovPathKernelDense
import LatticeProb.Prob.ConditionalLawCriterion
import LatticeProb.Prob.StoppingDyadic
import LatticeProb.Prob.BrownianStrongMarkov

/-!
# The strong Markov property of a continuous family of path laws

Let `K : E → Prob C(ℝ≥0, E)` be a continuous family of path laws.  If `K z` has the Markov property
at every deterministic time (`MarkovAt K z t`), then it has the strong Markov property at every
stopping time `σ` of the filtration generated by the stopped paths `x (· ∧ t)`: for every bounded
measurable test function `g` on pairs of paths,
`E g (x (· ∧ σ), x (σ + ·)) = E ∫ g (x (· ∧ σ), w) d(K (x σ)) (w)`
under `x ∼ K z`.

* `LatticeProb.stoppedPathFiltration`: the filtration of the path space generated by stopped paths.
* `LatticeProb.measurable_measure_comp_of_continuous`: a continuous family of path laws composed with a
  measurable map is a kernel.
* `LatticeProb.integral_stopShift_eq_of_forall_boundedContinuous`: continuous test functions suffice.
* `LatticeProb.MarkovAt.integral_eq_of_measurable`: the Markov property for bounded measurable test
  functions.
* `LatticeProb.integral_stopShift_eq_of_discrete`: strong Markov at a stopping time with countably
  many values.
* `LatticeProb.integral_stopShift_eq_of_boundedContinuous`, `LatticeProb.strongMarkov_of_markovAt`:
  strong Markov at a stopping time, by dyadic approximation.
-/

set_option autoImplicit false

open MeasureTheory Filter Topology ProbabilityTheory
open scoped BoundedContinuousFunction ENNReal NNReal

namespace LatticeProb

attribute [local instance] dUnifMetricSpace

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
  [MeasurableSpace C(ℝ≥0, E)] [BorelSpace C(ℝ≥0, E)]

/-- The filtration of the path space generated by the stopped paths `x (· ∧ t)`. -/
def stoppedPathFiltration : Filtration ℝ≥0 (inferInstance : MeasurableSpace C(ℝ≥0, E)) where
  seq t := MeasurableSpace.comap (fun x : C(ℝ≥0, E) => stopPath x t) inferInstance
  mono' s t hst := by
    have hmeas : Measurable fun y : C(ℝ≥0, E) => stopPath y s :=
      (continuous_stopPath_uncurry.comp (continuous_id.prodMk continuous_const)).measurable
    have hcomp : (fun x : C(ℝ≥0, E) => stopPath x s) =
        (fun y : C(ℝ≥0, E) => stopPath y s) ∘ fun x : C(ℝ≥0, E) => stopPath x t := by
      funext x
      ext u
      simp [min_assoc, min_eq_left hst]
    change MeasurableSpace.comap (fun x : C(ℝ≥0, E) => stopPath x s) inferInstance ≤
      MeasurableSpace.comap (fun x : C(ℝ≥0, E) => stopPath x t) inferInstance
    rw [hcomp, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono hmeas.comap_le
  le' t := by
    exact (continuous_stopPath_uncurry.comp (continuous_id.prodMk continuous_const)).measurable.comap_le

omit [SecondCountableTopology E] in
/-- A continuous family of path laws, composed with a measurable map, is measurable as a map into
measures (that is, it is a kernel). -/
theorem measurable_measure_comp_of_continuous {Ω : Type*} [MeasurableSpace Ω]
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) {r : Ω → E} (hr : Measurable r) :
    Measurable fun ω => (K (r ω) : Measure C(ℝ≥0, E)) := by
  refine measurable_measure_of_measurable_integral_boundedContinuous
    (P := fun ω => (K (r ω) : Measure C(ℝ≥0, E))) fun f => ?_
  have hF : Continuous fun ν : ProbabilityMeasure C(ℝ≥0, E) =>
      ∫ X, f X ∂(ν : Measure C(ℝ≥0, E)) :=
    continuous_iff_continuousAt.2 fun _ =>
      ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.1 tendsto_id f
  exact (hF.comp hK).measurable.comp hr

/-- The kernel `x ↦ K (x (σ x))` sending a path to the family member started at its value at the
random time `σ`. -/
noncomputable def endpointKernel {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K)
    {σ : C(ℝ≥0, E) → ℝ≥0} (hσ : Measurable σ) : Kernel C(ℝ≥0, E) C(ℝ≥0, E) where
  toFun x := (K (x (σ x)) : Measure C(ℝ≥0, E))
  measurable' := measurable_measure_comp_of_continuous hK
    (r := fun x : C(ℝ≥0, E) => x (σ x))
    ((ContinuousEval.continuous_eval :
      Continuous fun q : C(ℝ≥0, E) × ℝ≥0 => q.1 q.2).measurable.comp (measurable_id.prodMk hσ))

omit [SecondCountableTopology E] in
theorem endpointKernel_apply {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K)
    {σ : C(ℝ≥0, E) → ℝ≥0} (hσ : Measurable σ) (x : C(ℝ≥0, E)) :
    endpointKernel hK hσ x = (K (x (σ x)) : Measure C(ℝ≥0, E)) := rfl

instance {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K)
    {σ : C(ℝ≥0, E) → ℝ≥0} (hσ : Measurable σ) : IsMarkovKernel (endpointKernel hK hσ) :=
  ⟨fun x => by rw [endpointKernel_apply]; infer_instance⟩

/-- **Continuous test functions suffice.**  If the strong Markov identity holds at the measurable
random time `σ` for every bounded continuous test function, it holds for every bounded measurable
one. -/
theorem integral_stopShift_eq_of_forall_boundedContinuous
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) (z : E)
    {σ : C(ℝ≥0, E) → ℝ≥0} (hσ : Measurable σ)
    (h : ∀ g : (C(ℝ≥0, E) × C(ℝ≥0, E)) →ᵇ ℝ,
      ∫ x, g (stopPath x (σ x), pathShift x (σ x)) ∂(K z : Measure C(ℝ≥0, E)) =
        ∫ x, ∫ w, g (stopPath x (σ x), w) ∂(K (x (σ x)) : Measure C(ℝ≥0, E))
          ∂(K z : Measure C(ℝ≥0, E)))
    {g : C(ℝ≥0, E) × C(ℝ≥0, E) → ℝ} (hg : Measurable g) {C : ℝ} (hC : ∀ p, ‖g p‖ ≤ C) :
    ∫ x, g (stopPath x (σ x), pathShift x (σ x)) ∂(K z : Measure C(ℝ≥0, E)) =
      ∫ x, ∫ w, g (stopPath x (σ x), w) ∂(K (x (σ x)) : Measure C(ℝ≥0, E))
        ∂(K z : Measure C(ℝ≥0, E)) := by
  classical
  have hs1 : Measurable fun x : C(ℝ≥0, E) => (stopPath x (σ x), pathShift x (σ x)) :=
    (continuous_stopPath_uncurry.measurable.comp (measurable_id.prodMk hσ)).prodMk
      (continuous_pathShift_uncurry.measurable.comp (measurable_id.prodMk hσ))
  have hs2 : Measurable fun p : C(ℝ≥0, E) × C(ℝ≥0, E) => (stopPath p.1 (σ p.1), p.2) :=
    (continuous_stopPath_uncurry.measurable.comp
      ((measurable_fst).prodMk (hσ.comp measurable_fst))).prodMk measurable_snd
  have hint : ∀ (f : (C(ℝ≥0, E) × C(ℝ≥0, E)) → ℝ) (C' : ℝ), Measurable f → (∀ p, ‖f p‖ ≤ C') →
      Integrable (fun p : C(ℝ≥0, E) × C(ℝ≥0, E) => f (stopPath p.1 (σ p.1), p.2))
        ((K z : Measure C(ℝ≥0, E)) ⊗ₘ endpointKernel hK hσ) := fun f C' hf hfC =>
    Integrable.of_bound (hf.comp hs2).aestronglyMeasurable C' (Filter.Eventually.of_forall fun p => hfC _)
  have hμ : (K z : Measure C(ℝ≥0, E)).map
        (fun x : C(ℝ≥0, E) => (stopPath x (σ x), pathShift x (σ x))) =
      (((K z : Measure C(ℝ≥0, E)) ⊗ₘ endpointKernel hK hσ).map
        fun p : C(ℝ≥0, E) × C(ℝ≥0, E) => (stopPath p.1 (σ p.1), p.2)) := by
    refine ext_of_forall_integral_eq_of_IsFiniteMeasure fun f => ?_
    rw [integral_map hs1.aemeasurable f.continuous.aestronglyMeasurable,
      integral_map hs2.aemeasurable f.continuous.aestronglyMeasurable,
      Measure.integral_compProd
        (hint f ‖f‖ f.continuous.measurable fun p => f.norm_coe_le_norm _)]
    exact h f
  have e1 := integral_map hs1.aemeasurable (μ := (K z : Measure C(ℝ≥0, E))) hg.aestronglyMeasurable
  have e2 := integral_map hs2.aemeasurable
    (μ := ((K z : Measure C(ℝ≥0, E)) ⊗ₘ endpointKernel hK hσ)) hg.aestronglyMeasurable
  rw [hμ] at e1
  rw [← e1, e2, Measure.integral_compProd (hint g C hg hC)]
  rfl

/-- **The Markov property for bounded measurable test functions.** -/
theorem MarkovAt.integral_eq_of_measurable {K : E → ProbabilityMeasure C(ℝ≥0, E)}
    (hK : Continuous K) {z : E} {t : ℝ≥0} (h : MarkovAt K z t)
    {g : C(ℝ≥0, E) × C(ℝ≥0, E) → ℝ} (hg : Measurable g) {C : ℝ} (hC : ∀ p, ‖g p‖ ≤ C) :
    ∫ x, g (stopPath x t, pathShift x t) ∂(K z : Measure C(ℝ≥0, E)) =
      ∫ x, ∫ w, g (stopPath x t, w) ∂(K (x t) : Measure C(ℝ≥0, E))
        ∂(K z : Measure C(ℝ≥0, E)) :=
  integral_stopShift_eq_of_forall_boundedContinuous hK z (σ := fun _ => t) measurable_const
    (fun g => h g) hg hC

/-- **Strong Markov at a stopping time with countably many values.**  If `K z` has the Markov property
at every deterministic time and `τ` is a stopping time of the filtration of stopped paths with
countably many values, then the strong Markov identity holds at `τ` for bounded measurable test
functions. -/
theorem integral_stopShift_eq_of_discrete {K : E → ProbabilityMeasure C(ℝ≥0, E)}
    (hK : Continuous K) {z : E} (hM : ∀ t, MarkovAt K z t) {τ : C(ℝ≥0, E) → ℝ≥0}
    (hτ : IsStoppingTime (stoppedPathFiltration (E := E)) fun x => (τ x : ℝ≥0∞))
    (hcount : (Set.range fun x => ((τ x : ℝ≥0) : ℝ≥0∞)).Countable)
    {g : C(ℝ≥0, E) × C(ℝ≥0, E) → ℝ} (hg : Measurable g) {C : ℝ} (hC : ∀ p, ‖g p‖ ≤ C) :
    ∫ x, g (stopPath x (τ x), pathShift x (τ x)) ∂(K z : Measure C(ℝ≥0, E)) =
      ∫ x, ∫ w, g (stopPath x (τ x), w) ∂(K (x (τ x)) : Measure C(ℝ≥0, E))
        ∂(K z : Measure C(ℝ≥0, E)) := by
  classical
  have hτm : Measurable τ := measurable_of_isStoppingTime hτ
  have hRc : (Set.range τ).Countable := by
    refine Set.Countable.mono ?_ (hcount.preimage ENNReal.coe_injective)
    rintro s ⟨x, rfl⟩
    exact ⟨x, rfl⟩
  have : Countable (Set.range τ) := hRc.to_subtype
  set μ : Measure C(ℝ≥0, E) := (K z : Measure C(ℝ≥0, E)) with hμdef
  let A : Set.range τ → Set C(ℝ≥0, E) := fun s => {x | τ x = s}
  have hAst : ∀ s : ℝ≥0, MeasurableSet[MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => stopPath x s) inferInstance] {x | τ x = s} := by
    intro s
    have h := hτ.measurableSet_eq_of_countable_range hcount s
    have hset : {x | τ x = s} = {ω | ((τ ω : ℝ≥0) : ℝ≥0∞) = (s : ℝ≥0∞)} := by
      ext ω
      simp only [Set.mem_ofPred_eq, ENNReal.coe_inj]
    rw [hset]
    exact h
  have hAm : ∀ s, MeasurableSet (A s) := fun s => hτm (measurableSet_singleton (s : ℝ≥0))
  have hAd : Pairwise (Function.onFun Disjoint A) := fun s s' hne =>
    Set.disjoint_left.2 fun x h1 h2 => hne (Subtype.ext (h1.symm.trans h2))
  have hU : (⋃ s, A s) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    exact ⟨⟨τ x, x, rfl⟩, rfl⟩
  set κ := endpointKernel hK hτm with hκdef
  have hs2 : Measurable fun p : C(ℝ≥0, E) × C(ℝ≥0, E) => (stopPath p.1 (τ p.1), p.2) :=
    (continuous_stopPath_uncurry.measurable.comp
      ((measurable_fst).prodMk (hτm.comp measurable_fst))).prodMk measurable_snd
  have hFm : Measurable fun x : C(ℝ≥0, E) => g (stopPath x (τ x), pathShift x (τ x)) :=
    hg.comp ((continuous_stopPath_uncurry.measurable.comp (measurable_id.prodMk hτm)).prodMk
      (continuous_pathShift_uncurry.measurable.comp (measurable_id.prodMk hτm)))
  have hFint : Integrable (fun x : C(ℝ≥0, E) => g (stopPath x (τ x), pathShift x (τ x))) μ :=
    Integrable.of_bound hFm.aestronglyMeasurable C (Filter.Eventually.of_forall fun x => hC _)
  have hΦint : Integrable (fun x : C(ℝ≥0, E) => ∫ w, g (stopPath x (τ x), w)
      ∂(K (x (τ x)) : Measure C(ℝ≥0, E))) μ := by
    have hf : Integrable (fun p : C(ℝ≥0, E) × C(ℝ≥0, E) => g (stopPath p.1 (τ p.1), p.2)) (μ ⊗ₘ κ) :=
      Integrable.of_bound (hg.comp hs2).aestronglyMeasurable C
        (Filter.Eventually.of_forall fun p => hC _)
    exact hf.integral_compProd
  have hsumL := integral_iUnion (μ := μ)
    (f := fun x : C(ℝ≥0, E) => g (stopPath x (τ x), pathShift x (τ x))) hAm hAd
    (by rw [hU]; exact hFint.integrableOn)
  have hsumR := integral_iUnion (μ := μ)
    (f := fun x : C(ℝ≥0, E) => ∫ w, g (stopPath x (τ x), w)
      ∂(K (x (τ x)) : Measure C(ℝ≥0, E))) hAm hAd (by rw [hU]; exact hΦint.integrableOn)
  rw [hU, Measure.restrict_univ] at hsumL hsumR
  rw [hsumL, hsumR]
  refine tsum_congr fun s => ?_
  -- the piece over `A s`
  obtain ⟨B, hB, hBeq⟩ := hAst (s : ℝ≥0)
  let h : C(ℝ≥0, E) × C(ℝ≥0, E) → ℝ := fun p => if p.1 ∈ B then g p else 0
  have hhm : Measurable h := Measurable.ite (measurable_fst hB) hg measurable_const
  have hhC : ∀ p, ‖h p‖ ≤ C := fun p => by
    by_cases hp : p.1 ∈ B
    · simp only [h, hp, ↓reduceIte]; exact hC p
    · simp only [h, hp, ↓reduceIte, norm_zero]; exact (norm_nonneg _).trans (hC p)
  have hMk := MarkovAt.integral_eq_of_measurable hK (hM (s : ℝ≥0)) hhm hhC
  have hmemA : ∀ x : C(ℝ≥0, E), stopPath x (s : ℝ≥0) ∈ B ↔ x ∈ A s := fun x => by
    have : x ∈ (fun x : C(ℝ≥0, E) => stopPath x (s : ℝ≥0)) ⁻¹' B ↔ x ∈ {x | τ x = s} :=
      by rw [hBeq]
    exact this
  have hL : ∫ x, h (stopPath x (s : ℝ≥0), pathShift x (s : ℝ≥0)) ∂μ =
      ∫ x in A s, g (stopPath x (τ x), pathShift x (τ x)) ∂μ := by
    have : ∀ x, h (stopPath x (s : ℝ≥0), pathShift x (s : ℝ≥0)) =
        (A s).indicator (fun x => g (stopPath x (s : ℝ≥0), pathShift x (s : ℝ≥0))) x := fun x => by
      by_cases hx : x ∈ A s
      · rw [Set.indicator_of_mem hx]
        simp [h, (hmemA x).2 hx]
      · rw [Set.indicator_of_notMem hx]
        have hnB : stopPath x (s : ℝ≥0) ∉ B := fun hh => hx ((hmemA x).1 hh)
        simp [h, hnB]
    simp_rw [this]
    rw [integral_indicator (hAm s)]
    refine setIntegral_congr_fun (hAm s) fun x hx => ?_
    have hx' : τ x = s := hx
    simp only [hx']
  have hR : ∫ x, ∫ w, h (stopPath x (s : ℝ≥0), w) ∂(K (x (s : ℝ≥0)) : Measure C(ℝ≥0, E)) ∂μ =
      ∫ x in A s, ∫ w, g (stopPath x (τ x), w) ∂(K (x (τ x)) : Measure C(ℝ≥0, E)) ∂μ := by
    have : ∀ x, ∫ w, h (stopPath x (s : ℝ≥0), w) ∂(K (x (s : ℝ≥0)) : Measure C(ℝ≥0, E)) =
        (A s).indicator (fun x => ∫ w, g (stopPath x (τ x), w)
          ∂(K (x (τ x)) : Measure C(ℝ≥0, E))) x := fun x => by
      by_cases hx : x ∈ A s
      · rw [Set.indicator_of_mem hx]
        have hx' : τ x = s := hx
        simp [h, (hmemA x).2 hx, hx']
      · rw [Set.indicator_of_notMem hx]
        have hnB : stopPath x (s : ℝ≥0) ∉ B := fun hh => hx ((hmemA x).1 hh)
        simp [h, hnB]
    simp_rw [this]
    exact integral_indicator (hAm s)
  rw [← hL, ← hR]
  exact hMk

/-- **Strong Markov for bounded continuous test functions**, by dyadic approximation of the stopping
time. -/
theorem integral_stopShift_eq_of_boundedContinuous {K : E → ProbabilityMeasure C(ℝ≥0, E)}
    (hK : Continuous K) {z : E} (hM : ∀ t, MarkovAt K z t) {σ : C(ℝ≥0, E) → ℝ≥0}
    (hσ : IsStoppingTime (stoppedPathFiltration (E := E)) fun x => (σ x : ℝ≥0∞))
    (g : (C(ℝ≥0, E) × C(ℝ≥0, E)) →ᵇ ℝ) :
    ∫ x, g (stopPath x (σ x), pathShift x (σ x)) ∂(K z : Measure C(ℝ≥0, E)) =
      ∫ x, ∫ w, g (stopPath x (σ x), w) ∂(K (x (σ x)) : Measure C(ℝ≥0, E))
        ∂(K z : Measure C(ℝ≥0, E)) := by
  have hσm : Measurable σ := measurable_of_isStoppingTime hσ
  have hdisc : ∀ n : ℕ,
      ∫ x, g (stopPath x (dyUp n (σ x)), pathShift x (dyUp n (σ x))) ∂(K z : Measure C(ℝ≥0, E)) =
        ∫ x, ∫ w, g (stopPath x (dyUp n (σ x)), w) ∂(K (x (dyUp n (σ x))) : Measure C(ℝ≥0, E))
          ∂(K z : Measure C(ℝ≥0, E)) := fun n =>
    integral_stopShift_eq_of_discrete hK hM (τ := fun x => dyUp n (σ x))
      (isStoppingTime_dyUp hσ n) (countable_range_dyUp n σ) g.continuous.measurable
      (fun p => g.norm_coe_le_norm p)
  have hσn : ∀ n : ℕ, Measurable fun x : C(ℝ≥0, E) => dyUp n (σ x) := fun n =>
    measurable_of_isStoppingTime (isStoppingTime_dyUp hσ n)
  have hev : Continuous fun q : C(ℝ≥0, E) × ℝ≥0 => q.1 q.2 := ContinuousEval.continuous_eval
  have hΦ : Continuous fun q : C(ℝ≥0, E) × ℝ≥0 =>
      ∫ w, g (stopPath q.1 q.2, w) ∂(K (q.1 q.2) : Measure C(ℝ≥0, E)) :=
    continuous_integral_of_continuous_measure (μ := fun q : C(ℝ≥0, E) × ℝ≥0 => K (q.1 q.2))
      (hK.comp hev)
      (G := fun p : C(ℝ≥0, E) × (C(ℝ≥0, E) × ℝ≥0) => g (stopPath p.2.1 p.2.2, p.1))
      (g.continuous.comp ((continuous_stopPath_uncurry.comp continuous_snd).prodMk continuous_fst))
      (C := ‖g‖) fun p => g.norm_coe_le_norm _
  have hΦb : ∀ q : C(ℝ≥0, E) × ℝ≥0,
      ‖∫ w, g (stopPath q.1 q.2, w) ∂(K (q.1 q.2) : Measure C(ℝ≥0, E))‖ ≤ ‖g‖ := fun q => by
    simpa using norm_integral_le_of_norm_le_const (μ := (K (q.1 q.2) : Measure C(ℝ≥0, E)))
      (f := fun w => g (stopPath q.1 q.2, w)) (C := ‖g‖)
      (Filter.Eventually.of_forall fun w => g.norm_coe_le_norm _)
  have hlim : ∀ x : C(ℝ≥0, E), Tendsto (fun n : ℕ => (x, dyUp n (σ x))) atTop (𝓝 (x, σ x)) :=
    fun x => tendsto_const_nhds.prodMk_nhds (tendsto_dyUp (σ x))
  have hL : Tendsto (fun n : ℕ => ∫ x, g (stopPath x (dyUp n (σ x)), pathShift x (dyUp n (σ x)))
      ∂(K z : Measure C(ℝ≥0, E))) atTop
      (𝓝 (∫ x, g (stopPath x (σ x), pathShift x (σ x)) ∂(K z : Measure C(ℝ≥0, E)))) := by
    refine tendsto_integral_of_dominated_convergence (fun _ => ‖g‖) (fun n => ?_)
      (integrable_const _) (fun n => Filter.Eventually.of_forall fun x => g.norm_coe_le_norm _)
      (Filter.Eventually.of_forall fun x => ?_)
    · exact (g.continuous.measurable.comp
        ((continuous_stopPath_uncurry.measurable.comp (measurable_id.prodMk (hσn n))).prodMk
          (continuous_pathShift_uncurry.measurable.comp
            (measurable_id.prodMk (hσn n))))).aestronglyMeasurable
    · exact (g.continuous.continuousAt.tendsto).comp
        (((continuous_stopPath_uncurry.continuousAt.tendsto).comp (hlim x)).prodMk_nhds
          ((continuous_pathShift_uncurry.continuousAt.tendsto).comp (hlim x)))
  have hR : Tendsto (fun n : ℕ => ∫ x, ∫ w, g (stopPath x (dyUp n (σ x)), w)
      ∂(K (x (dyUp n (σ x))) : Measure C(ℝ≥0, E)) ∂(K z : Measure C(ℝ≥0, E))) atTop
      (𝓝 (∫ x, ∫ w, g (stopPath x (σ x), w) ∂(K (x (σ x)) : Measure C(ℝ≥0, E))
        ∂(K z : Measure C(ℝ≥0, E)))) := by
    refine tendsto_integral_of_dominated_convergence (fun _ => ‖g‖) (fun n => ?_)
      (integrable_const _) (fun n => Filter.Eventually.of_forall fun x => hΦb (x, dyUp n (σ x)))
      (Filter.Eventually.of_forall fun x => ?_)
    · exact (hΦ.measurable.comp (measurable_id.prodMk (hσn n))).aestronglyMeasurable
    · exact (hΦ.continuousAt.tendsto).comp (hlim x)
  exact tendsto_nhds_unique (hL.congr hdisc) hR

/-- **The strong Markov property of a continuous family of path laws.**  If `K : E → Prob C(ℝ≥0, E)` is
continuous and `K z` has the Markov property at every deterministic time, then for every stopping time
`σ` of the filtration of stopped paths (with values in `ℝ≥0`) and every bounded measurable test
function `g` on pairs of paths,
`∫ g (x (· ∧ σ), x (σ + ·)) d(K z) = ∫ ∫ g (x (· ∧ σ), w) d(K (x σ)) (w) d(K z)`. -/
theorem strongMarkov_of_markovAt {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K)
    {z : E} (hM : ∀ t, MarkovAt K z t) {σ : C(ℝ≥0, E) → ℝ≥0}
    (hσ : IsStoppingTime (stoppedPathFiltration (E := E)) fun x => (σ x : ℝ≥0∞))
    {g : C(ℝ≥0, E) × C(ℝ≥0, E) → ℝ} (hg : Measurable g) {C : ℝ} (hC : ∀ p, ‖g p‖ ≤ C) :
    ∫ x, g (stopPath x (σ x), pathShift x (σ x)) ∂(K z : Measure C(ℝ≥0, E)) =
      ∫ x, ∫ w, g (stopPath x (σ x), w) ∂(K (x (σ x)) : Measure C(ℝ≥0, E))
        ∂(K z : Measure C(ℝ≥0, E)) :=
  integral_stopShift_eq_of_forall_boundedContinuous hK z (measurable_of_isStoppingTime hσ)
    (integral_stopShift_eq_of_boundedContinuous hK hM hσ) hg hC

end LatticeProb
