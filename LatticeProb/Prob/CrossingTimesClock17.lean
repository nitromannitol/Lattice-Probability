import Mathlib
import LatticeProb.Prob.CrossingTimesClock16

/-!
# The inverse crossing clock is adapted to the clock-read past at every time

Under the hypotheses of `exists_measurable_pastSigma_pathClockInv_ratTime`, for every real time
`t ≥ 0` the variable `A_t` is almost surely a function, measurable for the σ-algebra generated by
the path read in its crossing clock at the rational times `≤ t`, of the path
(`exists_measurable_pastSigma_pathClockInv`).  Approximate `t` from below by rational times `q_n`;
then `A_{q_n} → A_t` almost surely by continuity of `u ↦ A_u`, each `A_{q_n}` agrees almost surely
with a function measurable for `pastSigma m (ratTime q_n) ≤ pastSigma m t`, and the limit superior
of these functions is measurable for `pastSigma m t` and almost surely equal to `A_t`.
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace LatticeProb

attribute [local instance] dUnifMetricSpace

/-- Rational times at most `t` converging to `t`. -/
theorem exists_ratTime_seq_le_tendsto (t : ℝ≥0) :
    ∃ q : ℕ → ℚ, (∀ n, ratTime (q n) ≤ t) ∧ Tendsto (fun n => ratTime (q n)) atTop (𝓝 t) := by
  refine ⟨fun n => ((⌊(t : ℝ) * ((n : ℝ) + 1)⌋ : ℤ) : ℚ) / ((n : ℚ) + 1), ?_, ?_⟩
  · intro n
    unfold ratTime
    rw [Real.toNNReal_le_iff_le_coe]
    have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    push_cast
    rw [div_le_iff₀ hn]
    exact Int.floor_le _
  · have hn : ∀ n : ℕ, (0 : ℝ) < (n : ℝ) + 1 := fun n => by positivity
    have hlow : ∀ n : ℕ, (t : ℝ) - 1 / ((n : ℝ) + 1) ≤
        (((⌊(t : ℝ) * ((n : ℝ) + 1)⌋ : ℤ) : ℚ) / ((n : ℚ) + 1) : ℚ) := by
      intro n
      push_cast
      rw [le_div_iff₀ (hn n), sub_mul, one_div, inv_mul_cancel₀ (hn n).ne']
      exact (Int.sub_one_lt_floor _).le
    have hup : ∀ n : ℕ, (((⌊(t : ℝ) * ((n : ℝ) + 1)⌋ : ℤ) : ℚ) / ((n : ℚ) + 1) : ℚ) ≤ (t : ℝ) := by
      intro n
      push_cast
      rw [div_le_iff₀ (hn n)]
      exact Int.floor_le _
    have hlim : Tendsto (fun n : ℕ =>
        ((((⌊(t : ℝ) * ((n : ℝ) + 1)⌋ : ℤ) : ℚ) / ((n : ℚ) + 1) : ℚ) : ℝ)) atTop (𝓝 (t : ℝ)) := by
      have h0 : Tendsto (fun n : ℕ => (t : ℝ) - 1 / ((n : ℝ) + 1)) atTop (𝓝 (t : ℝ)) := by
        simpa using (tendsto_const_nhds (x := (t : ℝ))).sub tendsto_one_div_add_atTop_nhds_zero_nat
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le h0 tendsto_const_nhds hlow hup
    have := (continuous_real_toNNReal.tendsto (t : ℝ)).comp hlim
    simpa [ratTime, Function.comp_def] using this

theorem pastSigma_mono {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E]
    [BorelSpace E] (m : ℝ≥0∞) {s t : ℝ≥0} (hst : s ≤ t) :
    pastSigma (E := E) m s ≤ pastSigma (E := E) m t :=
  iSup_mono fun _ => iSup_mono' fun h => ⟨h.trans hst, le_rfl⟩

/-- The nonnegative real part of the limit superior of a sequence of nonnegative measurable
functions is measurable. -/
theorem measurable_toNNReal_limsup {Ω : Type*} {U : MeasurableSpace Ω} {g : ℕ → Ω → ℝ≥0}
    (hg : ∀ n, Measurable (g n)) :
    Measurable fun x => (limsup (fun n => (g n x : ℝ≥0∞)) atTop).toNNReal :=
  ENNReal.measurable_toNNReal.comp (Measurable.limsup fun n => (hg n).coe_nnreal_ennreal)

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]

set_option linter.overlappingInstances false in
/-- **The inverse crossing clock is adapted to the clock-read past.**  Under `K z`, for every
time `t ≥ 0` the nonnegative variable `A_t` agrees almost surely with a function of the path that
is measurable for the σ-algebra generated by the path read in its crossing clock at the rational
times `≤ t`. -/
theorem exists_measurable_pastSigma_pathClockInv [PolishSpace E]
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) {z : E}
    (hM : ∀ t, MarkovAt K z t) (m : ℝ≥0∞)
    (hshift : ∀ t s : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ShiftIdentity m t s x)
    (hatt : ∀ t : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    (hcont : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      Continuous fun u : ℝ≥0 => (pathClockInv m x u).toReal) (t : ℝ≥0) :
    ∃ g : C(ℝ≥0, E) → ℝ≥0, Measurable[pastSigma m t] g ∧
      ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
        Real.toNNReal (pathClockInv m x t).toReal = g x := by
  classical
  obtain ⟨q, hq, hqt⟩ := exists_ratTime_seq_le_tendsto t
  choose g hg hgae using fun n =>
    exists_measurable_pastSigma_pathClockInv_ratTime hK hM m hshift hatt hcont (q n)
  have hall : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      ∀ n, Real.toNNReal (pathClockInv m x (ratTime (q n))).toReal = g n x :=
    ae_all_iff.2 hgae
  have hgt : ∀ n, Measurable[pastSigma m t] (g n) := fun n =>
    (hg n).mono (pastSigma_mono m (hq n)) le_rfl
  refine ⟨fun x => (limsup (fun n => (g n x : ℝ≥0∞)) atTop).toNNReal,
    measurable_toNNReal_limsup (U := pastSigma m t) hgt, ?_⟩
  filter_upwards [hall, hcont] with x hx hc
  have h1 : Tendsto (fun n => Real.toNNReal (pathClockInv m x (ratTime (q n))).toReal) atTop
      (𝓝 (Real.toNNReal (pathClockInv m x t).toReal)) :=
    (continuous_real_toNNReal.tendsto _).comp ((hc.tendsto t).comp hqt)
  have h2 : Tendsto (fun n => (g n x : ℝ≥0∞)) atTop
      (𝓝 ((Real.toNNReal (pathClockInv m x t).toReal : ℝ≥0) : ℝ≥0∞)) := by
    refine ENNReal.tendsto_coe.2 ?_
    simpa only [hx] using h1
  rw [h2.limsup_eq, ENNReal.toNNReal_coe]

end LatticeProb
