import Mathlib.MeasureTheory.Measure.MeasureSpaceDef
import Mathlib.MeasureTheory.MeasurableSpace.CountablyGenerated
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

/-! # Almost sure equality of observables from almost sure equality of generating coordinates

Let `α` carry a σ-algebra `m` contained in the σ-algebra generated by a family of maps
`p i : α → β i`. If two random elements `X, Y : Ω → α` satisfy `p i ∘ X = p i ∘ Y` almost
everywhere for each fixed `i` (the index family may be uncountable), then `F ∘ X = F ∘ Y` almost
everywhere for every `m`-measurable map `F` into a countably separated measurable space.

The sets `A` with `X ω ∈ A ↔ Y ω ∈ A` almost everywhere form a σ-algebra containing the
generators, hence containing `m`; a countable separating family of measurable sets of the target
then gives the conclusion. No measurability of `X` or `Y` is needed.

## Main results

* `LatticeProb.ae_iff_mem_of_ae_eq_generators`: `X ω ∈ A ↔ Y ω ∈ A` almost everywhere for every
  `m`-measurable `A`.
* `LatticeProb.ae_eq_comp_of_ae_eq_generators`: `F (X ω) = F (Y ω)` almost everywhere.
-/

open MeasureTheory Set

namespace LatticeProb

variable {Ω α : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {ι : Type*} {β : ι → Type*}
  [∀ i, MeasurableSpace (β i)] {p : ∀ i, α → β i} {m : MeasurableSpace α} {X Y : Ω → α}

/-- If `m` is contained in the σ-algebra generated by the maps `p i` and `p i ∘ X = p i ∘ Y`
almost everywhere for each `i`, then for every `m`-measurable set `A`, almost everywhere
`X ω ∈ A ↔ Y ω ∈ A`. -/
theorem ae_iff_mem_of_ae_eq_generators
    (hm : m ≤ ⨆ i, MeasurableSpace.comap (p i) inferInstance)
    (hXY : ∀ i, ∀ᵐ ω ∂μ, p i (X ω) = p i (Y ω)) {A : Set α} (hA : MeasurableSet[m] A) :
    ∀ᵐ ω ∂μ, (X ω ∈ A ↔ Y ω ∈ A) := by
  let G : MeasurableSpace α :=
    { MeasurableSet' := fun A => ∀ᵐ ω ∂μ, (X ω ∈ A ↔ Y ω ∈ A)
      measurableSet_empty := Filter.Eventually.of_forall fun _ => Iff.rfl
      measurableSet_compl := fun A hA => hA.mono fun ω h => by
        simp only [mem_compl_iff, h]
      measurableSet_iUnion := fun A hA => (ae_all_iff.2 hA).mono fun ω h => by
        simp only [mem_iUnion]
        exact exists_congr h }
  have hle : m ≤ G := hm.trans <| iSup_le fun i => by
    rintro _ ⟨B, -, rfl⟩
    exact (hXY i).mono fun ω h => by simp only [mem_preimage, h]
  exact hle A hA

/-- **Almost sure equality of observables.** If `m` is contained in the σ-algebra generated by
the maps `p i` and `p i ∘ X = p i ∘ Y` almost everywhere for each `i`, then `F ∘ X = F ∘ Y`
almost everywhere for every `m`-measurable map `F` into a countably separated space. -/
theorem ae_eq_comp_of_ae_eq_generators
    (hm : m ≤ ⨆ i, MeasurableSpace.comap (p i) inferInstance)
    (hXY : ∀ i, ∀ᵐ ω ∂μ, p i (X ω) = p i (Y ω))
    {E : Type*} [MeasurableSpace E] [HasCountableSeparatingOn E MeasurableSet univ]
    {F : α → E} (hF : Measurable[m] F) :
    ∀ᵐ ω ∂μ, F (X ω) = F (Y ω) := by
  obtain ⟨S, hSm, hS⟩ := exists_seq_separating E MeasurableSet.empty univ
  have hn : ∀ n, ∀ᵐ ω ∂μ, (F (X ω) ∈ S n ↔ F (Y ω) ∈ S n) := fun n =>
    ae_iff_mem_of_ae_eq_generators hm hXY (hF (hSm n))
  filter_upwards [ae_all_iff.2 hn] with ω hω
  exact hS _ (mem_univ _) _ (mem_univ _) hω

end LatticeProb
