import Mathlib
import LatticeProb.Prob.CrossingTimesStopping
import LatticeProb.Prob.BrownianStoppingFactor

/-!
# Crossing times of a Brownian motion are stopping times of its natural filtration

For a continuous process `B` in `ℝ^d` with measurable coordinates `B t`, every `ε`-crossing time
`ω ↦ crossTime ε (B · ω) k` is a stopping time of the natural filtration of `B`, and a measurable
random variable.  The proof compares the filtration of stopped paths on path space with the natural
filtration of the coordinate evaluations, and pulls back along the path map.
-/

open MeasureTheory
open scoped NNReal ENNReal

noncomputable section

namespace LatticeProb

/-- On the space of Brownian paths, the filtration generated by the stopped paths `x (· ∧ t)` is
contained in the natural filtration of the coordinate evaluations. -/
theorem stoppedPathFiltration_le_brownianNaturalFiltration (d : ℕ) (t : ℝ≥0) :
    stoppedPathFiltration (E := Euc d) t ≤ brownianNaturalFiltration d t := by
  change MeasurableSpace.comap (fun x : BrownianPath d => stopPath x t) _ ≤ _
  rw [ContinuousMapBorel.ContinuousMap.measurableSpace_eq_iSup_comap_eval,
    MeasurableSpace.comap_iSup]
  refine iSup_le fun x => ?_
  rw [MeasurableSpace.comap_comp]
  unfold brownianNaturalFiltration
  exact le_iSup₂_of_le (min x t) (min_le_right x t) le_rfl

/-- Each `ε`-crossing time of a Brownian path is a stopping time of the natural filtration of
the path space. -/
theorem isStoppingTime_crossTime_brownianNaturalFiltration (d : ℕ) {ε : ℝ} (hε : 0 < ε)
    (k : ℕ) :
    IsStoppingTime (brownianNaturalFiltration d)
      fun γ : BrownianPath d => crossTime ε (fun s => γ s) k := by
  intro u
  exact stoppedPathFiltration_le_brownianNaturalFiltration d u _
    (isStoppingTime_crossTime hε k u)

variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}

/-- Each `ε`-crossing time of a continuous process with measurable coordinates is a stopping time
of its natural filtration. -/
theorem isStoppingTime_crossTime_natFiltration (B : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d))
    (hm : ∀ t, StronglyMeasurable (B t)) (hcont : ∀ ω, Continuous fun t => B t ω) {ε : ℝ}
    (hε : 0 < ε) (k : ℕ) :
    IsStoppingTime (natFiltration B hm) fun ω => crossTime ε (fun t => B t ω) k := by
  intro u
  rw [natFiltration_eq_comap_pathMap B hm hcont u]
  exact ⟨_, isStoppingTime_crossTime_brownianNaturalFiltration d hε k u, rfl⟩

/-- Each `ε`-crossing time of a continuous process with measurable coordinates is a measurable
random variable. -/
theorem measurable_crossTime_process (B : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d))
    (hm : ∀ t, StronglyMeasurable (B t)) (hcont : ∀ ω, Continuous fun t => B t ω) {ε : ℝ}
    (hε : 0 < ε) (k : ℕ) :
    Measurable fun ω => crossTime ε (fun t => B t ω) k := by
  have h1 : Measurable (pathMap B hcont) :=
    measurable_pathMap B (fun t => (hm t).measurable) hcont
  have h2 : Measurable fun y : BrownianPath d => crossTime ε (fun s => y s) k :=
    measurable_crossTime (E := Euc d) hε k
  have h3 : Measurable fun ω => (fun y : BrownianPath d => crossTime ε (fun s => y s) k)
      (pathMap B hcont ω) := h2.comp h1
  exact h3

end LatticeProb
