import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.MeasureTheory.Function.AEEqOfIntegral
import Mathlib.MeasureTheory.MeasurableSpace.EventuallyMeasurable

/-! # Conditional lower bounds from integrated lower bounds

If an event `A` carries at least the fraction `p` of the mass of every set of a sub-σ-algebra
`G`, then its conditional probability given `G` is at least `p` almost everywhere.

For the σ-algebra generated by an observation `f`, completed by the null sets and intersected
with the ambient σ-algebra, it suffices to check the integrated bound on the preimages
`f ⁻¹' S` of measurable sets `S`. No measurability of `f` is needed: the intersection with the
ambient σ-algebra keeps the conditioning σ-algebra below it. -/

set_option autoImplicit false

open MeasureTheory Set Filter
open scoped ENNReal

namespace LatticeProb

/-- If `ofReal p * μ s ≤ μ (s ∩ A)` for every `G`-measurable set `s`, then the conditional
probability of `A` given `G` is at least `p` almost everywhere. -/
theorem le_condExp_indicator_of_forall_measure_inter_ge
    {Ω : Type*} {G : MeasurableSpace Ω} [m : MeasurableSpace Ω] {μ : Measure Ω} [IsFiniteMeasure μ]
    (hG : G ≤ m) {A : Set Ω} (hA : MeasurableSet[m] A) {p : ℝ}
    (h : ∀ s, MeasurableSet[G] s → ENNReal.ofReal p * μ s ≤ μ (s ∩ A)) :
    ∀ᵐ ω ∂μ, p ≤ μ[A.indicator (fun _ => (1 : ℝ)) | G] ω := by
  have hint : Integrable (A.indicator (fun _ => (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hA
  have hle : (fun _ => p) ≤ᵐ[μ.trim hG] μ[A.indicator (fun _ => (1 : ℝ)) | G] := by
    refine ae_le_of_forall_setIntegral_le (integrable_const p)
      (integrable_condExp.trim hG stronglyMeasurable_condExp) ?_
    intro s hs _
    rw [← setIntegral_trim hG stronglyMeasurable_const hs,
      ← setIntegral_trim hG stronglyMeasurable_condExp hs,
      setIntegral_condExp hG hint hs, setIntegral_const, integral_indicator_const _ hA,
      measureReal_restrict_apply hA, smul_eq_mul, smul_eq_mul, mul_one, inter_comm]
    have hmono : (ENNReal.ofReal p * μ s).toReal ≤ μ.real (s ∩ A) :=
      ENNReal.toReal_mono (measure_ne_top μ _) (h s hs)
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal', ← measureReal_def] at hmono
    calc μ.real s * p ≤ μ.real s * max p 0 :=
          mul_le_mul_of_nonneg_left (le_max_left p 0) measureReal_nonneg
      _ = max p 0 * μ.real s := mul_comm _ _
      _ ≤ μ.real (s ∩ A) := hmono
  exact ae_le_of_ae_le_trim hle

/-- Conditioning on the completed σ-algebra of an observation `f`, intersected with the ambient
σ-algebra: an integrated lower bound on the preimages of measurable sets gives the conditional
lower bound almost everywhere. -/
theorem le_condExp_indicator_of_forall_preimage
    {Ω β : Type*} [m : MeasurableSpace Ω] [mβ : MeasurableSpace β] {μ : Measure Ω}
    [IsFiniteMeasure μ] (f : Ω → β) {A : Set Ω} (hA : MeasurableSet[m] A) {p : ℝ}
    (h : ∀ S : Set β, MeasurableSet S → ENNReal.ofReal p * μ (f ⁻¹' S) ≤ μ (f ⁻¹' S ∩ A)) :
    ∀ᵐ ω ∂μ, p ≤ μ[A.indicator (fun _ => (1 : ℝ)) |
      eventuallyMeasurableSpace (mβ.comap f) (ae μ) ⊓ m] ω := by
  refine le_condExp_indicator_of_forall_measure_inter_ge (μ := μ)
    (G := eventuallyMeasurableSpace (mβ.comap f) (ae μ) ⊓ m) inf_le_right hA ?_
  intro s hs
  obtain ⟨t, ht, hst⟩ := (MeasurableSpace.measurableSet_inf.1 hs).1
  obtain ⟨S, hS, rfl⟩ := ht
  rw [measure_congr hst, measure_congr (hst.inter (EventuallyEq.refl _ A))]
  exact h S hS

end LatticeProb
