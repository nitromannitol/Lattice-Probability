import Mathlib
import LatticeProb.Prob.CrossingTimesClock17

/-!
# Transport of the adaptedness of the inverse crossing clock to the clock-read path space

Let `psi : Ω → Ω'` be measurable, `U ≤ mΩ'` a σ-algebra on `Ω'` and `Y : Ω' → ℝ≥0` measurable.  If
`Y ∘ psi` agrees `μ`-almost surely with a function measurable for `comap psi U`, then `Y` agrees
`μ.map psi`-almost surely with a `U`-measurable function
(`exists_measurable_ae_eq_map_of_comap`): an event of `comap Y` pulls back to an event of
`comap (Y ∘ psi)`, which is almost surely a preimage of an event of `U`, and the measure of the
symmetric difference of two events is computed after pulling back.

The clock-read map `clockRead m : C(ℝ≥0, E) → (ℝ≥0 → E)` sends a path to the path read in its
crossing clock.  The σ-algebra `pastSigma m t` is contained in `comap (clockRead m) (coordPast E t)`,
where `coordPast E t` is generated by the coordinates at times `≤ t` on the function space
(`pastSigma_le_comap_clockRead`).  Consequently, if the clock `A_t` is almost surely a measurable
functional `F` of the clock-read path, then `F` agrees, under the law of the clock-read path, with a
function measurable for the coordinates up to time `t`
(`exists_measurable_coordPast_ae_eq_map_clockRead`).
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace LatticeProb

/-- **Transport of an almost sure measurable version along a map.**  If `Y ∘ psi` agrees almost
surely with a `comap psi U`-measurable function, then `Y` agrees, under `μ.map psi`, with a
`U`-measurable function. -/
theorem exists_measurable_ae_eq_map_of_comap {Ω Ω' : Type*} (U : MeasurableSpace Ω')
    [mΩ : MeasurableSpace Ω] [mΩ' : MeasurableSpace Ω'] {μ : Measure Ω} {psi : Ω → Ω'}
    (hpsi : Measurable psi) (hU : U ≤ mΩ') {Y : Ω' → ℝ≥0} (hY : Measurable Y) {g : Ω → ℝ≥0}
    (hg : Measurable[MeasurableSpace.comap psi U] g) (hae : (fun ω => Y (psi ω)) =ᵐ[μ] g) :
    ∃ h : Ω' → ℝ≥0, Measurable[U] h ∧ Y =ᵐ[μ.map psi] h := by
  have hle : AELeSigma (MeasurableSpace.comap Y inferInstance) U (μ.map psi) := by
    rintro _ ⟨s, hs, rfl⟩
    obtain ⟨a, ha, hpa⟩ := hg hs
    refine ⟨a, ha, ?_⟩
    have hYs : MeasurableSet (Y ⁻¹' s) := hY hs
    have haM : MeasurableSet a := hU _ ha
    have hset : MeasurableSet {w : Ω' | (w ∈ Y ⁻¹' s) = (w ∈ a)} := by
      have : {w : Ω' | (w ∈ Y ⁻¹' s) = (w ∈ a)} = ((Y ⁻¹' s) ∩ a) ∪ ((Y ⁻¹' s)ᶜ ∩ aᶜ) := by
        ext w
        simp only [Set.mem_ofPred_eq, eq_iff_iff, Set.mem_union, Set.mem_inter_iff,
          Set.mem_compl_iff]
        tauto
      rw [this]
      exact (hYs.inter haM).union (hYs.compl.inter haM.compl)
    show ∀ᵐ w ∂(μ.map psi), (w ∈ Y ⁻¹' s) = (w ∈ a)
    rw [ae_map_iff hpsi.aemeasurable hset]
    filter_upwards [hae] with ω hω
    have h1 : (ω ∈ psi ⁻¹' a) = (ω ∈ g ⁻¹' s) := by rw [hpa]
    show (Y (psi ω) ∈ s) = (psi ω ∈ a)
    rw [hω]
    exact h1.symm
  exact AELeSigma.exists_measurable_ae_eq_nnreal hle

/-- The σ-algebra on the function space generated by the coordinates at times `≤ t`. -/
@[instance_reducible]
def coordPast (E : Type*) [MeasurableSpace E] (t : ℝ≥0) : MeasurableSpace (ℝ≥0 → E) :=
  ⨆ s ≤ t, MeasurableSpace.comap (fun f : ℝ≥0 → E => f s) inferInstance

theorem coordPast_le (E : Type*) [MeasurableSpace E] (t : ℝ≥0) :
    coordPast E t ≤ (inferInstance : MeasurableSpace (ℝ≥0 → E)) :=
  iSup₂_le fun s _ => (measurable_pi_apply s).comap_le

/-- The coordinates up to time `t` of a continuous path generate the same σ-algebra as the
coordinates of the path as a function. -/
theorem comap_coe_coordPast (E : Type*) [TopologicalSpace E] [MeasurableSpace E] (t : ℝ≥0) :
    MeasurableSpace.comap (fun (x : C(ℝ≥0, E)) (u : ℝ≥0) => x u) (coordPast E t) =
      ⨆ s ≤ t, MeasurableSpace.comap (fun x : C(ℝ≥0, E) => x s) inferInstance := by
  unfold coordPast
  rw [MeasurableSpace.comap_iSup]
  refine iSup_congr fun s => ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_congr fun _ => ?_
  rw [MeasurableSpace.comap_comp]
  rfl

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]

/-- The path read in its crossing clock, as a function of time. -/
def clockRead (m : ℝ≥0∞) (y : C(ℝ≥0, E)) (t : ℝ≥0) : E :=
  clockPath m (fun u => y u) t

theorem measurable_clockRead (m : ℝ≥0∞) : Measurable (clockRead (E := E) m) :=
  Measurable.of_eval fun t => measurable_clockPath m t

omit [SecondCountableTopology E] [BorelSpace E] in
theorem pastSigma_le_comap_clockRead (m : ℝ≥0∞) (t : ℝ≥0) :
    pastSigma (E := E) m t ≤ MeasurableSpace.comap (clockRead m) (coordPast E t) := by
  refine iSup₂_le fun q hq => ?_
  have h1 : MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => clockPath m (fun u => x u) (ratTime q)) inferInstance =
      MeasurableSpace.comap (clockRead m)
        (MeasurableSpace.comap (fun f : ℝ≥0 → E => f (ratTime q)) inferInstance) := by
    rw [MeasurableSpace.comap_comp]
    rfl
  rw [h1]
  exact MeasurableSpace.comap_mono (le_iSup₂_of_le (ratTime q) hq le_rfl)

attribute [local instance] dUnifMetricSpace

set_option linter.overlappingInstances false in
/-- **The clock functional is adapted to the coordinates of the clock-read path.**  Under `K z`,
if `A_t` is almost surely a measurable functional `F` of the path read in its crossing clock, then
`F` agrees, under the law of the clock-read path, with a function measurable for the coordinates
at times `≤ t`. -/
theorem exists_measurable_coordPast_ae_eq_map_clockRead [PolishSpace E]
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) {z : E}
    (hM : ∀ t, MarkovAt K z t) (m : ℝ≥0∞)
    (hshift : ∀ t s : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ShiftIdentity m t s x)
    (hatt : ∀ t : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    (hcont : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      Continuous fun u : ℝ≥0 => (pathClockInv m x u).toReal) (t : ℝ≥0)
    {F : (ℝ≥0 → E) → ℝ} (hF : Measurable F)
    (hFA : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), (pathClockInv m x t).toReal = F (clockRead m x)) :
    ∃ h : (ℝ≥0 → E) → ℝ≥0, Measurable[coordPast E t] h ∧
      (fun f => Real.toNNReal (F f)) =ᵐ[(K z : Measure C(ℝ≥0, E)).map (clockRead m)] h := by
  obtain ⟨g, hg, hgae⟩ :=
    exists_measurable_pastSigma_pathClockInv hK hM m hshift hatt hcont t
  refine exists_measurable_ae_eq_map_of_comap (coordPast E t) (measurable_clockRead m)
    (coordPast_le E t) hF.real_toNNReal
    (hg.mono (pastSigma_le_comap_clockRead m t) le_rfl) ?_
  filter_upwards [hgae, hFA] with x h1 h2
  show Real.toNNReal (F (clockRead m x)) = g x
  rw [← h2]
  exact h1

end LatticeProb
