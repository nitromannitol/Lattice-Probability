import LatticeProb.Prob.IncrementSigmaInclusions

/-! # Sigma algebras of centered half-paths -/

set_option autoImplicit false

open MeasureTheory MeasurableSpace Set
open scoped NNReal

namespace LatticeProb

variable {Ω ι : Type*}

/-- The sigma algebra of past increments is generated by the backward half-path. -/
theorem incrementSigma_past_eq_comap (X : ι → ℝ → Ω → ℝ) (b : ℝ) :
    incrementSigma X (Iic b) b =
      MeasurableSpace.comap
        (fun ω (p : ι × ℝ≥0) => X p.1 (b - (p.2 : ℝ)) ω - X p.1 b ω)
        inferInstance := by
  rw [MeasurableSpace.comap_process_pi]
  apply le_antisymm
  · refine iSup_le fun i => iSup_le fun t => iSup_le fun ht => ?_
    let r : ℝ≥0 := ⟨b - t, sub_nonneg.mpr ht⟩
    have heq : b - (r : ℝ) = t := by change b - (b - t) = t; ring
    simpa only [heq] using
      (le_iSup (fun p : ι × ℝ≥0 => MeasurableSpace.comap
        (fun ω => X p.1 (b - (p.2 : ℝ)) ω - X p.1 b ω) inferInstance) (i, r))
  · refine iSup_le fun p => ?_
    exact le_iSup_of_le p.1 <| le_iSup_of_le (b - (p.2 : ℝ)) <|
      le_iSup_of_le (sub_le_self b p.2.coe_nonneg) le_rfl

/-- The sigma algebra of future increments is generated by the forward half-path. -/
theorem incrementSigma_future_eq_comap (X : ι → ℝ → Ω → ℝ) (b : ℝ) :
    incrementSigma X (Ici b) b =
      MeasurableSpace.comap
        (fun ω (p : ι × ℝ≥0) => X p.1 (b + (p.2 : ℝ)) ω - X p.1 b ω)
        inferInstance := by
  rw [MeasurableSpace.comap_process_pi]
  apply le_antisymm
  · refine iSup_le fun i => iSup_le fun t => iSup_le fun ht => ?_
    let r : ℝ≥0 := ⟨t - b, sub_nonneg.mpr ht⟩
    have heq : b + (r : ℝ) = t := by change b + (t - b) = t; ring
    simpa only [heq] using
      (le_iSup (fun p : ι × ℝ≥0 => MeasurableSpace.comap
        (fun ω => X p.1 (b + (p.2 : ℝ)) ω - X p.1 b ω) inferInstance) (i, r))
  · refine iSup_le fun p => ?_
    exact le_iSup_of_le p.1 <| le_iSup_of_le (b + (p.2 : ℝ)) <|
      le_iSup_of_le (le_add_of_nonneg_right p.2.coe_nonneg) le_rfl

end LatticeProb
