import LatticeProb.Prob.StoppedPathHistory

/-! # Deterministic stopped paths and natural filtrations -/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace LatticeProb

/-- At a deterministic time, the natural filtration is generated by the continuous
path stopped at that time. -/
theorem natFiltration_eq_comap_stoppedPath {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    {X : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)}
    (hm : ∀ t, StronglyMeasurable (X t))
    (hc : ∀ ω, Continuous fun t => X t ω) (t : ℝ≥0) :
    natFiltration X hm t = MeasurableSpace.comap
      (fun ω => stoppedPath (t : ℝ≥0∞) (pathMap X hc ω)) inferInstance := by
  apply le_antisymm
  · rw [natFiltration_eq_comap]
    apply Measurable.comap_le
    let _ : MeasurableSpace Ω := MeasurableSpace.comap
      (fun ω => stoppedPath (t : ℝ≥0∞) (pathMap X hc ω)) inferInstance
    apply measurable_pi_iff.2
    intro s
    have h := (ContinuousMapBorel.ContinuousMap.measurable_eval (s : ℝ≥0)).comp
      (comap_measurable (fun ω => stoppedPath (t : ℝ≥0∞) (pathMap X hc ω)))
    convert h using 1
    funext ω
    change X (s : ℝ≥0) ω = X (min (s : ℝ≥0∞) (t : ℝ≥0∞)).toNNReal ω
    rw [min_eq_left (show (s : ℝ≥0∞) ≤ t by exact_mod_cast s.2)]
    simp
  · have hτ : IsStoppingTime (natFiltration X hm) (fun _ : Ω => (t : ℝ≥0∞)) :=
      isStoppingTime_const _ t
    have h := measurable_stoppedPath_natFiltration hm hc hτ
    change Measurable[(isStoppingTime_const (natFiltration X hm) t).measurableSpace] _ at h
    rw [IsStoppingTime.measurableSpace_const] at h
    exact h.comap_le

end LatticeProb
