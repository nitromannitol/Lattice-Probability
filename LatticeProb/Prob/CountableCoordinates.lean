import Mathlib.Data.Nat.Pairing
import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-!
# Events of a generated sigma-algebra depend on countably many coordinates

Let `X i : Ω → E` be a family of maps into a measurable space. Every event of the sigma-algebra generated by the
family is an event of countably many of the maps, in the strong form: it is the preimage of a *measurable* set of
sequences under `ω ↦ (X (x n) ω)ₙ` for some sequence of indices `x`.

* `LatticeProb.exists_seq_measurableSet_of_measurableSet_iSup_comap`: the statement for the sigma-algebra
  `⨆ i, comap (X i)`.
* `LatticeProb.exists_seq_measurableSet_of_measurableSet_iSup_comap_of_forall`: the statement for the family
  restricted to the indices satisfying a predicate, `⨆ (i) (_ : p i), comap (X i)`.
* `LatticeProb.exists_seq_measurableSet_of_measurableSet_comap_pi`: the statement for the sigma-algebra generated
  by the joint map `ω ↦ (X ω i)ᵢ` into the product space.
* `LatticeProb.exists_seq_measurableSet_of_measurableSet_pi`: a measurable set of the product space `ι → E` is the
  preimage of a measurable set of sequences under a countable coordinate projection.

Mathlib's `MeasurableSet.eq_preimage_restrict_countable` gives the dependence of a measurable set of a product
space on countably many coordinates without the measurability of the set of restricted configurations; here the
coordinates are enumerated by a sequence and the set of sequences is measurable.
-/

open MeasureTheory

namespace LatticeProb

variable {Ω ι E : Type*} [MeasurableSpace E]

/-- An event of the sigma-algebra generated by a family of maps `X i : Ω → E` is the preimage of a measurable set
of sequences under `ω ↦ (X (x n) ω)ₙ`, for some sequence of indices `x`. -/
theorem exists_seq_measurableSet_of_measurableSet_iSup_comap [Nonempty ι] {X : ι → Ω → E} {A : Set Ω}
    (hA : MeasurableSet[⨆ i, MeasurableSpace.comap (X i) inferInstance] A) :
    ∃ (x : ℕ → ι) (S : Set (ℕ → E)), MeasurableSet S ∧ A = {ω | (fun n => X (x n) ω) ∈ S} := by
  rw [MeasurableSpace.measurableSet_iSup] at hA
  induction hA with
  | basic s hs =>
    obtain ⟨i, B, hB, rfl⟩ := hs
    exact ⟨fun _ => i, {y | y 0 ∈ B}, measurable_pi_apply 0 hB, rfl⟩
  | empty => exact ⟨fun _ => Classical.arbitrary ι, ∅, MeasurableSet.empty, rfl⟩
  | compl s _ ih =>
    obtain ⟨x, S, hS, rfl⟩ := ih
    exact ⟨x, Sᶜ, hS.compl, rfl⟩
  | iUnion f _ ih =>
    choose x S hS hf using ih
    have key : ∀ k ω, (fun m => X (x (Nat.pair k m).unpair.1 (Nat.pair k m).unpair.2) ω) =
        fun n => X (x k n) ω := by
      intro k ω
      funext m
      rw [Nat.unpair_pair]
    refine ⟨fun n => x n.unpair.1 n.unpair.2, ⋃ k, {y | (fun m => y (Nat.pair k m)) ∈ S k}, ?_, ?_⟩
    · refine MeasurableSet.iUnion fun k => ?_
      have hg : Measurable fun (y : ℕ → E) (m : ℕ) => y (Nat.pair k m) :=
        measurable_pi_iff.mpr fun m => measurable_pi_apply (Nat.pair k m)
      exact hg (hS k)
    · ext ω
      constructor
      · intro h
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp h
        rw [hf k] at hk
        refine Set.mem_iUnion.mpr ⟨k, ?_⟩
        change (fun m => X (x (Nat.pair k m).unpair.1 (Nat.pair k m).unpair.2) ω) ∈ S k
        rw [key]
        exact hk
      · intro h
        have h' : (fun n => X (x n.unpair.1 n.unpair.2) ω) ∈
            ⋃ k, {y : ℕ → E | (fun m => y (Nat.pair k m)) ∈ S k} := h
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp h'
        change (fun m => X (x (Nat.pair k m).unpair.1 (Nat.pair k m).unpair.2) ω) ∈ S k at hk
        rw [key] at hk
        refine Set.mem_iUnion.mpr ⟨k, ?_⟩
        rw [hf k]
        exact hk

/-- An event of the sigma-algebra generated by the maps `X i` with `p i` is the preimage of a measurable set of
sequences under `ω ↦ (X (x n) ω)ₙ`, for some sequence of indices `x` satisfying `p`. -/
theorem exists_seq_measurableSet_of_measurableSet_iSup_comap_of_forall {p : ι → Prop} (hp : ∃ i, p i)
    {X : ι → Ω → E} {A : Set Ω}
    (hA : MeasurableSet[⨆ (i) (_ : p i), MeasurableSpace.comap (X i) inferInstance] A) :
    ∃ (x : ℕ → ι) (S : Set (ℕ → E)),
      (∀ n, p (x n)) ∧ MeasurableSet S ∧ A = {ω | (fun n => X (x n) ω) ∈ S} := by
  obtain ⟨i₀, hi₀⟩ := hp
  have : Nonempty {i // p i} := ⟨⟨i₀, hi₀⟩⟩
  rw [iSup_subtype'] at hA
  obtain ⟨x, S, hS, h⟩ :=
    exists_seq_measurableSet_of_measurableSet_iSup_comap (X := fun i : {i // p i} => X i) hA
  exact ⟨fun n => x n, S, fun n => (x n).2, hS, h⟩

/-- An event of the sigma-algebra generated by a map `X : Ω → ι → E` into a product space is the preimage of a
measurable set of sequences under `ω ↦ (X ω (x n))ₙ`, for some sequence of coordinates `x`. -/
theorem exists_seq_measurableSet_of_measurableSet_comap_pi [Nonempty ι] {X : Ω → ι → E} {A : Set Ω}
    (hA : MeasurableSet[MeasurableSpace.comap X MeasurableSpace.pi] A) :
    ∃ (x : ℕ → ι) (S : Set (ℕ → E)), MeasurableSet S ∧ A = {ω | (fun n => X ω (x n)) ∈ S} := by
  have e : MeasurableSpace.comap X MeasurableSpace.pi =
      ⨆ i, MeasurableSpace.comap (fun ω => X ω i) inferInstance := by
    rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    exact iSup_congr fun i => MeasurableSpace.comap_comp
  rw [e] at hA
  exact exists_seq_measurableSet_of_measurableSet_iSup_comap (X := fun i ω => X ω i) hA

/-- A measurable set of the product space `ι → E` is the preimage of a measurable set of sequences under the
projection `f ↦ (f (x n))ₙ` to countably many coordinates. -/
theorem exists_seq_measurableSet_of_measurableSet_pi [Nonempty ι] {T : Set (ι → E)} (hT : MeasurableSet T) :
    ∃ (x : ℕ → ι) (S : Set (ℕ → E)), MeasurableSet S ∧ T = {f | (fun n => f (x n)) ∈ S} :=
  exists_seq_measurableSet_of_measurableSet_comap_pi (X := id) (by rwa [MeasurableSpace.comap_id])

end LatticeProb
