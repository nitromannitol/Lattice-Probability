import LatticeProb.Prob.CanonicalOpenExitHistory
import LatticeProb.Prob.CanonicalSpacedExitTrial

/-! # Spaced exit trials conditioned on the stopped path -/

set_option autoImplicit false

open Set Metric MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace LatticeProb

/-- On canonical continuous-path space, the nested ball-exit history is generated by
its path stopped at that same exit. -/
theorem canonical_ballExitHistory_eq_stoppedPath {d : ℕ}
    (z : EuclideanSpace ℝ (Fin d)) (r : ℕ → ℝ) (hr : Monotone r) (k : ℕ) :
    let X : ℝ≥0 → C(ℝ≥0, EuclideanSpace ℝ (Fin d)) → EuclideanSpace ℝ (Fin d) :=
      fun t w => w t
    let hm : ∀ t, StronglyMeasurable (X t) :=
      fun t => (ContinuousMapBorel.ContinuousMap.measurable_eval t).stronglyMeasurable
    let hc : ∀ w, Continuous fun t => X t w := fun w => w.continuous
    ballExitHistory X hm hc z r hr k = MeasurableSpace.comap
      (fun w => stoppedPath (openExitTime X (ball z (r k)) w) w) inferInstance := by
  exact canonical_openExit_stopped_history isOpen_ball

/-- A stopped-path conditional success estimate gives the spaced exit-trial bound
for a measurable realization of a canonical path law. -/
theorem measureReal_real_ballExitTrace_failure_le_spaced_of_stoppedPath
    {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} (P : Measure Ω)
    [IsProbabilityMeasure P]
    (Φ : Ω → C(ℝ≥0, EuclideanSpace ℝ (Fin d))) (hΦ : Measurable Φ)
    (z : EuclideanSpace ℝ (Fin d)) (R C ε : ℝ)
    (hR : 0 < R) (hC : 0 < C) (hε : 0 < ε) {p : ℝ}
    (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    let X : ℝ≥0 → C(ℝ≥0, EuclideanSpace ℝ (Fin d)) → EuclideanSpace ℝ (Fin d) :=
      fun t w => w t
    (∀ᵐ w ∂(P.map Φ), openExitTime X (ball z R) w ≠ ⊤) →
    (∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, ∀ᵐ w ∂(P.map Φ),
      p ≤ (P.map Φ)[({w | ∃ y, ball y (ε * R) ⊆ (fun t : ℝ => X t.toNNReal w) '' Icc
        (sInf {t : ℝ | 0 ≤ t ∧ X t.toNNReal w ∉
          ball z (((k + 1 : ℕ) : ℝ) * (C * ε * R))})
        (sInf {t : ℝ | 0 ≤ t ∧ X t.toNNReal w ∉
          ball z (((k + 1 + 1 : ℕ) : ℝ) * (C * ε * R))})}).indicator
          (fun _ => (1 : ℝ)) | MeasurableSpace.comap
            (fun w => stoppedPath (openExitTime X
              (ball z (((k + 1 : ℕ) : ℝ) * (C * ε * R))) w) w) inferInstance] w) →
    P.real {ω | ¬ ∃ y, ball y (ε * R) ⊆ (fun t : ℝ => Φ ω t.toNNReal) '' Icc 0
      (sInf {t : ℝ | 0 ≤ t ∧ Φ ω t.toNNReal ∉ ball z R})} ≤
      Real.exp (p ^ 2) * Real.exp (-(p ^ 2 / 2) * (C * ε)⁻¹) := by
  dsimp only
  intro hfin hp
  apply measureReal_real_ballExitTrace_failure_le_spaced_of_map P Φ hΦ z R C ε
    hR hC hε hp0 hp1 hfin
  intro k hk
  rw [canonical_ballExitHistory_eq_stoppedPath]
  exact hp k hk

end LatticeProb
