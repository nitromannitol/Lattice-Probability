import LatticeProb.Prob.CondIndepEvJoin

/-!
# Conditional independence along a Markov chain of σ-algebras

General facts about the event form `LatticeProb.CondIndepEv` of conditional independence of
σ-algebras, used to show that the increments of an additive functional of a Markov process are
conditionally independent given the underlying process.

* `LatticeProb.CondIndepEv.weak_union`: if `A ⟂ B ⊔ C | G` then `A ⟂ B | C ⊔ G`.
* `LatticeProb.condIndepEv_of_markov_pair`: if the past pair `P ⊔ Dp` and the future pair
  `F ⊔ S` are conditionally independent given a state σ-algebra `X ≤ P`, where `P ⊔ F` is the whole
  path σ-algebra `ℬ`, then the past increments `Dp` and the next increment `S` are conditionally
  independent given `ℬ`.
* `LatticeProb.iCondIndepFun_of_condIndepEv_seq`: if each variable `D k` is conditionally
  independent given `ℬ` of the σ-algebra generated by the earlier ones, then the family is
  conditionally independent given `ℬ` (`ProbabilityTheory.iCondIndepFun`).
* `LatticeProb.iCondIndepFun_of_markov_chain`: the two combined.
* `LatticeProb.AELeSigma`, `LatticeProb.CondIndepEv.of_aeLe`: conditional independence is
  insensitive to modifying events on null sets.
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory MeasurableSpace Set

namespace LatticeProb

variable {Ω : Type*} {ℬ G A B C A' B' X P F Dp S : MeasurableSpace Ω} {mΩ : MeasurableSpace Ω}
  {μ : Measure Ω}

/-- **Weak union** for conditional independence: if `A ⟂ B ⊔ C | G` then `A ⟂ B | C ⊔ G`. -/
theorem CondIndepEv.weak_union [IsProbabilityMeasure μ]
    (hG : G ≤ mΩ) (hA : A ≤ mΩ) (hB : B ≤ mΩ) (hC : C ≤ mΩ)
    (h : CondIndepEv G A (B ⊔ C) μ) : CondIndepEv (C ⊔ G) A B μ := by
  have h1 : ∀ a, MeasurableSet[A] a → μ⟦a | (B ⊔ C) ⊔ G⟧ =ᵐ[μ] μ⟦a | G⟧ := fun a ha =>
    condExp_sup_eq_of_condIndepEv hG (sup_le hB hC) hA h.symm ha
  have h2 : ∀ a, MeasurableSet[A] a → μ⟦a | C ⊔ G⟧ =ᵐ[μ] μ⟦a | G⟧ := fun a ha =>
    condExp_sup_eq_of_condIndepEv hG hC hA (h.symm.mono le_sup_right le_rfl) ha
  refine condIndepEv_of_condExp_sup_eq (sup_le hC hG) hA hB fun a ha => ?_
  rw [← sup_assoc]
  exact (h1 a ha).trans (h2 a ha).symm

/-- **Past increments and next increment are conditionally independent given the whole path.**
Let `X ≤ P ≤ ℬ`, `F ≤ ℬ` and `ℬ ≤ P ⊔ F`.  If the past `P ⊔ Dp` and the future `F ⊔ S` are
conditionally independent given the state `X`, then `Dp ⟂ S | ℬ`. -/
theorem condIndepEv_of_markov_pair [IsProbabilityMeasure μ]
    (hX : X ≤ P) (hP : P ≤ ℬ) (hF : F ≤ ℬ) (hcov : ℬ ≤ P ⊔ F)
    (hℬ : ℬ ≤ mΩ) (hDp : Dp ≤ mΩ) (hS : S ≤ mΩ)
    (h : CondIndepEv X (P ⊔ Dp) (F ⊔ S) μ) : CondIndepEv ℬ Dp S μ := by
  have hPm : P ≤ mΩ := hP.trans hℬ
  have hFm : F ≤ mΩ := hF.trans hℬ
  have hXm : X ≤ mΩ := hX.trans hPm
  have h1 : CondIndepEv X (F ⊔ S) (Dp ⊔ P) μ := by
    rw [sup_comm Dp P]
    exact h.symm
  have h2 := CondIndepEv.weak_union hXm (sup_le hFm hS) hDp hPm h1
  rw [sup_eq_left.2 hX] at h2
  have h3 : CondIndepEv P Dp (S ⊔ F) μ := by
    rw [sup_comm S F]
    exact h2.symm
  have h4 := CondIndepEv.weak_union hPm hDp hS hFm h3
  have hFP : F ⊔ P = ℬ := le_antisymm (sup_le hF hP) (by rw [sup_comm F P]; exact hcov)
  rwa [hFP] at h4

/-- **Sequential criterion for conditional independence.**  If for every `k` the variable `D k`
is conditionally independent given `ℬ` of the σ-algebra generated by the variables `D i`, `i < k`,
then the family `D` is conditionally independent given `ℬ`. -/
theorem iCondIndepFun_of_condIndepEv_seq [StandardBorelSpace Ω] [IsProbabilityMeasure μ]
    {β : Type*} [MeasurableSpace β] {n : ℕ} (hℬ : ℬ ≤ mΩ)
    {D : Fin n → Ω → β} (hD : ∀ k, Measurable (D k))
    (h : ∀ k : Fin n, CondIndepEv ℬ
      (⨆ i : Fin n, ⨆ _ : i < k, MeasurableSpace.comap (D i) inferInstance)
      (MeasurableSpace.comap (D k) inferInstance) μ) :
    iCondIndepFun ℬ hℬ D μ := by
  classical
  refine (iCondIndepFun_iff_condExp_inter_preimage_eq_mul (fun _ : Fin n => inferInstance)
    D hD).2 ?_
  intro S
  induction S using Finset.induction_on_max with
  | empty =>
    intro sets _
    have hu : (⋂ i ∈ (∅ : Finset (Fin n)), D i ⁻¹' sets i) = Set.univ := by simp
    rw [hu, Finset.prod_empty, Set.indicator_univ, condExp_const hℬ]
    exact Filter.EventuallyEq.rfl
  | insert a S hlt ih =>
    intro sets hsets
    have han : a ∉ S := fun hm => lt_irrefl a (hlt a hm)
    have hmem : ∀ i ∈ S, MeasurableSet[⨆ i : Fin n, ⨆ _ : i < a,
        MeasurableSpace.comap (D i) inferInstance] (D i ⁻¹' sets i) := by
      intro i hi
      exact (le_iSup₂ (f := fun (j : Fin n) (_ : j < a) =>
        MeasurableSpace.comap (D j) inferInstance) i (hlt i hi)) _
        ⟨sets i, hsets i (Finset.mem_insert_of_mem hi), rfl⟩
    have hint := Finset.measurableSet_biInter S hmem
    have hDa : MeasurableSet[MeasurableSpace.comap (D a) inferInstance] (D a ⁻¹' sets a) :=
      ⟨sets a, hsets a (Finset.mem_insert_self a S), rfl⟩
    have key := h a _ _ hint hDa
    have hset : (⋂ i ∈ insert a S, D i ⁻¹' sets i) =
        (⋂ i ∈ S, D i ⁻¹' sets i) ∩ D a ⁻¹' sets a := by
      rw [Finset.set_biInter_insert, Set.inter_comm]
    rw [hset, Finset.prod_insert han]
    filter_upwards [key, ih (fun i hi => hsets i (Finset.mem_insert_of_mem hi))] with ω h1 h2
    simp only [Pi.mul_apply, Finset.prod_apply] at h1 h2 ⊢
    rw [h1, h2, mul_comm]

/-- **Conditional independence of the increments of an additive functional of a chain.**
Let `ℬ` be a σ-algebra and, for each `k`, let `X k ≤ P k ≤ ℬ` and `F k ≤ ℬ` with
`ℬ ≤ P k ⊔ F k`.  If the past `P k` together with the earlier variables `D i` (`i < k`), and the
future `F k` together with `D k`, are conditionally independent given the state `X k`, then the
family `D` is conditionally independent given `ℬ`. -/
theorem iCondIndepFun_of_markov_chain [StandardBorelSpace Ω] [IsProbabilityMeasure μ]
    {β : Type*} [MeasurableSpace β] {n : ℕ} (hℬ : ℬ ≤ mΩ)
    {D : Fin n → Ω → β} (hD : ∀ k, Measurable (D k)) (X P F : Fin n → MeasurableSpace Ω)
    (hX : ∀ k, X k ≤ P k) (hP : ∀ k, P k ≤ ℬ) (hF : ∀ k, F k ≤ ℬ)
    (hcov : ∀ k, ℬ ≤ P k ⊔ F k)
    (hmk : ∀ k : Fin n, CondIndepEv (X k)
      (P k ⊔ ⨆ i : Fin n, ⨆ _ : i < k, MeasurableSpace.comap (D i) inferInstance)
      (F k ⊔ MeasurableSpace.comap (D k) inferInstance) μ) :
    iCondIndepFun ℬ hℬ D μ := by
  refine iCondIndepFun_of_condIndepEv_seq hℬ hD fun k => ?_
  refine condIndepEv_of_markov_pair (hX k) (hP k) (hF k) (hcov k) hℬ ?_ (hD k).comap_le (hmk k)
  exact iSup₂_le fun i _ => (hD i).comap_le

/-- `A` is contained in `A'` up to null sets: every event of `A` agrees almost surely with an
event of `A'`. -/
def AELeSigma (A A' : MeasurableSpace Ω) (μ : Measure[mΩ] Ω) : Prop :=
  ∀ a, MeasurableSet[A] a → ∃ a', MeasurableSet[A'] a' ∧ a =ᵐ[μ] a'

/-- Conditional independence is insensitive to replacing events by almost surely equal events. -/
theorem CondIndepEv.of_aeLe
    (h : CondIndepEv G A' B' μ) (hA : AELeSigma A A' μ) (hB : AELeSigma B B' μ) :
    CondIndepEv G A B μ := by
  intro a b ha hb
  obtain ⟨a', ha', haa⟩ := hA a ha
  obtain ⟨b', hb', hbb⟩ := hB b hb
  have e1 : μ⟦a ∩ b | G⟧ =ᵐ[μ] μ⟦a' ∩ b' | G⟧ :=
    condExp_congr_ae (indicator_ae_eq_of_ae_eq_set (haa.inter hbb))
  have e2 : μ⟦a | G⟧ =ᵐ[μ] μ⟦a' | G⟧ := condExp_congr_ae (indicator_ae_eq_of_ae_eq_set haa)
  have e3 : μ⟦b | G⟧ =ᵐ[μ] μ⟦b' | G⟧ := condExp_congr_ae (indicator_ae_eq_of_ae_eq_set hbb)
  filter_upwards [e1, e2, e3, h a' b' ha' hb'] with ω h1 h2 h3 h4
  simp only [Pi.mul_apply] at h4 ⊢
  rw [h1, h2, h3, h4]

end LatticeProb
