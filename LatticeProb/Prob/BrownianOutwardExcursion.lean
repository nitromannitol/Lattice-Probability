import Mathlib

/-!
# Planar Brownian motion is positive in a random direction at arbitrarily small times

A planar Brownian motion `W` started at `0` has two measurable coordinates which are real Brownian
motions and are independent processes (Mörters–Peres, *Brownian Motion*, Cambridge 2010, the
definition of `d`-dimensional Brownian motion). For a random vector `N ≠ 0` independent of `W`, the
pairing `⟪N, W_s⟫` is almost surely positive at times `s` arbitrarily close to `0`
(`ae_frequently_pos_of_indepFun`).

The proof has three steps.
* For a fixed direction `v ≠ 0` the real process `s ↦ ⟪v, W_s⟫` has centred Gaussian marginals of
  variance `|v|² s`, so each event "positive at a rational time in `(0, u)`" has probability at least `1/2`.
* The event "positive at rational times arbitrarily close to `0`" lies in the germ σ-algebra at zero,
  so it has probability `0` or `1` by Blumenthal's zero-one law. This law enters as the explicit
  hypothesis `hBlum` (Mörters–Peres, Theorem 2.7 with `d = 2`).
* Independence of `N` and `W`, and Fubini's theorem for the product law, transfer the statement
  from each fixed direction to the random direction `N`.

The strong Markov restart at a stopping time enters `ae_frequently_excursion` as an explicit
hypothesis (Mörters–Peres, Theorem 2.16).
-/

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology

namespace LatticeProb.PlanarBrownian

variable {Ω : Type*} [MeasurableSpace Ω]

/-- Planar Brownian motion started at `0`: measurable coordinate processes, each a real Brownian
motion, and the two coordinate processes are independent of each other. -/
structure IsPlanarBrownian (W : ℝ≥0 → Ω → ℂ) (P : Measure Ω) : Prop where
  measurable : ∀ t, Measurable (W t)
  re : IsBrownianReal (fun t ω => (W t ω).re) P
  im : IsBrownianReal (fun t ω => (W t ω).im) P
  indep : IndepFun (fun ω (t : ℝ≥0) => (W t ω).re) (fun ω (t : ℝ≥0) => (W t ω).im) P

/-- The real pairing `⟪v, z⟫ = v.re * z.re + v.im * z.im` of two complex numbers. -/
def pairing (v z : ℂ) : ℝ := v.re * z.re + v.im * z.im

lemma inner_eq_pairing (v z : ℂ) : inner ℝ v z = pairing v z := by
  simp [pairing, Complex.inner]
  ring

lemma measurable_pairing_left (v : ℂ) : Measurable (fun z : ℂ => pairing v z) :=
  (measurable_const.mul Complex.measurable_re).add (measurable_const.mul Complex.measurable_im)

/-- The σ-algebra generated by the coordinates of `X` on `[0, u]`. -/
@[reducible] def pathSigmaTo {E : Type*} [MeasurableSpace E] (X : ℝ≥0 → Ω → E) (u : ℝ≥0) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (t : Set.Iic u) => X t ω) inferInstance

omit [MeasurableSpace Ω] in
lemma measurable_pathSigmaTo_coord {E : Type*} [MeasurableSpace E] {X : ℝ≥0 → Ω → E} {u s : ℝ≥0}
    (hs : s ≤ u) : Measurable[pathSigmaTo X u] (X s) :=
  (measurable_pi_apply (⟨s, hs⟩ : Set.Iic u)).comp
    (comap_measurable (fun ω (t : Set.Iic u) => X t ω))

omit [MeasurableSpace Ω] in
lemma pathSigmaTo_mono {E : Type*} [MeasurableSpace E] (X : ℝ≥0 → Ω → E) {u v : ℝ≥0}
    (huv : u ≤ v) : pathSigmaTo X u ≤ pathSigmaTo X v := by
  let g : (Set.Iic v → E) → (Set.Iic u → E) := fun h t => h ⟨t, t.2.trans huv⟩
  have hg : Measurable g := measurable_pi_iff.2 fun t => measurable_pi_apply _
  have hcomp : (fun ω (t : Set.Iic u) => X t ω) = g ∘ (fun ω (t : Set.Iic v) => X t ω) := rfl
  unfold pathSigmaTo
  rw [hcomp, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hg.comap_le

lemma pathSigmaTo_le {E : Type*} [MeasurableSpace E] (X : ℝ≥0 → Ω → E)
    (hXm : ∀ t, Measurable (X t)) (u : ℝ≥0) : pathSigmaTo X u ≤ ‹MeasurableSpace Ω› :=
  (measurable_pi_iff.2 fun t : Set.Iic u => hXm t).comap_le

/-- The times `((n : ℝ≥0) + 1)⁻¹`, decreasing to `0`. -/
noncomputable def freqEps (n : ℕ) : ℝ≥0 := ((n : ℝ≥0) + 1)⁻¹

lemma freqEps_pos (n : ℕ) : 0 < freqEps n := by
  unfold freqEps; positivity

lemma freqEps_anti : Antitone freqEps := by
  intro m n hmn
  unfold freqEps
  exact inv_anti₀ (by positivity) (by exact_mod_cast Nat.add_le_add_right hmn 1)

lemma tendsto_freqEps : Tendsto freqEps atTop (𝓝 0) := by
  apply NNReal.tendsto_coe.1
  simp only [NNReal.coe_zero]
  refine tendsto_one_div_add_atTop_nhds_zero_nat.congr fun n => ?_
  simp [freqEps]

/-- The event that the real process `X` is positive at some rational time in `(0, u)`. -/
def positiveAtRationalBefore (X : ℝ≥0 → Ω → ℝ) (u : ℝ≥0) : Set Ω :=
  ⋃ q : {q : ℚ // 0 < (q : ℝ) ∧ (q : ℝ) < u}, {ω | 0 < X (Real.toNNReal q.1) ω}

omit [MeasurableSpace Ω] in
lemma positiveAtRationalBefore_mono (X : ℝ≥0 → Ω → ℝ) {u v : ℝ≥0} (huv : u ≤ v) :
    positiveAtRationalBefore X u ⊆ positiveAtRationalBefore X v := by
  intro ω hω
  obtain ⟨q, h⟩ := mem_iUnion.1 hω
  exact mem_iUnion.2 ⟨⟨q.1, q.2.1, lt_of_lt_of_le q.2.2 huv⟩, h⟩

omit [MeasurableSpace Ω] in
lemma positiveAtRationalBefore_anti (X : ℝ≥0 → Ω → ℝ) :
    Antitone fun m : ℕ => positiveAtRationalBefore X (freqEps m) :=
  fun _ _ hmn => positiveAtRationalBefore_mono X (freqEps_anti hmn)

omit [MeasurableSpace Ω] in
lemma measurableSet_pos_pathSigmaTo (X : ℝ≥0 → Ω → ℝ) {s u : ℝ≥0} (hsu : s ≤ u) :
    MeasurableSet[pathSigmaTo X u] {ω | 0 < X s ω} :=
  measurableSet_lt measurable_const (measurable_pathSigmaTo_coord hsu)

omit [MeasurableSpace Ω] in
lemma measurableSet_positiveAtRationalBefore (X : ℝ≥0 → Ω → ℝ) (u : ℝ≥0) :
    MeasurableSet[pathSigmaTo X u] (positiveAtRationalBefore X u) :=
  MeasurableSet.iUnion fun q => measurableSet_pos_pathSigmaTo X
    (Real.toNNReal_le_iff_le_coe.2 q.2.2.le)

omit [MeasurableSpace Ω] in
/-- The intersection of the events `positiveAtRationalBefore X (freqEps m)` lies in the germ
σ-algebra at zero. -/
lemma measurableSet_germ_positiveAtRationalBefore (X : ℝ≥0 → Ω → ℝ) :
    MeasurableSet[⨅ n : ℕ, pathSigmaTo X (freqEps n)]
      (⋂ m : ℕ, positiveAtRationalBefore X (freqEps m)) := by
  refine MeasurableSpace.measurableSet_iInf.2 fun n => ?_
  have heq : (⋂ m : ℕ, positiveAtRationalBefore X (freqEps m)) =
      ⋂ m : ℕ, positiveAtRationalBefore X (freqEps (m + n)) := by
    ext ω
    constructor
    · intro hω
      exact mem_iInter.2 fun m => mem_iInter.1 hω (m + n)
    · intro hω
      exact mem_iInter.2 fun m =>
        positiveAtRationalBefore_mono X (freqEps_anti (Nat.le_add_right m n)) (mem_iInter.1 hω m)
  rw [heq]
  exact MeasurableSet.iInter fun m =>
    pathSigmaTo_mono X (freqEps_anti (Nat.le_add_left n m))
      _ (measurableSet_positiveAtRationalBefore X (freqEps (m + n)))

/-- The half-mass bound: if each one-dimensional marginal of `X` at a positive time is centred Gaussian
with positive variance, then `X` is positive at some rational time in `(0, u)` with probability at
least `1/2`. -/
lemma half_le_measure_positiveAtRationalBefore {P : Measure Ω} (X : ℝ≥0 → Ω → ℝ)
    (hmarg : ∀ q : ℝ≥0, 0 < q → P (X q ⁻¹' Ioi 0) = 2⁻¹) {u : ℝ≥0} (hu : 0 < u) :
    (2⁻¹ : ℝ≥0∞) ≤ P (positiveAtRationalBefore X u) := by
  obtain ⟨q, hq0, hqu⟩ := exists_rat_btwn (show (0 : ℝ) < (u : ℝ) from NNReal.coe_pos.2 hu)
  have hsub : X (Real.toNNReal q) ⁻¹' Ioi 0 ⊆ positiveAtRationalBefore X u :=
    fun ω hω => mem_iUnion.2 ⟨⟨q, hq0, hqu⟩, hω⟩
  calc (2⁻¹ : ℝ≥0∞) = P (X (Real.toNNReal q) ⁻¹' Ioi 0) :=
        (hmarg _ (Real.toNNReal_pos.2 hq0)).symm
    _ ≤ P (positiveAtRationalBefore X u) := measure_mono hsub

/-- Blumenthal-type step for a real process with Gaussian marginals: almost surely, for every `m`,
the process is positive at some rational time in `(0, freqEps m)`. -/
theorem ae_forall_exists_rat_pos_of_marginal {P : Measure Ω} [IsProbabilityMeasure P]
    {X : ℝ≥0 → Ω → ℝ} (hXm : ∀ t, Measurable (X t))
    (hmarg : ∀ q : ℝ≥0, 0 < q → P (X q ⁻¹' Ioi 0) = 2⁻¹)
    (hBlum : ∀ A : Set Ω, MeasurableSet[⨅ n : ℕ, pathSigmaTo X (freqEps n)] A →
      P A = 0 ∨ P A = 1) :
    ∀ᵐ ω ∂P, ∀ m : ℕ, ∃ q : ℚ, 0 < (q : ℝ) ∧ (q : ℝ) < freqEps m ∧ 0 < X (Real.toNNReal q) ω := by
  set A : Set Ω := ⋂ m : ℕ, positiveAtRationalBefore X (freqEps m) with hAdef
  have hAgerm : MeasurableSet[⨅ n : ℕ, pathSigmaTo X (freqEps n)] A :=
    measurableSet_germ_positiveAtRationalBefore X
  have hAmeas : MeasurableSet A :=
    (pathSigmaTo_le X hXm (freqEps 0)) A ((iInf_le (fun n : ℕ => pathSigmaTo X (freqEps n)) 0) A hAgerm)
  have hlow : (2⁻¹ : ℝ≥0∞) ≤ P A := by
    have hmeas : ∀ m : ℕ, NullMeasurableSet (positiveAtRationalBefore X (freqEps m)) P :=
      fun m => ((pathSigmaTo_le X hXm (freqEps m)) _
        (measurableSet_positiveAtRationalBefore X (freqEps m))).nullMeasurableSet
    have ht := tendsto_measure_iInter_atTop (μ := P) hmeas (positiveAtRationalBefore_anti X)
      ⟨0, measure_ne_top P _⟩
    exact ge_of_tendsto' ht fun m =>
      half_le_measure_positiveAtRationalBefore X hmarg (freqEps_pos m)
  have hone : P A = 1 := by
    rcases hBlum A hAgerm with h | h
    · exact absurd h (ne_of_gt (lt_of_lt_of_le (ENNReal.inv_pos.2 (by norm_num)) hlow))
    · exact h
  have hae : ∀ᵐ ω ∂P, ω ∈ A := ae_iff.2 ((prob_compl_eq_zero_iff hAmeas).2 hone)
  filter_upwards [hae] with ω hω m
  have hm' : ω ∈ positiveAtRationalBefore X (freqEps m) := mem_iInter.1 hω m
  obtain ⟨⟨q, hq⟩, hpos⟩ := mem_iUnion.1 hm'
  exact ⟨q, hq.1, hq.2, hpos⟩

/-- Deterministic step: positivity at rational times `q_m ∈ (0, freqEps m)` for every `m` gives
positivity at arbitrarily small times, in the sense of `∃ᶠ s in 𝓝[>] 0`. -/
lemma frequently_of_forall_exists_rat {f : ℝ≥0 → ℝ}
    (h : ∀ m : ℕ, ∃ q : ℚ, 0 < (q : ℝ) ∧ (q : ℝ) < freqEps m ∧ 0 < f (Real.toNNReal q)) :
    ∃ᶠ s in 𝓝[>] (0 : ℝ≥0), 0 < f s := by
  refine Filter.frequently_iff.2 fun {U} hU => ?_
  obtain ⟨u, hu, hUu⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hU
  have hu0 : (0 : ℝ≥0) < u := hu
  obtain ⟨m, hm⟩ : ∃ m : ℕ, freqEps m < u :=
    ((tendsto_order.1 tendsto_freqEps).2 u hu0).exists
  obtain ⟨q, hq0, hqm, hpos⟩ := h m
  refine ⟨Real.toNNReal q, hUu ⟨Real.toNNReal_pos.2 hq0, ?_⟩, hpos⟩
  rw [← NNReal.coe_lt_coe, Real.coe_toNNReal _ hq0.le]
  exact lt_trans hqm (NNReal.coe_lt_coe.2 hm)

/-- The square `x²` as a nonnegative real. -/
noncomputable def sqNNReal (x : ℝ) : ℝ≥0 := ⟨x ^ 2, sq_nonneg x⟩

/-- The variance `|v|² t` of the real pairing `⟪v, W_t⟫`, written as `(v.re² + v.im²) t`. -/
noncomputable def pairingVar (v : ℂ) (t : ℝ≥0) : ℝ≥0 :=
  (sqNNReal v.re + sqNNReal v.im) * t

lemma pairingVar_ne_zero {v : ℂ} (hv : v ≠ 0) {t : ℝ≥0} (ht : t ≠ 0) : pairingVar v t ≠ 0 := by
  unfold pairingVar
  refine mul_ne_zero ?_ ht
  intro h
  apply hv
  obtain ⟨h1, h2⟩ := add_eq_zero.1 h
  have hre2 : v.re ^ 2 = 0 := by
    have h3 : ((sqNNReal v.re : ℝ≥0) : ℝ) = 0 := by rw [h1]; simp
    exact h3
  have him2 : v.im ^ 2 = 0 := by
    have h3 : ((sqNNReal v.im : ℝ≥0) : ℝ) = 0 := by rw [h2]; simp
    exact h3
  apply Complex.ext
  · simpa using (pow_eq_zero_iff two_ne_zero).1 hre2
  · simpa using (pow_eq_zero_iff two_ne_zero).1 him2

lemma gaussianReal_zero_measure_Ioi {t : ℝ≥0} (ht : t ≠ 0) :
    gaussianReal 0 t (Ioi 0) = 2⁻¹ := by
  set μ := gaussianReal 0 t with hμ
  have hneg : μ.map (fun x : ℝ => -x) = μ := by
    rw [hμ, gaussianReal_map_neg, neg_zero]
  have h1 : μ (Iio 0) = μ (Ioi 0) := by
    have h' : μ.map (fun x : ℝ => -x) (Ioi 0) = μ (Ioi 0) := by rw [hneg]
    rw [Measure.map_apply measurable_neg measurableSet_Ioi] at h'
    have hset : (fun x : ℝ => -x) ⁻¹' Ioi 0 = Iio 0 := by
      ext x; simp
    rw [hset] at h'
    exact h'
  have h0 : μ {0} = 0 := by
    have hac := gaussianReal_absolutelyContinuous (0 : ℝ) ht
    exact hac (Real.volume_singleton)
  have hunion : (Iio (0 : ℝ) ∪ {0}) ∪ Ioi 0 = univ := by
    ext x
    rcases lt_trichotomy x 0 with h | h | h <;> simp [h]
  have hdisj1 : Disjoint (Iio (0 : ℝ)) {0} := by
    rw [Set.disjoint_singleton_right]; simp
  have hdisj2 : Disjoint (Iio (0 : ℝ) ∪ {0}) (Ioi 0) := by
    rw [Set.disjoint_union_left]
    constructor
    · exact Set.disjoint_left.2 fun x (hx : x < 0) (hy : 0 < x) => lt_asymm hy hx
    · rw [Set.disjoint_singleton_left]; simp
  have hsum : μ (Iio 0) + μ {0} + μ (Ioi 0) = 1 := by
    rw [← measure_univ (μ := μ), ← hunion, measure_union hdisj2 measurableSet_Ioi,
      measure_union hdisj1 (measurableSet_singleton 0)]
  rw [h0, h1, add_zero] at hsum
  have h2 : μ (Ioi 0) * 2 = 1 := by
    rw [mul_two, hsum]
  exact ENNReal.eq_inv_of_mul_eq_one_left h2

/-- For a planar Brownian motion, the pairing `⟪v, W_t⟫` is a centred Gaussian of variance `|v|² t`. -/
lemma hasLaw_pairing {P : Measure Ω} [IsProbabilityMeasure P] {W : ℝ≥0 → Ω → ℂ}
    (hW : IsPlanarBrownian W P) (v : ℂ) (t : ℝ≥0) :
    HasLaw (fun ω => pairing v (W t ω)) (gaussianReal 0 (pairingVar v t)) P := by
  have hre : HasLaw (fun ω => (W t ω).re) (gaussianReal 0 t) P :=
    hW.re.toIsPreBrownianReal.hasLaw_eval t
  have him : HasLaw (fun ω => (W t ω).im) (gaussianReal 0 t) P :=
    hW.im.toIsPreBrownianReal.hasLaw_eval t
  have hind : IndepFun (fun ω => (W t ω).re) (fun ω => (W t ω).im) P :=
    hW.indep.comp (measurable_pi_apply t) (measurable_pi_apply t)
  have h1 : HasLaw (fun ω => v.re * (W t ω).re)
      (gaussianReal 0 (sqNNReal v.re * t)) P := by
    have hc : HasLaw (fun x : ℝ => v.re * x)
        (gaussianReal (v.re * 0) (sqNNReal v.re * t)) (gaussianReal 0 t) :=
      ⟨(by fun_prop : Measurable fun x : ℝ => v.re * x).aemeasurable,
        gaussianReal_map_const_mul v.re⟩
    have := hc.comp hre
    rw [mul_zero] at this
    exact this
  have h2 : HasLaw (fun ω => v.im * (W t ω).im)
      (gaussianReal 0 (sqNNReal v.im * t)) P := by
    have hc : HasLaw (fun x : ℝ => v.im * x)
        (gaussianReal (v.im * 0) (sqNNReal v.im * t)) (gaussianReal 0 t) :=
      ⟨(by fun_prop : Measurable fun x : ℝ => v.im * x).aemeasurable,
        gaussianReal_map_const_mul v.im⟩
    have := hc.comp him
    rw [mul_zero] at this
    exact this
  have hXY : IndepFun (fun ω => v.re * (W t ω).re) (fun ω => v.im * (W t ω).im) P :=
    hind.comp (by fun_prop : Measurable fun x : ℝ => v.re * x)
      (by fun_prop : Measurable fun x : ℝ => v.im * x)
  have hsum := gaussianReal_add_gaussianReal_of_indepFun hXY h1 h2
  have hfun : (fun ω => pairing v (W t ω)) =
      (fun ω => v.re * (W t ω).re) + (fun ω => v.im * (W t ω).im) := rfl
  refine ⟨h1.aemeasurable.add h2.aemeasurable, ?_⟩
  rw [hfun, hsum, add_zero, pairingVar, add_mul]

/-- The Gaussian marginal gives probability `1/2` to positivity of `⟪v, W_t⟫`. -/
lemma measure_pairing_pos {P : Measure Ω} [IsProbabilityMeasure P] {W : ℝ≥0 → Ω → ℂ}
    (hW : IsPlanarBrownian W P) {v : ℂ} (hv : v ≠ 0) {t : ℝ≥0} (ht : t ≠ 0) :
    P ((fun ω => pairing v (W t ω)) ⁻¹' Ioi 0) = 2⁻¹ := by
  have hl := hasLaw_pairing hW v t
  rw [← Measure.map_apply_of_aemeasurable hl.aemeasurable measurableSet_Ioi, hl.map_eq,
    gaussianReal_zero_measure_Ioi (pairingVar_ne_zero hv ht)]

omit [MeasurableSpace Ω] in
/-- The pairing with a fixed vector is measurable with respect to the coordinates up to `u`. -/
lemma pathSigmaTo_pairing_le {W : ℝ≥0 → Ω → ℂ} (v : ℂ) (u : ℝ≥0) :
    pathSigmaTo (fun t ω => pairing v (W t ω)) u ≤ pathSigmaTo W u := by
  let g : (Set.Iic u → ℂ) → (Set.Iic u → ℝ) := fun h t => pairing v (h t)
  have hg : Measurable g := measurable_pi_iff.2 fun t => (measurable_pairing_left v).comp
    (measurable_pi_apply t)
  have hcomp : (fun ω (t : Set.Iic u) => pairing v (W t ω)) =
      g ∘ (fun ω (t : Set.Iic u) => W t ω) := rfl
  unfold pathSigmaTo
  rw [hcomp]
  exact (hg.comp (comap_measurable (fun ω (t : Set.Iic u) => W t ω))).comap_le

omit [MeasurableSpace Ω] in
lemma germ_pairing_le {W : ℝ≥0 → Ω → ℂ} (v : ℂ) :
    (⨅ n : ℕ, pathSigmaTo (fun t ω => pairing v (W t ω)) (freqEps n)) ≤
      ⨅ n : ℕ, pathSigmaTo W (freqEps n) :=
  iInf_mono fun n => pathSigmaTo_pairing_le v (freqEps n)

/-- Pairs `(x, w)` such that `w` is positive in direction `x` at rational times arbitrarily close to `0`. -/
def directionalSet : Set (ℂ × (ℝ≥0 → ℂ)) :=
  {p | ∀ m : ℕ, ∃ q : ℚ, 0 < (q : ℝ) ∧ (q : ℝ) < freqEps m ∧
    0 < pairing p.1 (p.2 (Real.toNNReal q))}

lemma measurableSet_directionalSet : MeasurableSet directionalSet := by
  have hm : ∀ q : ℝ≥0, Measurable (fun p : ℂ × (ℝ≥0 → ℂ) => pairing p.1 (p.2 q)) := by
    intro q
    have hev : Measurable (fun p : ℂ × (ℝ≥0 → ℂ) => p.2 q) :=
      (measurable_pi_apply q).comp measurable_snd
    unfold pairing
    exact ((Complex.measurable_re.comp measurable_fst).mul (Complex.measurable_re.comp hev)).add
      ((Complex.measurable_im.comp measurable_fst).mul (Complex.measurable_im.comp hev))
  have heq : directionalSet = ⋂ m : ℕ, ⋃ q : {q : ℚ // 0 < (q : ℝ) ∧ (q : ℝ) < freqEps m},
      {p : ℂ × (ℝ≥0 → ℂ) | 0 < pairing p.1 (p.2 (Real.toNNReal q.1))} := by
    ext p
    constructor
    · intro h
      exact mem_iInter.2 fun m => by
        obtain ⟨q, h1, h2, h3⟩ := h m
        exact mem_iUnion.2 ⟨⟨q, h1, h2⟩, h3⟩
    · intro h m
      obtain ⟨⟨q, h1, h2⟩, h3⟩ := mem_iUnion.1 (mem_iInter.1 h m)
      exact ⟨q, h1, h2, h3⟩
  rw [heq]
  exact MeasurableSet.iInter fun m => MeasurableSet.iUnion fun q =>
    measurableSet_lt measurable_const (hm _)

/-- A set `S` with `f ∈ S` almost surely has `P (f⁻¹' S) = 1`. -/
lemma prob_preimage_eq_one_of_ae {P : Measure Ω} [IsProbabilityMeasure P] {α : Type*}
    [MeasurableSpace α] {f : Ω → α} (hf : AEMeasurable f P) {S : Set α} (hS : MeasurableSet S)
    (h : ∀ᵐ ω ∂P, f ω ∈ S) : P (f ⁻¹' S) = 1 := by
  have hnull : NullMeasurableSet (f ⁻¹' S) P := hf.nullMeasurable hS
  have h0 : P (f ⁻¹' S)ᶜ = 0 := ae_iff.1 h
  exact (prob_compl_eq_zero_iff₀ hnull).1 h0

lemma ae_mem_of_prob_preimage_eq_one {P : Measure Ω} [IsProbabilityMeasure P] {α : Type*}
    [MeasurableSpace α] {f : Ω → α} (hf : AEMeasurable f P) {S : Set α} (hS : MeasurableSet S)
    (h : P (f ⁻¹' S) = 1) : ∀ᵐ ω ∂P, f ω ∈ S := by
  have hnull : NullMeasurableSet (f ⁻¹' S) P := hf.nullMeasurable hS
  exact ae_iff.2 ((prob_compl_eq_zero_iff₀ hnull).2 h)

/-- **Positivity in a random direction.** If `N` is almost surely nonzero and independent of the
planar Brownian motion `W`, then almost surely `⟪N, W_s⟫ > 0` for arbitrarily small `s > 0`.
The germ zero-one law for `W` enters as the hypothesis `hBlum`
(Mörters–Peres, *Brownian Motion*, Theorem 2.7 with `d = 2`). -/
theorem ae_frequently_pos_of_indepFun {P : Measure Ω} [IsProbabilityMeasure P] {W : ℝ≥0 → Ω → ℂ}
    (hW : IsPlanarBrownian W P)
    (hBlum : ∀ A : Set Ω, MeasurableSet[⨅ n : ℕ, pathSigmaTo W (freqEps n)] A →
      P A = 0 ∨ P A = 1)
    {N : Ω → ℂ} (hN : AEMeasurable N P)
    (hNW : IndepFun N (fun ω (s : ℝ≥0) => W s ω) P) (hN0 : ∀ᵐ ω ∂P, N ω ≠ 0) :
    ∀ᵐ ω ∂P, ∃ᶠ s in 𝓝[>] (0 : ℝ≥0), 0 < pairing (N ω) (W s ω) := by
  have hWm : Measurable (fun ω (s : ℝ≥0) => W s ω) :=
    Measurable.of_eval fun s => hW.measurable s
  have hmap : P.map (fun ω => (N ω, fun s : ℝ≥0 => W s ω)) =
      (P.map N).prod (P.map (fun ω (s : ℝ≥0) => W s ω)) :=
    (indepFun_iff_map_prod_eq_prod_map_map hN hWm.aemeasurable).1 hNW
  have hGm := measurableSet_directionalSet
  have hpair : AEMeasurable (fun ω => (N ω, fun s : ℝ≥0 => W s ω)) P :=
    hN.prodMk hWm.aemeasurable
  -- for each nonzero direction `x`, the section of the directional set has probability one
  have hsec : ∀ x : ℂ, x ≠ 0 →
      P.map (fun ω (s : ℝ≥0) => W s ω) (Prod.mk x ⁻¹' directionalSet) = 1 := by
    intro x hx
    rw [Measure.map_apply_of_aemeasurable hWm.aemeasurable (measurable_prodMk_left hGm)]
    refine prob_preimage_eq_one_of_ae hWm.aemeasurable (measurable_prodMk_left hGm) ?_
    have hX := ae_forall_exists_rat_pos_of_marginal (P := P)
      (X := fun t ω => pairing x (W t ω))
      (fun t => (measurable_pairing_left x).comp (hW.measurable t))
      (fun q hq => measure_pairing_pos hW hx hq.ne')
      (fun A hA => hBlum A (germ_pairing_le x A hA))
    filter_upwards [hX] with ω hω
    exact hω
  have hfull : P ((fun ω => (N ω, fun s : ℝ≥0 => W s ω)) ⁻¹' directionalSet) = 1 := by
    rw [← Measure.map_apply_of_aemeasurable hpair hGm, hmap, Measure.prod_apply hGm]
    have hae : ∀ᵐ x ∂(P.map N), x ≠ 0 := (ae_map_iff hN isOpen_ne.measurableSet).2 hN0
    have hconst : (fun x => (P.map (fun ω (s : ℝ≥0) => W s ω)) (Prod.mk x ⁻¹' directionalSet))
        =ᵐ[P.map N] fun _ => (1 : ℝ≥0∞) := by
      filter_upwards [hae] with x hx
      exact hsec x hx
    rw [lintegral_congr_ae hconst, lintegral_const, measure_univ, mul_one]
  filter_upwards [ae_mem_of_prob_preimage_eq_one hpair hGm hfull] with ω hω
  exact frequently_of_forall_exists_rat (f := fun s => pairing (N ω) (W s ω)) hω

/-- **Outward excursion at a stopping time (planar form).** Let `τ` be a random time, `B` a path with
`W_s = B_{τ+s} - B_τ` a planar Brownian motion independent of `B_τ` (strong Markov restart,
Mörters–Peres, *Brownian Motion*, Theorem 2.16). If `B_τ ≠ z` almost surely, then almost surely
`⟪B_τ - z, B_t - B_τ⟫ > 0` for arbitrarily small `t - τ > 0`. -/
theorem ae_frequently_excursion {P : Measure Ω} [IsProbabilityMeasure P] {B : ℝ≥0 → Ω → ℂ}
    {τ : Ω → ℝ≥0} {z : ℂ}
    (hW : IsPlanarBrownian (fun s ω => B (τ ω + s) ω - B (τ ω) ω) P)
    (hBlum : ∀ A : Set Ω,
      MeasurableSet[⨅ n : ℕ, pathSigmaTo (fun s ω => B (τ ω + s) ω - B (τ ω) ω) (freqEps n)] A →
        P A = 0 ∨ P A = 1)
    (hBτ : AEMeasurable (fun ω => B (τ ω) ω) P)
    (hind : IndepFun (fun ω => B (τ ω) ω) (fun ω (s : ℝ≥0) => B (τ ω + s) ω - B (τ ω) ω) P)
    (hz : ∀ᵐ ω ∂P, B (τ ω) ω ≠ z) :
    ∀ᵐ ω ∂P, ∃ᶠ t in 𝓝[>] (τ ω), 0 < inner ℝ (B (τ ω) ω - z) (B t ω - B (τ ω) ω) := by
  have hN : AEMeasurable (fun ω => B (τ ω) ω - z) P := hBτ.sub_const z
  have hNW : IndepFun (fun ω => B (τ ω) ω - z)
      (fun ω (s : ℝ≥0) => B (τ ω + s) ω - B (τ ω) ω) P :=
    hind.comp (by fun_prop : Measurable fun x : ℂ => x - z) measurable_id
  have hfreq := ae_frequently_pos_of_indepFun hW hBlum hN hNW
    (hz.mono fun ω hω => sub_ne_zero.2 hω)
  filter_upwards [hfreq, hz] with ω hω _
  have hT : Tendsto (fun s : ℝ≥0 => τ ω + s) (𝓝[>] 0) (𝓝[>] (τ ω)) := by
    refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
    · have : Tendsto (fun s : ℝ≥0 => τ ω + s) (𝓝 0) (𝓝 (τ ω + 0)) :=
        tendsto_const_nhds.add tendsto_id
      simpa using this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact lt_add_of_pos_right _ (show (0 : ℝ≥0) < s from hs)
  simp only [inner_eq_pairing]
  exact hT.frequently (p := fun t => 0 < pairing (B (τ ω) ω - z) (B t ω - B (τ ω) ω)) hω

end LatticeProb.PlanarBrownian
