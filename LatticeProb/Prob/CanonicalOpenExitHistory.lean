import LatticeProb.Prob.DeterministicStoppedHistory
import LatticeProb.Prob.OpenExitStoppedPath
import LatticeProb.Prob.StoppedPathComposition

/-! # Open-exit histories on canonical continuous-path space -/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace LatticeProb

/-- On the full continuous-path space, the natural filtration stopped at an open-set exit
is generated by the path stopped at that exit, including infinite exit times. -/
theorem canonical_openExit_stopped_history {d : ℕ}
    {U : Set (EuclideanSpace ℝ (Fin d))} (hU : IsOpen U) :
    let X : ℝ≥0 → C(ℝ≥0, EuclideanSpace ℝ (Fin d)) → EuclideanSpace ℝ (Fin d) :=
      fun t w => w t
    let hm : ∀ t, StronglyMeasurable (X t) :=
      fun t => (ContinuousMapBorel.ContinuousMap.measurable_eval t).stronglyMeasurable
    let hc : ∀ w, Continuous fun t => X t w := fun w => w.continuous
    let τ := openExitTime X U
    let hτ := isStoppingTime_openExitTime hm hc hU
    hτ.measurableSpace = MeasurableSpace.comap
      (fun w => stoppedPath (τ w) w) inferInstance := by
  dsimp only
  let X : ℝ≥0 → C(ℝ≥0, EuclideanSpace ℝ (Fin d)) → EuclideanSpace ℝ (Fin d) :=
    fun t w => w t
  let hm : ∀ t, StronglyMeasurable (X t) :=
    fun t => (ContinuousMapBorel.ContinuousMap.measurable_eval t).stronglyMeasurable
  let hc : ∀ w, Continuous fun t => X t w := fun w => w.continuous
  let τ := openExitTime X U
  let hτ := isStoppingTime_openExitTime hm hc hU
  change hτ.measurableSpace = MeasurableSpace.comap (fun w => stoppedPath (τ w) w) _
  apply le_antisymm
  · intro A hA
    apply MeasurableSpace.measurableSet_comap.mpr
    refine ⟨A, hτ.measurableSpace_le A hA, ?_⟩
    ext w
    change stoppedPath (τ w) w ∈ A ↔ w ∈ A
    by_cases htop : τ w = ⊤
    · simp only [htop, stoppedPath_top]
    · let t := (τ w).toNNReal
      have ht : (t : ℝ≥0∞) = τ w := ENNReal.coe_toNNReal htop
      have hexit : τ (stoppedPath (τ w) w) = τ w := by
        exact openExitTime_stoppedPath w hU
      have heq : stoppedPath (t : ℝ≥0∞) (stoppedPath (τ w) w) =
          stoppedPath (t : ℝ≥0∞) w := by
        rw [stoppedPath_stoppedPath, ht, min_self]
      have hAt := (hτ.measurableSet A).mp hA |>.2 t
      rw [natFiltration_eq_comap_stoppedPath hm hc] at hAt
      obtain ⟨B, hB, hpre⟩ := MeasurableSpace.measurableSet_comap.mp hAt
      have hpath (z : C(ℝ≥0, EuclideanSpace ℝ (Fin d))) : pathMap X hc z = z := by
        ext s
        rfl
      simp_rw [hpath] at hpre
      change (fun z => stoppedPath (t : ℝ≥0∞) z) ⁻¹' B =
        A ∩ {z | τ z ≤ (t : ℝ≥0∞)} at hpre
      have hmem : stoppedPath (τ w) w ∈ A ∩ {z | τ z ≤ (t : ℝ≥0∞)} ↔
          w ∈ A ∩ {z | τ z ≤ (t : ℝ≥0∞)} := by
        rw [← hpre]
        change stoppedPath (t : ℝ≥0∞) (stoppedPath (τ w) w) ∈ B ↔
          stoppedPath (t : ℝ≥0∞) w ∈ B
        rw [heq]
      simpa only [Set.mem_inter_iff, Set.mem_ofPred_eq, hexit, ht, le_refl, and_true] using hmem
  · have h := measurable_stoppedPath_natFiltration hm hc hτ
    have h' : Measurable[hτ.measurableSpace] (fun w => stoppedPath (τ w) w) := by
      convert h using 1
      funext w
      congr 1
    exact h'.comap_le

end LatticeProb
