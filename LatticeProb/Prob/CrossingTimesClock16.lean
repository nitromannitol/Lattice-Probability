import Mathlib
import LatticeProb.Prob.CrossingTimesClock12
import LatticeProb.Prob.AdaptedOfCondIndep

/-!
# The inverse crossing clock at a rational time is adapted to the clock-read past

Let `K` be a continuous family of path laws with the Markov property at deterministic times, and
suppose that under `K z` the shift identity holds at every `t, s`, the infimum defining `A_t` is
attained, and `u ↦ A_u` is continuous.

* `exists_measurable_pastSigma_pathClockInv_ratTime`: for every rational `q` the variable `A_q` is
  almost surely a function, measurable for the σ-algebra generated by the path read in its crossing
  clock at the rational times `≤ q`, of the path.  The inverse clock `A_q` is a function of the whole
  clock-read path (`exists_measurable_pathClockInv_ratTime`), and it is determined by the path
  stopped at `A_q`; the clock-read path after `q` is conditionally independent of the stopped path
  given the position at `A_q` (`condIndepEv_past_future`), so the clock-read future carries no
  information about `A_q` beyond the clock-read past
  (`exists_measurable_ae_eq_of_condIndepEv_past`).
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace LatticeProb

attribute [local instance] dUnifMetricSpace

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]

set_option linter.overlappingInstances false in
/-- **The inverse crossing clock at a rational time is adapted to the clock-read past.**  Under `K z`,
for every rational `q` the nonnegative variable `A_q` agrees almost surely with a function of the
path that is measurable for the σ-algebra generated by the path read in its crossing clock at the
rational times `≤ q`. -/
theorem exists_measurable_pastSigma_pathClockInv_ratTime [PolishSpace E]
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) {z : E}
    (hM : ∀ t, MarkovAt K z t) (m : ℝ≥0∞)
    (hshift : ∀ t s : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ShiftIdentity m t s x)
    (hatt : ∀ t : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    (hcont : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      Continuous fun u : ℝ≥0 => (pathClockInv m x u).toReal) (q : ℚ) :
    ∃ g : C(ℝ≥0, E) → ℝ≥0, Measurable[pastSigma m (ratTime q)] g ∧
      ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
        Real.toNNReal (pathClockInv m x (ratTime q)).toReal = g x := by
  classical
  have hfin : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), pathClockInv m x (ratTime q) < ⊤ :=
    (hshift (ratTime q) 0).mono fun x hx => hx.1
  have hrat : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      ∀ r : ℚ, ShiftIdentity m (ratTime q) (ratTime r - ratTime q) x :=
    ae_all_iff.2 fun r => hshift _ _
  have hDm : ∀ _ : Unit, Measurable fun x : C(ℝ≥0, E) => (pathClockInv m x (ratTime q)).toReal :=
    fun _ => (measurable_pathClockInv m _).ennreal_toReal
  have hDs : ∀ _ : Unit, True → ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (pathClockInv m x (ratTime q)).toReal =
        (pathClockInv m (stopPath x (pathClockInv m x (ratTime q)).toNNReal)
          (ratTime q)).toReal := by
    intro _ _
    filter_upwards [hatt (ratTime q)] with x hx
    rw [pathClockInv_stopPath_eq m x _ hx]
  have hci := condIndepEv_past_future hK hM m (ratTime q) hfin (hatt _) hrat (ι := Unit)
    (p := fun _ => True) (D := fun _ x => (pathClockInv m x (ratTime q)).toReal) hDm hDs
    (Df := fun _ => (0 : ℝ)) (g := fun _ => (0 : ℝ)) measurable_const
    (Filter.Eventually.of_forall fun _ => rfl)
  have hpast : pastSigma (E := E) m (ratTime q) ≤ ratClockSigma m :=
    pastSigma_le_ratClockSigma m _
  have hfut : futureSigma (E := E) m (ratTime q) ≤ ratClockSigma m :=
    futureSigma_le_ratClockSigma m _
  have hrc : ratClockSigma (E := E) m ≤ (inferInstance : MeasurableSpace C(ℝ≥0, E)) :=
    (measurable_ratClockPath (E := E) m).comap_le
  have hYD : MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => Real.toNNReal (pathClockInv m x (ratTime q)).toReal) inferInstance ≤
      MeasurableSpace.comap (fun x : C(ℝ≥0, E) => (pathClockInv m x (ratTime q)).toReal)
        inferInstance := by
    rintro _ ⟨s, hs, rfl⟩
    exact ⟨Real.toNNReal ⁻¹' s, measurable_real_toNNReal hs, rfl⟩
  have hYP : AELeSigma (MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => Real.toNNReal (pathClockInv m x (ratTime q)).toReal) inferInstance)
      (pastSigma m (ratTime q) ⊔ ⨆ (i : Unit), ⨆ (_ : True),
        MeasurableSpace.comap (fun x : C(ℝ≥0, E) => (pathClockInv m x (ratTime q)).toReal)
          inferInstance) (K z : Measure C(ℝ≥0, E)) :=
    AELeSigma.of_le (hYD.trans (le_sup_of_le_right (le_iSup₂_of_le () trivial le_rfl)))
  obtain ⟨G', hG', hGae⟩ := exists_measurable_pathClockInv_ratTime hK hM m hshift hatt hcont q
  have hY1 : AELeSigma (MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => Real.toNNReal (pathClockInv m x (ratTime q)).toReal) inferInstance)
      (ratClockSigma m) (K z : Measure C(ℝ≥0, E)) :=
    AELeSigma.comap_of_ae_eq
      (g := fun x : C(ℝ≥0, E) =>
        Real.toNNReal (G' (ratPath fun t => clockPath m (fun u => x u) t)))
      (measurable_real_toNNReal.comp (hG'.comp (comap_measurable _)))
      (hGae.mono fun x hx => by simp only [hx])
  have hYUV : AELeSigma (MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => Real.toNNReal (pathClockInv m x (ratTime q)).toReal) inferInstance)
      (pastSigma m (ratTime q) ⊔ (futureSigma m (ratTime q) ⊔
        MeasurableSpace.comap (fun _ : C(ℝ≥0, E) => (0 : ℝ)) inferInstance))
      (K z : Measure C(ℝ≥0, E)) := by
    intro a ha
    obtain ⟨a', ha', e⟩ := hY1 a ha
    exact ⟨a', (ratClockSigma_le_past_sup_future m (ratTime q)).trans
      (sup_le_sup_left le_sup_left _) a' ha', e⟩
  exact exists_measurable_ae_eq_of_condIndepEv_past
    (G := MeasurableSpace.comap (fun x : C(ℝ≥0, E) => x (pathClockInv m x (ratTime q)).toNNReal)
      inferInstance)
    (U := pastSigma m (ratTime q))
    (V := futureSigma m (ratTime q) ⊔
      MeasurableSpace.comap (fun _ : C(ℝ≥0, E) => (0 : ℝ)) inferInstance)
    (P := pastSigma m (ratTime q) ⊔ ⨆ (i : Unit), ⨆ (_ : True),
      MeasurableSpace.comap (fun x : C(ℝ≥0, E) => (pathClockInv m x (ratTime q)).toReal)
        inferInstance)
    (le_iSup₂_of_le q le_rfl le_rfl) le_sup_left
    (sup_le (hpast.trans hrc) (iSup_le fun i => iSup_le fun _ => (hDm i).comap_le))
    (sup_le (hfut.trans hrc) measurable_const.comap_le) hci.symm hYP hYUV

end LatticeProb

end
