import LatticeProb.Prob.McLeish.MartingaleCLT
import Mathlib.Analysis.Real.Sqrt
import Mathlib.Probability.ConditionalExpectation
import Mathlib.Probability.Distributions.Gaussian.Real
import Mathlib.Probability.Independence.InfinitePi
import Mathlib.Probability.Martingale.Basic
import Mathlib.Probability.ProductMeasure
import Mathlib.Probability.Process.Filtration

/-!
# A nonvacuous example for the martingale central limit theorem

Each coordinate of `ℕ → ℝ` is a fair sign under the infinite product measure `P`. Row `n` of the
array has the increments `sgn (ω (k + 1)) / √(n + 1)` for `k ≤ n`, and the increment at `k` depends
only on coordinate `k + 1`. The row partial sums are martingales for the filtration of initial
coordinates, the largest absolute increment of row `n` is `1 / √(n + 1)`, and the sum of squared
increments of every row is `1`. So the hypotheses of
`LatticeProb.McLeish.tendstoInDistribution_martingale_clt` hold with limit variance `1`, and the row
sums converge in distribution to the standard Gaussian law.
-/

namespace LatticeProb.McLeish.Example

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

/-- The sign function: `sgn x = -1` for `x ≤ 0` and `sgn x = 1` otherwise. -/
noncomputable def sgn (x : ℝ) : ℝ := if x ≤ 0 then -1 else 1

/-- The sign function has absolute value one. -/
lemma abs_sgn (x : ℝ) : |sgn x| = 1 := by
  unfold sgn
  split_ifs <;> norm_num

/-- The square of the sign function is one. -/
lemma sgn_sq (x : ℝ) : sgn x ^ 2 = 1 := by
  unfold sgn
  split_ifs <;> norm_num

/-- The sign function is measurable. -/
lemma measurable_sgn : Measurable sgn := by
  unfold sgn
  exact Measurable.ite (measurableSet_le measurable_id measurable_const) measurable_const
    measurable_const

/-- The fair coin on `{-1, 1}`. -/
noncomputable def coin : Measure ℝ :=
  (1 / 2 : ℝ≥0∞) • Measure.dirac (-1) + (1 / 2 : ℝ≥0∞) • Measure.dirac 1

/-- The fair coin is a probability measure. -/
instance isProbabilityMeasure_coin : IsProbabilityMeasure coin := by
  constructor
  simp [coin, one_div, ENNReal.inv_two_add_inv_two]

/-- The infinite product of fair coins on `ℕ → ℝ`. -/
noncomputable def P : Measure (ℕ → ℝ) := Measure.infinitePi fun _ : ℕ => coin

/-- The infinite product of fair coins is a probability measure. -/
instance isProbabilityMeasure_P : IsProbabilityMeasure P := by
  unfold P
  infer_instance

/-- The sign function integrates to zero against the fair coin. -/
lemma integral_sgn_coin : ∫ x, sgn x ∂coin = 0 := by
  have h1 : sgn (-1) = -1 := by simp [sgn]
  have h2 : sgn 1 = 1 := by norm_num [sgn]
  have hint : ∀ a : ℝ, ∀ c : ℝ≥0∞, c ≠ ⊤ → Integrable sgn (c • Measure.dirac a) := by
    intro a c hc
    refine Integrable.smul_measure ?_ hc
    exact (integrable_const (1 : ℝ)).mono' measurable_sgn.aestronglyMeasurable
      (ae_of_all _ fun x => by simp [abs_sgn])
  have hc : (1 / 2 : ℝ≥0∞) ≠ ⊤ := by simp
  rw [coin, integral_add_measure (hint _ _ hc) (hint _ _ hc), integral_smul_measure,
    integral_smul_measure, integral_dirac, integral_dirac, h1, h2]
  norm_num [ENNReal.toReal_div]

/-- The row profile: the scaled sign for indices `k < n + 1`, and zero beyond. -/
noncomputable def rowValue (n k : ℕ) (x : ℝ) : ℝ :=
  if k < n + 1 then sgn x / Real.sqrt ((n : ℝ) + 1) else 0

/-- The increment of row `n` at index `k`, which reads coordinate `k + 1`. -/
noncomputable def rademacherRow (n k : ℕ) (ω : ℕ → ℝ) : ℝ := rowValue n k (ω (k + 1))

/-- The filtration of initial coordinates: `coordFiltration k` is generated by the coordinates
`ω j` with `j ≤ k`. -/
def coordFiltration : Filtration ℕ (inferInstance : MeasurableSpace (ℕ → ℝ)) :=
  Filtration.piLE

/-- The row profile at an index `k < n + 1` is the scaled sign. -/
lemma rowValue_of_lt (x : ℝ) {n k : ℕ} (h : k < n + 1) :
    rowValue n k x = sgn x / Real.sqrt ((n : ℝ) + 1) := by
  unfold rowValue
  rw [if_pos h]

/-- The row profile vanishes at an index `k ≥ n + 1`. -/
lemma rowValue_of_not_lt (x : ℝ) {n k : ℕ} (h : ¬k < n + 1) : rowValue n k x = 0 := by
  unfold rowValue
  rw [if_neg h]

/-- The row profile is measurable. -/
lemma measurable_rowValue (n k : ℕ) : Measurable (rowValue n k) := by
  by_cases h : k < n + 1
  · rw [show rowValue n k = fun x => sgn x / Real.sqrt ((n : ℝ) + 1) from
      funext fun x => rowValue_of_lt x h]
    exact measurable_sgn.div_const _
  · rw [show rowValue n k = fun _ => 0 from funext fun x => rowValue_of_not_lt x h]
    exact measurable_const

/-- The absolute increment at an index `k < n + 1` equals `1 / √(n + 1)`. -/
lemma abs_rademacherRow_eq {n k : ℕ} (ω : ℕ → ℝ) (h : k < n + 1) :
    |rademacherRow n k ω| = 1 / Real.sqrt ((n : ℝ) + 1) := by
  unfold rademacherRow
  rw [rowValue_of_lt _ h, abs_div, abs_sgn, abs_of_pos (Real.sqrt_pos.2 (by positivity))]

/-- Every absolute increment of row `n` is at most `1 / √(n + 1)`. -/
lemma abs_rademacherRow_le (n k : ℕ) (ω : ℕ → ℝ) :
    |rademacherRow n k ω| ≤ 1 / Real.sqrt ((n : ℝ) + 1) := by
  by_cases h : k < n + 1
  · exact (abs_rademacherRow_eq ω h).le
  · unfold rademacherRow
    rw [rowValue_of_not_lt _ h, abs_zero]
    positivity

/-- The squared increment at an index `k < n + 1` equals `1 / (n + 1)`. -/
lemma sq_rademacherRow_of_lt (n k : ℕ) (ω : ℕ → ℝ) (h : k < n + 1) :
    rademacherRow n k ω ^ 2 = 1 / ((n : ℝ) + 1) := by
  unfold rademacherRow
  rw [rowValue_of_lt _ h, div_pow, sgn_sq, Real.sq_sqrt (by positivity)]

/-- Every squared increment of row `n` is at most `1 / (n + 1)`. -/
lemma sq_rademacherRow_le (n k : ℕ) (ω : ℕ → ℝ) :
    rademacherRow n k ω ^ 2 ≤ 1 / ((n : ℝ) + 1) := by
  by_cases h : k < n + 1
  · exact (sq_rademacherRow_of_lt n k ω h).le
  · unfold rademacherRow
    rw [rowValue_of_not_lt _ h, zero_pow two_ne_zero]
    positivity

/-- The maximal squared increment of row `n` is the constant `1 / (n + 1)`. -/
lemma sup'_sq_rademacherRow (n : ℕ) (ω : ℕ → ℝ) :
    (Finset.range (n + 1)).sup' (Finset.nonempty_range_iff.mpr (Nat.succ_ne_zero n))
      (fun k => rademacherRow n k ω ^ 2) = 1 / ((n : ℝ) + 1) := by
  refine le_antisymm (Finset.sup'_le _ _ fun k _ => sq_rademacherRow_le n k ω) ?_
  calc 1 / ((n : ℝ) + 1) = rademacherRow n 0 ω ^ 2 :=
        (sq_rademacherRow_of_lt n 0 ω (Nat.succ_pos n)).symm
    _ ≤ _ := Finset.le_sup' (fun k => rademacherRow n k ω ^ 2)
        (Finset.mem_range.2 (Nat.succ_pos n))

/-- The maximal absolute increment of row `n` is the constant `1 / √(n + 1)`. -/
lemma sup'_abs_rademacherRow (n : ℕ) (ω : ℕ → ℝ) :
    (Finset.range (n + 1)).sup' (Finset.nonempty_range_iff.mpr (Nat.succ_ne_zero n))
      (fun k => |rademacherRow n k ω|) = 1 / Real.sqrt ((n : ℝ) + 1) := by
  refine le_antisymm (Finset.sup'_le _ _ fun k _ => abs_rademacherRow_le n k ω) ?_
  calc 1 / Real.sqrt ((n : ℝ) + 1) = |rademacherRow n 0 ω| :=
        (abs_rademacherRow_eq ω (Nat.succ_pos n)).symm
    _ ≤ _ := Finset.le_sup' (fun k => |rademacherRow n k ω|) (Finset.mem_range.2 (Nat.succ_pos n))

/-- The squared increments of row `n` sum to one. -/
lemma sum_sq_rademacherRow (n : ℕ) (ω : ℕ → ℝ) :
    ∑ k ∈ Finset.range (n + 1), rademacherRow n k ω ^ 2 = 1 := by
  rw [Finset.sum_congr rfl fun k hk => sq_rademacherRow_of_lt n k ω (Finset.mem_range.1 hk),
    Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  push_cast
  exact mul_one_div_cancel (Nat.cast_add_one_ne_zero n)

/-- The integral of the row profile against the fair coin vanishes. -/
lemma integral_rowValue_coin (n k : ℕ) : ∫ x, rowValue n k x ∂coin = 0 := by
  by_cases h : k < n + 1
  · rw [show rowValue n k = fun x => sgn x / Real.sqrt ((n : ℝ) + 1) from
      funext fun x => rowValue_of_lt x h, integral_div, integral_sgn_coin, zero_div]
  · rw [show rowValue n k = fun _ => 0 from funext fun x => rowValue_of_not_lt x h, integral_zero]

/-- Each increment is integrable, being bounded by a constant on a probability space. -/
lemma integrable_rademacherRow (n k : ℕ) : Integrable (rademacherRow n k) P :=
  (integrable_const (1 / Real.sqrt ((n : ℝ) + 1))).mono'
    ((measurable_rowValue n k).comp (measurable_pi_apply (k + 1))).aestronglyMeasurable
    (ae_of_all _ fun ω => by simpa [Real.norm_eq_abs] using abs_rademacherRow_le n k ω)

/-- Each increment has mean zero under `P`. -/
lemma integral_rademacherRow (n k : ℕ) : ∫ ω, rademacherRow n k ω ∂P = 0 := by
  have hmeas : Measurable (fun ω : ℕ → ℝ => ω (k + 1)) := measurable_pi_apply _
  have hmap : P.map (fun ω : ℕ → ℝ => ω (k + 1)) = coin := by
    unfold P
    exact Measure.infinitePi_map_eval (fun _ : ℕ => coin) (k + 1)
  calc ∫ ω, rademacherRow n k ω ∂P
      = ∫ x, rowValue n k x ∂(P.map (fun ω : ℕ → ℝ => ω (k + 1))) :=
        (integral_map hmeas.aemeasurable (measurable_rowValue n k).aestronglyMeasurable).symm
    _ = ∫ x, rowValue n k x ∂coin := by rw [hmap]
    _ = 0 := integral_rowValue_coin n k

/-- The coordinate `j ≤ k` is measurable for the filtration at `k`. -/
lemma measurable_coord_le {j k : ℕ} (hj : j ≤ k) :
    Measurable[coordFiltration k] (fun ω : ℕ → ℝ => ω j) :=
  (measurable_pi_apply (⟨j, Set.mem_Iic.2 hj⟩ : Set.Iic k)).comp
    (comap_measurable fun ω : ℕ → ℝ => fun i : Set.Iic k => ω i)

/-- The partial sums of row `n` are adapted to the filtration of initial coordinates. -/
lemma measurable_partialSum (n k : ℕ) :
    Measurable[coordFiltration k] (fun ω => ∑ j ∈ Finset.range k, rademacherRow n j ω) := by
  refine Finset.measurable_sum _ fun j hj => ?_
  have hjk : j + 1 ≤ k := Finset.mem_range.1 hj
  exact (measurable_rowValue n j).comp (measurable_coord_le hjk)

/-- The partial sums of row `n` are integrable. -/
lemma integrable_partialSum (n k : ℕ) :
    Integrable (fun ω => ∑ j ∈ Finset.range k, rademacherRow n j ω) P :=
  integrable_finsetSum _ fun j _ => integrable_rademacherRow n j

/-- The increment at `i` is independent of the coordinates up to `i`. -/
lemma indep_coord_succ (i : ℕ) :
    Indep (MeasurableSpace.comap (fun ω : ℕ → ℝ => ω (i + 1)) inferInstance) (coordFiltration i) P := by
  have hiid : iIndep (fun j : ℕ => MeasurableSpace.comap (fun ω : ℕ → ℝ => ω j) inferInstance) P := by
    have h := iIndepFun_infinitePi (P := fun _ : ℕ => coin) (X := fun _ : ℕ => (id : ℝ → ℝ))
      (fun _ => measurable_id)
    rw [iIndepFun_iff_iIndep (fun _ : ℕ => (inferInstance : MeasurableSpace ℝ))] at h
    exact h
  have hdisj : Disjoint ({i + 1} : Set ℕ) (Set.Iic i) := by
    refine Set.disjoint_left.2 fun j hj hj' => ?_
    simp only [Set.mem_singleton_iff, Set.mem_Iic] at hj hj'
    omega
  have hind := indep_iSup_of_disjoint (fun j => (measurable_pi_apply j).comap_le) hiid hdisj
  have hleft : MeasurableSpace.comap (fun ω : ℕ → ℝ => ω (i + 1)) inferInstance ≤
      ⨆ j ∈ ({i + 1} : Set ℕ), MeasurableSpace.comap (fun ω : ℕ → ℝ => ω j) inferInstance :=
    le_iSup₂ (f := fun (j : ℕ) (_ : j ∈ ({i + 1} : Set ℕ)) =>
      MeasurableSpace.comap (fun ω : ℕ → ℝ => ω j) inferInstance) (i + 1) (Set.mem_singleton _)
  have hright : coordFiltration i ≤
      ⨆ j ∈ Set.Iic i, MeasurableSpace.comap (fun ω : ℕ → ℝ => ω j) inferInstance := by
    show MeasurableSpace.comap (fun ω : ℕ → ℝ => fun j : Set.Iic i => ω j) MeasurableSpace.pi ≤ _
    rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
    refine iSup_le fun j => ?_
    rw [MeasurableSpace.comap_comp]
    exact le_iSup₂ (f := fun (j' : ℕ) (_ : j' ∈ Set.Iic i) =>
      MeasurableSpace.comap (fun ω : ℕ → ℝ => ω j') inferInstance) (j : ℕ) j.2
  exact indep_of_indep_of_le_right (indep_of_indep_of_le_left hind hleft) hright

/-- The row partial sums are martingales for the filtration of initial coordinates. -/
theorem rademacherRow_martingale (n : ℕ) :
    Martingale (fun k ω => ∑ j ∈ Finset.range k, rademacherRow n j ω) coordFiltration P := by
  refine martingale_nat (fun k => (measurable_partialSum n k).stronglyMeasurable)
    (fun k => integrable_partialSum n k) ?_
  intro i
  show (fun ω => ∑ j ∈ Finset.range i, rademacherRow n j ω) =ᵐ[P]
    P[(fun ω => ∑ j ∈ Finset.range (i + 1), rademacherRow n j ω) | coordFiltration i]
  have hS : (fun ω => ∑ j ∈ Finset.range (i + 1), rademacherRow n j ω) =
      (fun ω => ∑ j ∈ Finset.range i, rademacherRow n j ω) + rademacherRow n i := by
    funext ω
    simp [Finset.sum_range_succ]
  rw [hS]
  have hJm : StronglyMeasurable[MeasurableSpace.comap (fun ω : ℕ → ℝ => ω (i + 1)) inferInstance]
      (rademacherRow n i) :=
    ((measurable_rowValue n i).comp (comap_measurable fun ω : ℕ → ℝ => ω (i + 1))).stronglyMeasurable
  have hJ0 : P[rademacherRow n i | coordFiltration i] =ᵐ[P] fun _ => (0 : ℝ) := by
    filter_upwards [condExp_indep_eq (measurable_pi_apply (i + 1)).comap_le
      (coordFiltration.le i) hJm (indep_coord_succ i)] with ω hω
    rw [hω]
    exact integral_rademacherRow n i
  have hI := integrable_partialSum n i
  have hJ := integrable_rademacherRow n i
  have hSm : StronglyMeasurable[coordFiltration i]
      (fun ω => ∑ j ∈ Finset.range i, rademacherRow n j ω) :=
    (measurable_partialSum n i).stronglyMeasurable
  filter_upwards [condExp_add hI hJ (coordFiltration i), hJ0] with ω h1 h3
  rw [h1, Pi.add_apply, h3, condExp_of_stronglyMeasurable (coordFiltration.le i) hSm hI, add_zero]

/-- A sequence of constant functions converging to `a` converges in measure to the constant `a`. -/
lemma tendstoInMeasure_const_of_tendsto (c : ℕ → ℝ) (a : ℝ) (hc : Tendsto c atTop (𝓝 a)) :
    TendstoInMeasure P (fun n _ => c n) atTop (fun _ => a) := by
  intro ε hε
  have hev := EMetric.tendsto_nhds.1 hc ε hε
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [hev] with n hn
  have hset : {ω : ℕ → ℝ | ε ≤ edist (c n) a} = ∅ := by
    ext ω
    simp [not_le.2 hn]
  show (0 : ℝ≥0∞) = P {ω : ℕ → ℝ | ε ≤ edist (c n) a}
  rw [hset, measure_empty]

/-- The reciprocal square root of `n + 1` tends to zero. -/
lemma tendsto_one_div_sqrt :
    Tendsto (fun n : ℕ => 1 / Real.sqrt ((n : ℝ) + 1)) atTop (𝓝 0) := by
  have h1 : Tendsto (fun n : ℕ => (n : ℝ) + 1) atTop atTop :=
    tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop
  have h2 := tendsto_inv_atTop_zero.comp (Real.tendsto_sqrt_atTop.comp h1)
  simpa only [one_div, Function.comp_def] using h2

/-- The row sums of the fair-sign array converge in distribution to the standard Gaussian law. -/
theorem rademacherRows_clt :
    TendstoInDistribution (fun n ω => ∑ k ∈ Finset.range (n + 1), rademacherRow n k ω) atTop
      (id : ℝ → ℝ) (fun _ => P) (gaussianReal 0 1) :=
  tendstoInDistribution_martingale_clt P (fun _ => coordFiltration) rademacherRow
    (fun n => n + 1) (fun n => Nat.succ_pos n) 1 rademacherRow_martingale
    (fun n => by simpa only [sup'_sq_rademacherRow] using integrable_const (1 / ((n : ℝ) + 1)))
    ⟨1, fun n => by
      simp only [sup'_sq_rademacherRow, integral_const, probReal_univ, one_smul]
      rw [div_le_one (by positivity)]
      linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]⟩
    (by simp only [sup'_abs_rademacherRow]
        exact tendstoInMeasure_const_of_tendsto (fun n : ℕ => 1 / Real.sqrt ((n : ℝ) + 1)) 0
          tendsto_one_div_sqrt)
    (by simp only [sum_sq_rademacherRow, NNReal.coe_one]
        exact tendstoInMeasure_const_of_tendsto (fun _ : ℕ => (1 : ℝ)) 1 tendsto_const_nhds)

end LatticeProb.McLeish.Example
