import Mathlib
import LatticeProb.Prob.CrossingTimesClock9
import LatticeProb.Prob.CrossingTimesClock11
import LatticeProb.Prob.CondIndepEvChain
import LatticeProb.Prob.ConditionalConstIncrement
import LatticeProb.Prob.ICondIndepFunCongr
import LatticeProb.Bonanno.LQGMetric.Prob.PolishContinuousMap

/-!
# The inverse crossing clock at a rational time is determined by the path read in its clock

Let `K` be a continuous family of path laws with the Markov property at deterministic times, and
suppose that under `K z` the shift identity holds at every `t, s`, the infimum defining `A_t` is
attained, and `u ↦ A_u` is continuous.  Write `B(x)` for the rational-time restriction of the path
read in its crossing clock.

* `iCondIndepFun_clockIncrements`: for rational times `a 0 ≤ a 1 ≤ ⋯`, the increments
  `A_{a (k+1)} - A_{a k}` are conditionally independent given `σ(B)`.  The proof is the chain
  criterion `iCondIndepFun_of_markov_chain` with the past–future independence at `A_t`
  (`condIndepEv_past_future`).
* `exists_measurable_pathClockInv_ratTime`: `A_q` is almost surely a measurable function of `B(x)`
  for every rational `q`.  The proof applies the determination of conditionally independent
  increments of a continuous nondecreasing process on a suitable measurable full-measure set.
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace LatticeProb

theorem ratTime_mono {r r' : ℚ} (h : r ≤ r') : ratTime r ≤ ratTime r' :=
  Real.toNNReal_mono (Rat.cast_le.2 h)

/-- The space of continuous paths `C(ℝ≥0, E)` in a Polish space is a standard Borel space. -/
instance instStandardBorelSpacePath {E : Type*} [MetricSpace E] [PolishSpace E] :
    StandardBorelSpace C(ℝ≥0, E) :=
  haveI : PolishSpace C(ℝ≥0, E) := LQGMetric.polishSpace_continuousMap ℝ≥0 E
  inferInstance

section

variable {E : Type*} [MetricSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]

/-- The σ-algebra generated by the rational-time restriction of the path read in its clock. -/
@[instance_reducible]
def ratClockSigma (m : ℝ≥0∞) : MeasurableSpace C(ℝ≥0, E) :=
  MeasurableSpace.comap (fun x : C(ℝ≥0, E) => ratPath fun t => clockPath m (fun u => x u) t)
    inferInstance

theorem measurable_ratClockPath (m : ℝ≥0∞) :
    Measurable fun x : C(ℝ≥0, E) => ratPath fun t => clockPath m (fun u => x u) t :=
  measurable_pi_iff.2 fun r => measurable_clockPath m (ratTime r)

omit [SecondCountableTopology E] [BorelSpace E] in
theorem pastSigma_le_ratClockSigma (m : ℝ≥0∞) (t : ℝ≥0) :
    pastSigma (E := E) m t ≤ ratClockSigma m :=
  iSup₂_le fun r _ => by
    have h : (fun x : C(ℝ≥0, E) => clockPath m (fun u => x u) (ratTime r)) =
        (fun b : ℚ → E => b r) ∘ fun x : C(ℝ≥0, E) => ratPath fun t => clockPath m (fun u => x u) t :=
      rfl
    rw [h, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_pi_apply r).comap_le

omit [SecondCountableTopology E] [BorelSpace E] in
theorem futureSigma_le_ratClockSigma (m : ℝ≥0∞) (t : ℝ≥0) :
    futureSigma (E := E) m t ≤ ratClockSigma m :=
  iSup₂_le fun r _ => by
    have h : (fun x : C(ℝ≥0, E) => clockPath m (fun u => x u) (ratTime r)) =
        (fun b : ℚ → E => b r) ∘ fun x : C(ℝ≥0, E) => ratPath fun t => clockPath m (fun u => x u) t :=
      rfl
    rw [h, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_pi_apply r).comap_le

omit [SecondCountableTopology E] [BorelSpace E] in
theorem ratClockSigma_le_past_sup_future (m : ℝ≥0∞) (t : ℝ≥0) :
    ratClockSigma (E := E) m ≤ pastSigma m t ⊔ futureSigma m t := by
  have h : ratClockSigma (E := E) m = ⨆ r : ℚ, MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => clockPath m (fun u => x u) (ratTime r)) inferInstance := by
    unfold ratClockSigma
    show MeasurableSpace.comap _ (⨆ a : ℚ, MeasurableSpace.comap (fun b : ℚ → E => b a)
      inferInstance) = _
    rw [MeasurableSpace.comap_iSup]
    simp only [MeasurableSpace.comap_comp]
    rfl
  rw [h]
  refine iSup_le fun r => ?_
  rcases le_total (ratTime r) t with h | h
  · exact le_sup_of_le_left (le_iSup₂_of_le r h le_rfl)
  · exact le_sup_of_le_right (le_iSup₂_of_le r h le_rfl)

omit [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E] in
theorem pathClockInv_zero (m : ℝ≥0∞) (x : C(ℝ≥0, E)) : pathClockInv m x 0 = 0 :=
  clockInv_zero _

set_option linter.overlappingInstances false in
/-- **Conditional independence of the increments of the inverse crossing clock.**  For rational
times `a 0 ≤ a 1 ≤ ⋯`, the increments `A_{a (k+1)} - A_{a k}` are conditionally independent given
the path read in its clock at the rational times. -/
theorem iCondIndepFun_clockIncrements [PolishSpace E]
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) {z : E}
    (hM : ∀ t, MarkovAt K z t) (m : ℝ≥0∞)
    (hshift : ∀ t s : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ShiftIdentity m t s x)
    (hatt : ∀ t : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    (a : ℕ → ℚ) (ha : Monotone a) (N : ℕ) :
    iCondIndepFun (ratClockSigma m) (measurable_ratClockPath (E := E) m).comap_le
      (fun (k : Fin N) (x : C(ℝ≥0, E)) =>
        (pathClockInv m x (ratTime (a (k + 1)))).toReal -
          (pathClockInv m x (ratTime (a k))).toReal)
      (K z : Measure C(ℝ≥0, E)) := by
  have hDm : ∀ k : Fin N, Measurable fun x : C(ℝ≥0, E) =>
      (pathClockInv m x (ratTime (a (k + 1)))).toReal -
        (pathClockInv m x (ratTime (a k))).toReal := fun k =>
    ((measurable_pathClockInv m _).ennreal_toReal).sub (measurable_pathClockInv m _).ennreal_toReal
  refine iCondIndepFun_of_markov_chain (measurable_ratClockPath (E := E) m).comap_le hDm
    (fun k => MeasurableSpace.comap
      (fun x : C(ℝ≥0, E) => x (pathClockInv m x (ratTime (a k))).toNNReal) inferInstance)
    (fun k => pastSigma m (ratTime (a k))) (fun k => futureSigma m (ratTime (a k)))
    (fun k => le_iSup₂_of_le (a k) le_rfl le_rfl) (fun k => pastSigma_le_ratClockSigma m _)
    (fun k => futureSigma_le_ratClockSigma m _) (fun k => ratClockSigma_le_past_sup_future m _)
    fun k => ?_
  have hfin : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), pathClockInv m x (ratTime (a k)) < ⊤ :=
    (hshift (ratTime (a k)) 0).mono fun x hx => hx.1
  have hrat : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      ∀ r : ℚ, ShiftIdentity m (ratTime (a k)) (ratTime r - ratTime (a k)) x :=
    ae_all_iff.2 fun r => hshift _ _
  have hle : ratTime (a k) ≤ ratTime (a (k + 1)) := ratTime_mono (ha (Nat.le_succ _))
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ≥0, ratTime (a k) + δ = ratTime (a (k + 1)) :=
    ⟨_, add_tsub_cancel_of_le hle⟩
  refine condIndepEv_past_future hK hM m (ratTime (a k)) hfin (hatt _) hrat
    (ι := Fin N) (p := fun i => i < k)
    (D := fun (i : Fin N) (x : C(ℝ≥0, E)) =>
      (pathClockInv m x (ratTime (a (i + 1)))).toReal - (pathClockInv m x (ratTime (a i))).toReal)
    hDm ?_ (Df := fun x : C(ℝ≥0, E) =>
      (pathClockInv m x (ratTime (a (k + 1)))).toReal - (pathClockInv m x (ratTime (a k))).toReal)
    (g := fun y : C(ℝ≥0, E) => (pathClockInv m y δ).toReal)
    (measurable_pathClockInv m δ).ennreal_toReal ?_
  · intro i hik
    filter_upwards [hatt (ratTime (a k))] with x hx
    have hi : (i : ℕ) + 1 ≤ k := hik
    have h1 := pathClockInv_stopPath_eq m x (pathClockInv m x (ratTime (a k))).toNNReal
      ((ENNReal.coe_le_coe.2 (ratTime_mono (ha hi))).trans hx)
    have hi0 : (i : ℕ) ≤ k := (Nat.le_succ _).trans hi
    have h0 := pathClockInv_stopPath_eq m x (pathClockInv m x (ratTime (a k))).toNNReal
      ((ENNReal.coe_le_coe.2 (ratTime_mono (ha hi0))).trans hx)
    simp only [h1, h0]
  · filter_upwards [hshift (ratTime (a k)) δ, hshift (ratTime (a (k + 1))) 0] with x hx hx'
    obtain ⟨-, hadd, -⟩ := hx
    rw [hδ] at hadd
    have hne := ENNReal.add_ne_top.1 (hadd ▸ hx'.1.ne)
    rw [hadd, ENNReal.toReal_add hne.1 hne.2]
    ring

omit [SecondCountableTopology E] in
/-- **The inverse crossing clock at a rational time is determined by the path read in its clock.**
Under `K z` suppose the shift identity holds at every `t, s`, the infimum defining `A_t` is attained,
and `u ↦ A_u` is continuous.  Then for every rational `q` the variable `A_q` is almost surely a
measurable function of the rational-time restriction of the path read in its crossing clock. -/
theorem exists_measurable_pathClockInv_ratTime [PolishSpace E]
    {K : E → ProbabilityMeasure C(ℝ≥0, E)} (hK : Continuous K) {z : E}
    (hM : ∀ t, MarkovAt K z t) (m : ℝ≥0∞)
    (hshift : ∀ t s : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), ShiftIdentity m t s x)
    (hatt : ∀ t : ℝ≥0, ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (t : ℝ≥0∞) ≤ crossClock m (fun w => x w) (pathClockInv m x t).toNNReal)
    (hcont : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      Continuous fun u : ℝ≥0 => (pathClockInv m x u).toReal)
    (q : ℚ) :
    ∃ g : (ℚ → E) → ℝ, Measurable g ∧ ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)),
      (pathClockInv m x (ratTime q)).toReal =
        g (ratPath fun t => clockPath m (fun u => x u) t) := by
  classical
  rcases le_or_gt q 0 with hq | hq
  · refine ⟨fun _ => 0, measurable_const, Filter.Eventually.of_forall fun x => ?_⟩
    have h0 : ratTime q = 0 := by
      unfold ratTime
      exact Real.toNNReal_of_nonpos (Rat.cast_nonpos.2 hq)
    rw [h0, pathClockInv_zero]
    simp
  have hfin : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), pathClockInv m x (ratTime q) < ⊤ :=
    (hshift (ratTime q) 0).mono fun x hx => hx.1
  have hgood := hfin.and hcont
  obtain ⟨N, hN, hNm, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 hgood)
  have haeN : ∀ᵐ x ∂(K z : Measure C(ℝ≥0, E)), x ∉ N := measure_eq_zero_iff_ae_notMem.1 hN0
  have hgoodN : ∀ x, x ∉ N → pathClockInv m x (ratTime q) < ⊤ ∧
      Continuous fun u : ℝ≥0 => (pathClockInv m x u).toReal := fun x hx => by
    by_contra h
    exact hx (hN h)
  obtain ⟨Abar, hAbar⟩ : ∃ Abar : ℝ → C(ℝ≥0, E) → ℝ, ∀ u x,
      Abar u x = if x ∈ N then u else (pathClockInv m x u.toNNReal).toReal :=
    ⟨fun u x => if x ∈ N then u else (pathClockInv m x u.toNNReal).toReal, fun _ _ => rfl⟩
  have hmeasAbar : ∀ u, Measurable (Abar u) := fun u => by
    have : Abar u = fun x => if x ∈ N then u else (pathClockInv m x u.toNNReal).toReal :=
      funext (hAbar u)
    rw [this]
    exact Measurable.ite hNm measurable_const (measurable_pathClockInv m _).ennreal_toReal
  have hcontAbar : ∀ x, ContinuousOn (fun u => Abar u x) (Set.Icc (0 : ℝ) (q : ℝ)) := fun x => by
    by_cases hx : x ∈ N
    · have e : (fun u => Abar u x) = fun u : ℝ => u := by
        funext u
        simp only [hAbar, hx, ↓reduceIte]
      rw [e]
      exact continuousOn_id
    · have e : (fun u => Abar u x) =
          fun u : ℝ => (pathClockInv m x u.toNNReal).toReal := by
        funext u
        simp only [hAbar, hx, ↓reduceIte]
      rw [e]
      exact ((hgoodN x hx).2.comp continuous_real_toNNReal).continuousOn
  have hmonoAbar : ∀ x, MonotoneOn (fun u => Abar u x) (Set.Icc (0 : ℝ) (q : ℝ)) := fun x => by
    by_cases hx : x ∈ N
    · intro u _ v _ huv
      show Abar u x ≤ Abar v x
      simp only [hAbar, hx, ↓reduceIte]
      exact huv
    · intro u _ v hv huv
      show Abar u x ≤ Abar v x
      simp only [hAbar, hx, ↓reduceIte]
      have hvq : v.toNNReal ≤ ratTime q := Real.toNNReal_mono hv.2
      refine ENNReal.toReal_mono ?_ (clockInv_mono (crossClock m fun w => x w)
        (Real.toNNReal_mono huv))
      exact ((clockInv_mono (crossClock m fun w => x w) hvq).trans_lt (hgoodN x hx).1).ne
  have hBm : Measurable fun x : C(ℝ≥0, E) => ratPath fun t => clockPath m (fun u => x u) t :=
    measurable_ratClockPath m
  have hind : ∀ n : ℕ, iCondIndepFun
      (MeasurableSpace.comap (fun x : C(ℝ≥0, E) => ratPath fun t => clockPath m (fun u => x u) t)
        inferInstance) hBm.comap_le
      (fun k : Fin (n + 1) => cellIncrement Abar 0 (q : ℝ) n k) (K z : Measure C(ℝ≥0, E)) := by
    intro n
    have hmono' : Monotone fun j : ℕ => (j : ℚ) * (q / (n + 1)) := fun i j hij =>
      mul_le_mul_of_nonneg_right (Nat.cast_le.2 hij) (by positivity)
    refine iCondIndepFun.congr_ae (iCondIndepFun_clockIncrements hK hM m hshift hatt _ hmono'
      (n + 1)) fun k => ?_
    filter_upwards [haeN] with x hx
    have hp : ∀ j : ℕ, (cellPoint 0 (q : ℝ) n j).toNNReal =
        ratTime ((j : ℚ) * (q / (n + 1))) := by
      intro j
      have : cellPoint 0 (q : ℝ) n j = (((j : ℚ) * (q / (n + 1)) : ℚ) : ℝ) := by
        unfold cellPoint
        push_cast
        ring
      rw [this]
      rfl
    show _ = Abar (cellPoint 0 (q : ℝ) n (k + 1)) x - Abar (cellPoint 0 (q : ℝ) n k) x
    simp only [hAbar, hx, ↓reduceIte, hp]
  obtain ⟨g, hg, hae⟩ := exists_measurable_comp_ae_eq_of_condIndep_increments hBm
    (P := (K z : Measure C(ℝ≥0, E))) (A := Abar) (s := 0) (t := (q : ℝ))
    (by exact_mod_cast hq.le) hmeasAbar hcontAbar hmonoAbar hind
  refine ⟨g, hg, ?_⟩
  filter_upwards [hae, haeN] with x hx hxN
  have hx' : Abar (q : ℝ) x - Abar 0 x =
      g (ratPath fun t => clockPath m (fun u => x u) t) := hx
  simp only [hAbar, hxN, ↓reduceIte, Real.toNNReal_zero, pathClockInv_zero, ENNReal.toReal_zero,
    sub_zero] at hx'
  exact hx'

end

end LatticeProb
