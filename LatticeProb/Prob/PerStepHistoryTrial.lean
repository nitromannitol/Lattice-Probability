import LatticeProb.Prob.ConditionalTrialHistory
import LatticeProb.Topology.FiniteNestedExitTrial

/-! # Conditional trials against per-step histories

A conditional success bound for the `k`-th trial is often available given a
history `G k` that contains the earlier trials, while the histories `G k` are
not known to be nested. The earlier trials generate a filtration that lies
below every such history, so the conditional bounds descend to it and the
exponential failure bound of a filtration-adapted family of trials applies. -/

set_option autoImplicit false

open Set Metric MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace LatticeProb

/-- The filtration generated by the trials `A i`, `i < n`, that occur strictly before each
step. -/
def trialFiltration {Ω : Type*} {m : MeasurableSpace Ω} (A : ℕ → Set Ω) (n : ℕ)
    (hA : ∀ k < n, MeasurableSet (A k)) : Filtration ℕ m where
  seq k := ⨆ (i : ℕ) (_ : i < k ∧ i < n), MeasurableSpace.generateFrom {A i}
  mono' := by
    intro k l hkl
    exact iSup₂_mono' fun i hi => ⟨i, ⟨lt_of_lt_of_le hi.1 hkl, hi.2⟩, le_rfl⟩
  le' := by
    intro k
    refine iSup₂_le fun i hi => MeasurableSpace.generateFrom_le ?_
    rintro s rfl
    exact hA i hi.2

/-- Each trial before `n` is measurable at the following step of the trial filtration. -/
theorem measurableSet_trialFiltration_succ {Ω : Type*} [MeasurableSpace Ω]
    (A : ℕ → Set Ω) (n : ℕ) (hA : ∀ k < n, MeasurableSet (A k)) (k : ℕ) (hk : k < n) :
    MeasurableSet[trialFiltration A n hA (k + 1)] (A k) := by
  have hle : MeasurableSpace.generateFrom {A k} ≤
      ⨆ (i : ℕ) (_ : i < k + 1 ∧ i < n), MeasurableSpace.generateFrom {A i} :=
    le_iSup₂_of_le k ⟨Nat.lt_succ_self k, hk⟩ le_rfl
  exact hle _ (MeasurableSpace.measurableSet_generateFrom rfl)

/-- The trial filtration lies below any history that contains the earlier trials. -/
theorem trialFiltration_le_of_measurableSet {Ω : Type*} [MeasurableSpace Ω]
    (A : ℕ → Set Ω) (n : ℕ) (hA : ∀ k < n, MeasurableSet (A k))
    (G : MeasurableSpace Ω) (k : ℕ) (hAG : ∀ i < k, i < n → MeasurableSet[G] (A i)) :
    trialFiltration A n hA k ≤ G := by
  show (⨆ (i : ℕ) (_ : i < k ∧ i < n), MeasurableSpace.generateFrom {A i}) ≤ G
  refine iSup₂_le fun i hi => MeasurableSpace.generateFrom_le ?_
  rintro s rfl
  exact hAG i hi.1 hi.2

/-- Trials with conditional success probability at least `p`, each given a history that
contains the earlier trials, all fail with probability at most `exp (-(p ^ 2 / 2) n)`. The
histories need not be nested. -/
theorem measureReal_no_success_le_of_condExp_ge_perStepHistory
    {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
    (G : ℕ → MeasurableSpace Ω) (A : ℕ → Set Ω) (n : ℕ)
    (hG : ∀ k < n, G k ≤ m) (hA : ∀ k < n, MeasurableSet (A k))
    (hAG : ∀ k < n, ∀ i < k, MeasurableSet[G k] (A i))
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1)
    (hp : ∀ k < n, ∀ᵐ ω ∂μ, p ≤ μ[(A k).indicator (fun _ => (1 : ℝ)) | G k] ω) :
    μ.real {ω | ∀ k ∈ Finset.range n, ω ∉ A k} ≤
      Real.exp (-(p ^ 2 / 2) * n) := by
  refine measureReal_no_success_le_of_condExp_ge_on_range (trialFiltration A n hA) A n
    (fun k hk => measurableSet_trialFiltration_succ A n hA k hk) hp0 hp1 ?_
  intro k hk
  exact condExp_const_le_of_le_of_condExp_const_le
    (trialFiltration_le_of_measurableSet A n hA (G k) k
      (fun i hi _ => hAG k hk i hi)) (hG k hk) (hp k hk)

/-- The `k`-th nested exit trial: some ball of radius `a` lies in the trace of `η` between
its first exits, after time `t₀`, from the concentric balls of radii `r k` and `r (k + 1)`. -/
def nestedExitTrialEvent {Ω E : Type*} [PseudoMetricSpace E] (η : Ω → ℝ → E)
    (t₀ : Ω → ℝ) (z : E) (r : ℕ → ℝ) (a : ℝ) (k : ℕ) : Set Ω :=
  {ω | ∃ w, ball w a ⊆ η ω '' Icc
    (sInf {t : ℝ | t₀ ω ≤ t ∧ η ω t ∉ ball z (r k)})
    (sInf {t : ℝ | t₀ ω ≤ t ∧ η ω t ∉ ball z (r (k + 1))})}

/-- Nested exit trials with conditional success probability at least `p`, each given a
history containing the earlier trials, yield the inverse-scale exponential bound for the
failure of the whole first-exit trace. The histories need not be nested. -/
theorem measureReal_firstExitTrace_failure_le_floor_inv_of_perStepHistory
    {Ω E : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
    [PseudoMetricSpace E] (G : ℕ → MeasurableSpace Ω) (η : Ω → ℝ → E)
    (t₀ : Ω → ℝ) (z : E) (r : ℕ → ℝ) (R a C ε : ℝ)
    (hr : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, r k ≤ R ∧ r (k + 1) ≤ R)
    (hpath : ∀ᵐ ω ∂μ, Continuous (η ω) ∧
      openExitTime (fun s (_ : Unit) => η ω (t₀ ω + (s : ℝ))) (ball z R) () ≠ ⊤)
    (hG : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, G k ≤ m)
    (hA : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, MeasurableSet (nestedExitTrialEvent η t₀ z r a k))
    (hAG : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, ∀ i < k,
      MeasurableSet[G k] (nestedExitTrialEvent η t₀ z r a i))
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1)
    (hp : ∀ k < ⌊(C * ε)⁻¹⌋₊ - 1, ∀ᵐ ω ∂μ,
      p ≤ μ[(nestedExitTrialEvent η t₀ z r a k).indicator (fun _ => (1 : ℝ)) | G k] ω) :
    μ.real {ω | ¬ ∃ w, ball w a ⊆ η ω '' Icc (t₀ ω)
      (sInf {t : ℝ | t₀ ω ≤ t ∧ η ω t ∉ ball z R})} ≤
      Real.exp (p ^ 2) * Real.exp (-(p ^ 2 / 2) * (C * ε)⁻¹) := by
  set n := ⌊(C * ε)⁻¹⌋₊ - 1 with hn
  let ℱ := trialFiltration (nestedExitTrialEvent η t₀ z r a) n hA
  refine measureReal_firstExitTrace_failure_le_floor_inv_on_range ℱ η t₀ z r R a C ε hr
    hpath (fun k hk => measurableSet_trialFiltration_succ _ n hA k hk) hp0 hp1 ?_
  intro k hk
  exact condExp_const_le_of_le_of_condExp_const_le
    (trialFiltration_le_of_measurableSet _ n hA (G k) k
      (fun i hi _ => hAG k hk i hi)) (hG k hk) (hp k hk)

end LatticeProb
