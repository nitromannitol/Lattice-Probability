import Mathlib

/-!
# Integrals against a measurable family of measures, and vague limits

Let `X` be a measurable space and let `Measure X` carry Mathlib's σ-algebra `Measure.instMeasurableSpace`, the
one generated by the evaluations `m ↦ m s`. For every measurable `φ : X → ℝ` the map `m ↦ ∫ φ dm` is measurable
(`LatticeProb.measurable_integral_measure`). Hence, if `ω ↦ ν n ω` is a sequence of a.e. measurable random measures
on `X` which converge vaguely to `μ ω` for `P`-almost every `ω`, then `ω ↦ ∫ φ d(μ ω)` is a.e. measurable for every
continuous compactly supported test function `φ` (`LatticeProb.aemeasurable_integral_of_vague_limit`).

Literature locator: standard measure theory. The measurability of `m ↦ ∫ φ dm` is the measurability of integrals
of a measurable kernel (Kallenberg, *Foundations of Modern Probability*, 2nd ed., chapter on kernels), proved here
from the Giry-monad lemma `MeasureTheory.Measure.measurable_lintegral`. Vague convergence of locally finite measures
is tested against continuous compactly supported functions (Kallenberg, *Random Measures, Theory and Applications*,
2017). No theorem number is claimed.
-/

namespace LatticeProb

open MeasureTheory Filter Topology
open scoped ENNReal

/-- The map `m ↦ ∫ φ dm` is measurable on the space of measures on `X`, for every measurable `φ : X → ℝ`.
The Bochner integral vanishes when `φ` is not `m`-integrable, so it equals
`(∫⁻ φ⁺ dm).toReal - (∫⁻ φ⁻ dm).toReal` on the measurable set `{m | ∫⁻ |φ| dm < ∞}` and `0` elsewhere. -/
theorem measurable_integral_measure {X : Type*} [MeasurableSpace X] {φ : X → ℝ} (hφ : Measurable φ) :
    Measurable fun m : Measure X => ∫ x, φ x ∂m := by
  have hpos : Measurable fun x => ENNReal.ofReal (φ x) := ENNReal.measurable_ofReal.comp hφ
  have hneg : Measurable fun x => ENNReal.ofReal (-φ x) := ENNReal.measurable_ofReal.comp hφ.neg
  have hnorm : Measurable fun x => ‖φ x‖ₑ := hφ.enorm
  have hset : MeasurableSet {m : Measure X | ∫⁻ x, ‖φ x‖ₑ ∂m < ∞} :=
    measurableSet_lt (Measure.measurable_lintegral hnorm) measurable_const
  have key : (fun m : Measure X => ∫ x, φ x ∂m) = fun m : Measure X =>
      if ∫⁻ x, ‖φ x‖ₑ ∂m < ∞ then
        (∫⁻ x, ENNReal.ofReal (φ x) ∂m).toReal - (∫⁻ x, ENNReal.ofReal (-φ x) ∂m).toReal
      else 0 := by
    funext m
    split_ifs with hm
    · rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part]
      exact ⟨hφ.aestronglyMeasurable, hm⟩
    · rw [integral_undef]
      exact fun h => hm h.2
  rw [key]
  exact Measurable.ite hset
    ((ENNReal.measurable_toReal.comp (Measure.measurable_lintegral hpos)).sub
      (ENNReal.measurable_toReal.comp (Measure.measurable_lintegral hneg)))
    measurable_const

/-- Vague limits of a.e. measurable random measures are a.e. measurable against test functions. Let `ν n ω` be
measures on `X`, each `ν n` a.e. measurable as a map `Ω → Measure X`, and let `μ ω` be measures such that
`∫ f d(ν n ω) → ∫ f d(μ ω)` for every continuous compactly supported `f`, for `P`-almost every `ω`. Then for every
continuous compactly supported `φ`, the map `ω ↦ ∫ φ d(μ ω)` is a.e. measurable. -/
theorem aemeasurable_integral_of_vague_limit {Ω X : Type*} [MeasurableSpace Ω] [TopologicalSpace X]
    [MeasurableSpace X] [BorelSpace X] (P : Measure Ω) (ν : ℕ → Ω → Measure X) (μ : Ω → Measure X)
    (hν : ∀ n, AEMeasurable (ν n) P)
    (hvague : ∀ᵐ ω ∂P, ∀ f : X → ℝ, Continuous f → HasCompactSupport f →
      Tendsto (fun n => ∫ x, f x ∂(ν n ω)) atTop (𝓝 (∫ x, f x ∂(μ ω))))
    (φ : X → ℝ) (hφ : Continuous φ) (hφc : HasCompactSupport φ) :
    AEMeasurable (fun ω => ∫ x, φ x ∂(μ ω)) P := by
  refine aemeasurable_of_tendsto_metrizable_ae (f := fun (n : ℕ) (ω : Ω) => ∫ x, φ x ∂(ν n ω))
    (atTop : Filter ℕ) (fun n => ?_) ?_
  · exact (measurable_integral_measure hφ.measurable).comp_aemeasurable (hν n)
  · filter_upwards [hvague] with ω hω using hω φ hφ hφc

end LatticeProb
