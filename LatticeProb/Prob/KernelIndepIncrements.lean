import Mathlib
import LatticeProb.Prob.ContinuousMonotoneIndepIncrements

/-!
# Independent increments under a kernel

Let `κ` be a Markov kernel, `ν` a measure on the source and `f₁, …, f_d` real random variables
which are independent under `κ` for `ν`-almost every `a` in the sense of
`ProbabilityTheory.Kernel.iIndepFun` (for each family of sets, the product formula holds for
`ν`-almost every `a`).  Because the Borel σ-algebra of `ℝ` is generated by the countable
π-system of half-lines `(-∞, q]`, `q ∈ ℚ`, the null sets can be collected: for `ν`-almost every
`a`, the variables are independent under the measure `κ a`.

* `LatticeProb.ae_iIndepFun_of_kernel_iIndepFun`: this transfer.
* `LatticeProb.ae_ae_eq_integral_of_kernel_indepIncrements`: if `A` has continuous nondecreasing
  paths on `[s, t]` and its increments over every uniform partition of `[s, t]` are independent
  under `κ`, then for `ν`-almost every `a`, `A t - A s` is `κ a`-almost surely equal to its
  `κ a`-mean.
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory

namespace LatticeProb

variable {α Ω : Type*} {mα : MeasurableSpace α} {mΩ : MeasurableSpace Ω}

/-- If finitely many real random variables are independent under a Markov kernel `κ` for the
measure `ν`, then for `ν`-almost every `a` they are independent under the measure `κ a`. -/
theorem ae_iIndepFun_of_kernel_iIndepFun {κ : Kernel α Ω} [IsMarkovKernel κ] {ν : Measure α}
    {d : ℕ} {f : Fin d → Ω → ℝ} (hf : ∀ i, Measurable (f i)) (h : Kernel.iIndepFun f κ ν) :
    ∀ᵐ a ∂ν, iIndepFun f (κ a) := by
  have h1 := (Kernel.iIndepFun_iff_measure_inter_preimage_eq_mul _ _).1 h
  have h2 : ∀ᵐ a ∂ν, ∀ (S : Finset (Fin d)) (q : Fin d → ℚ),
      κ a (⋂ i ∈ S, f i ⁻¹' Set.Iic (q i : ℝ)) = ∏ i ∈ S, κ a (f i ⁻¹' Set.Iic (q i : ℝ)) := by
    rw [ae_all_iff]
    intro S
    rw [ae_all_iff]
    intro q
    exact h1 S (sets := fun i => Set.Iic (q i : ℝ)) (fun i _ => measurableSet_Iic)
  filter_upwards [h2] with a ha
  have hpi : ∀ i, IsPiSystem (Set.range fun q : ℚ => f i ⁻¹' Set.Iic (q : ℝ)) := by
    intro i
    rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩ _
    refine ⟨min x y, ?_⟩
    ext ω
    simp [Rat.cast_min]
  have hgen : ∀ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ) =
      MeasurableSpace.generateFrom (Set.range fun q : ℚ => f i ⁻¹' Set.Iic (q : ℝ)) := by
    intro i
    have h3 := MeasurableSpace.comap_generateFrom (f := f i)
      (s := ⋃ x : ℚ, {Set.Iic (x : ℝ)})
    rw [← Real.borel_eq_generateFrom_Iic_rat, ← BorelSpace.measurable_eq] at h3
    rw [h3]
    congr 1
    ext s
    simp [Set.mem_image, eq_comm]
  rw [iIndepFun_iff_iIndep]
  refine iIndepSets.iIndep (m := fun i => MeasurableSpace.comap (f i) (inferInstance :
    MeasurableSpace ℝ)) (fun i => (hf i).comap_le) _ hpi (fun i => hgen i) ?_
  rw [iIndepSets_iff]
  intro S g hg
  have hq : ∀ i, ∃ q : ℚ, i ∈ S → g i = f i ⁻¹' Set.Iic (q : ℝ) := by
    intro i
    by_cases hi : i ∈ S
    · obtain ⟨q, hq⟩ := hg i hi
      exact ⟨q, fun _ => hq.symm⟩
    · exact ⟨0, fun h => absurd h hi⟩
  choose q hq using hq
  have e1 : (⋂ i ∈ S, g i) = ⋂ i ∈ S, f i ⁻¹' Set.Iic (q i : ℝ) :=
    Set.iInter₂_congr fun i hi => hq i hi
  have e2 : ∏ i ∈ S, κ a (g i) = ∏ i ∈ S, κ a (f i ⁻¹' Set.Iic (q i : ℝ)) :=
    Finset.prod_congr rfl fun i hi => by rw [hq i hi]
  rw [e1, e2]
  exact ha S q

/-- **Conditional constancy of the increments of a continuous nondecreasing process.**
Let `A` have continuous nondecreasing paths on `[s, t]`, and suppose that for every `n` the
increments of `A` over the cells of the uniform partition of `[s, t]` into `n + 1` cells are
independent under the Markov kernel `κ` for `ν`.  Then for `ν`-almost every `a`, `A t - A s` is
`κ a`-almost surely equal to its `κ a`-mean. -/
theorem ae_ae_eq_integral_of_kernel_indepIncrements {κ : Kernel α Ω} [IsMarkovKernel κ]
    {ν : Measure α} {A : ℝ → Ω → ℝ} {s t : ℝ} (hst : s ≤ t) (hmeas : ∀ u, Measurable (A u))
    (hcont : ∀ ω, ContinuousOn (fun u => A u ω) (Set.Icc s t))
    (hmono : ∀ ω, MonotoneOn (fun u => A u ω) (Set.Icc s t))
    (hind : ∀ n : ℕ, Kernel.iIndepFun (fun k : Fin (n + 1) => cellIncrement A s t n k) κ ν) :
    ∀ᵐ a ∂ν, (fun ω => A t ω - A s ω) =ᵐ[κ a] fun _ => ∫ ω, (A t ω - A s ω) ∂κ a := by
  have h : ∀ n : ℕ, ∀ᵐ a ∂ν, iIndepFun (fun k : Fin (n + 1) => cellIncrement A s t n k) (κ a) :=
    fun n => ae_iIndepFun_of_kernel_iIndepFun (fun k => measurable_cellIncrement hmeas n k)
      (hind n)
  filter_upwards [ae_all_iff.2 h] with a ha
  obtain ⟨c, hc⟩ := ae_eq_const_of_monotone_continuous_indepIncrements (μ := κ a) hst hmeas hcont
    hmono ha
  have hint : ∫ ω, (A t ω - A s ω) ∂κ a = c := by
    rw [integral_congr_ae hc]
    simp
  rw [hint]
  exact hc

end LatticeProb
