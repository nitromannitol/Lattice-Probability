import LatticeProb.Prob.CorrelatedBMFixedTimeDescent
import LatticeProb.Bonanno.MatedCRTHarmonic.Frozen.MatedCRTDirectRel

/-!
# Singleton contour classes at a fixed time

Two-sided descent isolates a time in the equivalence relation generated by strict contour
identifications. For correlated Brownian motion this holds almost surely at each fixed time.
-/

open MeasureTheory Set
open MatedCRTHarmonic.MatedCRT

namespace LatticeProb.CorrelatedBM

/-- Two-sided descent excludes a strict contour identification with the anchor as an endpoint. -/
theorem not_directRel_anchor {X : ℝ → ℝ} {a : ℝ}
    (hleft : ∀ u < a, ∃ w ∈ Ioo u a, X w < X a)
    (hright : ∀ u, a < u → ∃ w ∈ Ioo a u, X w < X a) :
    (∀ t, ¬ DirectRel X a t) ∧ ∀ s, ¬ DirectRel X s a := by
  constructor
  · intro t h
    obtain ⟨w, hw, hlt⟩ := hright t h.1
    exact (not_lt_of_ge (le_of_lt (h.2.2 w hw))) hlt
  · intro s h
    obtain ⟨w, hw, hlt⟩ := hleft s h.1
    have hgt := h.2.2 w hw
    rw [h.2.1] at hgt
    exact (not_lt_of_ge (le_of_lt hgt)) hlt

/-- If both functions descend on both sides of an anchor, its generated contour class is singleton. -/
theorem eqvGen_directRel_anchor_iff {X Y : ℝ → ℝ} {a t : ℝ}
    (hX : (∀ u < a, ∃ w ∈ Ioo u a, X w < X a) ∧
      ∀ u, a < u → ∃ w ∈ Ioo a u, X w < X a)
    (hY : (∀ u < a, ∃ w ∈ Ioo u a, Y w < Y a) ∧
      ∀ u, a < u → ∃ w ∈ Ioo a u, Y w < Y a) :
    Relation.EqvGen (fun s t => DirectRel X s t ∨ DirectRel Y s t) a t ↔ t = a := by
  have hX' := not_directRel_anchor hX.1 hX.2
  have hY' := not_directRel_anchor hY.1 hY.2
  have hchain : ∀ {s t}, Relation.EqvGen (fun s t => DirectRel X s t ∨ DirectRel Y s t) s t →
      (s = a ↔ t = a) := by
    intro s t h
    induction h with
    | rel s t h =>
      constructor
      · intro hs
        subst s
        exact False.elim (h.elim (hX'.1 t) (hY'.1 t))
      · intro ht
        subst t
        exact False.elim (h.elim (hX'.2 s) (hY'.2 s))
    | refl => exact Iff.rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  constructor
  · intro h
    exact (hchain h).1 rfl
  · rintro rfl
    exact Relation.EqvGen.refl _

/-- The contour class of a fixed time of a correlated Brownian pair is almost surely singleton. -/
theorem ae_eqvGen_directRel_anchor_iff {γ : ℝ} {μ : Measure Path2}
    (hμ : IsCorrelatedBM2 γ μ) (a : ℝ) :
    ∀ᵐ ω ∂μ, ∀ t, Relation.EqvGen
      (fun s t => DirectRel (fun u => lrCoord 0 u ω) s t ∨
        DirectRel (fun u => lrCoord 1 u ω) s t) a t ↔ t = a := by
  filter_upwards [ae_forall_coord_real_descends hμ a] with ω hω
  intro t
  exact eqvGen_directRel_anchor_iff (hω 0) (hω 1)

end LatticeProb.CorrelatedBM
