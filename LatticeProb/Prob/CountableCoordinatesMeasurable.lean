import Mathlib

/-!
# Measurable maps of a generated sigma-algebra depend on countably many coordinates

Let `X i : α → E i` be a family of maps into measurable spaces and `p` a predicate on the indices. An event of the
sigma-algebra `⨆ (i) (_ : p i), comap (X i)` is an event of the sigma-algebra generated by countably many of the maps
`X i` with `p i`; the same holds for a measurable map `g` from `α` into a countably generated measurable space. If
moreover the singletons of the target are measurable, then `g` takes the same value at two points at which these
countably many maps agree. Consequently, for random elements `F` and `G` of `α` such that `X i ∘ F = X i ∘ G` almost
everywhere for each index `i` with `p i` separately, `g ∘ F = g ∘ G` almost everywhere.

* `LatticeProb.exists_countable_measurableSet_iSup_comap`: the statement for events.
* `LatticeProb.exists_countable_measurable_iSup_comap`: the statement for maps into a countably generated space.
* `LatticeProb.eq_of_measurable_iSup_comap`: a map measurable for the sigma-algebra generated by the `X i`, `i ∈ J`,
  takes equal values at points where all the `X i`, `i ∈ J`, agree.
* `LatticeProb.exists_countable_determining_of_measurable_iSup_comap`: the two combined.
* `LatticeProb.ae_eq_comp_of_measurable_iSup_comap`: the almost-everywhere consequence.

`LatticeProb.exists_seq_measurableSet_of_measurableSet_iSup_comap_of_forall` gives the event statement in a
sequential form under the assumption that some index satisfies `p`; here no such assumption is made.
-/

open MeasureTheory Set

namespace LatticeProb

variable {α ι : Type*} {E : ι → Type*} [mE : ∀ i, MeasurableSpace (E i)]

/-- An event of the sigma-algebra generated by the maps `X i` with `p i` is an event of the sigma-algebra generated
by countably many of them. -/
theorem exists_countable_measurableSet_iSup_comap {p : ι → Prop} {X : ∀ i, α → E i} {A : Set α}
    (hA : MeasurableSet[⨆ (i) (_ : p i), MeasurableSpace.comap (X i) (mE i)] A) :
    ∃ J : Set ι, J.Countable ∧ (∀ i ∈ J, p i) ∧
      MeasurableSet[⨆ (i) (_ : i ∈ J), MeasurableSpace.comap (X i) (mE i)] A := by
  rw [iSup_subtype', MeasurableSpace.measurableSet_iSup] at hA
  induction hA with
  | basic s hs =>
    obtain ⟨i, hi⟩ := hs
    refine ⟨{i.1}, countable_singleton _, fun j hj => ?_, ?_⟩
    · rw [mem_singleton_iff.1 hj]
      exact i.2
    · exact le_iSup₂ (f := fun j (_ : j ∈ ({i.1} : Set ι)) => MeasurableSpace.comap (X j) (mE j))
        i.1 rfl s hi
  | empty => exact ⟨∅, countable_empty, fun _ h => h.elim, MeasurableSpace.measurableSet_empty _⟩
  | compl s _ ih =>
    obtain ⟨J, hJ, hJp, h⟩ := ih
    exact ⟨J, hJ, hJp, MeasurableSpace.measurableSet_compl _ _ h⟩
  | iUnion f _ ih =>
    choose J hJ hJp h using ih
    refine ⟨⋃ n, J n, countable_iUnion hJ, fun i hi => ?_,
      MeasurableSpace.measurableSet_iUnion _ _ fun n => ?_⟩
    · obtain ⟨n, hn⟩ := mem_iUnion.1 hi
      exact hJp n i hn
    · exact (iSup₂_mono' fun j hj => ⟨j, mem_iUnion.2 ⟨n, hj⟩, le_rfl⟩ :
        (⨆ (j) (_ : j ∈ J n), MeasurableSpace.comap (X j) (mE j)) ≤ _) _ (h n)

/-- A map into a countably generated measurable space that is measurable for the sigma-algebra generated by the
maps `X i` with `p i` is measurable for the sigma-algebra generated by countably many of them. -/
theorem exists_countable_measurable_iSup_comap {γ : Type*} [MeasurableSpace γ]
    [MeasurableSpace.CountablyGenerated γ] {p : ι → Prop} {X : ∀ i, α → E i} {g : α → γ}
    (hg : Measurable[⨆ (i) (_ : p i), MeasurableSpace.comap (X i) (mE i)] g) :
    ∃ J : Set ι, J.Countable ∧ (∀ i ∈ J, p i) ∧
      Measurable[⨆ (i) (_ : i ∈ J), MeasurableSpace.comap (X i) (mE i)] g := by
  have hb := MeasurableSpace.countable_countableGeneratingSet (α := γ)
  have hJex : ∀ t : MeasurableSpace.countableGeneratingSet γ, ∃ J : Set ι, J.Countable ∧ (∀ i ∈ J, p i) ∧
      MeasurableSet[⨆ (i) (_ : i ∈ J), MeasurableSpace.comap (X i) (mE i)] (g ⁻¹' t) := fun t =>
    exists_countable_measurableSet_iSup_comap
      (hg (MeasurableSpace.measurableSet_countableGeneratingSet t.2))
  choose J hJ hJp h using hJex
  have : Countable (MeasurableSpace.countableGeneratingSet γ) := hb.to_subtype
  refine ⟨⋃ t, J t, countable_iUnion hJ, fun i hi => ?_, ?_⟩
  · obtain ⟨t, ht⟩ := mem_iUnion.1 hi
    exact hJp t i ht
  · have key := @measurable_generateFrom _ _
      (⨆ (i) (_ : i ∈ ⋃ t, J t), MeasurableSpace.comap (X i) (mE i))
      (MeasurableSpace.countableGeneratingSet γ) g (fun t ht =>
        (iSup₂_mono' fun j hj => ⟨j, mem_iUnion.2 ⟨⟨t, ht⟩, hj⟩, le_rfl⟩ :
          (⨆ (j) (_ : j ∈ J ⟨t, ht⟩), MeasurableSpace.comap (X j) (mE j)) ≤ _) _ (h ⟨t, ht⟩))
    rwa [MeasurableSpace.generateFrom_countableGeneratingSet] at key

/-- A map with measurable singletons in its target that is measurable for the sigma-algebra generated by the maps
`X i`, `i ∈ J`, takes equal values at two points at which all these maps agree. -/
theorem eq_of_measurable_iSup_comap {γ : Type*} [MeasurableSpace γ] [MeasurableSingletonClass γ]
    {J : Set ι} {X : ∀ i, α → E i} {g : α → γ}
    (hg : Measurable[⨆ (i) (_ : i ∈ J), MeasurableSpace.comap (X i) (mE i)] g) {x y : α}
    (hxy : ∀ i ∈ J, X i x = X i y) : g x = g y := by
  obtain ⟨R, hRdef⟩ : ∃ R : α → ∀ i : J, E i, R = fun z (i : J) => X i z := ⟨_, rfl⟩
  have hle : (⨆ (i) (_ : i ∈ J), MeasurableSpace.comap (X i) (mE i)) ≤
      MeasurableSpace.comap R MeasurableSpace.pi := by
    refine iSup₂_le fun i hi => ?_
    have e : X i = (fun f : ∀ j : J, E j => f ⟨i, hi⟩) ∘ R := by subst hRdef; rfl
    rw [e, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_pi_apply (⟨i, hi⟩ : J)).comap_le
  obtain ⟨s, -, hs⟩ := MeasurableSpace.measurableSet_comap.1 (hle _ (hg (measurableSet_singleton (g x))))
  have hR : R x = R y := by
    subst hRdef
    exact funext fun i => hxy i i.2
  have hx : R x ∈ s := by
    show x ∈ R ⁻¹' s
    rw [hs]
    exact mem_singleton (g x)
  have hy : y ∈ g ⁻¹' {g x} := by
    rw [← hs]
    show R y ∈ s
    rw [← hR]
    exact hx
  exact (hy : g y = g x).symm

/-- A map into a countably generated space with measurable singletons that is measurable for the sigma-algebra
generated by the maps `X i` with `p i` is determined by countably many of them. -/
theorem exists_countable_determining_of_measurable_iSup_comap {γ : Type*} [MeasurableSpace γ]
    [MeasurableSpace.CountablyGenerated γ] [MeasurableSingletonClass γ] {p : ι → Prop}
    {X : ∀ i, α → E i} {g : α → γ}
    (hg : Measurable[⨆ (i) (_ : p i), MeasurableSpace.comap (X i) (mE i)] g) :
    ∃ J : Set ι, J.Countable ∧ (∀ i ∈ J, p i) ∧
      ∀ x y : α, (∀ i ∈ J, X i x = X i y) → g x = g y := by
  obtain ⟨J, hJ, hJp, hgJ⟩ := exists_countable_measurable_iSup_comap hg
  exact ⟨J, hJ, hJp, fun _ _ h => eq_of_measurable_iSup_comap hgJ h⟩

/-- If two random elements `F` and `G` of `α` satisfy `X i ∘ F = X i ∘ G` almost everywhere for each index `i` with
`p i`, then `g ∘ F = g ∘ G` almost everywhere, for every map `g` into a countably generated space with measurable
singletons that is measurable for the sigma-algebra generated by the maps `X i` with `p i`. -/
theorem ae_eq_comp_of_measurable_iSup_comap {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {γ : Type*} [MeasurableSpace γ] [MeasurableSpace.CountablyGenerated γ] [MeasurableSingletonClass γ]
    {p : ι → Prop} {X : ∀ i, α → E i} {g : α → γ}
    (hg : Measurable[⨆ (i) (_ : p i), MeasurableSpace.comap (X i) (mE i)] g) {F G : Ω → α}
    (hFG : ∀ i, p i → ∀ᵐ ω ∂μ, X i (F ω) = X i (G ω)) : ∀ᵐ ω ∂μ, g (F ω) = g (G ω) := by
  obtain ⟨J, hJ, hJp, hdet⟩ := exists_countable_determining_of_measurable_iSup_comap hg
  have hall : ∀ᵐ ω ∂μ, ∀ i ∈ J, X i (F ω) = X i (G ω) :=
    (ae_ball_iff hJ).2 fun i hi => hFG i (hJp i hi)
  filter_upwards [hall] with ω hω using hdet _ _ hω

end LatticeProb
